def work_bundle_identity(bundle: Path, state: dict) -> str:
    return validate_bundle_identity(bundle, state)

def generic_receipt_identity(bundle: Path, state: dict) -> dict[str, str]:
    return {
        "workKind": state["work_kind"],
        "workId": state["work_id"],
        "workBundle": work_bundle_identity(bundle, state),
    }

def coordinator_git_common_dir() -> str:
    process = subprocess.run(
        ["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
        cwd=REPO, text=True, capture_output=True, check=False,
    )
    if process.returncode != 0:
        raise StateError(
            "cannot resolve coordinator Git common directory: "
            + process.stderr.strip()
        )
    value = process.stdout.strip()
    normalized = absolute_path_value(value, "coordinator Git common directory")
    if normalized != value:
        raise StateError("coordinator Git common directory must be canonical")
    return normalized

def typed_receipt(
    bundle: Path,
    relative: str | None,
    label: str,
    fields: set[str],
) -> tuple[dict, str]:
    if relative is None:
        raise StateError(f"{label} requires a typed receipt")
    path = safe_path(bundle, relative, label, required=True)
    if path.suffix != ".json":
        raise StateError(f"{label} must be JSON")
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise StateError(f"invalid {label}: {error}") from error
    return exact_object(raw, label, fields), hashlib.sha256(path.read_bytes()).hexdigest()

def receipt_schema(bundle: Path, relative: str, label: str) -> str | None:
    path = safe_path(bundle, relative, label, required=True)
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise StateError(f"invalid {label}: {error}") from error
    return raw.get("schema") if isinstance(raw, dict) else None

def receipt_kind(bundle: Path, relative: str, label: str) -> str | None:
    path = safe_path(bundle, relative, label, required=True)
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise StateError(f"invalid {label}: {error}") from error
    return raw.get("kind") if isinstance(raw, dict) else None

def git_binding_receipt_value(
    bundle: Path,
    state: dict,
    item: dict,
    role: str,
    task: dict,
    *,
    kind: str,
    relative: str | None,
    persisted: bool = False,
) -> tuple[dict, str]:
    label = f"{item['id']} {role} {kind.replace('_', '-')} receipt"
    fields = (
        GIT_BINDING_ADOPTION_RECEIPT_FIELDS
        if kind == "implementation_pr_adoption"
        else GIT_BINDING_RECEIPT_FIELDS
    )
    value, digest = typed_receipt(bundle, relative, label, fields)
    if value["schema"] != "spec-work-task-git-binding" or value["kind"] != kind:
        raise StateError(f"{label} has an unsupported schema or kind")
    for field in (
        "workKind", "workId", "workBundle", "sliceId", "role", "taskType",
        "launchMarker", "branch", "branchRef", "boundSha", "worktreeHeadSha",
        "localBranchSha", "observedRemoteHeadSha", "result",
    ):
        string_value(value[field], f"{label} {field}")
    integer_value(value["attempt"], f"{label} attempt", 1)
    integer_value(value["revisionEpoch"], f"{label} revisionEpoch", 1)
    integer_value(value["observationEpoch"], f"{label} observationEpoch", 1)
    optional_digest(value["releaseReceiptDigest"], f"{label} releaseReceiptDigest")
    optional_digest(
        value["reauthorizationDigest"],
        f"{label} reauthorizationDigest",
    )
    if kind == "review_attachment":
        validate_snapshot_authorization(
            value["snapshotAuthorization"],
            expected_slice=item["id"],
            candidate_head=value["boundSha"],
        )
        coordinator_authorization = item["implementation_task"][
            "snapshot_authorization"
        ]
        if value["snapshotAuthorization"] != coordinator_authorization:
            raise StateError(
                f"{label} differs from coordinator-approved snapshot authorization"
            )
    elif value["snapshotAuthorization"] is not None:
        raise StateError(
            f"{label} snapshotAuthorization applies only to review attachments"
        )
    owned_paths = [
        repo_path_value(path, f"{label} ownedPaths")
        for path in string_list(value["ownedPaths"], f"{label} ownedPaths")
    ]
    if owned_paths != sorted(set(owned_paths)):
        raise StateError(f"{label} ownedPaths must be sorted and unique")
    if value["releaseObservationEpoch"] is not None:
        integer_value(
            value["releaseObservationEpoch"],
            f"{label} releaseObservationEpoch", 1,
        )
    optional_string(value["threadId"], f"{label} threadId")
    optional_string(value["clientThreadId"], f"{label} clientThreadId")
    optional_string(value["symbolicRef"], f"{label} symbolicRef")
    if kind == "implementation_pr_adoption":
        string_value(value["baseRef"], f"{label} baseRef")
        string_value(value["baseSha"], f"{label} baseSha", pattern=SHA_RE)
        string_value(
            value["adoptionStartSha"],
            f"{label} adoptionStartSha",
            pattern=SHA_RE,
        )
        integer_value(value["pr"], f"{label} pr", 1)
    for field in (
        "boundSha", "worktreeHeadSha", "localBranchSha",
        "observedRemoteHeadSha",
    ):
        string_value(value[field], f"{label} {field}", pattern=SHA_RE)
    for field in ("gitCommonDir", "taskWorktree"):
        normalized = absolute_path_value(value[field], f"{label} {field}")
        if normalized != value[field]:
            raise StateError(f"{label} {field} must be a canonical absolute path")
    coordinator_common_dir = coordinator_git_common_dir()
    if value["gitCommonDir"] != coordinator_common_dir:
        raise StateError(f"{label} does not match coordinator Git common directory")
    if value["clean"] is not True:
        raise StateError(f"{label} must prove a clean worktree")
    if not isinstance(value["branchOwners"], list):
        raise StateError(f"{label} branchOwners must be an array")
    owners = []
    for index, raw_owner in enumerate(value["branchOwners"]):
        owner = exact_object(
            raw_owner, f"{label} branchOwners.{index}", GIT_BINDING_OWNER_FIELDS
        )
        owner_path = absolute_path_value(
            owner["worktree"], f"{label} branchOwners.{index}.worktree"
        )
        if owner_path != owner["worktree"]:
            raise StateError(f"{label} owner worktree must be canonical")
        string_value(
            owner["headSha"], f"{label} branchOwners.{index}.headSha",
            pattern=SHA_RE,
        )
        string_value(
            owner["branchRef"], f"{label} branchOwners.{index}.branchRef"
        )
        owners.append(owner)
    if owners != sorted(owners, key=lambda owner: owner["worktree"]):
        raise StateError(f"{label} branch owners must be sorted by worktree")
    historical_release = (
        kind == "branch_release"
        and value["revisionEpoch"] < item["revision_epoch"]
    )
    bound_sha = (
        value["boundSha"]
        if (
            historical_release
            or (kind == "implementation_pr_adoption" and persisted)
        )
        else task["output_head_sha"] or task["bound_sha"]
    )
    if bound_sha is None or task["task_worktree"] is None:
        raise StateError(f"{label} requires a resolved task worktree and head")
    receipt_branch = (
        value["branch"]
        if kind == "branch_release" and task["state"] == "superseded"
        else item["branch"]
    )
    branch_ref = f"refs/heads/{receipt_branch}"
    expected = {
        **generic_receipt_identity(bundle, state),
        "sliceId": item["id"],
        "role": role,
        "taskType": f"slice_{role}",
        "attempt": task["attempt"],
        "revisionEpoch": (
            value["revisionEpoch"]
            if (
                kind == "branch_release"
                or (kind == "implementation_pr_adoption" and persisted)
            )
            else item["revision_epoch"]
        ),
        "launchMarker": task["launch_marker"],
        "threadId": value["threadId"],
        "clientThreadId": value["clientThreadId"],
        "gitCommonDir": coordinator_common_dir,
        "taskWorktree": task["task_worktree"],
        "branch": receipt_branch,
        "branchRef": branch_ref,
        "boundSha": bound_sha,
        "worktreeHeadSha": bound_sha,
        "localBranchSha": bound_sha,
        "observedRemoteHeadSha": bound_sha,
        "clean": True,
    }
    if kind == "branch_release":
        if value["revisionEpoch"] > item["revision_epoch"]:
            raise StateError(
                f"{label} claims a future slice revision epoch"
            )
        expected.update({
            "symbolicRef": None,
            "branchOwners": [],
            "result": "RELEASED",
            "releaseReceiptDigest": None,
            "releaseObservationEpoch": None,
            "ownedPaths": [],
            "reauthorizationDigest": None,
            "snapshotAuthorization": None,
        })
    elif kind in {"review_attachment", "implementation_attachment"}:
        expected_role = (
            "review" if kind == "review_attachment" else "implementation"
        )
        if role != expected_role:
            raise StateError(
                f"{kind.replace('_', ' ')} receipt requires a {expected_role} task"
            )
        for identity_field, task_field in (
            ("threadId", "thread_id"),
            ("clientThreadId", "client_thread_id"),
        ):
            if value[identity_field] not in {None, task[task_field]}:
                raise StateError(
                    f"{label} {identity_field} conflicts with coordinator identity"
                )
        checkpoint_release = (
            final_ui_checkpoint_clean_release(
                bundle, state, item, before_epoch=value["observationEpoch"]
            )
            if kind == "implementation_attachment"
            else None
        )
        branch_candidates = branch_release_candidates(
            item, before_epoch=value["observationEpoch"]
        )
        if branch_candidates:
            release_role, release_task = causal_branch_release(
                item, before_epoch=value["observationEpoch"]
            )
            branch_release, branch_release_digest = git_binding_receipt_value(
                bundle, state, item, release_role, release_task,
                kind="branch_release", relative=release_task["branch_release_receipt"],
            )
            branch_release_epoch = release_task["branch_release_epoch"]
        else:
            branch_release = branch_release_digest = branch_release_epoch = None
        if checkpoint_release is not None:
            checkpoint, checkpoint_digest = checkpoint_release
            checkpoint_epoch = checkpoint["observationEpoch"]
        else:
            checkpoint = checkpoint_digest = checkpoint_epoch = None
        if branch_release_epoch is None and checkpoint_epoch is None:
            raise StateError("review attachment requires a prior branch release")
        if branch_release_epoch == checkpoint_epoch:
            raise StateError("task attachment release lineage is ambiguous")
        if branch_release_epoch is not None and (
            checkpoint_epoch is None or branch_release_epoch > checkpoint_epoch
        ):
            release, release_digest, release_epoch = (
                branch_release, branch_release_digest, branch_release_epoch
            )
        else:
            release, release_digest = checkpoint_release
            release_epoch = release["observationEpoch"]
        if (
            release_digest != value["releaseReceiptDigest"]
            or release_epoch != value["releaseObservationEpoch"]
        ):
            raise StateError("task attachment release receipt digest is stale")
        expected.update({
            "gitCommonDir": release["gitCommonDir"],
            "symbolicRef": branch_ref,
            "branchOwners": [{
                "worktree": task["task_worktree"],
                "headSha": bound_sha,
                "branchRef": branch_ref,
            }],
            "result": "ATTACHED_UNIQUE",
            "releaseReceiptDigest": release_digest,
            "releaseObservationEpoch": release_epoch,
            "ownedPaths": (
                sorted(item["owned_paths"])
                if kind == "review_attachment"
                else []
            ),
            "reauthorizationDigest": (
                item["revision_history"][-1]["reauthorization_digest"]
                if (
                    kind == "review_attachment"
                    and item["revision_epoch"] > 1
                    and item["revision_history"]
                    and item["revision_history"][-1]["revision_epoch"]
                    == item["revision_epoch"] - 1
                )
                else None
            ),
            "snapshotAuthorization": (
                item["implementation_task"]["snapshot_authorization"]
                if kind == "review_attachment"
                else None
            ),
        })
    elif kind == "implementation_pr_adoption":
        if role != "implementation" or task["attempt"] != 1:
            raise StateError(
                "implementation PR adoption requires implementation attempt 1"
            )
        if value["threadId"] is None and value["clientThreadId"] is None:
            raise StateError(
                "implementation PR adoption requires one external task identity"
            )
        retained_for_pre_pr_scope = (
            item["status"] == "blocked"
            and task["state"] == "quiescent"
            and task["terminal_result"] == "SCOPE_EXPANSION_REQUIRED"
        )
        if item["status"] not in {
            "pending", "in_progress", "verifying", "verified", "pr_open", "merged"
        } and not retained_for_pre_pr_scope:
            raise StateError(
                "implementation PR adoption requires an active or published slice"
            )
        for identity_field, task_field in (
            ("threadId", "thread_id"),
            ("clientThreadId", "client_thread_id"),
        ):
            if value[identity_field] not in {None, task[task_field]}:
                raise StateError(
                    f"{label} {identity_field} conflicts with coordinator identity"
                )
        adoption_start_sha = task["adoption_start_sha"]
        if adoption_start_sha is None:
            raise StateError(
                "implementation PR adoption requires the durable adoption start SHA"
            )
        expected.update({
            "symbolicRef": branch_ref,
            "branchOwners": [{
                "worktree": task["task_worktree"],
                "headSha": bound_sha,
                "branchRef": branch_ref,
            }],
            "result": (
                "ADOPTED_EXISTING_PR"
                if bound_sha == adoption_start_sha
                else "ADOPTED_REQUIRED_BASE_SYNC"
            ),
            "releaseReceiptDigest": None,
            "releaseObservationEpoch": None,
            "ownedPaths": [],
            "reauthorizationDigest": None,
            "snapshotAuthorization": None,
            "baseRef": item["base_ref"],
            "baseSha": value["baseSha"] if persisted else item["base_sha"],
            "adoptionStartSha": adoption_start_sha,
            "pr": value["pr"],
        })
    else:
        raise StateError(f"unsupported Git binding receipt kind: {kind}")
    mismatched = [
        name
        for name, expected_value in expected.items()
        if value[name] != expected_value
    ]
    if mismatched:
        raise StateError(
            f"{label} is not bound to this exact task and branch state: "
            + ", ".join(mismatched)
        )
    return value, digest

def review_head_adoption_receipt_value(
    bundle: Path,
    state: dict,
    item: dict,
    task: dict,
    relative: str | None,
    *,
    persisted: bool = False,
) -> tuple[dict, str]:
    label = f"{item['id']} review head-adoption receipt"
    value, digest = typed_receipt(
        bundle, relative, label, HEAD_ADOPTION_RECEIPT_FIELDS
    )
    if (
        value["schema"] != "spec-work-review-head-adoption"
        or value["kind"] != "review_head_adoption"
    ):
        raise StateError(f"{label} has an unsupported schema or kind")
    for field in (
        "workKind", "workId", "workBundle", "sliceId", "role", "taskType",
        "launchMarker", "gitCommonDir", "observerWorktree", "branch",
        "branchRef", "baseRef", "result",
    ):
        string_value(value[field], f"{label} {field}")
    for field in (
        "priorHeadSha", "newHeadSha", "priorBaseSha", "newBaseSha",
        "worktreeHeadSha", "localBranchSha", "observedRemoteHeadSha",
        "observedRemoteBaseSha",
    ):
        string_value(value[field], f"{label} {field}", pattern=SHA_RE)
    integer_value(value["attempt"], f"{label} attempt", 1)
    integer_value(value["revisionEpoch"], f"{label} revisionEpoch", 1)
    integer_value(value["pr"], f"{label} pr", 1)
    integer_value(value["observationEpoch"], f"{label} observationEpoch", 1)
    integer_value(
        value["releaseObservationEpoch"],
        f"{label} releaseObservationEpoch", 1,
    )
    relative_path_value(value["releaseReceipt"], f"{label} releaseReceipt")
    string_value(
        value["releaseReceiptDigest"],
        f"{label} releaseReceiptDigest",
        pattern=DIGEST_RE,
    )
    optional_string(value["threadId"], f"{label} threadId")
    optional_string(value["clientThreadId"], f"{label} clientThreadId")
    optional_string(value["symbolicRef"], f"{label} symbolicRef")
    for field in ("gitCommonDir", "observerWorktree"):
        normalized = absolute_path_value(value[field], f"{label} {field}")
        if normalized != value[field]:
            raise StateError(f"{label} {field} must be a canonical absolute path")
    owned_paths = [
        repo_path_value(path, f"{label} ownedPaths")
        for path in string_list(
            value["ownedPaths"], f"{label} ownedPaths", nonempty=True
        )
    ]
    changed_paths = [
        repo_path_value(path, f"{label} changedPaths")
        for path in string_list(value["changedPaths"], f"{label} changedPaths")
    ]
    if owned_paths != sorted(owned_paths):
        raise StateError(f"{label} ownedPaths must be sorted")
    if changed_paths != sorted(changed_paths):
        raise StateError(f"{label} changedPaths must be sorted")
    if any(
        not any(
            path == owned or path.startswith(f"{owned}/")
            for owned in owned_paths
        )
        for path in changed_paths
    ):
        raise StateError(f"{label} changedPaths escape authorized owned paths")
    if (
        value["symbolicRef"] is not None
        or value["branchOwners"] != []
        or value["clean"] is not True
    ):
        raise StateError(f"{label} must prove a clean ownerless detached worktree")
    if value["priorHeadSha"] == value["newHeadSha"]:
        raise StateError(f"{label} does not advance the PR head")
    if value["priorBaseSha"] == value["newBaseSha"]:
        raise StateError(f"{label} does not advance the PR base")
    release, release_digest = typed_receipt(
        bundle,
        value["releaseReceipt"],
        f"{label} causal release",
        GIT_BINDING_RECEIPT_FIELDS,
    )
    if (
        release["schema"] != "spec-work-task-git-binding"
        or release["kind"] != "branch_release"
        or release["role"] not in {"implementation", "review"}
        or release["taskType"] != f"slice_{release['role']}"
    ):
        raise StateError(f"{label} causal release has an unsupported contract")
    integer_value(release["attempt"], f"{label} causal release attempt", 1)
    integer_value(
        release["revisionEpoch"],
        f"{label} causal release revisionEpoch",
        1,
    )
    integer_value(
        release["observationEpoch"],
        f"{label} causal release observationEpoch",
        1,
    )
    string_value(
        release["launchMarker"], f"{label} causal release launchMarker"
    )
    optional_string(release["threadId"], f"{label} causal release threadId")
    optional_string(
        release["clientThreadId"], f"{label} causal release clientThreadId"
    )
    for field in ("gitCommonDir", "taskWorktree"):
        normalized = absolute_path_value(
            release[field], f"{label} causal release {field}"
        )
        if normalized != release[field]:
            raise StateError(
                f"{label} causal release {field} must be a canonical absolute path"
            )
    expected_release = {
        **generic_receipt_identity(bundle, state),
        "sliceId": item["id"],
        "gitCommonDir": value["gitCommonDir"],
        "branch": item["branch"],
        "branchRef": f"refs/heads/{item['branch']}",
        "boundSha": value["priorHeadSha"],
        "worktreeHeadSha": value["priorHeadSha"],
        "localBranchSha": value["priorHeadSha"],
        "observedRemoteHeadSha": value["priorHeadSha"],
        "symbolicRef": None,
        "branchOwners": [],
        "clean": True,
        "result": "RELEASED",
        "observationEpoch": value["releaseObservationEpoch"],
        "releaseReceiptDigest": None,
        "releaseObservationEpoch": None,
        "ownedPaths": [],
        "reauthorizationDigest": None,
    }
    if (
        release_digest != value["releaseReceiptDigest"]
        or any(
            release[name] != expected_value
            for name, expected_value in expected_release.items()
        )
    ):
        raise StateError(f"{label} release receipt is stale")
    if not persisted:
        release_role, release_task = causal_branch_release(
            item, before_epoch=value["observationEpoch"]
        )
        _current_release, current_release_digest = git_binding_receipt_value(
            bundle,
            state,
            item,
            release_role,
            release_task,
            kind="branch_release",
            relative=release_task["branch_release_receipt"],
        )
        if (
            release_task["branch_release_receipt"] != value["releaseReceipt"]
            or current_release_digest != release_digest
            or release_task["branch_release_epoch"]
            != value["releaseObservationEpoch"]
        ):
            raise StateError(f"{label} release receipt is stale")
    if persisted:
        for receipt_field, task_field in (
            ("threadId", "thread_id"),
            ("clientThreadId", "client_thread_id"),
        ):
            if value[receipt_field] not in {None, task[task_field]}:
                raise StateError(
                    f"{label} {receipt_field} conflicts with coordinator identity"
                )
    binding_item = item
    if persisted and value["revisionEpoch"] < item["revision_epoch"]:
        historical = next(
            (
                revision
                for revision in item["revision_history"]
                if revision["revision_epoch"] == value["revisionEpoch"]
            ),
            None,
        )
        if historical is None:
            raise StateError(f"{label} has no matching historical revision")
        binding_item = {
            **item,
            "revision_epoch": historical["revision_epoch"],
            "pr": historical["pr"],
            "head_sha": historical["head_sha"],
            "base_ref": historical["base_ref"],
            "base_sha": historical["base_sha"],
            "owned_paths": historical["owned_paths"],
            "implementation_task": {
                **item["implementation_task"],
                "output_head_sha": value["priorHeadSha"],
            },
        }
    expected = {
        **generic_receipt_identity(bundle, state),
        "sliceId": binding_item["id"],
        "role": "review",
        "taskType": "slice_review",
        "attempt": task["attempt"],
        "revisionEpoch": binding_item["revision_epoch"],
        "launchMarker": task["launch_marker"],
        "threadId": value["threadId"] if persisted else task["thread_id"],
        "clientThreadId": (
            value["clientThreadId"] if persisted else task["client_thread_id"]
        ),
        "gitCommonDir": release["gitCommonDir"],
        "branch": binding_item["branch"],
        "branchRef": f"refs/heads/{binding_item['branch']}",
        "baseRef": binding_item["base_ref"],
        "pr": binding_item["pr"],
        "worktreeHeadSha": value["newHeadSha"],
        "localBranchSha": value["newHeadSha"],
        "observedRemoteHeadSha": value["newHeadSha"],
        "observedRemoteBaseSha": value["newBaseSha"],
        "result": "ADOPTED_OWNERLESS_BASE_SYNC",
        "releaseReceiptDigest": release_digest,
        "releaseObservationEpoch": value["releaseObservationEpoch"],
        "ownedPaths": sorted(binding_item["owned_paths"]),
    }
    if persisted:
        lineage_head, lineage_base, lineage_result = (
            review_head_adoption_lineage_tip(
                bundle,
                state,
                binding_item,
                task,
                value,
                label,
            )
        )
        attachment_receipt = task["branch_attachment_receipt"]
        if attachment_receipt is not None and receipt_schema(
            bundle,
            attachment_receipt,
            f"{item['id']} review attachment",
        ) == "spec-work-review-lease-terminal":
            terminal, terminal_digest = review_lease_terminal_value(
                bundle,
                state,
                item,
                task,
                attachment_receipt,
                target=(
                    "clean" if task["review_receipt"] is not None else "blocked"
                ),
                review_receipt=task["review_receipt"],
                persisted=True,
            )
            if (
                terminal_digest != task["branch_attachment_digest"]
                or terminal["observationEpoch"]
                != task["branch_attachment_epoch"]
            ):
                raise StateError(f"{label} terminal review lineage is stale")
            if (
                terminal["initialHeadSha"] != lineage_head
                or (
                    terminal["initialBaseSha"] != lineage_base
                    and lineage_result != "CLEAN"
                )
            ):
                raise StateError(
                    f"{label} terminal review lineage is not contiguous"
                )
            lineage_head = terminal["finalHeadSha"]
            lineage_base = terminal["finalBaseSha"]
        elif task["bound_sha"] is not None:
            if (
                task["bound_sha"] != lineage_head
                or (
                    binding_item["base_sha"] != lineage_base
                    and lineage_result != "CLEAN"
                )
            ):
                raise StateError(
                    f"{label} is not bound to the current review lineage"
                )
        elif (
            binding_item["head_sha"] != lineage_head
            or binding_item["base_sha"] != lineage_base
        ):
            raise StateError(f"{label} is not bound to the creating review")
        expected.update({
            "priorHeadSha": binding_item["implementation_task"]["output_head_sha"],
        })
    else:
        expected.update({
            "priorHeadSha": item["head_sha"],
            "priorBaseSha": item["base_sha"],
        })
    mismatched = [
        name
        for name, expected_value in expected.items()
        if value[name] != expected_value
    ]
    if mismatched:
        raise StateError(
            f"{label} is not bound to this exact review reservation: "
            + ", ".join(mismatched)
        )
    return value, digest


def review_head_adoption_lineage_tip(
    bundle: Path,
    state: dict,
    item: dict,
    task: dict,
    adoption: dict | None,
    label: str,
) -> tuple[str, str, str | None]:
    head = None if adoption is None else adoption["newHeadSha"]
    base = None if adoption is None else adoption["newBaseSha"]
    prior_epoch = 0 if adoption is None else adoption["observationEpoch"]
    prior_result = None
    for index, raw_entry in enumerate(task["head_adoption_terminal_lineage"]):
        entry_label = f"{label} terminal lineage {index + 1}"
        entry = exact_object(
            raw_entry,
            entry_label,
            HEAD_ADOPTION_TERMINAL_ENTRY_FIELDS,
        )
        relative_path_value(entry["receipt"], f"{entry_label} receipt")
        string_value(
            entry["digest"],
            f"{entry_label} digest",
            pattern=DIGEST_RE,
        )
        epoch = integer_value(entry["epoch"], f"{entry_label} epoch", 1)
        if epoch <= prior_epoch:
            raise StateError(f"{entry_label} epoch is not monotonic")
        raw_terminal, raw_digest = typed_receipt(
            bundle,
            entry["receipt"],
            entry_label,
            REVIEW_LEASE_TERMINAL_FIELDS,
        )
        if (
            raw_digest != entry["digest"]
            or raw_terminal["observationEpoch"] != epoch
        ):
            raise StateError(f"{entry_label} binding is stale")
        if head is None:
            head = raw_terminal["initialHeadSha"]
            base = raw_terminal["initialBaseSha"]
        historical_task = {**task, "bound_sha": raw_terminal["finalHeadSha"]}
        terminal, terminal_digest = review_lease_terminal_value(
            bundle,
            state,
            item,
            historical_task,
            entry["receipt"],
            target=entry["result"].lower(),
            review_receipt=entry["review_receipt"],
            persisted=True,
        )
        if terminal_digest != entry["digest"]:
            raise StateError(f"{entry_label} digest is stale")
        if entry["result"] == "CLEAN":
            clean_task = {
                **historical_task,
                "state": "superseded",
                "branch_attachment_receipt": entry["receipt"],
                "branch_attachment_digest": terminal_digest,
                "branch_attachment_epoch": epoch,
                "review_receipt": entry["review_receipt"],
            }
            clean_proof = review_clean_receipt_value(
                bundle, state, item, clean_task
            )
            if clean_proof["review_receipt"] != entry["review_receipt"]:
                raise StateError(f"{entry_label} review receipt is stale")
        if terminal["initialHeadSha"] != head:
            raise StateError(f"{entry_label} is not contiguous")
        if (
            terminal["initialBaseSha"] != base
            and prior_result != "CLEAN"
        ):
            raise StateError(f"{entry_label} base is not contiguous")
        head = terminal["finalHeadSha"]
        base = terminal["finalBaseSha"]
        prior_epoch = epoch
        prior_result = entry["result"]
    return head or item["head_sha"], base or item["base_sha"], prior_result


def review_lease_terminal_value(
    bundle: Path,
    state: dict,
    item: dict,
    task: dict,
    relative: str | None,
    *,
    target: str,
    review_receipt: str | None,
    persisted: bool = False,
    allow_final_head_adoption: bool = False,
) -> tuple[dict, str]:
    label = f"{item['id']} terminal review lease receipt"
    value, digest = typed_receipt(
        bundle, relative, label, REVIEW_LEASE_TERMINAL_FIELDS
    )
    if (
        value["schema"] != "spec-work-review-lease-terminal"
        or value["kind"] != "review_lease_terminal"
        or value["result"] != target.upper()
        or value["clean"] is not True
    ):
        raise StateError(f"{label} has an unsupported result or contract")
    for field in (
        "initialHeadSha", "initialBaseSha", "finalHeadSha", "finalBaseSha"
    ):
        string_value(value[field], f"{label} {field}", pattern=SHA_RE)
    for field in ("activationDigest", "identityDigest", "leaseDigest"):
        string_value(value[field], f"{label} {field}", pattern=DIGEST_RE)
    integer_value(value["attempt"], f"{label} attempt", 1)
    integer_value(value["revisionEpoch"], f"{label} revisionEpoch", 1)
    integer_value(value["rotationCount"], f"{label} rotationCount", 0)
    integer_value(value["observationEpoch"], f"{label} observationEpoch", 1)
    owned = [
        repo_path_value(path, f"{label} ownedPaths")
        for path in string_list(value["ownedPaths"], f"{label} ownedPaths")
    ]
    changed = [
        repo_path_value(path, f"{label} changedPaths")
        for path in string_list(value["changedPaths"], f"{label} changedPaths")
    ]
    optional_string(
        value["compactBugFixRecord"], f"{label} compactBugFixRecord"
    )
    optional_digest(
        value["reauthorizationDigest"],
        f"{label} reauthorizationDigest",
    )
    snapshot_authorization = validate_snapshot_authorization(
        value["snapshotAuthorization"],
        expected_slice=item["id"],
        candidate_head=value["finalHeadSha"],
    )
    disposition = value["blockedDisposition"]
    required_owned = [
        repo_path_value(path, f"{label} requiredOwnedPaths")
        for path in string_list(
            value["requiredOwnedPaths"], f"{label} requiredOwnedPaths"
        )
    ]
    regression_obligations = string_list(
        value["regressionObligations"], f"{label} regressionObligations"
    )
    verification_obligations = string_list(
        value["verificationObligations"], f"{label} verificationObligations"
    )
    if disposition is None:
        if (
            required_owned
            or value["acceptanceId"] is not None
            or value["owningSeam"] is not None
            or regression_obligations
            or verification_obligations
        ):
            raise StateError(
                f"{label} has untyped blocked-review scope evidence"
            )
    elif (
        target != "blocked"
        or disposition != "required_by_intent_scope_expansion"
        or not required_owned
        or not regression_obligations
        or not verification_obligations
    ):
        raise StateError(
            f"{label} has incomplete required-by-intent scope evidence"
        )
    else:
        string_value(
            value["acceptanceId"],
            f"{label} acceptanceId",
            pattern=ACCEPTANCE_ID_RE,
        )
        string_value(
            value["owningSeam"],
            f"{label} owningSeam",
            maximum=500,
        )
        if any(
            not obligation.strip() or len(obligation) > 500
            for obligation in [
                *regression_obligations, *verification_obligations
            ]
        ):
            raise StateError(
                f"{label} scope obligations must be nonempty and at most 500 characters"
            )
    compact_record = value["compactBugFixRecord"]
    if compact_record is not None:
        canonical_record = (
            f"docs/bug_fixes/completed/{state['work_id']}/BUG_FIX.md"
        )
        if (
            value["workKind"] != "bug_fix"
            or repo_path_value(
                compact_record, f"{label} compactBugFixRecord"
            ) != canonical_record
        ):
            raise StateError(
                f"{label} compact bug-fix record is not work-derived and canonical"
            )
        if compact_record not in changed:
            raise StateError(
                f"{label} compact bug-fix record is absent from changed paths"
            )
    expected_owned = sorted(item["owned_paths"])
    if persisted and value["revisionEpoch"] < item["revision_epoch"]:
        historical = next(
            (
                revision
                for revision in item["revision_history"]
                if revision["revision_epoch"] == value["revisionEpoch"]
            ),
            None,
        )
        if historical is None:
            raise StateError(f"{label} has no matching historical revision")
        expected_owned = sorted(historical["owned_paths"])
    if owned != expected_owned:
        raise StateError(f"{label} changed the frozen owned-path authority")
    escaped = [
        path for path in changed
        if not any(path == root or path.startswith(root + "/") for root in owned)
    ]
    snapshot_roots: list[str] = []
    if snapshot_authorization is not None:
        snapshot_path = snapshot_authorization["snapshotPath"]
        parts = list(PurePosixPath(snapshot_path).parts)
        parts[-2] = (
            "completed" if parts[-2] == "in_progress" else "in_progress"
        )
        snapshot_roots = [snapshot_path, PurePosixPath(*parts).as_posix()]
    unexplained = [
        path for path in escaped
        if not any(
            path == root or path.startswith(root + "/")
            for root in snapshot_roots
        )
    ]
    if unexplained:
        raise StateError(
            f"{label} changed paths outside frozen owned paths and authenticated "
            "snapshot: " + ", ".join(unexplained)
        )
    if value["invalidatedEvidence"] not in ([], [
        "ci", "mergeability", "semantic-review", "terminal-verification"
    ]):
        raise StateError(f"{label} has an invalid evidence-invalidation set")
    validate_review_lease_terminal_ledger(value, label)
    if target == "clean":
        if review_receipt is None:
            raise StateError("clean review requires a durable receipt")
        safe_path(
            bundle, review_receipt, f"{item['id']} review receipt", required=True
        )
    if (
        allow_final_head_adoption
        and item["head_sha"]
        not in {value["initialHeadSha"], value["finalHeadSha"]}
    ):
        raise StateError(
            f"{label} is stale against the current slice head"
        )
    expected = {
        **generic_receipt_identity(bundle, state),
        "sliceId": item["id"],
        "role": "review",
        "taskType": "slice_review",
        "attempt": task["attempt"],
        "revisionEpoch": (
            value["revisionEpoch"]
            if (
                persisted
                and value["revisionEpoch"] < item["revision_epoch"]
                and (
                    task["state"] == "superseded"
                    or (
                        task["state"] == "blocked"
                        and task["branch_release_digest"] is not None
                    )
                )
            )
            else item["revision_epoch"]
        ),
        "launchMarker": task["launch_marker"],
        "threadId": value["threadId"],
        "clientThreadId": value["clientThreadId"],
        "taskWorktree": task["task_worktree"],
        "gitCommonDir": coordinator_git_common_dir(),
        "branch": item["branch"],
        "branchRef": f"refs/heads/{item['branch']}",
        "baseRef": (
            value["baseRef"]
            if persisted
            else canonical_remote_branch_ref(item["base_ref"])
        ),
        "initialHeadSha": (
            value["initialHeadSha"] if persisted else task["bound_sha"]
        ),
        "finalHeadSha": (
            task["bound_sha"]
            if persisted
            else (
                value["finalHeadSha"]
                if allow_final_head_adoption
                else item["head_sha"]
            )
        ),
        "finalBaseSha": value["finalBaseSha"] if persisted else item["base_sha"],
        "activationDigest": (
            value["activationDigest"]
            if persisted else task["branch_attachment_digest"]
        ),
        "reviewReceiptDigest": None,
    }
    for identity_field, task_field in (
        ("threadId", "thread_id"),
        ("clientThreadId", "client_thread_id"),
    ):
        if value[identity_field] not in {None, task[task_field]}:
            raise StateError(
                f"{label} {identity_field} conflicts with coordinator identity"
            )
    if any(value[name] != expected_value for name, expected_value in expected.items()):
        raise StateError(f"{label} is not bound to this exact review lineage")
    return value, digest

def review_lease_identity_projection(lease: dict) -> dict:
    return {
        key: lease[key]
        for key in (
            "activationDigest", "workKind", "workId", "workBundle", "sliceId",
            "role", "taskType", "attempt", "revisionEpoch", "launchMarker",
            "threadId",
            "clientThreadId", "taskWorktree", "gitCommonDir", "branch",
            "branchRef", "remote", "remoteUrl", "baseRef", "initialHeadSha",
            "initialBaseSha", "ownedPaths", "compactBugFixRecord",
            "reauthorizationDigest", "snapshotAuthorization",
        )
    }

def validate_review_lease_terminal_ledger(value: dict, label: str) -> None:
    rotations = value["rotations"]
    if not isinstance(rotations, list):
        raise StateError(f"{label} rotations must be an array")
    if len(rotations) != value["rotationCount"]:
        raise StateError(f"{label} rotation count does not match its ledger")
    owned = value["ownedPaths"]
    prior_head = value["initialHeadSha"]
    prior_base = value["initialBaseSha"]
    normalized_rotations: list[dict] = []
    for index, raw in enumerate(rotations):
        rotation = exact_object(
            raw, f"{label} rotation {index + 1}", REVIEW_LEASE_ROTATION_FIELDS
        )
        if rotation["kind"] not in {"remediation", "base_sync"}:
            raise StateError(f"{label} rotation has an unsupported kind")
        for field in ("priorHeadSha", "newHeadSha", "priorBaseSha", "newBaseSha"):
            string_value(
                rotation[field], f"{label} rotation {index + 1} {field}",
                pattern=SHA_RE,
            )
        string_value(
            rotation["mutationReceiptDigest"],
            f"{label} rotation {index + 1} mutationReceiptDigest",
            pattern=DIGEST_RE,
        )
        changed = [
            repo_path_value(path, f"{label} rotation {index + 1} changedPaths")
            for path in string_list(
                rotation["changedPaths"],
                f"{label} rotation {index + 1} changedPaths",
            )
        ]
        if (
            rotation["priorHeadSha"] != prior_head
            or rotation["priorBaseSha"] != prior_base
        ):
            raise StateError(f"{label} rotation ledger is not contiguous")
        new_head = rotation["newHeadSha"]
        new_base = rotation["newBaseSha"]
        if rotation["kind"] == "remediation":
            if new_base != prior_base:
                raise StateError(f"{label} remediation rotation changed the base")
        elif new_base == prior_base:
            raise StateError(f"{label} base sync did not advance the base")
        if new_head == prior_head:
            raise StateError(f"{label} rotation did not advance the head")
        if any(
            not any(path == root or path.startswith(root + "/") for root in owned)
            for path in changed
        ):
            raise StateError(f"{label} rotation escaped frozen owned paths")
        normalized_rotations.append(rotation)
        prior_head, prior_base = new_head, new_base
    if prior_head != value["finalHeadSha"] or prior_base != value["finalBaseSha"]:
        raise StateError(f"{label} final head/base does not match its rotation ledger")
    expected_invalidated = [
        "ci", "mergeability", "semantic-review", "terminal-verification"
    ] if rotations else []
    if value["invalidatedEvidence"] != expected_invalidated:
        raise StateError(f"{label} evidence invalidation does not match its rotations")
    reconstructed = {
        "schema": "spec-work-review-lease",
        "activationDigest": value["activationDigest"],
        "identityDigest": value["identityDigest"],
        **{
            key: value[key]
            for key in (
                "workKind", "workId", "workBundle", "sliceId", "role",
                "taskType", "attempt", "revisionEpoch", "launchMarker",
                "threadId",
                "clientThreadId", "taskWorktree", "gitCommonDir", "branch",
                "branchRef", "remote", "remoteUrl", "baseRef",
            )
        },
        "initialHeadSha": value["initialHeadSha"],
        "currentHeadSha": value["finalHeadSha"],
        "initialBaseSha": value["initialBaseSha"],
        "currentBaseSha": value["finalBaseSha"],
        "ownedPaths": value["ownedPaths"],
        "compactBugFixRecord": value["compactBugFixRecord"],
        "reauthorizationDigest": value["reauthorizationDigest"],
        "snapshotAuthorization": value["snapshotAuthorization"],
        "rotations": normalized_rotations,
        "invalidatedEvidence": value["invalidatedEvidence"],
        "result": "ACTIVE",
    }
    identity = hashlib.sha256(json.dumps(
        review_lease_identity_projection(reconstructed),
        sort_keys=True, separators=(",", ":"),
    ).encode("utf-8")).hexdigest()
    if identity != value["identityDigest"]:
        raise StateError(f"{label} identity digest is stale")
    lease_digest = hashlib.sha256((
        json.dumps(reconstructed, sort_keys=True, separators=(",", ":")) + "\n"
    ).encode("utf-8")).hexdigest()
    if lease_digest != value["leaseDigest"]:
        raise StateError(f"{label} lease digest is stale")

def observation_receipt_value(
    bundle: Path,
    state: dict,
    item: dict,
    role: str,
    task: dict,
    *,
    kind: str,
    relative: str | None,
    prior_task: dict | None = None,
    allow_authorization_drift: bool = False,
) -> tuple[dict, str]:
    if kind == "branch_release":
        return git_binding_receipt_value(
            bundle, state, item, role, task,
            kind="branch_release", relative=relative,
        )
    value, digest = typed_receipt(
        bundle, relative, f"{item['id']} {role} {kind} observation",
        OBSERVATION_RECEIPT_FIELDS,
    )
    if value["schema"] != "spec-work-task-observation" or value["kind"] != kind:
        raise StateError(f"task observation must have exact kind {kind}")
    integer_value(value["attempt"], "task observation attempt", 1)
    integer_value(value["priorAttempt"], "task observation priorAttempt", 0)
    integer_value(value["observationEpoch"], "task observation epoch", 1)
    optional_string(value["threadId"], "task observation threadId")
    optional_string(value["clientThreadId"], "task observation clientThreadId")
    optional_string(value["priorThreadId"], "task observation priorThreadId")
    optional_string(value["headSha"], "task observation headSha", sha=True)
    for field in (
        "workKind", "workId", "workBundle", "sliceId", "role", "taskType",
        "launchMarker", "branch", "predicate", "result",
    ):
        string_value(value[field], f"task observation {field}")
    creating_head = item["head_sha"]
    if (
        role == "review"
        and task["state"] == "creating"
        and task["head_adoption_receipt"] is not None
    ):
        adoption, _digest = typed_receipt(
            bundle,
            task["head_adoption_receipt"],
            f"{item['id']} review head-adoption receipt",
            HEAD_ADOPTION_RECEIPT_FIELDS,
        )
        creating_head = adoption["priorHeadSha"]
    if kind == "companion_probe":
        predicate, result = "gitnexus-pr-review available", "AVAILABLE"
        prior_attempt, prior_thread = 0, None
        thread_id = client_thread_id = None
        head = creating_head if task["state"] == "creating" else value["headSha"]
    elif kind == "replacement_predicate":
        if prior_task is None:
            raise StateError("replacement observation requires the prior task")
        predicates = authorized_replacement_predicates(bundle, state, item["id"], role)
        predicate = next(
            (candidate for candidate in predicates if text_digest(candidate) == task["replacement_predicate_digest"]),
            None,
        )
        if predicate is None:
            if task["state"] != "superseded" and not allow_authorization_drift:
                raise StateError(
                    "replacement observation predicate is not in the registered roster"
                )
            predicate = value["predicate"]
            if text_digest(predicate) != task["replacement_predicate_digest"]:
                raise StateError("replacement observation predicate binding is stale")
        result = "SATISFIED"
        prior_attempt, prior_thread = prior_task["attempt"], prior_task["thread_id"]
        thread_id = client_thread_id = None
        if task["state"] == "creating":
            head = (
                creating_head
                if role == "review" or item["status"] == "pr_open"
                else item["base_sha"]
            )
        else:
            head = value["headSha"]
    elif kind == "stop":
        predicate, result = "task quiescent", "QUIESCENT"
        prior_attempt, prior_thread = task["attempt"], task["thread_id"]
        thread_id, client_thread_id = task["thread_id"], task["client_thread_id"]
        head = task["output_head_sha"] or task["bound_sha"]
    else:
        raise StateError(f"unsupported task observation kind: {kind}")
    expected = {
        **generic_receipt_identity(bundle, state),
        "sliceId": item["id"], "role": role, "taskType": f"slice_{role}",
        "attempt": task["attempt"], "launchMarker": task["launch_marker"],
        "threadId": thread_id, "clientThreadId": client_thread_id,
        "branch": (
            value["branch"] if task["state"] == "superseded" else item["branch"]
        ),
        "headSha": head, "predicate": predicate,
        "priorAttempt": prior_attempt, "priorThreadId": prior_thread, "result": result,
    }
    if any(value[name] != expected_value for name, expected_value in expected.items()):
        raise StateError(f"{kind} observation is not bound to this exact task context")
    return value, digest

def require_strict_epoch_chain(values: list[int], label: str) -> None:
    for previous, current in zip(values, values[1:]):
        if current <= previous:
            raise StateError(f"{label} epochs must advance monotonically")


def task_observation_epochs(item: dict, role: str) -> set[int]:
    epochs: set[int] = set()
    prior_attempt_high_water = 0
    for task, _ in task_records(item, role):
        values = {
            field: task[field]
            for field in (
                "replacement_observation_epoch", "companion_probe_epoch",
                "head_adoption_epoch", "branch_attachment_epoch",
                "stop_proof_epoch", "branch_release_epoch",
            )
            if task[field] is not None
        }
        for epoch in values.values():
            if epoch in epochs:
                raise StateError("task observation epoch is reused")
            epochs.add(epoch)
        if not values:
            continue
        if min(values.values()) <= prior_attempt_high_water:
            raise StateError(
                "task observation epochs must advance monotonically"
            )
        require_strict_epoch_chain(
            [
                values[field]
                for field in (
                    "replacement_observation_epoch",
                    "companion_probe_epoch",
                    "head_adoption_epoch",
                    "branch_attachment_epoch",
                    "stop_proof_epoch",
                )
                if field in values
            ],
            "task observation",
        )
        require_strict_epoch_chain(
            [
                values[field]
                for field in (
                    "replacement_observation_epoch",
                    "companion_probe_epoch",
                    "branch_release_epoch",
                )
                if field in values
            ],
            "task observation",
        )
        prior_attempt_high_water = max(values.values())
    return epochs


def observation_epochs(state: dict) -> set[int]:
    epochs: set[int] = set()
    for item in state["slices"]:
        for role in ("implementation", "review"):
            for epoch in task_observation_epochs(item, role):
                if epoch in epochs:
                    raise StateError("task observation epoch is reused")
                epochs.add(epoch)
    return epochs

def causal_review_head_adoption_task(item: dict) -> dict | None:
    archived_receipts = {
        revision["head_adoption_receipt"]
        for revision in item["revision_history"]
        if revision["head_adoption_receipt"] is not None
    }
    return next(
        (
            candidate
            for candidate in (
                item["review_task"],
                *(
                    entry["task"]
                    for entry in reversed(item["task_history"])
                    if entry["role"] == "review"
                ),
            )
            if (
                candidate["head_adoption_receipt"] is not None
                and candidate["head_adoption_receipt"] not in archived_receipts
            )
        ),
        None,
    )


def implementation_receipt_value(
    bundle: Path,
    state: dict,
    item: dict,
    task: dict,
    *,
    persisted: bool = False,
) -> dict:
    relative = task["implementation_receipt"]
    if relative is None:
        raise StateError(
            f"{item['id']} implementation terminal receipt requires a typed receipt"
        )
    path = safe_path(
        bundle,
        relative,
        f"{item['id']} implementation terminal receipt",
        required=True,
    )
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise StateError(
            f"invalid {item['id']} implementation terminal receipt: {error}"
        ) from error
    prerequisite_failure = (
        isinstance(raw, dict)
        and raw.get("result") == "FAILED"
        and any(
            field in raw
            for field in PREREQUISITE_IMPLEMENTATION_RECEIPT_FIELDS
            - IMPLEMENTATION_RECEIPT_FIELDS
        )
    )
    fields = (
        SCOPE_IMPLEMENTATION_RECEIPT_FIELDS
        if isinstance(raw, dict) and raw.get("result") == "SCOPE_EXPANSION_REQUIRED"
        else (
            PREREQUISITE_IMPLEMENTATION_RECEIPT_FIELDS
            if prerequisite_failure
            else IMPLEMENTATION_RECEIPT_FIELDS
        )
    )
    value, digest = typed_receipt(
        bundle, relative,
        f"{item['id']} implementation terminal receipt", fields,
    )
    if value["schema"] != "spec-work-implementation-terminal":
        raise StateError("implementation terminal receipt has an unsupported schema")
    for field in ("baseSha", "boundSha", "outputHeadSha"):
        string_value(value[field], f"implementation terminal {field}", pattern=SHA_RE)
    for field in (
        "verificationDigest", "changedPathsDigest", "descendantQuiescenceDigest"
    ):
        string_value(value[field], f"implementation terminal {field}", pattern=DIGEST_RE)
    if value["pr"] is not None:
        integer_value(value["pr"], "implementation terminal pr", 1)
    integer_value(
        value["revisionEpoch"], "implementation terminal revisionEpoch", 1
    )
    result = enum_value(value["result"], "implementation terminal result", TERMINAL_RESULTS)
    verification = enum_value(
        value["verificationVerdict"],
        "implementation terminal verificationVerdict",
        VERIFICATION_VERDICTS,
    )
    if value["descendantQuiescenceVerdict"] != "PASS":
        raise StateError("implementation terminal requires descendant quiescence PASS")
    if result == "SUCCEEDED" and verification != "PASS":
        raise StateError("successful implementation terminal requires verification PASS")
    if result != "SUCCEEDED" and verification not in {"FAIL", "NOT_RUN"}:
        raise StateError("non-success implementation terminal cannot claim verification PASS")
    if result == "SCOPE_EXPANSION_REQUIRED":
        if value["pr"] is not None:
            raise StateError("scope expansion terminal cannot claim a PR")
        if value["outputHeadSha"] != value["boundSha"]:
            raise StateError(
                "scope expansion terminal must preserve the bound head"
            )
        required_paths = [
            repo_path_value(path, "implementation terminal requiredOwnedPaths")
            for path in string_list(
                value["requiredOwnedPaths"],
                "implementation terminal requiredOwnedPaths",
                nonempty=True,
            )
        ]
        if required_paths != sorted(set(required_paths)):
            raise StateError(
                "implementation terminal requiredOwnedPaths must be sorted and unique"
            )
        string_value(
            value["acceptanceId"],
            "implementation terminal acceptanceId",
            pattern=ACCEPTANCE_ID_RE,
        )
        string_value(
            value["owningSeam"],
            "implementation terminal owningSeam",
            maximum=500,
        )
        cohesion = state_slice_plan_contract(
            bundle, state, item, require_cohesion=True
        )["cohesion"]
        if (
            cohesion["Owning observable seam"]
            != value["owningSeam"]
        ):
            raise StateError(
                "implementation terminal owning seam differs from the accepted plan"
            )
        string_list(
            value["regressionObligations"],
            "implementation terminal regressionObligations",
            nonempty=True,
        )
        string_list(
            value["verificationObligations"],
            "implementation terminal verificationObligations",
            nonempty=True,
        )
        checkpoint = item["plan_checkpoint_sha"]
        if checkpoint is None:
            raise StateError(
                "scope expansion terminal requires the immutable plan checkpoint"
            )
        checkpointed_plan = checkpointed_slice_plan_bytes(
            bundle,
            item,
            checkpoint,
            f"{item['id']} scope terminal plan checkpoint",
        ).decode("utf-8")
        cohesion = slice_cohesion_contract(
            checkpointed_plan,
            item["id"],
            required=True,
        )
        assert cohesion is not None
        if value["acceptanceId"] != cohesion["Primary acceptance criterion"]:
            raise StateError(
                "scope expansion terminal acceptance differs from the checkpointed plan"
            )
        if value["owningSeam"] != cohesion["Owning observable seam"]:
            raise StateError(
                "scope expansion terminal owning seam differs from the checkpointed plan"
            )
    elif prerequisite_failure:
        if value["pr"] is not None:
            raise StateError("prerequisite failure terminal cannot claim a PR")
        if value["outputHeadSha"] != value["boundSha"]:
            raise StateError(
                "prerequisite failure terminal must preserve the bound head"
            )
        if value["prerequisiteIssue"] is not None:
            integer_value(
                value["prerequisiteIssue"],
                "implementation terminal prerequisiteIssue",
                1,
            )
        integer_value(
            value["prerequisitePr"],
            "implementation terminal prerequisitePr",
            1,
        )
        string_value(
            value["prerequisiteHeadSha"],
            "implementation terminal prerequisiteHeadSha",
            pattern=SHA_RE,
        )
        required_base_ref = canonical_remote_branch_ref(
            value["requiredBaseRef"]
        )
        if required_base_ref != canonical_remote_branch_ref(item["base_ref"]):
            raise StateError(
                "prerequisite failure required base differs from the current slice"
            )
        prerequisite_identity = {
            "trackingIssue": value["prerequisiteIssue"],
            "pullRequest": value["prerequisitePr"],
            "headSha": value["prerequisiteHeadSha"],
            "requiredBaseRef": value["requiredBaseRef"],
        }
        if value["prerequisiteFingerprint"] != canonical_digest(
            prerequisite_identity
        ):
            raise StateError("prerequisite failure fingerprint is stale")
    historical = task["state"] == "superseded"
    expected = {
        **generic_receipt_identity(bundle, state),
        "implementationWorktree": task["task_worktree"],
        "sliceId": item["id"],
        "branch": value["branch"] if historical else item["branch"],
        "baseSha": (
            value["baseSha"]
            if historical or persisted
            else item["base_sha"]
        ),
        "boundSha": task["bound_sha"], "taskType": "slice_implementation",
        "attempt": task["attempt"],
        "revisionEpoch": (
            value["revisionEpoch"] if historical else item["revision_epoch"]
        ),
        "threadId": task["thread_id"],
    }
    if any(value[name] != expected_value for name, expected_value in expected.items()):
        raise StateError("implementation terminal receipt is not bound to this attempt")
    if (
        task["branch_attachment_receipt"] is not None
        and receipt_kind(
            bundle,
            task["branch_attachment_receipt"],
            f"{item['id']} implementation attachment",
        ) == "implementation_pr_adoption"
    ):
        adoption, _adoption_digest = git_binding_receipt_value(
            bundle,
            state,
            item,
            "implementation",
            task,
            kind="implementation_pr_adoption",
            relative=task["branch_attachment_receipt"],
            persisted=True,
        )
        if (
            result != "SCOPE_EXPANSION_REQUIRED"
            and value["pr"] != adoption["pr"]
        ):
            raise StateError(
                "implementation terminal output PR differs from adopted PR"
            )
    return {
        "implementation_receipt": task["implementation_receipt"],
        "implementation_receipt_digest": digest,
        "terminal_result": result, "verification_verdict": verification,
        "output_head_sha": value["outputHeadSha"], "output_pr": value["pr"],
        "verification_digest": value["verificationDigest"],
        "changed_paths_digest": value["changedPathsDigest"],
        "descendant_quiescence_digest": value["descendantQuiescenceDigest"],
    }

def implementation_terminal_retains_branch(
    bundle: Path, relative: str
) -> bool:
    path = safe_path(
        bundle,
        relative,
        "implementation terminal branch policy",
        required=True,
    )
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise StateError(
            f"invalid implementation terminal branch policy: {error}"
        ) from error
    return isinstance(value, dict) and (
        value.get("result") == "SCOPE_EXPANSION_REQUIRED"
        or (
            value.get("result") == "FAILED"
            and "prerequisiteFingerprint" in value
        )
    )

def nonquiescent_task_labels(item: dict) -> list[str]:
    return [
        f"{item['id']}:{role}"
        for role, field in (
            ("implementation", "implementation_task"),
            ("review", "review_task"),
        )
        if item[field]["state"] in NONQUIESCENT_TASK_STATES
    ]

def base_invalidation_interlock_labels(item: dict) -> list[str]:
    labels = nonquiescent_task_labels(item)
    if item["implementation_task"]["state"] == "authorized":
        labels.append(f"{item['id']}:implementation")
    return labels

def all_nonquiescent_task_labels(items: dict[str, dict]) -> list[str]:
    return sorted(
        label for item in items.values() for label in nonquiescent_task_labels(item)
    )

def blind_audit_nonquiescent_task_labels(state: dict) -> list[str]:
    labels: list[str] = []
    for item in state["slices"]:
        for role, field in (
            ("implementation", "implementation_task"),
            ("review", "review_task"),
        ):
            task = item[field]
            plan_replacement_reservation = (
                state["phase"] == "plan"
                and role == "implementation"
                and task["state"] == "creating"
                and task["attempt"] >= 2
                and all(
                    task[name] is None
                    for name in (
                        "thread_id",
                        "client_thread_id",
                        "task_worktree",
                        "bound_sha",
                    )
                )
                and item["status"] == "pending"
                and item["execution_mode"] == "serial"
                and item["replacement_lineage"] is not None
                and task["replacement_predicate_digest"] is not None
                and task["replacement_observation_digest"] is not None
            )
            if task["state"] in NONQUIESCENT_TASK_STATES and not (
                plan_replacement_reservation
            ):
                labels.append(f"{item['id']}:{role}")
    return sorted(labels)

def review_has_head_authority(item: dict) -> bool:
    review = item["review_task"]
    return (
        review["state"] == "active"
        or (
            review["state"] in {"clean", "blocked"}
            and item["head_sha"] is not None
            and review["bound_sha"] == item["head_sha"]
        )
    )

def implementation_attention_handoff(item: dict) -> bool:
    """Return whether the bound implementation is waiting on snapshot bytes."""
    task = item["implementation_task"]
    review = item["review_task"]
    review_released_for_remediation = (
        review["state"] == "blocked"
        and review["branch_release_digest"] is not None
        and review["branch_release_epoch"] is not None
    )
    checkpoint_issue_handoff = (
        review["state"] == "blocked"
        and bool(item["revision_history"])
        and item["revision_history"][-1]["reauthorization_disposition"]
        == "final_ui_checkpoint_issue"
    )
    return (
        task["state"] == "active"
        and task["implementation_receipt"] is None
        and task["terminal_result"] is None
        and task["output_head_sha"] is None
        and task["output_pr"] is None
        and (
            review["state"] in {"unbound", "superseded"}
            or review_released_for_remediation
            or checkpoint_issue_handoff
        )
    )


def terminal_parallel_snapshot_carrier(state: dict) -> str | None:
    """Return the deterministic carrier identity for a terminal parallel wave."""
    items = slice_map(state)
    if not items:
        return None
    final_wave = max(item["wave"] for item in items.values())
    members = sorted(
        (
            item for item in items.values()
            if item["wave"] == final_wave
            and item["execution_mode"] == "parallel"
        ),
        key=lambda item: item["id"],
    )
    if len(members) < 2:
        return None
    member_ids = {item["id"] for item in members}
    if any(
        item["status"] not in TERMINAL_SLICE_STATUSES
        and item["id"] not in member_ids
        for item in items.values()
    ):
        return None
    remaining = [
        item for item in members
        if item["status"] not in TERMINAL_SLICE_STATUSES
    ]
    if not remaining:
        return None
    return remaining[-1]["id"]


def terminal_stacked_snapshot_carrier(state: dict) -> str | None:
    """Return an active terminal stacked slice that still owns final projection."""
    items = slice_map(state)
    if not items:
        return None
    final_wave = max(item["wave"] for item in items.values())
    candidates = [
        item for item in items.values()
        if (
            item["wave"] == final_wave
            and item["execution_mode"] == "serial"
            and item["depends_on"]
            and item["status"] == "pr_open"
            and item["implementation_task"]["state"] == "active"
        )
    ]
    if len(candidates) != 1:
        return None
    candidate = candidates[0]
    if any(
        item["id"] != candidate["id"]
        and item["status"] not in TERMINAL_SLICE_STATUSES
        and not dependency_reaches(items, candidate["id"], item["id"])
        for item in items.values()
    ):
        return None
    return candidate["id"]


def terminal_snapshot_carrier(state: dict) -> str | None:
    return (
        terminal_parallel_snapshot_carrier(state)
        or terminal_stacked_snapshot_carrier(state)
    )

def expected_start_sha(item: dict) -> str | None:
    lineage = item["replacement_lineage"]
    return lineage["start_sha"] if lineage is not None else item["base_sha"]

def retain_replacement_lineage(item: dict) -> None:
    if item["pr"] is None or item["head_sha"] is None:
        raise StateError("open-PR replacement requires a current PR head")
    item["replacement_lineage"] = {
        "pr": item["pr"], "start_sha": item["head_sha"]
    }

def retain_adopted_replacement_lineage(
    bundle: Path, state: dict, item: dict, task: dict
) -> None:
    relative = task["branch_attachment_receipt"]
    if (
        relative is None
        or receipt_kind(
            bundle,
            relative,
            f"{item['id']} implementation attachment",
        ) != "implementation_pr_adoption"
    ):
        return
    adoption, _digest = git_binding_receipt_value(
        bundle,
        state,
        item,
        "implementation",
        task,
        kind="implementation_pr_adoption",
        relative=relative,
        persisted=True,
    )
    retained = {
        "pr": adoption["pr"],
        "start_sha": task["output_head_sha"] or adoption["boundSha"],
    }
    if (
        item["replacement_lineage"] is not None
        and item["replacement_lineage"] != retained
    ):
        raise StateError(
            "adopted implementation replacement lineage conflicts with "
            "existing retained PR head"
        )
    item["replacement_lineage"] = retained

def require_initial_implementation_handoff(item: dict) -> None:
    task = item["implementation_task"]
    if item["head_sha"] is None:
        raise StateError(f"{item['id']} implementation-owned publication requires a head SHA")
    if implementation_attention_handoff(item):
        return
    if (
        task["state"] not in {"quiescent", "superseded"}
        or task["terminal_result"] != "SUCCEEDED"
    ):
        raise StateError(
            f"{item['id']} implementation-owned publication requires a quiescent "
            "SUCCEEDED terminal receipt"
        )
    if (
        task["output_head_sha"] != item["head_sha"]
        and causal_review_head_adoption_task(item) is None
    ):
        raise StateError(
            f"{item['id']} implementation terminal output head differs from slice head"
        )
    if item["pr"] is not None and task["output_pr"] != item["pr"]:
        raise StateError(
            f"{item['id']} implementation terminal output PR differs from slice PR"
        )

def task_records(item: dict, role: str) -> list[tuple[dict, bool]]:
    return [
        *(
            (entry["task"], False)
            for entry in item["task_history"]
            if entry["role"] == role
        ),
        (item[f"{role}_task"], True),
    ]

def descendant_quiescence_projection(state: dict) -> list[dict]:
    """Return deterministic persisted task lifecycle facts for blind auditing."""
    projected_fields = tuple(
        field for field in sorted(TASK_FIELDS) if not field.endswith("_receipt")
    )

    def projected_task(task: dict) -> dict:
        return {field: task[field] for field in projected_fields}

    return [
        {
            "sliceId": item["id"],
            "revisionEpoch": item["revision_epoch"],
            "planCheckpointSha": item["plan_checkpoint_sha"],
            "current": {
                role: projected_task(item[f"{role}_task"])
                for role in ("implementation", "review")
            },
            "history": [
                {
                    "role": entry["role"],
                    "task": projected_task(entry["task"]),
                }
                for entry in item["task_history"]
            ],
        }
        for item in sorted(state["slices"], key=lambda candidate: candidate["id"])
    ]

def descendant_quiescence_digest(state: dict) -> str:
    return canonical_digest(descendant_quiescence_projection(state))

def branch_release_candidates(
    item: dict, *, before_epoch: int
) -> list[tuple[int, str, dict]]:
    candidates: list[tuple[int, str, dict]] = []
    fields = (
        "branch_release_receipt", "branch_release_digest", "branch_release_epoch"
    )
    for role in ("implementation", "review"):
        for task, _current in task_records(item, role):
            present = [task[field] is not None for field in fields]
            if any(present) and not all(present):
                raise StateError("branch release lineage contains an incomplete proof triple")
            if all(present) and task["branch_release_epoch"] < before_epoch:
                candidates.append((task["branch_release_epoch"], role, task))
    return candidates


def causal_branch_release(item: dict, *, before_epoch: int) -> tuple[str, dict]:
    candidates = branch_release_candidates(item, before_epoch=before_epoch)
    if not candidates:
        raise StateError("review attachment requires a prior branch release")
    greatest = max(epoch for epoch, _role, _task in candidates)
    selected = [candidate for candidate in candidates if candidate[0] == greatest]
    if len(selected) != 1:
        raise StateError("branch release lineage has an ambiguous greatest epoch")
    _epoch, role, task = selected[0]
    return role, task


def review_task_for_terminal(item: dict, terminal: dict, label: str) -> dict:
    identity_fields = {
        "attempt": "attempt",
        "launchMarker": "launch_marker",
        "threadId": "thread_id",
        "clientThreadId": "client_thread_id",
        "taskWorktree": "task_worktree",
    }
    candidates = [
        task
        for task, _current in task_records(item, "review")
        if all(
            terminal[receipt_field] == task[task_field]
            for receipt_field, task_field in identity_fields.items()
        )
    ]
    if len(candidates) != 1:
        raise StateError(f"{label} does not resolve to exactly one review task")
    return candidates[0]


def final_ui_checkpoint_clean_release(
    bundle: Path, state: dict, item: dict, *, before_epoch: int
) -> tuple[dict, str] | None:
    if not item["revision_history"]:
        return None
    revision = item["revision_history"][-1]
    if revision["reauthorization_disposition"] != "final_ui_checkpoint_issue":
        return None
    terminal, digest = typed_receipt(
        bundle,
        revision["review_terminal_receipt"],
        f"{item['id']} final UI checkpoint clean release",
        REVIEW_LEASE_TERMINAL_FIELDS,
    )
    review = review_task_for_terminal(
        item, terminal, f"{item['id']} final UI checkpoint clean release"
    )
    expected = {
        **generic_receipt_identity(bundle, state),
        "schema": "spec-work-review-lease-terminal",
        "kind": "review_lease_terminal",
        "sliceId": item["id"],
        "role": "review",
        "taskType": "slice_review",
        "attempt": review["attempt"],
        "revisionEpoch": revision["revision_epoch"],
        "launchMarker": review["launch_marker"],
        "threadId": review["thread_id"],
        "clientThreadId": review["client_thread_id"],
        "taskWorktree": review["task_worktree"],
        "branch": item["branch"],
        "finalHeadSha": revision["head_sha"],
        "finalBaseSha": revision["base_sha"],
        "clean": True,
        "result": "CLEAN",
    }
    mismatched = [
        field for field, value in expected.items()
        if terminal.get(field) != value
    ]
    if digest != revision["review_terminal_digest"]:
        mismatched.append("digest")
    epoch = integer_value(
        terminal["observationEpoch"],
        f"{item['id']} final UI checkpoint clean release epoch",
        1,
    )
    if epoch >= before_epoch:
        mismatched.append("observationEpoch")
    if mismatched:
        raise StateError(
            f"{item['id']} final UI checkpoint clean release is stale: "
            + ", ".join(sorted(set(mismatched)))
        )
    return terminal, digest

def transitive_dependencies(items: dict[str, dict], item: dict) -> list[dict]:
    return sorted(
        (
            candidate
            for candidate in items.values()
            if candidate["id"] != item["id"]
            and dependency_reaches(items, item["id"], candidate["id"])
        ),
        key=lambda candidate: candidate["id"],
    )

def require_review_dependency_quiescence(
    items: dict[str, dict], item: dict
) -> None:
    active = sorted(
        label
        for dependency in transitive_dependencies(items, item)
        for label in nonquiescent_task_labels(dependency)
    )
    if active:
        raise StateError(
            "clean review requires quiescent dependency tasks: " + ", ".join(active)
        )

def review_clean_receipt_value(
    bundle: Path, state: dict, item: dict, task: dict
) -> dict:
    relative = task["review_receipt"]
    if relative is None:
        raise StateError(f"{item['id']} clean review requires a durable receipt")
    path = safe_path(
        bundle, relative, f"{item['id']} review receipt", required=True
    )
    if path.suffix != ".json":
        raise StateError("review clean receipt must be JSON")
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise StateError(f"invalid review clean receipt: {error}") from error
    value = exact_object(raw, "review clean receipt", REVIEW_CLEAN_RECEIPT_FIELDS)
    if value["schema"] != "spec-work-review-clean":
        raise StateError("review clean receipt has an unsupported schema")
    string_value(value["sliceId"], "review receipt slice", pattern=SLICE_ID_RE)
    string_value(value["headSha"], "review receipt head", pattern=SHA_RE)
    integer_value(value["attempt"], "review receipt attempt", 1)
    integer_value(value["revisionEpoch"], "review receipt revisionEpoch", 1)
    optional_string(value["reviewThreadId"], "review receipt thread")
    integer_value(value["pr"], "review receipt PR", 1)
    if value["verdict"] != "CLEAN" or value["dispositionsComplete"] is not True:
        raise StateError("review clean receipt requires CLEAN and complete dispositions")
    artifact_paths = {
        value["dispositionArtifact"], value["taskQuiescenceArtifact"],
        value["dependencyQuiescenceArtifact"],
    }
    if len(artifact_paths) != 3 or relative in artifact_paths:
        raise StateError("review clean receipt requires distinct proof artifacts")
    for path_field, digest_field in (
        ("dispositionArtifact", "dispositionProofDigest"),
        ("taskQuiescenceArtifact", "taskQuiescenceProofDigest"),
        ("dependencyQuiescenceArtifact", "dependencyQuiescenceProofDigest"),
    ):
        relative_path_value(value[path_field], f"review receipt {path_field}")
        string_value(value[digest_field], f"review receipt {digest_field}", pattern=DIGEST_RE)
        artifact = safe_path(
            bundle, value[path_field], f"review receipt {path_field}", required=True
        )
        if hashlib.sha256(artifact.read_bytes()).hexdigest() != value[digest_field]:
            raise StateError(f"review receipt {path_field} digest mismatch")
    historical = task["state"] == "superseded"
    expected = {
        **generic_receipt_identity(bundle, state),
        "reviewWorktree": task["task_worktree"], "sliceId": item["id"],
        "branch": value["branch"] if historical else item["branch"],
        "pr": value["pr"] if historical or item["pr"] is None else item["pr"],
        "headSha": task["bound_sha"],
        "taskType": "slice_review", "attempt": task["attempt"],
        "revisionEpoch": (
            value["revisionEpoch"] if historical else item["revision_epoch"]
        ),
        "reviewThreadId": task["thread_id"],
        "capabilityProbeDigest": task["companion_probe_digest"],
        "branchAttachmentDigest": task["branch_attachment_digest"],
    }
    if any(value[name] != expected_value for name, expected_value in expected.items()):
        raise StateError("review clean receipt is not bound to this task and exact head")
    return {
        "review_receipt": relative,
        "review_receipt_digest": hashlib.sha256(path.read_bytes()).hexdigest(),
        "review_epoch": value["revisionEpoch"],
        "review_disposition_digest": value["dispositionProofDigest"],
        "review_task_quiescence_digest": value["taskQuiescenceProofDigest"],
        "review_dependency_quiescence_digest": value[
            "dependencyQuiescenceProofDigest"
        ],
    }

def premerge_merged_value(
    bundle: Path,
    state: dict,
    item: dict,
    relative: str | None,
    expected_main: str,
) -> tuple[dict, str]:
    value, digest = typed_receipt(
        bundle,
        relative,
        f"{item['id']} successful premerge result",
        PREMERGE_RESULT_FIELDS,
    )
    if (
        value["schema"] != "spec-work-premerge-result"
        or value["result"] != "MERGED"
        or value["mergeMethod"] != "merge"
        or value["merged"] is not True
        or value["atomicCommitIdentityEnforced"] is not True
    ):
        raise StateError(
            "premerge result lacks a successful atomic commit identity"
        )
    for field in (
        "requestDigest", "operationDigest", "providerCommandDigest",
        "policyPreconditionDigest",
    ):
        string_value(value[field], f"premerge result {field}", pattern=DIGEST_RE)
    if value["reconciliationCommandDigest"] is not None:
        string_value(
            value["reconciliationCommandDigest"],
            "premerge reconciliation command digest",
            pattern=DIGEST_RE,
        )
    provider = string_value(value["provider"], "premerge provider")
    for field in (
        "expectedHeadSha", "expectedBaseSha", "observedHeadSha",
        "observedBaseSha", "mergeCommitSha",
    ):
        string_value(value[field], f"premerge result {field}", pattern=SHA_RE)
    integer_value(value["expectedPrNumber"], "premerge expected PR", 1)
    integer_value(value["observedPrNumber"], "premerge observed PR", 1)
    integer_value(value["providerStatus"], "premerge provider status", 0)
    integer_value(value["observationEpoch"], "premerge observation epoch", 1)

    lineage = item["review_task"]["head_adoption_terminal_lineage"]
    freshness = item["terminal_freshness"]
    if freshness is None:
        raise StateError("successful premerge result requires consumed CLEAN freshness")
    review_head_adoption_lineage_tip(
        bundle,
        state,
        item,
        item["review_task"],
        None,
        f"{item['id']} successful premerge result",
    )
    current = current_clean_terminal_lineage_entry(bundle, state, item)
    initial = {
        field: freshness[field]
        for field in ("receipt", "digest", "epoch", "review_receipt")
    }
    if {**initial, "result": "CLEAN"} not in lineage:
        raise StateError("successful premerge freshness binding is absent from CLEAN lineage")
    precondition = {
        "workKind": state["work_kind"],
        "workId": state["work_id"],
        "sliceId": item["id"],
        "expectedPrNumber": item["pr"],
        "expectedHeadSha": item["head_sha"],
        "expectedBaseRef": item["base_ref"],
        "expectedBaseSha": item["base_sha"],
        "initialCleanReceipt": initial["receipt"],
        "initialCleanReceiptDigest": initial["digest"],
        "currentCleanReceipt": current["receipt"],
        "currentCleanReceiptDigest": current["digest"],
        "observedMainSha": item["base_sha"],
    }
    policy_digest = canonical_digest(precondition)
    request = {
        "schema": "spec-work-premerge-operation",
        "workKind": state["work_kind"],
        "workId": state["work_id"],
        "sliceId": item["id"],
        "expectedPrNumber": item["pr"],
        "expectedHeadSha": item["head_sha"],
        "expectedBaseRef": item["base_ref"],
        "expectedBaseSha": item["base_sha"],
        "mergeMethod": "merge",
        "policyPreconditionDigest": policy_digest,
        "observationEpoch": value["observationEpoch"],
    }
    operation = {
        "request": request,
        "provider": provider,
        "providerCommandDigest": value["providerCommandDigest"],
        "reconciliationCommandDigest": value["reconciliationCommandDigest"],
    }
    expected = {
        "workKind": state["work_kind"],
        "workId": state["work_id"],
        "sliceId": item["id"],
        "expectedPrNumber": item["pr"],
        "expectedHeadSha": item["head_sha"],
        "expectedBaseRef": item["base_ref"],
        "expectedBaseSha": item["base_sha"],
        "observedPrNumber": item["pr"],
        "observedHeadSha": item["head_sha"],
        "observedBaseSha": item["base_sha"],
        "mergeCommitSha": expected_main,
        "mergeCommitParents": [item["base_sha"], item["head_sha"]],
        "policyPreconditionDigest": policy_digest,
    }
    if any(value[field] != expected_value for field, expected_value in expected.items()):
        raise StateError("successful premerge result lost the terminal CLEAN identity")
    if value["requestDigest"] != premerge_transport_digest(request):
        raise StateError("successful premerge result request digest is stale")
    if value["operationDigest"] != premerge_transport_digest(operation):
        raise StateError("successful premerge result operation digest is stale")
    return value, digest


def merge_receipt_value(
    bundle: Path, state: dict, item: dict, relative: str | None,
    *, expected_main: str | None = None, allow_legacy: bool = False,
) -> tuple[dict, dict]:
    review = item["review_task"]
    label = f"{item['id']} merge observation"
    if relative is None:
        raise StateError(f"{label} requires a typed receipt")
    path = safe_path(bundle, relative, label, required=True)
    if path.suffix != ".json":
        raise StateError(f"{label} must be JSON")
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise StateError(f"invalid {label}: {error}") from error
    legacy = allow_legacy and isinstance(raw, dict) and (
        set(raw) == LEGACY_MERGE_RECEIPT_FIELDS
    )
    value = exact_object(
        raw,
        label,
        LEGACY_MERGE_RECEIPT_FIELDS if legacy else MERGE_RECEIPT_FIELDS,
    )
    digest = hashlib.sha256(path.read_bytes()).hexdigest()
    if value["schema"] != "spec-work-merge-observation":
        raise StateError("merge observation has an unsupported schema")
    integer_value(value["pr"], "merge observation PR", 1)
    integer_value(value["observationEpoch"], "merge observation epoch", 1)
    for field in ("reviewedHeadSha", "resultMainSha"):
        string_value(value[field], f"merge observation {field}", pattern=SHA_RE)
    if not legacy:
        relative_path_value(
            value["premergeReceipt"], "merge observation premerge receipt"
        )
        string_value(
            value["premergeReceiptDigest"],
            "merge observation premerge receipt digest",
            pattern=DIGEST_RE,
        )
    expected = {
        **generic_receipt_identity(bundle, state),
        "reviewWorktree": review["task_worktree"], "sliceId": item["id"],
        "branch": item["branch"], "pr": item["pr"],
        "reviewedHeadSha": review["bound_sha"], "result": "MERGED",
        "resultMainSha": expected_main or item["merge_main_sha"] or state["observed_main_sha"],
    }
    if any(value[name] != expected_value for name, expected_value in expected.items()):
        raise StateError("merge observation is not bound to this reviewed PR and main head")
    if not legacy:
        premerge, premerge_digest = premerge_merged_value(
            bundle,
            state,
            item,
            value["premergeReceipt"],
            value["resultMainSha"],
        )
        if premerge_digest != value["premergeReceiptDigest"]:
            raise StateError("merge observation premerge receipt digest mismatch")
        require_strict_epoch_chain(
            [premerge["observationEpoch"], value["observationEpoch"]],
            f"{item['id']} merge evidence",
        )
    return value, {
        "merge_receipt": relative, "merge_receipt_digest": digest,
        "merge_epoch": value["observationEpoch"], "merge_main_sha": value["resultMainSha"],
    }

def planning_artifact_paths(
    state: dict, extra_excluded: set[str] | None = None
) -> set[str]:
    paths = {"discovery/chatgpt-pro-primary.md"}
    for evidence in state["planning"]["evidence"]:
        paths.add(evidence["answer_artifact"])
        if evidence["repair_artifact"] is not None:
            paths.add(evidence["repair_artifact"])
    return paths | (extra_excluded or set())


def approved_discovery_source_path(
    state: dict,
    source: str,
    extra_excluded: set[str] | None = None,
) -> bool:
    path = PurePosixPath(source)
    parts = path.parts
    if (
        len(parts) < 2
        or parts[0] != "discovery"
        or path.suffix.lower() != ".md"
    ):
        return False
    if source in planning_artifact_paths(state, extra_excluded):
        return False
    if parts[1] in {"corrections", "pro-lifecycle-evidence"}:
        return False
    return not path.name.startswith((
        "chatgpt-pro-primary", "chatgpt-pro-answer", "chatgpt-pro-repair",
    ))


def approved_source_inventory(
    bundle: Path,
    state: dict,
    *,
    extra_excluded: set[str] | None = None,
) -> list[dict[str, str]]:
    """Return canonical approved source-note identity, excluding Pro outputs."""
    paths = {
        state["artifacts"][key]
        for key in ("primary", "interview", "decisions", "acceptance")
    }
    discovery = bundle / "discovery"
    if discovery.is_symlink():
        raise StateError("discovery must not be a symlink")
    if discovery.exists() and not discovery.is_dir():
        raise StateError("discovery must be a directory")
    if discovery.is_dir():
        for directory, directory_names, file_names in os.walk(
            discovery, followlinks=False
        ):
            directory_path = Path(directory)
            for name in directory_names:
                if (directory_path / name).is_symlink():
                    raise StateError("discovery source directories must not be symlinks")
            for name in file_names:
                path = directory_path / name
                relative = path.relative_to(bundle).as_posix()
                if not approved_discovery_source_path(
                    state, relative, extra_excluded
                ):
                    continue
                ensure_regular_file(path, f"approved source {relative}", required=True)
                paths.add(relative)
    inventory: list[dict[str, str]] = []
    for relative in sorted(paths):
        path = safe_path(
            bundle, relative, f"approved source {relative}",
            required=True, markdown=True,
        )
        inventory.append({
            "path": relative,
            "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
        })
    return inventory

def canonical_plan_digest(bundle: Path, state: dict) -> str:
    projection = [
        {
            "id": item["id"],
            "title": item["title"],
            "plan": {
                "path": item["plan"],
                "sha256": plan_file_digest(bundle, item),
            },
            "depends_on": sorted(item["depends_on"]),
            "wave": item["wave"],
            "execution_mode": item["execution_mode"],
            "owned_paths": sorted(item["owned_paths"]),
        }
        for item in sorted(state["slices"], key=lambda candidate: candidate["id"])
    ]
    return canonical_digest(projection)

def require_current_atomic_plan(
    bundle: Path, state: dict, *, required: bool = False
) -> None:
    adopted = state["planning"]["current_plan_digest"]
    if required and adopted is None:
        raise StateError("Plan-to-Delivery requires atomic Plan adoption")
    if adopted is not None and adopted != canonical_plan_digest(bundle, state):
        raise StateError(
            "atomic Plan adoption is stale against current Plan bytes"
        )

def retained_plan_checkpoint_changed(
    bundle: Path, state: dict
) -> bool:
    return any(
        item["plan_checkpoint_sha"] is not None
        and item["implementation_task"]["state"]
        not in {"unbound", "superseded"}
        and hashlib.sha256(checkpointed_slice_plan_bytes(
            bundle,
            item,
            item["plan_checkpoint_sha"],
            f"{item['id']} retained implementation plan checkpoint",
        )).hexdigest()
        != plan_file_digest(bundle, item)
        for item in state["slices"]
    )

def completion_fact_digests(
    bundle: Path,
    state: dict,
    *,
    extra_excluded: set[str] | None = None,
) -> tuple[str, str, str, str]:
    plan_digest = canonical_plan_digest(bundle, state)
    source_inventory = approved_source_inventory(
        bundle, state, extra_excluded=extra_excluded
    )
    approved_source_pack_digest = canonical_digest(source_inventory)
    specification = hashlib.sha256()
    for record in source_inventory:
        path = safe_path(
            bundle, record["path"], "approved specification source", required=True
        )
        specification.update(record["path"].encode())
        specification.update(b"\0")
        specification.update(path.read_bytes())
        specification.update(b"\0")
    coverage = {
        identifier: {
            key: value
            for key, value in record.items()
            if key not in {"locked", "evidence", "evidence_digests"}
        }
        for identifier, record in sorted(state["acceptance"].items())
    }
    coverage_digest = text_digest(
        json.dumps(coverage, sort_keys=True, separators=(",", ":"))
    )
    return (
        plan_digest,
        specification.hexdigest(),
        approved_source_pack_digest,
        coverage_digest,
    )

def locked_completion_ui_bindings(bundle: Path, state: dict) -> list[dict]:
    result: list[dict] = []
    for identifier, record in state["acceptance"].items():
        if not record["locked"]:
            continue
        for relative in record["evidence"]:
            path = safe_path(
                bundle,
                relative,
                f"locked acceptance {identifier} evidence",
                required=True,
            )
            raw_bytes = path.read_bytes()
            try:
                raw = json.loads(raw_bytes.decode("utf-8"))
            except (UnicodeDecodeError, json.JSONDecodeError):
                continue
            if not isinstance(raw, dict) or (
                raw.get("schema") != UI_ATTESTATION_SCHEMA
                or raw.get("mode") != "completion"
            ):
                continue
            attestation = exact_object(
                raw,
                f"locked acceptance {identifier} completion attestation",
                {
                    "schema", "mode", "receipt", "receiptSha256",
                    "bundleRevision", "finalSlice", "acceptanceId", "headSha",
                    "headTree", "prNumber", "verdict",
                },
            )
            receipt = relative_path_value(
                attestation["receipt"],
                f"locked acceptance {identifier} completion receipt",
            )
            binding = {
                "receipt": receipt,
                "receipt_digest": string_value(
                    attestation["receiptSha256"],
                    f"locked acceptance {identifier} completion receipt digest",
                    pattern=DIGEST_RE,
                ),
                "attestation": relative,
                "attestation_digest": hashlib.sha256(raw_bytes).hexdigest(),
                "head_sha": string_value(
                    attestation["headSha"],
                    f"locked acceptance {identifier} completion head",
                    pattern=SHA_RE,
                ),
                "head_tree": string_value(
                    attestation["headTree"],
                    f"locked acceptance {identifier} completion tree",
                    pattern=SHA_RE,
                ),
                "pr": integer_value(
                    attestation["prNumber"],
                    f"locked acceptance {identifier} completion PR",
                    1,
                ),
                "final_slice": string_value(
                    attestation["finalSlice"],
                    f"locked acceptance {identifier} completion final slice",
                    pattern=SLICE_ID_RE,
                ),
                "acceptance_id": string_value(
                    attestation["acceptanceId"],
                    f"locked acceptance {identifier} completion acceptance",
                    pattern=ACCEPTANCE_ID_RE,
                ),
                "verdict": attestation["verdict"],
            }
            validate_completion_binding_files(
                bundle,
                binding,
                location=f"locked acceptance {identifier} completion binding",
            )
            result.append(binding)
    return result

def blind_completeness_receipt_value(
    bundle: Path, state: dict, relative: str | None
) -> tuple[dict, dict]:
    value, digest = typed_receipt(
        bundle,
        relative,
        "blind completeness audit",
        BLIND_COMPLETENESS_RECEIPT_FIELDS,
    )
    if value["schema"] != "spec-work-blind-completeness":
        raise StateError("blind completeness audit has an unsupported schema")
    for field in (
        "planDigest", "approvedSourcePackDigest", "descendantQuiescenceDigest"
    ):
        string_value(
            value[field], f"blind completeness audit {field}", pattern=DIGEST_RE
        )
    findings = string_list(
        value["materialFindings"], "blind completeness audit materialFindings"
    )
    limitations = string_list(
        value["limitations"], "blind completeness audit limitations"
    )
    if any(len(item) > 500 for item in [*findings, *limitations]):
        raise StateError(
            "blind completeness audit findings and limitations are limited to 500 characters"
        )
    integer_value(value["auditEpoch"], "blind completeness audit auditEpoch", 1)
    plan_digest, _specification, source_pack_digest, _coverage = (
        completion_fact_digests(bundle, state)
    )
    expected = {
        **generic_receipt_identity(bundle, state),
        "planDigest": plan_digest,
        "approvedSourcePackDigest": source_pack_digest,
        "verdict": "CLEAN",
        "materialFindings": [],
        "descendantQuiescenceVerdict": "QUIESCENT",
        "descendantQuiescenceDigest": descendant_quiescence_digest(state),
    }
    if any(value[name] != expected_value for name, expected_value in expected.items()):
        raise StateError(
            "blind completeness audit is stale, not CLEAN, has material findings, "
            "or lacks descendant quiescence"
        )
    return value, {
        "receipt": relative,
        "receipt_digest": digest,
        "epoch": value["auditEpoch"],
    }

def git_output(arguments: list[str], *, check: bool = True) -> str:
    result = subprocess.run(
        ["git", "-C", str(REPO), *arguments],
        check=False,
        capture_output=True,
        text=True,
        timeout=20,
    )
    if check and result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or "git failed"
        raise StateError(detail)
    return result.stdout.strip() if result.returncode == 0 else ""

def github_repository_slug(remote_url: str) -> str | None:
    value = remote_url.strip()
    scp_match = re.match(r"^(?:[^@]+@)?([^:]+):(.+)$", value)
    if scp_match is not None and "://" not in value:
        host, path = scp_match.groups()
    else:
        parsed = urlparse(value)
        host = parsed.hostname or ""
        path = parsed.path.lstrip("/")
    if host.lower() != "github.com" or not path:
        return None
    return path.removesuffix(".git")

def live_remote_branch_head(remote: str, branch: str) -> str:
    reference = f"refs/heads/{branch}"
    output = git_output(
        ["ls-remote", "--heads", remote, reference],
        check=False,
    )
    lines = [line.split() for line in output.splitlines() if line.strip()]
    if (
        len(lines) != 1
        or len(lines[0]) != 2
        or SHA_RE.fullmatch(lines[0][0]) is None
        or lines[0][1] != reference
    ):
        raise StateError(
            "Pro applicability source observation cannot verify one live "
            "remote branch head"
        )
    return lines[0][0]


def live_remote_ref_head(remote: str, reference: str, label: str) -> str:
    output = git_output(["ls-remote", remote, reference], check=False)
    lines = [line.split() for line in output.splitlines() if line.strip()]
    if (
        len(lines) != 1
        or len(lines[0]) != 2
        or SHA_RE.fullmatch(lines[0][0]) is None
        or lines[0][1] != reference
    ):
        raise StateError(
            f"{label} cannot verify one live remote ref"
        )
    return lines[0][0]


def live_pull_request_delivery(pull: int, label: str) -> dict[str, object]:
    remote_url = git_output(["remote", "get-url", "origin"])
    repository = github_repository_slug(remote_url)
    if repository is None:
        raise StateError(f"{label} cannot resolve the GitHub repository")
    try:
        result = subprocess.run(
            ["gh", "api", f"repos/{repository}/pulls/{pull}"],
            cwd=REPO,
            check=False,
            capture_output=True,
            text=True,
            timeout=20,
        )
    except (OSError, subprocess.SubprocessError) as error:
        raise StateError(
            f"{label} cannot query authoritative pull-request delivery"
        ) from error
    if result.returncode != 0:
        raise StateError(
            f"{label} cannot query authoritative pull-request delivery"
        )
    try:
        raw = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise StateError(
            f"{label} returned malformed pull-request delivery"
        ) from error
    # REST projection of the same authoritative fields; the REST endpoint
    # stays available while GitHub GraphQL (behind `gh pr view`) degrades.
    value: dict[str, object] = {}
    if isinstance(raw, dict):
        head_obj = raw.get("head")
        base_obj = raw.get("base")
        head_repo = (
            head_obj.get("repo") if isinstance(head_obj, dict) else None
        )
        base_repo = (
            base_obj.get("repo") if isinstance(base_obj, dict) else None
        )
        value = {
            "number": raw.get("number"),
            "state": (
                "MERGED"
                if raw.get("merged") is True and raw.get("state") == "closed"
                else raw.get("state")
            ),
            "mergedAt": raw.get("merged_at"),
            "mergeCommit": (
                {"oid": raw["merge_commit_sha"]}
                if isinstance(raw.get("merge_commit_sha"), str)
                else None
            ),
            "headRefOid": (
                head_obj.get("sha") if isinstance(head_obj, dict) else None
            ),
            "headRefName": (
                head_obj.get("ref") if isinstance(head_obj, dict) else None
            ),
            "headRepository": (
                {"nameWithOwner": head_repo.get("full_name")}
                if isinstance(head_repo, dict)
                else None
            ),
            "baseRefName": (
                base_obj.get("ref") if isinstance(base_obj, dict) else None
            ),
            "isCrossRepository": (
                head_repo.get("full_name") != base_repo.get("full_name")
                if isinstance(head_repo, dict) and isinstance(base_repo, dict)
                else None
            ),
        }
    merge_commit = value.get("mergeCommit")
    head_repository = value.get("headRepository")
    if (
        not isinstance(value, dict)
        or value.get("number") != pull
        or value.get("state") != "MERGED"
        or not isinstance(value.get("mergedAt"), str)
        or not value["mergedAt"].strip()
        or value.get("baseRefName") != "main"
        or value.get("isCrossRepository") is not False
        or not isinstance(head_repository, dict)
        or head_repository.get("nameWithOwner") != repository
        or not isinstance(merge_commit, dict)
    ):
        raise StateError(
            f"{label} is not one authoritative merged repository pull request"
        )
    head = string_value(
        value.get("headRefOid"), f"{label} head", pattern=SHA_RE
    )
    branch = string_value(value.get("headRefName"), f"{label} branch")
    merge = string_value(
        merge_commit.get("oid"), f"{label} merge commit", pattern=SHA_RE
    )
    return {"pr": pull, "head": head, "branch": branch, "merge": merge}


def commit_parents(commit: str, label: str) -> list[str]:
    require_commit_object(commit, label)
    values = git_output(["rev-list", "--parents", "-n", "1", commit]).split()
    if not values or values[0] != commit:
        raise StateError(f"cannot verify {label} parents")
    return values[1:]


def require_ancestor(ancestor: str, descendant: str, label: str) -> None:
    require_commit_object(ancestor, f"{label} ancestor")
    require_commit_object(descendant, f"{label} descendant")
    result = subprocess.run(
        [
            "git", "-C", str(REPO), "merge-base", "--is-ancestor",
            ancestor, descendant,
        ],
        check=False,
        capture_output=True,
        text=True,
        timeout=20,
    )
    if result.returncode == 1:
        raise StateError(label)
    if result.returncode != 0:
        raise StateError(f"cannot verify {label}")


def validate_authoritative_delivery_projection(
    state: dict,
    item: dict,
    *,
    deep_external: bool,
) -> None:
    if not is_authoritative_delivery_projection(item):
        raise StateError(
            f"{item['id']} authoritative delivery projection is malformed"
        )
    if (
        item["receipt"] is not None
        or item["replacement_lineage"] is not None
        or item["task_history"]
        or item["implementation_task"] != empty_task()
        or item["review_task"] != empty_task()
        or item["terminal_freshness"] is not None
        or item["premerge_drift"] is not None
    ):
        raise StateError(
            f"{item['id']} projected delivery retained task or receipt ceremony"
        )
    parents = commit_parents(
        item["merge_main_sha"],
        f"{item['id']} projected merge commit",
    )
    if parents != [item["base_sha"], item["head_sha"]]:
        raise StateError(f"{item['id']} projected merge-parent mismatch")
    observed_main = state["observed_main_sha"]
    if observed_main is None:
        raise StateError("projected delivery requires observed current main")
    require_ancestor(
        item["merge_main_sha"],
        observed_main,
        f"{item['id']} projected merge is not reachable from current main",
    )
    if deep_external:
        delivery = live_pull_request_delivery(
            item["pr"], f"{item['id']} projected pull request"
        )
        if delivery != {
            "pr": item["pr"],
            "head": item["head_sha"],
            "branch": item["branch"],
            "merge": item["merge_main_sha"],
        }:
            raise StateError(
                f"{item['id']} projected pull-request delivery identity mismatch"
            )

def require_commit_object(commit: str, label: str) -> None:
    try:
        git_output(["cat-file", "-e", f"{commit}^{{commit}}"])
    except (StateError, subprocess.SubprocessError) as error:
        raise StateError(f"{label} does not resolve to a local commit object") from error

def require_checkpointed_slice_plan(
    bundle: Path,
    item: dict,
    checkpoint: str,
    label: str = "reauthorization plan checkpoint",
) -> None:
    require_commit_object(checkpoint, label)
    plan = safe_path(
        bundle,
        item["plan"],
        f"{item['id']} checkpointed plan",
        required=True,
        markdown=True,
    )
    repository_path = plan.relative_to(REPO).as_posix()
    try:
        result = subprocess.run(
            [
                "git", "-C", str(REPO), "show",
                f"{checkpoint}:{repository_path}",
            ],
            check=False,
            capture_output=True,
            timeout=20,
        )
    except subprocess.SubprocessError as error:
        raise StateError(
            f"{label} does not contain the current slice plan"
        ) from error
    if result.returncode != 0 or result.stdout != plan.read_bytes():
        raise StateError(
            f"{label} does not contain the current slice plan"
        )


def checkpointed_slice_plan_bytes(
    bundle: Path, item: dict, checkpoint: str, label: str
) -> bytes:
    require_commit_object(checkpoint, label)
    plan = safe_path(
        bundle,
        item["plan"],
        f"{item['id']} checkpointed plan",
        required=True,
        markdown=True,
    )
    repository_path = plan.relative_to(REPO).as_posix()
    result = subprocess.run(
        ["git", "-C", str(REPO), "show", f"{checkpoint}:{repository_path}"],
        check=False,
        capture_output=True,
        timeout=20,
    )
    if result.returncode != 0:
        raise StateError(f"{label} does not contain the slice plan")
    return result.stdout


def checkpointed_plan_digest(
    bundle: Path, state: dict, checkpoint: str, label: str
) -> str:
    require_commit_object(checkpoint, label)
    bundle_relative = bundle.relative_to(REPO)
    state_path = (bundle_relative / "state.json").as_posix()
    state_result = subprocess.run(
        ["git", "-C", str(REPO), "show", f"{checkpoint}:{state_path}"],
        check=False,
        capture_output=True,
        timeout=20,
    )
    if state_result.returncode != 0:
        raise StateError(f"{label} does not contain state.json")
    try:
        checkpoint_state = json.loads(state_result.stdout)
        if (
            checkpoint_state["schema"] != state["schema"]
            or checkpoint_state["work_kind"] != state["work_kind"]
            or checkpoint_state["work_id"] != state["work_id"]
            or checkpoint_state["work_id"] != bundle.name
        ):
            raise StateError(f"{label} has the wrong work identity")
        slices = checkpoint_state["slices"]
        projection = []
        for item in sorted(slices, key=lambda candidate: candidate["id"]):
            plan = repo_path_value(item["plan"], f"{label} plan path")
            repository_path = (
                bundle_relative / PurePosixPath(plan)
            ).as_posix()
            plan_result = subprocess.run(
                [
                    "git", "-C", str(REPO), "show",
                    f"{checkpoint}:{repository_path}",
                ],
                check=False,
                capture_output=True,
                timeout=20,
            )
            if plan_result.returncode != 0:
                raise StateError(
                    f"{label} does not contain the plan for {item['id']}"
                )
            projection.append({
                "id": item["id"],
                "title": item["title"],
                "plan": {
                    "path": plan,
                    "sha256": hashlib.sha256(plan_result.stdout).hexdigest(),
                },
                "depends_on": sorted(item["depends_on"]),
                "wave": item["wave"],
                "execution_mode": item["execution_mode"],
                "owned_paths": sorted(item["owned_paths"]),
            })
    except (json.JSONDecodeError, KeyError, TypeError) as error:
        raise StateError(f"{label} has malformed planning state") from error
    return canonical_digest(projection)


def plan_digest_with_overrides(
    bundle: Path,
    state: dict,
    *,
    slice_id: str,
    plan_bytes: bytes,
    owned_paths: list[str],
) -> str:
    projection = []
    for item in sorted(state["slices"], key=lambda candidate: candidate["id"]):
        projection.append({
            "id": item["id"],
            "title": item["title"],
            "plan": {
                "path": item["plan"],
                "sha256": (
                    hashlib.sha256(plan_bytes).hexdigest()
                    if item["id"] == slice_id
                    else plan_file_digest(bundle, item)
                ),
            },
            "depends_on": sorted(item["depends_on"]),
            "wave": item["wave"],
            "execution_mode": item["execution_mode"],
            "owned_paths": (
                sorted(owned_paths)
                if item["id"] == slice_id
                else sorted(item["owned_paths"])
            ),
        })
    return canonical_digest(projection)


def markdown_h2_sections(text: str, label: str) -> tuple[str, list[tuple[str, str]]]:
    matches = list(re.finditer(r"(?m)^##\s+(.+?)\s*$", text))
    if not matches:
        raise StateError(f"{label} has no level-two sections")
    preamble = text[:matches[0].start()]
    sections: list[tuple[str, str]] = []
    headings: set[str] = set()
    for index, match in enumerate(matches):
        heading = match.group(1)
        if heading in headings:
            raise StateError(f"{label} has duplicate section: {heading}")
        headings.add(heading)
        end = matches[index + 1].start() if index + 1 < len(matches) else len(text)
        sections.append((heading, text[match.end():end]))
    return preamble, sections


def normalized_scope_owned_paths(
    section: str, label: str
) -> tuple[list[str], str]:
    lines = section.splitlines(keepends=True)
    matches = [
        index
        for index, line in enumerate(lines)
        if re.match(r"^- Owned paths:\s*", line)
    ]
    if (
        not matches
        or matches != list(range(matches[0], matches[-1] + 1))
    ):
        raise StateError(
            f"{label} requires one contiguous Owned paths declaration region"
        )
    start = matches[0]
    end = matches[-1] + 1
    while end < len(lines) and re.match(r"^\s{2,}-\s+", lines[end]):
        end += 1
    block = "".join(lines[start:end])
    paths = [
        repo_path_value(path, f"{label} owned path")
        for path in re.findall(r"`([^`]+)`", block)
    ]
    if not paths or len(paths) != len(set(paths)):
        raise StateError(f"{label} owned paths are empty or duplicated")
    normalized = "".join(
        [*lines[:start], "- Owned paths: <authorized-path-inventory>\n", *lines[end:]]
    )
    return sorted(paths), normalized


def acceptance_blocks(section: str, label: str) -> tuple[list[str], dict[str, str]]:
    matches = list(re.finditer(r"(?m)^-\s+(AC-[0-9]{3}):", section))
    identifiers = [match.group(1) for match in matches]
    if not identifiers or len(identifiers) != len(set(identifiers)):
        raise StateError(f"{label} acceptance coverage is missing or duplicated")
    blocks = {}
    for index, match in enumerate(matches):
        end = matches[index + 1].start() if index + 1 < len(matches) else len(section)
        blocks[match.group(1)] = section[match.start():end]
    return identifiers, blocks


def validate_required_by_intent_plan_amendment(
    *,
    slice_id: str,
    prior_plan: bytes,
    revised_plan: bytes,
    prior_owned_paths: list[str],
    revised_owned_paths: list[str],
    acceptance_id: str,
    owning_seam: str,
    regression_obligations: list[str],
    verification_obligations: list[str],
    prior_authenticated_cohesion_evidence: dict | None = None,
    authenticated_cohesion_evidence: dict | None = None,
) -> None:
    try:
        prior_text = prior_plan.decode("utf-8")
        revised_text = revised_plan.decode("utf-8")
    except UnicodeDecodeError as error:
        raise StateError("required-by-intent plans must be UTF-8") from error
    prior_preamble, prior_sections = markdown_h2_sections(
        prior_text, "prior required-by-intent plan"
    )
    revised_preamble, revised_sections = markdown_h2_sections(
        revised_text, "revised required-by-intent plan"
    )
    if (
        prior_preamble != revised_preamble
        or [heading for heading, _ in prior_sections]
        != [heading for heading, _ in revised_sections]
    ):
        raise StateError(
            "required-by-intent amendment changed the plan structure or outcome"
        )
    prior_by_heading = dict(prior_sections)
    revised_by_heading = dict(revised_sections)
    prior_cohesion = slice_cohesion_contract(
        prior_text,
        slice_id,
        required=True,
        authenticated_required_by_intent_evidence=(
            prior_authenticated_cohesion_evidence
        ),
    )
    assert prior_cohesion is not None
    if (
        prior_cohesion["Owning observable seam"]
        != owning_seam
    ):
        raise StateError(
            "required-by-intent review owning seam differs from the prior plan"
        )
    revised_cohesion = slice_cohesion_contract(
        revised_text,
        slice_id,
        required=True,
        authenticated_required_by_intent_evidence=(
            authenticated_cohesion_evidence
        ),
    )
    assert revised_cohesion is not None
    allowed = {
        "Scope and Ownership",
        "Slice Cohesion",
        "Acceptance Coverage",
        "Verification",
    }
    if not allowed.issubset(prior_by_heading):
        raise StateError(
            "required-by-intent amendment requires Scope and Ownership, "
            "Acceptance Coverage, and Verification sections"
        )
    for heading in set(prior_by_heading) - allowed:
        if prior_by_heading[heading] != revised_by_heading[heading]:
            raise StateError(
                f"required-by-intent amendment changed forbidden section: {heading}"
            )
    prior_cohesion_section = prior_by_heading["Slice Cohesion"]
    consumer_declaration = re.compile(
        rf"^([ \t]*-[ \t]+{re.escape(COHESIVE_CONSUMER_SWEEP_LABEL)}:"
        r"[ \t]*)no([ \t]*)$",
        re.IGNORECASE | re.MULTILINE,
    )
    expected_cohesion_section, declaration_count = consumer_declaration.subn(
        lambda match: f"{match.group(1)}yes{match.group(2)}",
        prior_cohesion_section,
    )
    if prior_cohesion[COHESIVE_CONSUMER_SWEEP_LABEL] == "no":
        assert declaration_count == 1
    if (
        revised_by_heading["Slice Cohesion"] != prior_cohesion_section
        and revised_by_heading["Slice Cohesion"] != expected_cohesion_section
    ):
        raise StateError(
            "required-by-intent amendment changed forbidden section: Slice Cohesion"
        )
    prior_paths, prior_scope = normalized_scope_owned_paths(
        prior_by_heading["Scope and Ownership"], "prior plan"
    )
    revised_paths, revised_scope = normalized_scope_owned_paths(
        revised_by_heading["Scope and Ownership"], "revised plan"
    )
    if (
        prior_scope != revised_scope
        or prior_paths != sorted(prior_owned_paths)
        or revised_paths != sorted(revised_owned_paths)
    ):
        raise StateError(
            "required-by-intent amendment changed scope beyond the exact path inventory"
        )
    prior_ids, prior_acceptance = acceptance_blocks(
        prior_by_heading["Acceptance Coverage"], "prior plan"
    )
    revised_ids, revised_acceptance = acceptance_blocks(
        revised_by_heading["Acceptance Coverage"], "revised plan"
    )
    if prior_ids != revised_ids or acceptance_id not in prior_acceptance:
        raise StateError(
            "required-by-intent amendment changed acceptance identifiers"
        )
    for identifier in prior_ids:
        prior_block = prior_acceptance[identifier]
        revised_block = revised_acceptance[identifier]
        if identifier == acceptance_id:
            prior_prefix = prior_block.rstrip()
            if (
                revised_block == prior_block
                or not revised_block.startswith(prior_prefix)
            ):
                raise StateError(
                    "required-by-intent amendment must append to its existing criterion"
                )
            revised_acceptance_suffix = revised_block[len(prior_prefix):]
        elif revised_block != prior_block:
            raise StateError(
                "required-by-intent amendment changed an unrelated criterion"
            )
    if any(
        obligation not in revised_acceptance_suffix
        for obligation in regression_obligations
    ):
        raise StateError(
            "required-by-intent plan omits the reviewer regression obligation"
        )
    prior_verification = prior_by_heading["Verification"].rstrip()
    revised_verification = revised_by_heading["Verification"].rstrip()
    if (
        revised_verification == prior_verification
        or not revised_verification.startswith(prior_verification)
        or not revised_verification[len(prior_verification):].lstrip().startswith("- ")
    ):
        raise StateError(
            "required-by-intent verification changes must be append-only bullets"
        )
    revised_verification_suffix = revised_verification[len(prior_verification):]
    if any(
        obligation not in revised_verification_suffix
        for obligation in verification_obligations
    ):
        raise StateError(
            "required-by-intent plan omits the reviewer verification obligation"
        )


def validate_coordinator_scope_expansion_contract(
    *,
    slice_id: str,
    plan: bytes,
    prior_owned_paths: list[str],
    acceptance_id: str,
    owning_seam: str,
) -> None:
    try:
        text = plan.decode("utf-8")
    except UnicodeDecodeError as error:
        raise StateError("coordinator scope-expansion plan must be UTF-8") from error
    _preamble, sections = markdown_h2_sections(
        text, "coordinator scope-expansion plan"
    )
    by_heading = dict(sections)
    scope = by_heading.get("Scope and Ownership")
    acceptance = by_heading.get("Acceptance Coverage")
    if scope is None or acceptance is None:
        raise StateError(
            "coordinator scope expansion requires accepted scope and acceptance coverage"
        )
    plan_paths, _normalized = normalized_scope_owned_paths(
        scope, "coordinator scope-expansion plan"
    )
    if plan_paths != sorted(prior_owned_paths):
        raise StateError(
            "coordinator scope expansion changed the accepted path inventory"
        )
    cohesion = slice_cohesion_contract(text, slice_id, required=True)
    if (
        cohesion["Owning observable seam"]
        != owning_seam
    ):
        raise StateError(
            "coordinator scope expansion owning seam differs from the accepted plan"
        )
    acceptance_ids, _blocks = acceptance_blocks(
        acceptance, "coordinator scope-expansion plan"
    )
    if acceptance_id not in acceptance_ids:
        raise StateError(
            "coordinator scope expansion acceptance differs from the accepted plan"
        )

def repository_relative_source_path(bundle: Path, value: str) -> str:
    """Convert one bundle-relative source coordinate to repository-relative."""
    repo_path_value(value, "applicability repository path")
    try:
        bundle_relative = bundle.relative_to(REPO).as_posix()
    except ValueError as error:
        raise StateError("feature bundle is outside the coordinator repository") from error
    return (
        PurePosixPath(bundle_relative) / PurePosixPath(value)
    ).as_posix()

def bundle_repository_roots(bundle: Path) -> tuple[PurePosixPath, ...]:
    """Return the sole operational repository root for one lifecycle identity."""
    try:
        current = PurePosixPath(bundle.relative_to(REPO).as_posix())
    except ValueError as error:
        raise StateError("feature bundle is outside the coordinator repository") from error
    parts = current.parts
    if (
        len(parts) != 4
        or parts[0] != "docs"
        or parts[1] not in {"features", "bug_fixes"}
        or parts[2] not in {"in_progress", "completed"}
    ):
        return (current,)
    in_progress = PurePosixPath(parts[0], parts[1], "in_progress", parts[3])
    if parts[2] == "in_progress":
        return (in_progress,)
    active_path = REPO / Path(*in_progress.parts)
    if active_path.is_dir():
        return (in_progress,)
    # A completed-only bundle must still authenticate source commits recorded
    # before its lifecycle move. No individual accepted commit may contain the
    # same approved coordinate in both roots.
    return (in_progress, current)

def bundle_source_coordinate(
    bundle: Path, path: str, label: str
) -> str | None:
    """Map one current or paired-lifecycle repository path to bundle-relative."""
    repository_path = PurePosixPath(repo_path_value(path, label))
    for root in bundle_repository_roots(bundle):
        root_parts = root.parts
        if repository_path.parts[:len(root_parts)] != root_parts:
            continue
        source_parts = repository_path.parts[len(root_parts):]
        if source_parts:
            return PurePosixPath(*source_parts).as_posix()
    return None

def bundle_repository_source_paths(bundle: Path, value: str) -> tuple[str, ...]:
    """Expand one bundle-relative coordinate across exact lifecycle roots."""
    repo_path_value(value, "applicability repository path")
    source = PurePosixPath(value)
    return tuple((root / source).as_posix() for root in bundle_repository_roots(bundle))

def repository_regular_file(
    path: str, label: str, *, required: bool = True
) -> Path | None:
    """Resolve one repository path while rejecting symlinked components."""
    target = REPO
    parts = repo_path_parts(path, label)
    for index, part in enumerate(parts):
        target = target / part
        try:
            mode = target.lstat().st_mode
        except FileNotFoundError:
            if not required:
                return None
            raise StateError(
                f"required repository file is missing for {label}: {path}"
            ) from None
        except OSError as error:
            raise StateError(
                f"repository path is unreadable for {label}: {path}"
            ) from error
        if stat.S_ISLNK(mode):
            raise StateError(
                f"symlinked repository path is forbidden for {label}: {path}"
            )
        if index < len(parts) - 1 and not stat.S_ISDIR(mode):
            raise StateError(
                f"repository path component is not a directory for {label}: {path}"
            )
        if index == len(parts) - 1 and not stat.S_ISREG(mode):
            raise StateError(
                f"repository path is not a regular file for {label}: {path}"
            )
    return target

def approved_source_repository_path(
    bundle: Path,
    state: dict,
    path: str,
    *,
    extra_excluded: set[str] | None = None,
) -> bool:
    """Return whether a repository path is an approved source at either commit."""
    source = bundle_source_coordinate(bundle, path, "approved source path")
    if source is None:
        return False
    semantic_sources = {
        state["artifacts"][key]
        for key in ("primary", "interview", "decisions", "acceptance")
    }
    if source in semantic_sources:
        return True
    return approved_discovery_source_path(state, source, extra_excluded)

def commit_path_digest(commit: str, path: str) -> str | None:
    result = subprocess.run(
        ["git", "-C", str(REPO), "show", f"{commit}:{path}"],
        check=False,
        capture_output=True,
        timeout=20,
    )
    if result.returncode != 0:
        return None
    return hashlib.sha256(result.stdout).hexdigest()

def commit_approved_source_paths(
    bundle: Path, state: dict, commit: str
) -> dict[str, str]:
    """List syntactically approved feature sources present at one commit."""
    roots = bundle_repository_roots(bundle)
    paths = filter(
        None,
        git_output(
            [
                "ls-tree", "-r", "--name-only", commit, "--",
                *(root.as_posix() for root in roots),
            ]
        ).splitlines(),
    )
    approved: dict[str, str] = {}
    for path in paths:
        if not approved_source_repository_path(bundle, state, path):
            continue
        source = bundle_source_coordinate(bundle, path, "approved source path")
        if source is None:
            continue
        if source in approved:
            raise StateError(
                "approved source exists under both lifecycle repository roots: "
                f"{source}"
            )
        approved[source] = path
    return approved


def require_descendant_commit(
    ancestor: str,
    descendant: str,
    label: str,
) -> None:
    require_commit_object(ancestor, f"{label} ancestor")
    require_commit_object(descendant, label)
    try:
        result = subprocess.run(
            [
                "git", "-C", str(REPO), "merge-base", "--is-ancestor",
                ancestor, descendant,
            ],
            check=False,
            capture_output=True,
            text=True,
            timeout=20,
        )
    except (OSError, subprocess.SubprocessError) as error:
        raise StateError(f"cannot verify {label} ancestry") from error
    if result.returncode == 1:
        raise StateError(
            f"{label} must descend from terminal applicability source"
        )
    if result.returncode != 0:
        raise StateError(f"cannot verify {label} ancestry")


def require_current_approved_sources_at_commit(
    bundle: Path,
    state: dict,
    commit: str,
    label: str,
) -> None:
    require_commit_object(commit, label)
    committed = commit_approved_source_paths(bundle, state, commit)
    approved = {
        record["path"]: record["sha256"]
        for record in approved_source_inventory(bundle, state)
    }
    mismatched = sorted(
        path
        for path in set(approved) | set(committed)
        if (
            commit_path_digest(commit, committed[path])
            if path in committed else None
        ) != approved.get(path)
    )
    if mismatched:
        raise StateError(
            f"{label} does not bind current approved source bytes: "
            f"{mismatched[0]}"
        )


def validate_applicability_repository_truth(
    bundle: Path,
    state: dict,
    value: dict,
    *,
    require_current_binding: bool,
) -> None:
    from_commit = value["fromSourceCommit"]
    to_commit = value["toSourceCommit"]
    require_commit_object(from_commit, "Pro applicability fromSourceCommit")
    require_commit_object(to_commit, "Pro applicability toSourceCommit")
    from_commit_paths = commit_approved_source_paths(bundle, state, from_commit)
    to_commit_paths = (
        from_commit_paths
        if from_commit == to_commit
        else commit_approved_source_paths(bundle, state, to_commit)
    )
    claimed = set(value["changedPaths"])
    approved = {
        record["path"]: record["sha256"]
        for record in approved_source_inventory(bundle, state)
    }
    if from_commit != to_commit:
        changed = set(
            filter(
                None,
                git_output(
                    ["diff", "--name-only", "--no-renames", from_commit, to_commit, "--"]
                ).splitlines(),
            )
        )
        expected = set()
        for path in changed:
            if not approved_source_repository_path(bundle, state, path):
                continue
            source = bundle_source_coordinate(bundle, path, "approved source path")
            if source is not None:
                expected.add(source)
        if claimed != expected:
            raise StateError(
                "Pro applicability changedPaths do not equal the approved-source "
                "repository diff"
            )
        if require_current_binding:
            mismatched = sorted(
                path
                for path in set(approved) | set(to_commit_paths)
                if (
                    commit_path_digest(to_commit, to_commit_paths[path])
                    if path in to_commit_paths else None
                ) != approved.get(path)
            )
            if mismatched:
                raise StateError(
                    "current approved source bytes do not match Pro applicability "
                    f"toSourceCommit: {mismatched[0]}"
                )
    elif require_current_binding:
        current_paths = set(approved)
        local_changes = {
            path
            for path in current_paths | set(to_commit_paths)
            if (
                commit_path_digest(to_commit, to_commit_paths[path])
                if path in to_commit_paths else None
            ) != approved.get(path)
        }
        if claimed != local_changes:
            raise StateError(
                "Pro applicability changedPaths do not equal the approved local "
                "source delta for the unchanged commit"
            )
    for anchor in value["evidenceAnchors"]:
        path = repository_relative_source_path(bundle, anchor)
        local = repository_regular_file(
            path, "Pro applicability evidence anchor", required=False
        )
        if local is None and not any(
            commit_path_digest(commit, candidate) is not None
            for commit in (from_commit, to_commit)
            for candidate in bundle_repository_source_paths(bundle, anchor)
        ):
            raise StateError(
                f"Pro applicability evidence anchor does not resolve: {anchor}"
            )

def validate_applicability_value(
    bundle: Path,
    state: dict,
    evidence: dict,
    record: dict,
    value: dict,
    *,
    require_current_binding: bool = False,
) -> None:
    if value["schema"] != "spec-work-pro-applicability":
        raise StateError("Pro applicability has an unsupported schema")
    for field in ("responseDigest", "fromDigest", "toDigest"):
        string_value(value[field], f"Pro applicability {field}", pattern=DIGEST_RE)
    for field in ("fromSourceCommit", "toSourceCommit"):
        string_value(value[field], f"Pro applicability {field}", pattern=SHA_RE)
    enum_value(
        value["classification"],
        "Pro applicability classification",
        APPLICABILITY_CLASSIFICATIONS,
    )
    enum_value(
        value["validationResult"],
        "Pro applicability validationResult",
        APPLICABILITY_RESULTS,
    )
    for field in ("recommendationsChanged", "implementationSlicesChanged"):
        if type(value[field]) is not bool:
            raise StateError(f"Pro applicability {field} must be a boolean")
    for field in ("changedPaths", "evidenceAnchors"):
        paths = string_list(value[field], f"Pro applicability {field}", nonempty=True)
        for index, path in enumerate(paths):
            repo_path_value(path, f"Pro applicability {field}.{index}")
    string_value(
        value["semanticDiffSummary"],
        "Pro applicability semanticDiffSummary",
        maximum=2000,
    )
    string_value(
        value["applicabilityRationale"],
        "Pro applicability applicabilityRationale",
        maximum=2000,
    )
    integer_value(value["assessmentEpoch"], "Pro applicability assessmentEpoch", 1)
    expected = {
        **generic_receipt_identity(bundle, state),
        "responseDigest": evidence["response_digest"],
        "fromDigest": record["from_digest"],
        "toDigest": record["to_digest"],
        "fromSourceCommit": record["from_source_commit"],
        "toSourceCommit": record["to_source_commit"],
        "classification": record["classification"],
        "changedPaths": record["changed_paths"],
        "recommendationsChanged": record["recommendations_changed"],
        "implementationSlicesChanged": record["implementation_slices_changed"],
        "validationResult": record["validation_result"],
        "evidenceAnchors": record["evidence_anchors"],
        "assessmentEpoch": record["epoch"],
    }
    if any(value[field] != expected_value for field, expected_value in expected.items()):
        raise StateError("Pro applicability receipt is stale against planning state")
    validate_applicability_repository_truth(
        bundle,
        state,
        value,
        require_current_binding=require_current_binding,
    )


def source_observation_value(
    bundle: Path,
    state: dict,
    evidence: dict,
    relative: str | None,
    *,
    require_current_head: bool,
) -> tuple[dict, str, str]:
    if relative is None:
        raise StateError(
            "Pro applicability target reconciliation requires a source observation"
        )
    path = safe_path(
        bundle,
        relative,
        "Pro applicability source observation",
        required=True,
    )
    if path.suffix != ".json":
        raise StateError("Pro applicability source observation must be JSON")
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise StateError(
            f"invalid Pro applicability source observation: {error}"
        ) from error
    if not isinstance(raw, dict) or raw.get("schema") != (
        "chatgpt-pro-feature-planner/context-manifest"
    ):
        raise StateError(
            "Pro applicability source observation has an unsupported schema"
        )
    if (
        raw.get("repository_slug") != evidence["repository"]
        or raw.get("branch") != evidence["source_branch"]
    ):
        raise StateError(
            "Pro applicability source observation is bound to another source"
        )
    remote_name = string_value(
        raw.get("remote"),
        "Pro applicability source observation remote",
        maximum=240,
    )
    if re.fullmatch(r"[A-Za-z0-9._-]+", remote_name) is None:
        raise StateError(
            "Pro applicability source observation remote is not a configured name"
        )
    expected_remote_url = (
        f"https://github.com/{evidence['repository']}.git"
    )
    if (
        raw.get("remote_url") != expected_remote_url
        or os.path.realpath(str(raw.get("repository_root", "")))
        != os.path.realpath(REPO)
    ):
        raise StateError(
            "Pro applicability source observation is bound to another repository"
        )
    remote = exact_object(
        raw.get("remote_branch"),
        "Pro applicability source observation remote_branch",
        {"mode", "sha", "verified", "error"},
    )
    local_candidate = raw.get("local_head")
    remote_candidate = remote.get("sha")
    if (
        raw.get("exact_local_head_is_verified_remote_head") is not True
        or remote["mode"] != "live"
        or remote["verified"] is not True
        or remote["error"] is not None
        or not isinstance(local_candidate, str)
        or SHA_RE.fullmatch(local_candidate) is None
        or not isinstance(remote_candidate, str)
        or SHA_RE.fullmatch(remote_candidate) is None
        or local_candidate != remote_candidate
    ):
        raise StateError(
            "Pro applicability source observation does not prove one exact "
            "live remote head"
        )
    candidate = local_candidate
    require_commit_object(candidate, "Pro applicability reconciled source commit")
    if require_current_head and git_output(["rev-parse", "HEAD"]) != candidate:
        raise StateError(
            "Pro applicability source observation does not match checked-out HEAD"
        )
    if require_current_head:
        configured_remote = git_output(
            ["remote", "get-url", remote_name],
            check=False,
        )
        if github_repository_slug(configured_remote) != evidence["repository"]:
            raise StateError(
                "Pro applicability source observation does not match the "
                "configured repository remote"
            )
        if live_remote_branch_head(remote_name, evidence["source_branch"]) != candidate:
            raise StateError(
                "Pro applicability source observation does not match the live "
                "remote branch head"
            )
    raw_paths = raw.get("paths")
    if not isinstance(raw_paths, list):
        raise StateError("Pro applicability source observation paths must be an array")
    records: dict[str, dict] = {}
    inventory: list[dict] = []
    for index, raw_record in enumerate(raw_paths):
        if not isinstance(raw_record, dict):
            raise StateError(
                f"Pro applicability source observation paths.{index} must be an object"
            )
        try:
            inventory_record = {
                field: raw_record[field]
                for field in SOURCE_OBSERVATION_INVENTORY_FIELDS
            }
        except KeyError as error:
            raise StateError(
                "Pro applicability source observation path is incomplete"
            ) from error
        repository_path = repo_path_value(
            inventory_record["path"],
            f"Pro applicability source observation paths.{index}.path",
        )
        if repository_path in records:
            raise StateError(
                "Pro applicability source observation contains duplicate paths"
            )
        records[repository_path] = inventory_record
        inventory.append(inventory_record)
    if [record["path"] for record in inventory] != sorted(records):
        raise StateError(
            "Pro applicability source observation paths are not canonical"
        )
    if canonical_digest(inventory) != raw.get("source_inventory_digest"):
        raise StateError(
            "Pro applicability source observation inventory digest mismatch"
        )
    provenance = {
        "schema": "chatgpt-pro-feature-planner/provenance",
        "repository_slug": evidence["repository"],
        "branch": evidence["source_branch"],
        "local_head": candidate,
        "remote_branch": {
            field: remote[field]
            for field in ("mode", "sha", "verified", "error")
        },
        "exact_local_head_is_verified_remote_head": True,
        "source_inventory_digest": raw["source_inventory_digest"],
    }
    if canonical_digest(provenance) != raw.get("provenance_digest"):
        raise StateError(
            "Pro applicability source observation provenance digest mismatch"
        )
    for repository_path, record in records.items():
        observed_digest = record["working_sha256"]
        expected_blob = git_output(
            ["rev-parse", f"{candidate}:{repository_path}"],
            check=False,
        )
        if (
            record["exists"] is not True
            or record["tracked"] is not True
            or record["committed_at_head"] is not True
            or record["working_copy_dirty"] is not False
            or record["source_route"] != "github"
            or record["reason"] != "exact_clean_path_at_verified_remote_commit"
            or not isinstance(observed_digest, str)
            or DIGEST_RE.fullmatch(observed_digest) is None
            or commit_path_digest(candidate, repository_path) != observed_digest
            or not expected_blob
            or record["head_blob"] != expected_blob
        ):
            raise StateError(
                "Pro applicability source observation does not bind current "
                f"approved source bytes: {repository_path}"
            )
    if require_current_head:
        approved = approved_source_inventory(bundle, state)
        expected_paths = {
            repository_relative_source_path(bundle, item["path"]): item["sha256"]
            for item in approved
        }
        if set(records) != set(expected_paths) or any(
            records[path]["working_sha256"] != digest
            for path, digest in expected_paths.items()
        ):
            raise StateError(
                "Pro applicability source observation does not exactly cover "
                "current approved sources"
            )
    return raw, hashlib.sha256(path.read_bytes()).hexdigest(), candidate


def applicability_correction_projection(
    bundle: Path,
    state: dict,
    evidence: dict,
    original_relative: str,
    original_digest: str,
    original_value: dict,
    source_observation_relative: str,
    source_observation_digest: str,
    candidate: str,
) -> dict[str, object]:
    derived_value = {**original_value, "toSourceCommit": candidate}
    authority = sorted(
        [
            {
                "source": "evidence",
                "reference": evidence["answer_artifact"],
                "valueOrDigest": evidence["response_digest"],
            },
            {
                "source": "local-git",
                "reference": "HEAD",
                "valueOrDigest": candidate,
            },
            {
                "source": "source-observation",
                "reference": source_observation_relative,
                "valueOrDigest": source_observation_digest,
            },
            {
                "source": "state",
                "reference": "planning.current_specification_digest",
                "valueOrDigest": original_value["toDigest"],
            },
        ],
        key=lambda item: (
            item["source"],
            item["reference"],
            item["valueOrDigest"],
        ),
    )
    identity_digest = canonical_digest(
        {
            "workKind": state["work_kind"],
            "workId": state["work_id"],
            "boundary": APPLICABILITY_TARGET_BOUNDARY,
            "rule": APPLICABILITY_TARGET_RULE,
            "original": {
                "path": original_relative,
                "sha256": original_digest,
            },
            "authorityDigest": canonical_digest(authority),
        }
    )
    derived_relative = (
        "discovery/corrections/"
        f"pro-applicability-effective-{identity_digest}.json"
    )
    correction_relative = (
        "discovery/corrections/"
        f"{APPLICABILITY_TARGET_BOUNDARY}-{identity_digest}.json"
    )
    derived_bytes = canonical_json_bytes(derived_value)
    derived_digest = hashlib.sha256(derived_bytes).hexdigest()
    receipt = {
        "schema": CORRECTION_SCHEMA,
        "workKind": state["work_kind"],
        "workId": state["work_id"],
        "stage": "plan",
        "boundary": APPLICABILITY_TARGET_BOUNDARY,
        "kind": "reconcile_authoritative_state",
        "rule": APPLICABILITY_TARGET_RULE,
        "original": {
            "path": original_relative,
            "sha256": original_digest,
        },
        "derived": {
            "path": derived_relative,
            "sha256": derived_digest,
        },
        "change": {
            "observed": original_value["toSourceCommit"],
            "corrected": candidate,
        },
        "authority": authority,
    }
    receipt_bytes = canonical_json_bytes(receipt)
    return {
        "receipt": derived_relative,
        "receipt_digest": derived_digest,
        "original_receipt": original_relative,
        "original_receipt_digest": original_digest,
        "correction_receipt": correction_relative,
        "correction_receipt_digest": hashlib.sha256(
            receipt_bytes
        ).hexdigest(),
        "derived_value": derived_value,
        "derived_bytes": derived_bytes,
        "correction": receipt,
        "correction_bytes": receipt_bytes,
    }


def publish_applicability_correction(
    bundle: Path,
    projection: dict[str, object],
) -> dict[str, object]:
    publish_immutable_bytes(
        safe_path(
            bundle,
            projection["receipt"],
            "reconciled Pro applicability receipt",
            required=False,
        ),
        projection["derived_bytes"],
    )
    publish_immutable_bytes(
        safe_path(
            bundle,
            projection["correction_receipt"],
            "Pro applicability correction receipt",
            required=False,
        ),
        projection["correction_bytes"],
    )
    return {
        field: projection[field]
        for field in (
            "receipt",
            "receipt_digest",
            "original_receipt",
            "original_receipt_digest",
            "correction_receipt",
            "correction_receipt_digest",
        )
    }


def validate_applicability_correction_binding(
    bundle: Path,
    state: dict,
    evidence: dict,
    record: dict,
    *,
    require_current_binding: bool,
) -> tuple[dict, str]:
    original_value, original_digest = typed_receipt(
        bundle,
        record["original_receipt"],
        "original Pro applicability",
        APPLICABILITY_RECEIPT_FIELDS,
    )
    if original_digest != record["original_receipt_digest"]:
        raise StateError("original Pro applicability receipt digest mismatch")
    correction, correction_digest = typed_receipt(
        bundle,
        record["correction_receipt"],
        "Pro applicability correction",
        CORRECTION_RECEIPT_FIELDS,
    )
    if correction_digest != record["correction_receipt_digest"]:
        raise StateError("Pro applicability correction receipt digest mismatch")
    observations = [
        item
        for item in correction["authority"]
        if isinstance(item, dict) and item.get("source") == "source-observation"
    ]
    if len(observations) != 1:
        raise StateError(
            "Pro applicability correction requires one source observation"
        )
    source_observation_relative = string_value(
        observations[0].get("reference"),
        "Pro applicability correction source observation reference",
        maximum=500,
    )
    _observation, observation_digest, candidate = source_observation_value(
        bundle,
        state,
        evidence,
        source_observation_relative,
        require_current_head=False,
    )
    projection = applicability_correction_projection(
        bundle,
        state,
        evidence,
        record["original_receipt"],
        original_digest,
        original_value,
        source_observation_relative,
        observation_digest,
        candidate,
    )
    for field in (
        "receipt",
        "receipt_digest",
        "original_receipt",
        "original_receipt_digest",
        "correction_receipt",
        "correction_receipt_digest",
    ):
        if record[field] != projection[field]:
            raise StateError(
                "Pro applicability correction binding is stale or noncanonical"
            )
    derived_path = safe_path(
        bundle,
        record["receipt"],
        "reconciled Pro applicability receipt",
        required=True,
    )
    correction_path = safe_path(
        bundle,
        record["correction_receipt"],
        "Pro applicability correction receipt",
        required=True,
    )
    if derived_path.read_bytes() != projection["derived_bytes"]:
        raise StateError(
            "reconciled Pro applicability bytes conflict with correction"
        )
    if correction_path.read_bytes() != projection["correction_bytes"]:
        raise StateError(
            "Pro applicability correction receipt bytes are noncanonical"
        )
    derived_value = projection["derived_value"]
    validate_applicability_value(
        bundle,
        state,
        evidence,
        record,
        derived_value,
        require_current_binding=require_current_binding,
    )
    return derived_value, record["receipt_digest"]


def applicability_receipt_value(
    bundle: Path,
    state: dict,
    evidence: dict,
    record: dict,
    *,
    require_current_binding: bool = False,
) -> tuple[dict, str]:
    correction_bound = record["correction_receipt"] is not None
    if correction_bound:
        return validate_applicability_correction_binding(
            bundle,
            state,
            evidence,
            record,
            require_current_binding=require_current_binding,
        )
    value, digest = typed_receipt(
        bundle,
        record["receipt"],
        "Pro applicability",
        APPLICABILITY_RECEIPT_FIELDS,
    )
    validate_applicability_value(
        bundle,
        state,
        evidence,
        record,
        value,
        require_current_binding=require_current_binding,
    )
    return value, digest

def validate_context_manifest_binding(
    bundle: Path,
    state: dict,
    evidence: dict,
    *,
    require_current_identity: bool,
) -> None:
    path = safe_path(
        bundle,
        evidence["manifest_artifact"],
        "Pro context manifest",
        required=True,
    )
    if path.suffix != ".json":
        raise StateError("Pro context manifest must be JSON")
    if (
        hashlib.sha256(path.read_bytes()).hexdigest()
        != evidence["manifest_artifact_digest"]
    ):
        raise StateError("Pro context manifest artifact digest mismatch")
    try:
        manifest = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise StateError(f"invalid Pro context manifest: {error}") from error
    if not isinstance(manifest, dict) or manifest.get("schema") != (
        "chatgpt-pro-feature-planner/context-manifest"
    ):
        raise StateError("Pro context manifest has an unsupported schema")
    expected = {
        "repository_slug": evidence["repository"],
        "branch": evidence["source_branch"],
        "local_head": evidence["generated_source_commit"],
        "provenance_digest": evidence["manifest_digest"],
    }
    if any(manifest.get(field) != value for field, value in expected.items()):
        raise StateError("Pro context manifest binding is stale")
    paths = manifest.get("paths")
    if not isinstance(paths, list) or any(
        not isinstance(record, dict) or record.get("source_route") == "blocked"
        for record in paths
    ):
        raise StateError("Pro context manifest contains unavailable required sources")
    try:
        source_inventory = [
            {field: record[field] for field in SOURCE_INVENTORY_FIELDS}
            for record in paths
        ]
        source_inventory_digest = manifest["source_inventory_digest"]
        remote_branch = manifest["remote_branch"]
        provenance = {
            "schema": "chatgpt-pro-feature-planner/provenance",
            "repository_slug": manifest["repository_slug"],
            "branch": manifest["branch"],
            "local_head": manifest["local_head"],
            "remote_branch": {
                field: remote_branch[field]
                for field in ("mode", "sha", "verified", "error")
            },
            "exact_local_head_is_verified_remote_head": manifest[
                "exact_local_head_is_verified_remote_head"
            ],
            "source_inventory_digest": source_inventory_digest,
        }
    except (KeyError, TypeError) as error:
        raise StateError(
            "Pro context manifest lacks canonical provenance inventory fields"
        ) from error
    if source_inventory_digest != canonical_digest(source_inventory):
        raise StateError("Pro context manifest source inventory digest mismatch")
    if manifest["provenance_digest"] != canonical_digest(provenance):
        raise StateError("Pro context manifest provenance digest mismatch")
    try:
        manifest_paths = [
            repo_path_value(record["path"], "Pro context manifest source path")
            for record in paths
        ]
    except (KeyError, TypeError) as error:
        raise StateError("Pro context manifest source path is malformed") from error
    manifest_path_set = set(manifest_paths)
    prior_artifact_paths = {
        repository_relative_source_path(bundle, artifact)
        for artifact in planning_artifact_paths(state)
    }
    if not manifest_path_set.isdisjoint(prior_artifact_paths):
        raise StateError("Pro context manifest contains prior planning artifacts")
    if not require_current_identity:
        return
    approved = approved_source_inventory(bundle, state)
    expected_paths = {
        repository_relative_source_path(bundle, record["path"])
        for record in approved
    }
    if len(manifest_paths) != len(manifest_path_set) or not expected_paths.issubset(
        manifest_path_set
    ):
        raise StateError(
            "Pro context manifest membership omits or duplicates current approved sources"
        )
    remote_verified = remote_branch.get("verified")
    exact_remote_head = manifest.get("exact_local_head_is_verified_remote_head")
    if type(remote_verified) is not bool or type(exact_remote_head) is not bool:
        raise StateError("Pro context manifest remote provenance is malformed")
    derived_exact_remote_head = bool(
        remote_verified and remote_branch.get("sha") == manifest["local_head"]
    )
    if exact_remote_head != derived_exact_remote_head:
        raise StateError("Pro context manifest remote provenance is incoherent")
    approved_digests = {
        repository_relative_source_path(bundle, record["path"]): record["sha256"]
        for record in approved
    }
    records = dict(zip(manifest_paths, paths, strict=True))
    for source_path in sorted(manifest_path_set):
        local = repository_regular_file(source_path, "Pro context manifest source")
        status = git_output(
            ["status", "--porcelain=v1", "--", source_path], check=False
        )
        tracked = bool(git_output(
            ["ls-files", "--error-unmatch", "--", source_path], check=False
        ))
        head_blob = git_output(
            ["rev-parse", f"{manifest['local_head']}:{source_path}"], check=False
        ) or None
        dirty = bool(status)
        if (
            manifest["repository_slug"]
            and remote_verified
            and exact_remote_head
            and head_blob is not None
            and not dirty
        ):
            route = "github"
            reason = "exact_clean_path_at_verified_remote_commit"
        else:
            route = "local_inline_or_upload"
            if not manifest["repository_slug"]:
                reason = "remote_is_not_github_com"
            elif not remote_verified:
                reason = "remote_visibility_not_live_verified"
            elif not exact_remote_head:
                reason = "local_head_not_remote_branch_head"
            elif head_blob is None:
                reason = "path_not_committed_at_local_head"
            else:
                reason = "working_copy_differs_from_local_head"
        expected_identity = {
            "path": source_path,
            "exists": True,
            "is_file": True,
            "tracked": tracked,
            "committed_at_head": head_blob is not None,
            "working_copy_dirty": dirty,
            "head_blob": head_blob,
            "working_sha256": approved_digests.get(source_path) or hashlib.sha256(
                local.read_bytes()
            ).hexdigest(),
            "working_bytes": local.stat().st_size,
            "source_route": route,
            "reason": reason,
        }
        record = records[source_path]
        try:
            actual_identity = {
                field: record[field] for field in expected_identity
            }
        except KeyError as error:
            raise StateError(
                "Pro context manifest lacks current local source identity"
            ) from error
        if actual_identity != expected_identity:
            raise StateError(
                f"Pro context manifest source identity is stale: {source_path}"
            )


def context_manifest_source_digest(
    bundle: Path,
    state: dict,
    evidence: dict,
    source: str,
) -> str | None:
    validate_context_manifest_binding(
        bundle,
        state,
        evidence,
        require_current_identity=False,
    )
    path = safe_path(
        bundle,
        evidence["manifest_artifact"],
        "Pro context manifest",
        required=True,
    )
    manifest = json.loads(path.read_text(encoding="utf-8"))
    matches = [
        record for record in manifest["paths"]
        if record["path"] == source
    ]
    if len(matches) != 1:
        return None
    digest = matches[0].get("working_sha256")
    return digest if isinstance(digest, str) else None


def validate_pro_response_text(
    response: str,
    *,
    response_digest: str,
    manifest_digest: str,
) -> dict[str, object]:
    if not response.strip():
        raise ProResponseContractError(
            "semantic_response_unusable",
            "captured Pro response must not be empty",
        )
    return {
        "result": "valid",
        "response_digest": response_digest,
        "manifest_digest": manifest_digest,
    }


def classify_pro_response_recovery(
    bundle: Path,
    state: dict,
    evidence: dict,
    *,
    semantic_unusable: bool = False,
) -> dict[str, object]:
    validate_context_manifest_binding(
        bundle,
        state,
        evidence,
        require_current_identity=True,
    )
    answer = safe_path(
        bundle,
        evidence["answer_artifact"],
        "Pro answer artifact",
        required=True,
        markdown=True,
    )
    original = answer.read_bytes()
    if hashlib.sha256(original).hexdigest() != evidence["response_digest"]:
        raise StateError("Pro answer artifact digest mismatch")
    try:
        response = original.decode("utf-8")
    except UnicodeDecodeError as error:
        raise StateError(
            f"Pro answer artifact is not UTF-8 Markdown: {error}"
        ) from error
    try:
        validate_pro_response_text(
            response,
            response_digest=evidence["response_digest"],
            manifest_digest=evidence["manifest_digest"],
        )
    except ProResponseContractError as error:
        return {
            "recovery_class": "restart_or_fail_closed",
            "reason_code": error.reason_code,
            "message": str(error),
        }
    if semantic_unusable:
        return {
            "recovery_class": "restart_or_fail_closed",
            "reason_code": "semantic_response_unusable",
            "message": "Root classified the captured response as unable to support planning",
        }
    return {"recovery_class": "valid"}


def validate_pro_response_contract(
    bundle: Path,
    state: dict,
    evidence: dict,
) -> dict[str, object]:
    validate_context_manifest_binding(
        bundle,
        state,
        evidence,
        require_current_identity=True,
    )
    answer = safe_path(
        bundle,
        evidence["answer_artifact"],
        "Pro acceptance artifact",
        required=True,
        markdown=True,
    )
    try:
        original_response = answer.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as error:
        raise StateError(f"Pro answer artifact is not UTF-8 Markdown: {error}") from error
    return validate_pro_response_text(
        original_response,
        response_digest=evidence["response_digest"],
        manifest_digest=evidence["manifest_digest"],
    )


def validate_planning_evidence(
    bundle: Path,
    state: dict,
    *,
    allow_specification_drift: bool = False,
) -> None:
    planning = state["planning"]
    current_digest = planning["current_specification_digest"]
    actual_digest = (
        completion_fact_digests(bundle, state)[1]
        if current_digest is not None and state["phase"] != "discuss"
        else None
    )
    if not allow_specification_drift and actual_digest is not None:
        if current_digest != actual_digest:
            raise StateError(
                "current specification digest is stale; record Pro applicability"
            )
    for evidence_index, evidence in enumerate(planning["evidence"]):
        validate_context_manifest_binding(
            bundle,
            state,
            evidence,
            require_current_identity=(
                evidence_index == len(planning["evidence"]) - 1
                and evidence["generated_for_digest"] == current_digest
                and current_digest == actual_digest
                and state["phase"] != "complete"
            ),
        )
        answer = safe_path(
            bundle,
            evidence["answer_artifact"],
            "Pro answer artifact",
            required=True,
            markdown=True,
        )
        if hashlib.sha256(answer.read_bytes()).hexdigest() != evidence[
            "response_digest"
        ]:
            raise StateError("Pro answer artifact digest mismatch")
        if evidence["repair_artifact"] is not None:
            repair = safe_path(
                bundle,
                evidence["repair_artifact"],
                "Pro repair artifact",
                required=True,
                markdown=True,
            )
            if hashlib.sha256(repair.read_bytes()).hexdigest() != evidence[
                "repair_digest"
            ]:
                raise StateError("Pro repair artifact digest mismatch")
        for record in evidence["applicability"]:
            _, digest = applicability_receipt_value(
                bundle,
                state,
                evidence,
                record,
                require_current_binding=(
                    not allow_specification_drift
                    and record["to_digest"] == current_digest
                    and record["to_source_commit"]
                    == planning["current_source_commit"]
                ),
            )
            if digest != record["receipt_digest"]:
                raise StateError("Pro applicability receipt digest mismatch")
    if planning["pro_primary_waiver"] is not None and not allow_specification_drift:
        require_current_pro_primary_waiver(state, bundle)
    blind = planning["blind_completeness"]
    admitted_local_delivery = has_admitted_local_plan_authority(state)
    if (
        blind is not None
        and not allow_specification_drift
        and not admitted_local_delivery
    ):
        _, binding = blind_completeness_receipt_value(
            bundle, state, blind["receipt"]
        )
        if binding != blind:
            raise StateError("blind completeness audit receipt digest mismatch")


def has_admitted_local_plan_authority(state: dict) -> bool:
    waiver = state["planning"]["pro_primary_waiver"]
    return (
        state["phase"] == "delivery"
        and waiver is not None
        and waiver["disposition"] != "fresh_primary"
    )


def validated_local_plan_continuation(
    bundle: Path,
    state: dict,
    disposition: str,
    specification_digest: str,
    source_commit: str,
) -> tuple[dict, str]:
    continuation_path = safe_path(
        bundle,
        "discovery/planning-continuation.json",
        "planning continuation",
        required=True,
    )
    try:
        validation = subprocess.run(
            [
                sys.executable,
                str(PRO_LIFECYCLE),
                "validate-continuation",
                "--planning-continuation",
                str(continuation_path),
            ],
            cwd=REPO,
            text=True,
            capture_output=True,
            check=False,
            timeout=20,
        )
        continuation = json.loads(continuation_path.read_text(encoding="utf-8"))
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError) as error:
        raise StateError("planning continuation authority is invalid") from error
    if validation.returncode != 0 or not isinstance(continuation, dict):
        raise StateError("planning continuation authority is invalid")
    if (
        continuation.get("work_kind") != state["work_kind"]
        or continuation.get("work_id") != state["work_id"]
        or Path(str(continuation.get("work_bundle", ""))).expanduser().absolute()
        != bundle
    ):
        raise StateError("planning continuation authority is bound elsewhere")
    if disposition == "captureless_pro_recovery":
        if (
            continuation.get("revision") != 0
            or continuation.get("passes") != []
            or continuation.get("parent_cursor") is not None
        ):
            raise StateError(
                "captureless local Plan recovery requires zero-pass Pro continuation"
            )
    elif disposition == "source_access_recovery":
        passes = continuation.get("passes")
        cursor = continuation.get("parent_cursor")
        predecessor = passes[0] if isinstance(passes, list) and passes else None
        if (
            continuation.get("revision") != 2
            or not isinstance(predecessor, dict)
            or predecessor.get("status") != "invalidated"
            or not isinstance(predecessor.get("invalidation"), dict)
            or predecessor["invalidation"].get("reason_code")
            != "semantic_response_unusable"
            or predecessor.get("specification_digest") != specification_digest
            or predecessor.get("source_commit") != source_commit
            or not isinstance(cursor, dict)
            or cursor.get("stage") != "await_invalid_response_successor"
        ):
            raise StateError(
                "source-access local Plan recovery requires the exact bounded "
                "invalidated primary trajectory"
            )
    else:
        raise StateError("local Plan recovery disposition is invalid")
    return continuation, hashlib.sha256(continuation_path.read_bytes()).hexdigest()


def require_current_pro_primary_waiver(state: dict, bundle: Path) -> dict:
    planning = state["planning"]
    waiver = planning["pro_primary_waiver"]
    if waiver is None:
        raise StateError("Plan-to-Delivery has no Pro primary waiver")
    evidence = planning["evidence"]
    blind = planning["blind_completeness"]
    current_plan_digest = canonical_plan_digest(bundle, state)
    disposition = waiver["disposition"]
    if disposition != "fresh_primary":
        expected = {
            "active_response_digest": None,
            "specification_digest": planning["current_specification_digest"],
            "source_commit": planning["current_source_commit"],
            "plan_digest": current_plan_digest,
            "blind_receipt_digest": None if blind is None else blind["receipt_digest"],
        }
        stale_fields = [
            field
            for field, value in expected.items()
            if waiver[field] != value
        ]
        if planning["active_response_digest"] is not None:
            stale_fields.append("planning.active_response_digest")
        if planning["evidence"]:
            stale_fields.append("planning.evidence")
        if stale_fields:
            raise StateError(
                "local Plan recovery authority is stale: "
                + ", ".join(stale_fields)
            )
        _, continuation_digest = validated_local_plan_continuation(
            bundle,
            state,
            disposition,
            planning["current_specification_digest"],
            planning["current_source_commit"],
        )
        if waiver["continuation_digest"] != continuation_digest:
            raise StateError("local Plan recovery continuation is stale")
        require_current_approved_sources_at_commit(
            bundle,
            state,
            planning["current_source_commit"],
            "local Plan recovery source commit",
        )
        requirement = planning["blind_requirement"]
        if (
            requirement
            != {
                "requirement": "required_local_plan_recovery",
                "plan_digest": current_plan_digest,
            }
            or blind is None
        ):
            raise StateError("local Plan recovery lacks its required blind authority")
        if state["phase"] == "delivery":
            _, receipt_digest = typed_receipt(
                bundle,
                blind["receipt"],
                "admitted local Plan blind completeness audit",
                BLIND_COMPLETENESS_RECEIPT_FIELDS,
            )
            if receipt_digest != blind["receipt_digest"]:
                raise StateError("local Plan recovery blind receipt is stale")
        else:
            _, binding = blind_completeness_receipt_value(
                bundle, state, blind["receipt"]
            )
            if binding != blind:
                raise StateError("local Plan recovery blind receipt is stale")
        return waiver
    lineage = terminal_fresh_pro_primary_lineage(planning)
    expected = {
        "active_response_digest": planning["active_response_digest"],
        "specification_digest": planning["current_specification_digest"],
        "source_commit": planning["current_source_commit"],
        "plan_digest": current_plan_digest,
        "blind_receipt_digest": (
            None if blind is None else blind["receipt_digest"]
        ),
    }
    if (
        not evidence
        or planning["active_response_digest"] is None
        or evidence[-1]["response_digest"] != planning["active_response_digest"]
        or lineage is None
        or any(waiver[field] != value for field, value in expected.items())
    ):
        raise StateError("Pro primary waiver is stale")
    _active, latest = lineage
    require_descendant_commit(
        latest["to_source_commit"],
        planning["current_source_commit"],
        "Pro primary waiver final source commit",
    )
    require_current_approved_sources_at_commit(
        bundle,
        state,
        planning["current_source_commit"],
        "Pro primary waiver final source commit",
    )
    requirement = planning["blind_requirement"]
    if (
        requirement != {
            "requirement": "required_user_requested",
            "plan_digest": current_plan_digest,
        }
        or blind is None
    ):
        raise StateError("Pro primary waiver lacks its required blind authority")
    _, binding = blind_completeness_receipt_value(bundle, state, blind["receipt"])
    if binding != blind:
        raise StateError("Pro primary waiver blind receipt is stale")
    return evidence[-1]

def require_existing_accepted_pro_evidence(state: dict, bundle: Path) -> dict:
    validate_planning_evidence(bundle, state)
    planning = state["planning"]
    if not planning["evidence"] or planning["active_response_digest"] is None:
        raise StateError("required-by-intent amendment requires accepted Pro evidence")
    evidence = planning["evidence"][-1]
    if (
        evidence["accepted_for_digest"]
        != planning["current_specification_digest"]
        or evidence["accepted_source_commit"] != planning["current_source_commit"]
        or evidence["response_digest"] != planning["active_response_digest"]
        or completion_fact_digests(bundle, state)[1]
        != planning["current_specification_digest"]
    ):
        raise StateError(
            "required-by-intent amendment changed or detached accepted Pro evidence"
        )
    return evidence


def current_required_by_intent_authority(state: dict, bundle: Path) -> dict | None:
    if state["phase"] != "plan":
        return None
    candidates = []
    for item in state["slices"]:
        if not item["revision_history"]:
            continue
        latest = item["revision_history"][-1]
        if (
            latest["reauthorization_disposition"]
            == "required_by_intent_scope_expansion"
            and item["revision_epoch"] == latest["revision_epoch"] + 1
            and item["status"] == "pending"
        ):
            candidates.append(item)
    if len(candidates) != 1:
        return None
    binding = state["planning"]["blind_requirement"]
    if (
        binding is None
        or binding["requirement"] != "not_required_exact_pro_plan"
        or binding["plan_digest"] != canonical_plan_digest(bundle, state)
    ):
        return None
    return require_existing_accepted_pro_evidence(state, bundle)


def validate_continuation_binding(
    bundle: Path,
    evidence: dict,
    current: dict,
) -> None:
    repaired = evidence["contract_disposition"] in {
        "repaired_addendum",
        "repaired_replacement",
    }
    lifecycle_artifact = (
        evidence["repair_artifact"] if repaired else evidence["answer_artifact"]
    )
    lifecycle_digest = (
        evidence["repair_digest"] if repaired else evidence["response_digest"]
    )
    if current.get("response_digest") != lifecycle_digest:
        raise StateError("planning continuation is stale or digest-mismatched")
    lifecycle_path = safe_path(
        bundle,
        lifecycle_artifact,
        "planning continuation producer evidence",
        required=True,
        markdown=True,
    )
    lifecycle_bytes = lifecycle_path.read_bytes()
    if hashlib.sha256(lifecycle_bytes).hexdigest() != lifecycle_digest:
        raise StateError("planning continuation producer evidence digest mismatch")
    response_evidence = safe_path(
        bundle,
        current.get("response_evidence", ""),
        "planning continuation response evidence",
        required=True,
        markdown=True,
    )
    response_evidence_bytes = response_evidence.read_bytes()
    if (
        hashlib.sha256(response_evidence_bytes).hexdigest()
        != current.get("response_evidence_digest")
        or response_evidence_bytes != lifecycle_bytes
    ):
        raise StateError("planning continuation response evidence digest mismatch")


def require_current_pro_evidence(
    state: dict,
    bundle: Path,
    *,
    allow_admitted_delivery_authority: bool = False,
) -> dict:
    amendment_authority = current_required_by_intent_authority(state, bundle)
    if amendment_authority is not None:
        return amendment_authority
    waiver_evidence = None
    if state["planning"]["pro_primary_waiver"] is not None:
        waiver_evidence = require_current_pro_primary_waiver(state, bundle)
        if state["planning"]["pro_primary_waiver"]["disposition"] != "fresh_primary":
            return waiver_evidence
    continuation_path = safe_path(
        bundle,
        "discovery/planning-continuation.json",
        "planning continuation",
        required=True,
    )
    try:
        lifecycle_validation = subprocess.run(
            [
                sys.executable,
                str(PRO_LIFECYCLE),
                "validate-continuation",
                "--planning-continuation",
                str(continuation_path),
            ],
            cwd=REPO,
            text=True,
            capture_output=True,
            check=False,
            timeout=20,
        )
    except (OSError, subprocess.SubprocessError) as error:
        raise StateError("planning continuation authority is invalid") from error
    if lifecycle_validation.returncode != 0:
        raise StateError("planning continuation authority is invalid")
    planning = state["planning"]
    active = planning["active_response_digest"]
    if active is None:
        raise StateError("Plan-to-Delivery requires ChatGPT Pro planning evidence")
    evidence = planning["evidence"][-1]
    if waiver_evidence is None and not allow_admitted_delivery_authority and (
        evidence["accepted_for_digest"] != planning["current_specification_digest"]
        or evidence["accepted_source_commit"] != planning["current_source_commit"]
    ):
        raise StateError(
            "Plan-to-Delivery requires a fresh ChatGPT Pro primary for the current "
            "specification"
        )
    if evidence["contract_disposition"] not in CONTRACT_DISPOSITIONS:
        raise StateError("Plan-to-Delivery has unresolved Pro response contract gaps")
    try:
        continuation = json.loads(continuation_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise StateError("planning continuation is unreadable") from error
    if not isinstance(continuation, dict) or continuation.get("schema") != (
        "planning-continuation"
    ):
        raise StateError("planning continuation authority is invalid")
    if (
        continuation.get("work_kind") != state["work_kind"]
        or continuation.get("work_id") != state["work_id"]
        or Path(str(continuation.get("work_bundle", ""))).expanduser().absolute()
        != bundle
        or continuation.get("repository") != evidence["repository"]
    ):
        raise StateError("planning continuation authority is bound elsewhere")
    if waiver_evidence is not None:
        return waiver_evidence
    if allow_admitted_delivery_authority:
        # Delivery already consumed its one-shot waiver. Revalidate the durable
        # admitted evidence without reselecting the later transient cursor.
        validate_planning_evidence(bundle, state)
        if evidence["response_digest"] != active:
            raise StateError("active Pro evidence is stale or digest-mismatched")
        for item in continuation["passes"]:
            response_evidence = safe_path(
                bundle,
                item["response_evidence"],
                "planning continuation response evidence",
                required=True,
                markdown=True,
            )
            if hashlib.sha256(response_evidence.read_bytes()).hexdigest() != item[
                "response_evidence_digest"
            ]:
                raise StateError(
                    "planning continuation response evidence digest mismatch"
                )
        return evidence
    current_id = continuation.get("current_pass_id")
    passes = continuation.get("passes")
    matching = (
        [
            item
            for item in passes
            if isinstance(item, dict)
            and item.get("consultation_id") == current_id
        ]
        if isinstance(passes, list)
        else []
    )
    cursor = continuation.get("parent_cursor")
    if (
        len(matching) != 1
        or not isinstance(cursor, dict)
        or cursor.get("consultation_id") != current_id
    ):
        raise StateError("planning continuation has no current consumed authority")
    current = matching[0]
    consultation_identity = {
        "work_kind": state["work_kind"],
        "work_id": state["work_id"],
        "repository": current.get("repository"),
        "specification_digest": current.get("specification_digest"),
        "source_branch": current.get("source_branch"),
        "source_commit": current.get("source_commit"),
        "prompt_digest": current.get("prompt_digest"),
    }
    if current.get("attempt_ordinal", 1) != 1:
        consultation_identity["attempt_ordinal"] = current.get(
            "attempt_ordinal"
        )
    canonical_consultation_id = hashlib.sha256(
        json.dumps(
            consultation_identity, sort_keys=True, separators=(",", ":")
        ).encode()
    ).hexdigest()
    pass_identity = {
        "work_kind": state["work_kind"],
        "work_id": state["work_id"],
        **{
            key: current.get(key)
            for key in (
                "repository",
                "consultation_id",
                "specification_digest",
                "source_branch",
                "source_commit",
                "prompt_digest",
                "conversation_ref_digest",
                "conversation_generation_id",
                "conversation_binding_digest",
                "conversation_origin_anchor_digest",
                "invoking_automation_ref_digest",
            )
        },
    }
    canonical_origin_anchor_digest = hashlib.sha256(
        json.dumps(
            {
                "consultation_id": current.get("consultation_id"),
                "conversation_ref_digest": current.get(
                    "conversation_ref_digest"
                ),
                "conversation_generation_id": current.get(
                    "conversation_generation_id"
                ),
                "binding_result_digest": current.get(
                    "conversation_binding_digest"
                ),
            },
            sort_keys=True,
            separators=(",", ":"),
        ).encode()
    ).hexdigest()
    canonical_pass_id = hashlib.sha256(
        json.dumps(pass_identity, sort_keys=True, separators=(",", ":")).encode()
    ).hexdigest()
    if (
        current_id != canonical_consultation_id
        or current.get("consultation_id") != canonical_consultation_id
        or current.get("conversation_origin_anchor_digest")
        != canonical_origin_anchor_digest
        or current.get("pass_id") != canonical_pass_id
    ):
        raise StateError("planning continuation identity is noncanonical")
    repaired = evidence["contract_disposition"] in {
        "repaired_addendum",
        "repaired_replacement",
    }
    authoritative_artifact = (
        evidence["repair_artifact"] if repaired else evidence["answer_artifact"]
    )
    authoritative_digest = (
        evidence["repair_digest"] if repaired else evidence["response_digest"]
    )
    authoritative_path = safe_path(
        bundle,
        authoritative_artifact,
        "disposition-authoritative Pro evidence",
        required=True,
        markdown=True,
    )
    authoritative_bytes = authoritative_path.read_bytes()
    if hashlib.sha256(authoritative_bytes).hexdigest() != authoritative_digest:
        raise StateError("disposition-authoritative Pro evidence digest mismatch")
    if (
        current.get("status") != "consumed"
        or current.get("repository") != evidence["repository"]
        or current.get("source_branch") != evidence["source_branch"]
        or current.get("specification_digest")
        != evidence["generated_for_digest"]
        or current.get("source_commit") != evidence["generated_source_commit"]
    ):
        raise StateError("planning continuation is stale or digest-mismatched")
    validate_continuation_binding(bundle, evidence, current)
    return evidence

def require_current_blind_completeness(bundle: Path, state: dict) -> dict:
    binding = state["planning"]["blind_requirement"]
    if binding is None:
        raise StateError(
            "Plan-to-Delivery requires a typed blind completeness requirement"
        )
    if binding["plan_digest"] != canonical_plan_digest(bundle, state):
        raise StateError(
            "Plan-to-Delivery blind completeness requirement is stale against "
            "the current plan digest"
        )
    requirement = binding["requirement"]
    if requirement == "not_required_exact_pro_plan":
        if state["planning"]["blind_completeness"] is not None:
            raise StateError(
                "an exact complete Pro plan cannot carry a blind audit binding"
            )
        return {"requirement": requirement, "receipt": None}
    blind = state["planning"]["blind_completeness"]
    if blind is None:
        raise StateError(
            f"Plan-to-Delivery {requirement} requires a fresh CLEAN blind "
            "completeness audit"
        )
    _, binding = blind_completeness_receipt_value(
        bundle, state, blind["receipt"]
    )
    if binding != blind:
        raise StateError("Plan-to-Delivery blind completeness audit is stale")
    if blind_audit_nonquiescent_task_labels(state):
        raise StateError("Plan-to-Delivery requires descendant quiescence")
    return blind

def validate_evidence_epoch_chronology(state: dict) -> set[int]:
    epochs = observation_epochs(state)
    applicability_epochs: list[int] = []
    for evidence in state["planning"]["evidence"]:
        for record in evidence["applicability"]:
            applicability_epochs.append(record["epoch"])
    require_strict_epoch_chain(applicability_epochs, "planning applicability")
    blind = state["planning"]["blind_completeness"]
    if blind is not None:
        require_strict_epoch_chain(
            [*applicability_epochs, blind["epoch"]],
            "planning evidence",
        )
    for item in state["slices"]:
        revision_epochs: list[int] = []
        for revision in item["revision_history"]:
            if (
                revision["reauthorization_disposition"]
                in PRE_PR_REAUTHORIZATION_DISPOSITIONS
            ):
                revision_epochs.append(
                    revision["pre_pr_observation_epoch"]
                )
        require_strict_epoch_chain(
            revision_epochs,
            f"{item['id']} revision evidence",
        )
        freshness = item["terminal_freshness"]
        drift = item["premerge_drift"]
        if freshness is not None and drift is not None:
            require_strict_epoch_chain(
                [freshness["epoch"], drift["epoch"]],
                f"{item['id']} premerge evidence",
            )
        if item["merge_epoch"] is not None:
            predecessor_epochs = set(revision_epochs)
            for role in ("implementation", "review"):
                predecessor_epochs.update(task_observation_epochs(item, role))
            if freshness is not None:
                predecessor_epochs.add(freshness["epoch"])
            if drift is not None:
                predecessor_epochs.add(drift["epoch"])
            if predecessor_epochs:
                require_strict_epoch_chain(
                    [max(predecessor_epochs), item["merge_epoch"]],
                    f"{item['id']} merge evidence",
                )
    return epochs


def recorded_evidence_epochs(state: dict) -> set[int]:
    epochs = validate_evidence_epoch_chronology(state)
    for evidence in state["planning"]["evidence"]:
        for record in evidence["applicability"]:
            if record["epoch"] in epochs:
                raise StateError("evidence epoch is reused")
            epochs.add(record["epoch"])
    blind = state["planning"]["blind_completeness"]
    if blind is not None:
        if blind["epoch"] in epochs:
            raise StateError("evidence epoch is reused")
        epochs.add(blind["epoch"])
    for item in state["slices"]:
        for revision in item["revision_history"]:
            if (
                revision["reauthorization_disposition"]
                in PRE_PR_REAUTHORIZATION_DISPOSITIONS
            ):
                epoch = revision["pre_pr_observation_epoch"]
                if epoch in epochs:
                    raise StateError("evidence epoch is reused")
                epochs.add(epoch)
        if item["merge_epoch"] is not None:
            if item["merge_epoch"] in epochs:
                raise StateError("evidence epoch is reused")
            epochs.add(item["merge_epoch"])
        if item["premerge_drift"] is not None:
            epoch = item["premerge_drift"]["epoch"]
            if epoch in epochs:
                raise StateError("evidence epoch is reused")
            epochs.add(epoch)
    return epochs

def evidence_epochs(state: dict) -> set[int]:
    epochs = recorded_evidence_epochs(state)
    high_water = state["observation_epoch_high_water"]
    if high_water < max(epochs, default=0):
        raise StateError(
            "observation_epoch_high_water is behind recorded evidence"
        )
    if high_water > 0:
        epochs.add(high_water)
    return epochs

def validate_task_bindings(
    bundle: Path,
    state: dict,
    *,
    allow_authorization_drift: bool = False,
) -> None:
    items = slice_map(state)
    synchronized_parallel_carrier = terminal_snapshot_carrier(state)
    identifiers: dict[str, str] = {}
    for slice_id, item in items.items():
        persisted_premerge_drift_value(bundle, state, item)
        implementation = item["implementation_task"]
        review = item["review_task"]
        if is_authoritative_delivery_projection(item):
            if (
                implementation != empty_task()
                or review != empty_task()
                or item["task_history"]
            ):
                raise StateError(
                    f"{slice_id} projected delivery retained task ceremony"
                )
            continue
        history_by_role = {
            role: [entry["task"] for entry in item["task_history"] if entry["role"] == role]
            for role in ("implementation", "review")
        }
        for role in ("implementation", "review"):
            history = history_by_role[role]
            attempts = [task["attempt"] for task in history]
            if attempts != list(range(1, len(history) + 1)):
                raise StateError(f"{slice_id} {role} task history is not append-only")
            current_task = item[f"{role}_task"]
            expected_attempt = len(history) + 1
            if current_task["state"] == "unbound":
                if history:
                    raise StateError(f"{slice_id} {role} task history lost its current attempt")
            elif current_task["attempt"] != expected_attempt:
                raise StateError(f"{slice_id} {role} task attempt lineage has a gap")
        for role in ("implementation", "review"):
            for task, is_current in task_records(item, role):
                for field in (
                    "launch_marker", "thread_id", "client_thread_id", "task_worktree"
                ):
                    value = task[field]
                    if value is None:
                        continue
                    if field == "task_worktree" and value == REPO.as_posix():
                        raise StateError(
                            f"{slice_id} {role} task must use a distinct worktree"
                        )
                    owner = identifiers.get(value)
                    current = f"{slice_id}:{role}:{task['attempt']}:{field}"
                    if owner is not None:
                        raise StateError(
                            f"task identifier is shared by {owner} and {current}: {value}"
                        )
                    identifiers[value] = current
                if role == "implementation":
                    if task["companion_probe_digest"] is not None:
                        raise StateError(
                            f"{slice_id} implementation task cannot carry a review companion probe"
                        )
                    if any(task[field] is not None for field in REVIEW_PROOF_FIELDS):
                        raise StateError(
                            f"{slice_id} implementation task cannot carry review proof"
                        )
                elif task["snapshot_authorization"] is not None:
                    raise StateError(
                        f"{slice_id} review task cannot carry coordinator snapshot "
                        "authorization"
                    )
                elif task["state"] != "unbound" and task[
                    "companion_probe_digest"
                ] is None:
                    raise StateError(
                        f"{slice_id} review task requires a companion availability probe"
                    )
                if role == "review" and task["state"] != "unbound":
                    if any(task[field] is None for field in (
                        "companion_probe_receipt", "companion_probe_digest",
                        "companion_probe_epoch",
                    )):
                        raise StateError(
                            f"{slice_id} review task requires a typed companion probe"
                        )
                    probe, probe_digest = observation_receipt_value(
                        bundle, state, item, role, task, kind="companion_probe",
                        relative=task["companion_probe_receipt"],
                    )
                    if (
                        probe_digest != task["companion_probe_digest"]
                        or probe["observationEpoch"] != task["companion_probe_epoch"]
                    ):
                        raise StateError(f"{slice_id} companion probe binding is stale")
                if (
                    role == "implementation"
                    and task["state"] == "superseded"
                    and (task["thread_id"] is not None or task["client_thread_id"] is not None)
                    and task["branch_release_digest"] is None
                ):
                    raise StateError(
                        f"{slice_id} superseded implementation requires branch-release proof"
                    )
                if is_current and task["state"] not in {"unbound", "superseded"}:
                    matching_authorization = next(
                        (
                            entry
                            for entry in (
                                state["task_authorization"] or {"entries": []}
                            )["entries"]
                            if entry["slice_id"] == slice_id
                            and entry["role"] == role
                        ),
                        None,
                    )
                    expected = (
                        task["authorization_digest"]
                        if matching_authorization is None
                        and allow_authorization_drift
                        else authorization_entry(state, slice_id, role)[
                            "entry_digest"
                        ]
                    )
                    if (
                        task["authorization_digest"] != expected
                        and not allow_authorization_drift
                    ):
                        raise StateError(
                            f"{slice_id} {role} task roster binding is stale"
                        )
                    if task["attempt"] > 1 and not allow_authorization_drift:
                        allowed = {
                            text_digest(value)
                            for value in authorized_replacement_predicates(
                                bundle, state, slice_id, role
                            )
                        }
                        if task["replacement_predicate_digest"] not in allowed:
                            raise StateError(
                                f"{slice_id} {role} replacement predicate is not authorized"
                            )
                if task["attempt"] > 1:
                    prior = next(
                        (
                            candidate for candidate in history_by_role[role]
                            if candidate["attempt"] == task["attempt"] - 1
                        ),
                        None,
                    )
                    observation, observation_digest = observation_receipt_value(
                        bundle, state, item, role, task,
                        kind="replacement_predicate",
                        relative=task["replacement_observation_receipt"],
                        prior_task=prior,
                        allow_authorization_drift=(
                            is_current and allow_authorization_drift
                        ),
                    )
                    if (
                        observation_digest != task["replacement_observation_digest"]
                        or observation["observationEpoch"]
                        != task["replacement_observation_epoch"]
                    ):
                        raise StateError(f"{slice_id} replacement observation binding is stale")
                if task["state"] == "superseded":
                    stop, stop_digest = observation_receipt_value(
                        bundle, state, item, role, task, kind="stop",
                        relative=task["stop_proof_receipt"],
                    )
                    if (
                        stop_digest != task["stop_proof_digest"]
                        or stop["observationEpoch"] != task["stop_proof_epoch"]
                    ):
                        raise StateError(f"{slice_id} stop proof binding is stale")
                    if (
                        task["thread_id"] is not None or task["client_thread_id"] is not None
                    ):
                        release, release_digest = observation_receipt_value(
                            bundle, state, item, role, task, kind="branch_release",
                            relative=task["branch_release_receipt"],
                        )
                        if (
                            release_digest != task["branch_release_digest"]
                            or release["observationEpoch"] != task["branch_release_epoch"]
                        ):
                            raise StateError(f"{slice_id} branch-release binding is stale")
                if role == "implementation" and task["state"] in {"quiescent", "superseded"}:
                    if task["implementation_receipt"] is not None:
                        terminal = implementation_receipt_value(
                            bundle, state, item, task, persisted=True
                        )
                        if any(task[field] != value for field, value in terminal.items()):
                            raise StateError(
                                f"{slice_id} implementation terminal receipt is stale"
                            )
                    elif task["state"] == "quiescent":
                        raise StateError(
                            f"{slice_id} quiescent implementation lacks terminal proof"
                        )
                    if task["state"] == "quiescent":
                        retains_branch = implementation_terminal_retains_branch(
                            bundle, task["implementation_receipt"]
                        )
                        has_release = task["branch_release_receipt"] is not None
                        if retains_branch and has_release:
                            raise StateError(
                                f"{slice_id} retained-owner terminal cannot "
                                "carry branch-release proof"
                            )
                        if retains_branch:
                            continue
                        if not has_release:
                            raise StateError(
                                f"{slice_id} ordinary implementation terminal "
                                "requires branch-release proof"
                            )
                        release, release_digest = observation_receipt_value(
                            bundle, state, item, role, task, kind="branch_release",
                            relative=task["branch_release_receipt"],
                        )
                        if (
                            release_digest != task["branch_release_digest"]
                            or release["observationEpoch"] != task["branch_release_epoch"]
                        ):
                            raise StateError(f"{slice_id} branch-release binding is stale")
                if role == "review" and task["state"] == "blocked":
                    release_fields = (
                        task["branch_release_receipt"],
                        task["branch_release_digest"],
                        task["branch_release_epoch"],
                    )
                    if any(value is not None for value in release_fields):
                        if any(value is None for value in release_fields):
                            raise StateError(
                                f"{slice_id} blocked review branch-release proof is incomplete"
                            )
                        release, release_digest = observation_receipt_value(
                            bundle,
                            state,
                            item,
                            role,
                            task,
                            kind="branch_release",
                            relative=task["branch_release_receipt"],
                        )
                        if (
                            release_digest != task["branch_release_digest"]
                            or release["observationEpoch"]
                            != task["branch_release_epoch"]
                        ):
                            raise StateError(
                                f"{slice_id} blocked review branch-release binding is stale"
                            )
                if task["head_adoption_receipt"] is not None:
                    if role != "review":
                        raise StateError(
                            f"{slice_id} implementation cannot carry review head adoption"
                        )
                    adoption, adoption_digest = review_head_adoption_receipt_value(
                        bundle,
                        state,
                        item,
                        task,
                        task["head_adoption_receipt"],
                        persisted=True,
                    )
                    if (
                        adoption_digest != task["head_adoption_digest"]
                        or adoption["observationEpoch"]
                        != task["head_adoption_epoch"]
                    ):
                        raise StateError(
                            f"{slice_id} review head-adoption binding is stale"
                        )
                elif (
                    role == "review"
                    and task["head_adoption_terminal_lineage"]
                ):
                    review_head_adoption_lineage_tip(
                        bundle,
                        state,
                        item,
                        task,
                        None,
                        f"{slice_id} ordinary review",
                    )
                if task["branch_attachment_receipt"] is not None:
                    if role == "review" and receipt_schema(
                        bundle,
                        task["branch_attachment_receipt"],
                        f"{slice_id} review attachment",
                    ) == "spec-work-review-lease-terminal":
                        attachment, attachment_digest = review_lease_terminal_value(
                            bundle,
                            state,
                            item,
                            task,
                            task["branch_attachment_receipt"],
                            target=(
                                "clean"
                                if task["review_receipt"] is not None
                                else "blocked"
                            ),
                            review_receipt=task["review_receipt"],
                            persisted=True,
                        )
                    elif role == "review":
                        attachment, attachment_digest = git_binding_receipt_value(
                            bundle, state, item, role, task,
                            kind="review_attachment",
                            relative=task["branch_attachment_receipt"],
                        )
                    else:
                        implementation_kind = receipt_kind(
                            bundle,
                            task["branch_attachment_receipt"],
                            f"{slice_id} implementation attachment",
                        )
                        if implementation_kind not in {
                            "implementation_attachment",
                            "implementation_pr_adoption",
                        }:
                            raise StateError(
                                f"{slice_id} implementation attachment has "
                                "an unsupported kind"
                            )
                        attachment, attachment_digest = git_binding_receipt_value(
                            bundle, state, item, role, task,
                            kind=implementation_kind,
                            relative=task["branch_attachment_receipt"],
                            persisted=(
                                implementation_kind == "implementation_pr_adoption"
                            ),
                        )
                    if (
                        attachment_digest != task["branch_attachment_digest"]
                        or attachment["observationEpoch"]
                        != task["branch_attachment_epoch"]
                    ):
                        raise StateError(
                            f"{slice_id} branch-attachment binding is stale"
                        )
                review_proof = [task[field] for field in REVIEW_PROOF_FIELDS]
                if role == "review" and task["state"] == "clean":
                    if any(value is None for value in review_proof):
                        raise StateError(f"{slice_id} clean review proof is incomplete")
                    if review_clean_receipt_value(bundle, state, item, task) != {
                        field: task[field] for field in REVIEW_PROOF_FIELDS
                    }:
                        raise StateError(f"{slice_id} clean review receipt digest is stale")
                    if is_current:
                        require_review_dependency_quiescence(items, item)
                elif role == "review" and task["state"] in {"blocked", "superseded"}:
                    if any(value is not None for value in review_proof) and any(
                        value is None for value in review_proof
                    ):
                        raise StateError(f"{slice_id} historical review proof is partial")
                    if all(value is not None for value in review_proof):
                        if review_clean_receipt_value(bundle, state, item, task) != {
                            field: task[field] for field in REVIEW_PROOF_FIELDS
                        }:
                            raise StateError(
                                f"{slice_id} historical review receipt digest is stale"
                            )
                elif role == "review" and any(value is not None for value in review_proof):
                    raise StateError(f"{slice_id} non-clean review task cannot carry clean proof")
        if implementation["state"] in {
            "prepared", "authorized", "active", "quiescent"
        }:
            if item["plan_checkpoint_sha"] is None:
                raise StateError(
                    f"{slice_id} launched implementation requires a plan checkpoint"
                )
        if implementation["state"] == "authorized":
            if item["revision_epoch"] < 2:
                raise StateError(
                    f"{slice_id} authorized implementation requires a resumed revision"
                )
            pre_pr_authorized = (
                bool(item["revision_history"])
                and item["revision_history"][-1]["reauthorization_disposition"]
                in PRE_PR_REAUTHORIZATION_DISPOSITIONS
            )
            if pre_pr_authorized:
                if (
                    item["replacement_lineage"] is not None
                    or item["pr"] is not None
                    or item["head_sha"] is not None
                ):
                    raise StateError(
                        f"{slice_id} pre-PR authorization cannot retain PR lineage"
                    )
            elif item["replacement_lineage"] is None:
                raise StateError(
                    f"{slice_id} authorized implementation requires retained PR lineage"
                )
            if (
                not pre_pr_authorized
                and implementation["bound_sha"]
                != item["replacement_lineage"]["start_sha"]
            ):
                raise StateError(
                    f"{slice_id} authorized implementation is stale against its PR head"
                )
        if (
            implementation["state"] == "prepared"
            and implementation["bound_sha"] != expected_start_sha(item)
        ):
            raise StateError(
                f"{slice_id} prepared implementation is stale against its exact START SHA"
            )
        if implementation["state"] == "active" and implementation["attempt"] == 1:
            if item["revision_epoch"] == 1:
                adopted = (
                    implementation["branch_attachment_receipt"] is not None
                    and receipt_kind(
                        bundle,
                        implementation["branch_attachment_receipt"],
                        f"{slice_id} initial implementation attachment",
                    ) == "implementation_pr_adoption"
                )
                synchronized_carrier = (
                    slice_id == synchronized_parallel_carrier
                    and item["status"] == "pr_open"
                    and item["base_sha"] == state["observed_main_sha"]
                )
                if (
                    implementation["bound_sha"] != item["base_sha"]
                    and not adopted
                    and not synchronized_carrier
                ):
                    raise StateError(
                        f"{slice_id} initial implementation is stale against its base SHA"
                    )
        if (
            implementation["state"] == "active"
            and item["revision_epoch"] > 1
            and implementation["branch_attachment_digest"] is None
            and not (
                item["revision_history"]
                and item["revision_history"][-1][
                    "reauthorization_disposition"
                ] in PRE_PR_REAUTHORIZATION_DISPOSITIONS
            )
        ):
            raise StateError(
                f"{slice_id} resumed implementation lacks branch-attachment proof"
            )
        if implementation["state"] in {"creating", "prepared"} and item["status"] not in {
            "pending", "pr_open"
        }:
            raise StateError(
                f"{slice_id} unactivated implementation task has an invalid slice status"
            )
        if item["status"] in MUTATING_SLICE_STATUSES and all(
            item[field]["state"] == "unbound"
            for field in ("implementation_task", "review_task")
        ):
            raise StateError(
                f"{slice_id} mutating status has no accounted owning task"
            )
        if item["status"] in {"blocked", "superseded"} and nonquiescent_task_labels(item):
            raise StateError(
                f"{slice_id} {item['status']} slice has nonquiescent tasks"
            )
        released_blocked_review = (
            review["state"] == "blocked"
            and review["branch_release_digest"] is not None
            and implementation["state"] in {"authorized", "active"}
        )
        checkpoint_issue_handoff = (
            review["state"] == "blocked"
            and implementation["state"] in {"authorized", "active"}
            and bool(item["revision_history"])
            and item["revision_history"][-1]["reauthorization_disposition"]
            == "final_ui_checkpoint_issue"
        )
        if (
            review["state"] not in {"unbound", "superseded"}
            and implementation["state"] not in {"quiescent", "superseded"}
            and not released_blocked_review
            and not checkpoint_issue_handoff
        ):
            raise StateError(
                f"{slice_id} review task requires quiescent implementation"
            )
        if review["state"] == "active":
            if item["status"] not in {"in_progress", "verifying", "verified", "pr_open"}:
                raise StateError(f"{slice_id} active review has an invalid slice status")
        if review["state"] == "creating" and (
            item["status"] != "pr_open" or item["pr"] is None
        ):
            raise StateError(f"{slice_id} creating review requires an open PR")
        if review["state"] == "clean":
            if item["status"] not in {"pr_open", "merged", "blocked"}:
                raise StateError(
                    f"{slice_id} clean review requires an open, merged, or stale-blocked slice"
                )
            if item["status"] != "blocked" and review["bound_sha"] != item["head_sha"]:
                raise StateError(
                    f"{slice_id} clean review is stale against the current head"
                )
        if item["status"] in {"verified", "pr_open"} and not review_has_head_authority(item):
            require_initial_implementation_handoff(item)
        if item["status"] == "merged":
            if implementation["state"] not in {"quiescent", "superseded"}:
                raise StateError(
                    f"{slice_id} merge requires quiescent implementation task"
                )
            if review["state"] != "clean":
                raise StateError(f"{slice_id} merge requires a clean review task")
    observation_epochs(state)

def truthful_premerge_final_slice(state: dict) -> str | None:
    """Return the sole open final slice encoded by a frozen completed snapshot."""
    nonterminal = [
        item for item in state["slices"]
        if item["status"] not in TERMINAL_SLICE_STATUSES
    ]
    if len(nonterminal) != 1 or nonterminal[0]["status"] != "pr_open":
        return None
    return nonterminal[0]["id"]


def reopened_premerge_snapshot_owner(state: dict) -> str | None:
    """Return the sole immutable snapshot handoff retained for reconciliation."""
    if (
        state["phase"] != "discuss"
        or state["completion_specification_digest"] is not None
        or not any(record["locked"] for record in state["acceptance"].values())
    ):
        return None
    slice_id = truthful_premerge_final_slice(state)
    if slice_id is None:
        return None
    selected = slice_map(state)[slice_id]
    if not implementation_attention_handoff(selected):
        return None
    return f"{slice_id}:implementation"


def closure_errors(
    state: dict,
    declared_acceptance: set[str],
    *,
    premerge_final_slice: str | None = None,
    deferred_acceptance: str | None = None,
) -> list[str]:
    errors: list[str] = []
    if state["blockers"]:
        errors.append("blockers remain")
    inferred_premerge_final = (
        truthful_premerge_final_slice(state)
        if state["phase"] == "complete"
        else None
    )
    permitted_premerge_final = premerge_final_slice or inferred_premerge_final
    if premerge_final_slice is not None:
        items = slice_map(state)
        selected = items.get(premerge_final_slice)
        if selected is None:
            errors.append(f"pre-merge final slice is unknown: {premerge_final_slice}")
        elif selected["status"] != "pr_open":
            errors.append(
                f"pre-merge final slice is not open: {premerge_final_slice}"
            )
        elif truthful_premerge_final_slice(state) != premerge_final_slice:
            errors.append(
                "pre-merge final snapshot requires exactly one nonterminal slice"
            )
        elif not implementation_attention_handoff(selected):
            errors.append(
                "pre-merge final snapshot requires the selected active "
                "implementation awaiting snapshot bytes"
            )
    nonterminal = [
        item["id"]
        for item in state["slices"]
        if (
            item["status"] not in TERMINAL_SLICE_STATUSES
            and item["id"] != permitted_premerge_final
        )
    ]
    if nonterminal:
        errors.append("nonterminal slices: " + ", ".join(nonterminal))
    if state["work_kind"] == "bug_fix" and not any(
        item["status"] == "merged" for item in state["slices"]
    ) and permitted_premerge_final is None:
        errors.append("bug-fix completion requires at least one merged fix PR")
    active_tasks = all_nonquiescent_task_labels(slice_map(state))
    if permitted_premerge_final is not None:
        selected = slice_map(state).get(permitted_premerge_final)
        snapshot_owner = f"{permitted_premerge_final}:implementation"
        if (
            selected is not None
            and selected["status"] == "pr_open"
            and implementation_attention_handoff(selected)
        ):
            active_tasks = [
                label for label in active_tasks if label != snapshot_owner
            ]
    if active_tasks:
        errors.append("nonquiescent tasks: " + ", ".join(active_tasks))
    if set(state["acceptance"]) != declared_acceptance:
        errors.append("acceptance index does not match ACCEPTANCE.md")
    if deferred_acceptance is not None:
        deferred_record = state["acceptance"].get(deferred_acceptance)
        if (
            not isinstance(deferred_record, dict)
            or deferred_record.get("status") != "pending"
            or deferred_record.get("locked") is not False
        ):
            errors.append(
                "pre-merge final UI acceptance must remain pending and unlocked"
            )
    incomplete = [
        identifier
        for identifier in sorted(declared_acceptance)
        if identifier != deferred_acceptance
        if state["acceptance"].get(identifier, {}).get("status")
        not in {"passed", "waived"}
    ]
    if incomplete:
        errors.append("acceptance not complete: " + ", ".join(incomplete))
    if state["phase"] == "complete":
        unlocked = [
            identifier for identifier in sorted(declared_acceptance)
            if identifier != deferred_acceptance
            if not state["acceptance"].get(identifier, {}).get("locked", False)
        ]
        if unlocked:
            errors.append("complete acceptance is not locked: " + ", ".join(unlocked))
    return errors

def require_resolved_interview(bundle: Path, state: dict) -> int:
    interview = safe_path(
        bundle,
        state["artifacts"]["interview"],
        "interview",
        required=True,
        markdown=True,
    ).read_text(encoding="utf-8")
    terminal_statuses = {
        "GA": {"answered_by_docs", "answered_by_user", "closed", "deferred"},
        "Q": {"answered", "answered_by_docs", "superseded", "deferred"},
    }
    headings = list(re.finditer(r"(?m)^##\s+([^\n]*?)\s*$", interview))
    unresolved: list[str] = []
    identifiers: set[str] = set()
    for index, heading in enumerate(headings):
        heading_text = heading.group(1)
        first_token = heading_text.split(maxsplit=1)[0] if heading_text else ""
        if not first_token.startswith(("GA-", "Q-")):
            continue
        canonical = re.fullmatch(
            r"((GA|Q)-[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*):\s+(\S.*)",
            heading_text,
        )
        if canonical is None:
            prefix = first_token.rstrip(":")
            raise StateError(f"malformed interview entry heading: {prefix}")
        identifier, kind, _title = canonical.groups()
        if identifier in identifiers:
            raise StateError(f"duplicate interview entry identity: {identifier}")
        identifiers.add(identifier)
        end = (
            headings[index + 1].start()
            if index + 1 < len(headings)
            else len(interview)
        )
        body = interview[heading.end():end]
        statuses = markdown_list_values(body, "Status")
        if len(statuses) != 1 or statuses[0] not in terminal_statuses[kind]:
            unresolved.append(identifier)
    if unresolved:
        raise StateError(
            "unresolved consequential interview entries block phase advance: "
            + ", ".join(sorted(unresolved))
        )
    return len(identifiers)

def required_record_value(text: str, field: str, label: str) -> str:
    matches = re.findall(
        rf"(?mi)^\s*(?:-\s*)?{re.escape(field)}\s*:\s*(.*?)\s*$",
        text,
    )
    if len(matches) != 1:
        raise StateError(f"{label} requires exactly one {field}")
    value = matches[0].strip().strip('"').strip("'")
    if not value or value.lower() in {"pending", "unknown", "tbd", "todo"}:
        raise StateError(f"{label} has unresolved {field}")
    return value

def meaningful_record_scalar(value: str, field: str) -> str:
    normalized = value.strip().strip('"').strip("'")
    if not normalized or normalized.lower() in {
        "pending", "unknown", "tbd", "todo", "none",
    }:
        raise StateError(
            f"regression-test abstraction has unresolved {field}"
        )
    return normalized

def canonical_regression_abstraction(text: str) -> dict:
    fences = re.findall(r"(?ms)^```ya?ml\s*\n(.*?)^```\s*$", text)
    if len(fences) != 1:
        raise StateError(
            "regression-test abstraction requires one fenced test_abstraction_record"
        )
    lines = fences[0].splitlines()
    if not lines or lines[0].strip() != "test_abstraction_record:":
        raise StateError(
            "regression-test abstraction requires test_abstraction_record"
        )
    scalar_fields = {
        "incident_evidence", "invariant", "owning_seam", "fixture_strategy",
        "generalized_test_name", "display_contract",
    }
    list_fields = {
        "equivalence_classes", "essential_inputs", "observable_outcomes",
    }
    allowed = scalar_fields | list_fields | {"identity_specific_details"}
    record: dict[str, object] = {}
    index = 1
    while index < len(lines):
        line = lines[index]
        if not line.strip():
            index += 1
            continue
        match = re.fullmatch(r"  ([a-z_]+):(?:\s*(.*))?", line)
        if match is None or match.group(1) not in allowed:
            raise StateError("regression-test abstraction has invalid structure")
        field, inline = match.group(1), (match.group(2) or "").strip()
        if field in record:
            raise StateError(
                f"regression-test abstraction has duplicate {field}"
            )
        if field in scalar_fields:
            record[field] = meaningful_record_scalar(inline, field)
            index += 1
            continue
        if field in list_fields:
            if inline:
                raise StateError(
                    f"regression-test abstraction {field} must be a nonempty list"
                )
            values: list[str] = []
            index += 1
            while index < len(lines):
                item = re.fullmatch(r"    -\s+(.+?)\s*", lines[index])
                if item is None:
                    break
                values.append(meaningful_record_scalar(item.group(1), field))
                index += 1
            if not values:
                raise StateError(
                    f"regression-test abstraction {field} must be a nonempty list"
                )
            record[field] = values
            continue
        if inline:
            raise StateError(
                "regression-test abstraction identity_specific_details must be an object"
            )
        index += 1
        details: list[str] | None = None
        justification: str | None = None
        while index < len(lines):
            nested = re.fullmatch(r"    (details|justification):(?:\s*(.*))?", lines[index])
            if nested is None:
                break
            name, value = nested.group(1), (nested.group(2) or "").strip()
            if name == "details":
                if details is not None:
                    raise StateError(
                        "regression-test abstraction has duplicate identity details"
                    )
                if value == "[]":
                    details = []
                    index += 1
                elif value:
                    raise StateError(
                        "regression-test abstraction identity details must be a list"
                    )
                else:
                    details = []
                    index += 1
                    while index < len(lines):
                        item = re.fullmatch(r"      -\s+(.+?)\s*", lines[index])
                        if item is None:
                            break
                        details.append(meaningful_record_scalar(
                            item.group(1), "identity_specific_details.details"
                        ))
                        index += 1
            else:
                if justification is not None:
                    raise StateError(
                        "regression-test abstraction has duplicate identity justification"
                    )
                justification = meaningful_record_scalar(
                    value, "identity_specific_details.justification"
                )
                index += 1
        if details is None or justification is None:
            raise StateError(
                "regression-test abstraction identity_specific_details requires "
                "details and justification"
            )
        record[field] = {"details": details, "justification": justification}
    missing = sorted(allowed - set(record))
    if missing:
        raise StateError(
            "regression-test abstraction requires " + ", ".join(missing)
        )
    if record["display_contract"] == "not_applicable":
        raise StateError(
            "regression-test abstraction display_contract requires a reason"
        )
    return record

def require_bug_planning_evidence(bundle: Path, state: dict) -> None:
    if state["work_kind"] != "bug_fix":
        return
    root_cause = safe_path(
        bundle,
        "discovery/root-cause.md",
        "confirmed root-cause record",
        required=True,
        markdown=True,
    ).read_text(encoding="utf-8")
    if required_record_value(root_cause, "Status", "root-cause record") != "confirmed":
        raise StateError("root-cause record Status must be confirmed")
    for field in ("Owning seam", "Failed invariant", "Evidence"):
        required_record_value(root_cause, field, "root-cause record")

    abstraction = safe_path(
        bundle,
        "discovery/regression-test-abstraction.md",
        "regression-test abstraction",
        required=True,
        markdown=True,
    ).read_text(encoding="utf-8")
    if required_record_value(
        abstraction, "Status", "regression-test abstraction"
    ) != "complete":
        raise StateError("regression-test abstraction Status must be complete")
    canonical_regression_abstraction(abstraction)


def persisted_required_by_intent_cohesion_evidence(
    bundle: Path, item: dict
) -> dict | None:
    if not item["revision_history"]:
        return None
    revision = next(
        (
            candidate
            for candidate in reversed(item["revision_history"])
            if candidate["reauthorization_disposition"]
            == "required_by_intent_scope_expansion"
            and candidate["revision_epoch"] < item["revision_epoch"]
        ),
        None,
    )
    if revision is None:
        return None
    terminal, terminal_digest = typed_receipt(
        bundle,
        revision["review_terminal_receipt"],
        f"{item['id']} cohesive expansion terminal",
        REVIEW_LEASE_TERMINAL_FIELDS,
    )
    required_paths = sorted(
        repo_path_value(path, f"{item['id']} cohesive expansion required path")
        for path in string_list(
            terminal["requiredOwnedPaths"],
            f"{item['id']} cohesive expansion required paths",
            nonempty=True,
        )
    )
    prior_owned_paths = sorted(revision["owned_paths"])
    added_owned_paths = sorted(revision["added_owned_paths"])
    expected = {
        "terminal digest": revision["review_terminal_digest"],
        "schema": "spec-work-review-lease-terminal",
        "kind": "review_lease_terminal",
        "result": "BLOCKED",
        "clean": True,
        "disposition": "required_by_intent_scope_expansion",
        "required paths": added_owned_paths,
        "acceptance": revision["required_by_intent_acceptance_id"],
        "owned paths": sorted([*prior_owned_paths, *added_owned_paths]),
        "branch": item["branch"],
    }
    observed = {
        "terminal digest": terminal_digest,
        "schema": terminal["schema"],
        "kind": terminal["kind"],
        "result": terminal["result"],
        "clean": terminal["clean"],
        "disposition": terminal["blockedDisposition"],
        "required paths": required_paths,
        "acceptance": terminal["acceptanceId"],
        "owned paths": sorted(item["owned_paths"]),
        "branch": terminal["branch"],
    }
    mismatched = [
        field for field in expected if observed[field] != expected[field]
    ]
    if mismatched:
        raise StateError(
            f"{item['id']} persisted cohesive expansion evidence is stale: "
            + ", ".join(mismatched)
        )
    string_value(
        terminal["owningSeam"],
        f"{item['id']} cohesive expansion owning seam",
        maximum=500,
    )
    return terminal


def required_by_intent_cohesion_evidence(
    bundle: Path, state: dict, item: dict
) -> dict | None:
    review = item["review_task"]
    persisted = persisted_required_by_intent_cohesion_evidence(bundle, item)
    if persisted is not None:
        return persisted

    if (
        state["phase"] != "plan"
        or item["status"] != "pr_open"
        or review["state"] != "blocked"
        or review["branch_attachment_receipt"] is None
        or review["branch_release_digest"] is None
        or review["branch_release_epoch"] is None
        or review["branch_attachment_epoch"] is None
        or review["branch_release_epoch"] <= review["branch_attachment_epoch"]
        or receipt_schema(
            bundle,
            review["branch_attachment_receipt"],
            f"{item['id']} review attachment",
        )
        != "spec-work-review-lease-terminal"
    ):
        return None
    terminal, terminal_digest = review_lease_terminal_value(
        bundle,
        state,
        item,
        review,
        review["branch_attachment_receipt"],
        target="blocked",
        review_receipt=None,
        persisted=True,
    )
    if terminal["blockedDisposition"] != "required_by_intent_scope_expansion":
        return None
    if terminal_digest != review["branch_attachment_digest"]:
        raise StateError(
            f"{item['id']} cohesive expansion terminal digest is stale"
        )
    return terminal


def state_slice_plan_contract(
    bundle: Path,
    state: dict,
    item: dict,
    *,
    require_cohesion: bool = False,
) -> dict:
    return slice_plan_contract(
        bundle,
        item,
        require_cohesion=require_cohesion,
        authenticated_required_by_intent_evidence=(
            required_by_intent_cohesion_evidence(bundle, state, item)
        ),
    )

def validate_state(
    bundle: Path,
    state: object,
    *,
    allow_acceptance_drift: bool = False,
    allow_digest_drift: set[str] | None = None,
    allow_authorization_drift: bool = False,
    allow_task_authorization_drift: bool = False,
    allow_parallel_drift: set[tuple[str, str]] | None = None,
    allow_specification_drift: bool = False,
    deep_external: bool = False,
) -> dict:
    state = validate_schema(state)
    validate_evidence_epoch_chronology(state)
    artifacts = state["artifacts"]
    validate_bundle_identity(bundle, state)
    for key in ("primary", "interview", "decisions", "acceptance"):
        safe_path(bundle, artifacts[key], key, required=True, markdown=True)
    if state["work_kind"] == "bug_fix":
        for relative, label in (
            ("discovery/root-cause.md", "confirmed root-cause record"),
            (
                "discovery/regression-test-abstraction.md",
                "regression-test abstraction",
            ),
        ):
            safe_path(bundle, relative, label, required=True, markdown=True)
    items = slice_map(state)
    validate_dependencies(items)
    validate_bindings(items)
    validate_observed_main(state)
    validate_task_bindings(
        bundle,
        state,
        allow_authorization_drift=allow_task_authorization_drift,
    )
    validate_mutation_interlocks(state)
    validate_task_authorization(
        bundle, state, allow_drift=allow_authorization_drift
    )
    validate_parallel_assessments(
        bundle, state, allow_drift=allow_parallel_drift
    )
    if state["phase"] in {"delivery", "complete"}:
        require_complete_task_authorization(
            state,
            allow_current_task_drift=allow_task_authorization_drift,
        )
    for identifier, item in items.items():
        validate_slice_artifact_paths(item)
        plan_path = safe_path(
            bundle, item["plan"], f"{identifier} plan", required=True, markdown=True
        )
        if (
            (
                (
                    state["phase"] in {"delivery", "complete"}
                    and state["planning"]["current_plan_digest"] is not None
                )
                or item["status"] not in {"pending", "blocked"}
            )
            and "*" not in (allow_digest_drift or set())
            and hashlib.sha256(plan_path.read_bytes()).hexdigest()
            != item["plan_digest"]
        ):
            raise StateError(
                f"{identifier} retained Plan bytes differ from adopted digest"
            )
        state_slice_plan_contract(
            bundle,
            state,
            item,
            require_cohesion=True,
        )
        for revision in item["revision_history"]:
            pre_pr_revision = (
                revision["reauthorization_disposition"]
                in PRE_PR_REAUTHORIZATION_DISPOSITIONS
            )
            if (
                revision["reauthorization_disposition"]
                == "final_ui_checkpoint_issue"
            ):
                historical_item = {
                    **item,
                    "head_sha": revision["head_sha"],
                    "pr": revision["pr"],
                    "revision_epoch": revision["revision_epoch"],
                }
                issue_digest = validate_final_ui_issue_receipt(
                    bundle,
                    state,
                    historical_item,
                    revision["final_ui_issue_receipt"],
                    allow_archived=True,
                    archived_plan_checkpoint_sha=revision[
                        "plan_checkpoint_sha"
                    ],
                )
                if issue_digest != revision["final_ui_issue_receipt_digest"]:
                    raise StateError(
                        f"{identifier} historical final UI issue receipt digest is stale"
                    )
            terminal_receipt = revision[
                (
                    "implementation_terminal_receipt"
                    if pre_pr_revision
                    else "review_terminal_receipt"
                )
            ]
            if terminal_receipt is None:
                continue
            terminal_path = safe_path(
                bundle,
                terminal_receipt,
                f"{identifier} historical terminal",
                required=True,
            )
            if (
                hashlib.sha256(terminal_path.read_bytes()).hexdigest()
                != revision[
                    (
                        "implementation_terminal_digest"
                        if pre_pr_revision
                        else "review_terminal_digest"
                    )
                ]
            ):
                raise StateError(
                    (
                        f"{identifier} historical implementation terminal "
                        "digest is stale"
                        if pre_pr_revision
                        else f"{identifier} historical review terminal digest is stale"
                    )
                )
            if (
                revision["reauthorization_disposition"]
                == "final_ui_checkpoint_issue"
            ):
                terminal, terminal_digest = typed_receipt(
                    bundle,
                    revision["review_terminal_receipt"],
                    f"{identifier} historical final UI clean terminal",
                    REVIEW_LEASE_TERMINAL_FIELDS,
                )
                terminal_review = review_task_for_terminal(
                    item,
                    terminal,
                    f"{identifier} historical final UI clean terminal",
                )
                historical_review = {
                    **terminal_review,
                    "state": "superseded",
                    "bound_sha": revision["head_sha"],
                    "review_receipt": revision["final_ui_review_receipt"],
                    "branch_attachment_receipt": revision[
                        "review_terminal_receipt"
                    ],
                    "branch_attachment_digest": terminal_digest,
                    "branch_attachment_epoch": terminal["observationEpoch"],
                }
                canonical_terminal, canonical_terminal_digest = (
                    review_lease_terminal_value(
                        bundle,
                        state,
                        historical_item,
                        historical_review,
                        revision["review_terminal_receipt"],
                        target="clean",
                        review_receipt=revision["final_ui_review_receipt"],
                        persisted=True,
                    )
                )
                if (
                    canonical_terminal_digest
                    != revision["review_terminal_digest"]
                    or canonical_terminal["observationEpoch"]
                    != terminal["observationEpoch"]
                ):
                    raise StateError(
                        f"{identifier} historical final UI clean terminal is stale"
                    )
                clean_proof = review_clean_receipt_value(
                    bundle, state, historical_item, historical_review
                )
                if (
                    clean_proof["review_receipt"]
                    != revision["final_ui_review_receipt"]
                    or clean_proof["review_receipt_digest"]
                    != revision["review_receipt_digest"]
                ):
                    raise StateError(
                        f"{identifier} historical final UI clean review is stale"
                    )
            if pre_pr_revision:
                observation_path = safe_path(
                    bundle,
                    revision["pre_pr_observation_receipt"],
                    f"{identifier} historical pre-PR observation",
                    required=True,
                )
                if (
                    hashlib.sha256(observation_path.read_bytes()).hexdigest()
                    != revision["pre_pr_observation_digest"]
                ):
                    raise StateError(
                        f"{identifier} historical pre-PR observation digest is stale"
                    )
                if (
                    revision["reauthorization_disposition"]
                    == "satisfied_prerequisite"
                ):
                    delivery, delivery_digest = typed_receipt(
                        bundle,
                        revision["prerequisite_delivery_receipt"],
                        f"{identifier} historical prerequisite delivery",
                        MERGE_RECEIPT_FIELDS,
                    )
                    if (
                        delivery_digest
                        != revision["prerequisite_delivery_digest"]
                        or delivery["resultMainSha"]
                        != revision["prerequisite_merge_sha"]
                    ):
                        raise StateError(
                            f"{identifier} historical prerequisite delivery is stale"
                        )
                    _premerge, premerge_digest = typed_receipt(
                        bundle,
                        delivery["premergeReceipt"],
                        f"{identifier} historical prerequisite premerge result",
                        PREMERGE_RESULT_FIELDS,
                    )
                    if premerge_digest != delivery["premergeReceiptDigest"]:
                        raise StateError(
                            f"{identifier} historical prerequisite premerge is stale"
                        )
            elif revision["head_adoption_receipt"] is not None:
                adoption_path = safe_path(
                    bundle,
                    revision["head_adoption_receipt"],
                    f"{identifier} historical review head adoption",
                    required=True,
                )
                if (
                    hashlib.sha256(adoption_path.read_bytes()).hexdigest()
                    != revision["head_adoption_digest"]
                ):
                    raise StateError(
                        f"{identifier} historical review head-adoption digest is stale"
                    )
                for index, entry in enumerate(
                    revision["head_adoption_terminal_lineage"]
                ):
                    lineage_path = safe_path(
                        bundle,
                        entry["receipt"],
                        (
                            f"{identifier} historical review head-adoption "
                            f"terminal {index + 1}"
                        ),
                        required=True,
                    )
                    if (
                        hashlib.sha256(lineage_path.read_bytes()).hexdigest()
                        != entry["digest"]
                    ):
                        raise StateError(
                            f"{identifier} historical review head-adoption "
                            "terminal digest is stale"
                        )
        receipt = item["receipt"]
        if receipt is not None:
            safe_path(
                bundle, receipt, f"{identifier} receipt", required=True, markdown=True
            )
        if item["status"] == "merged":
            unmerged = [
                dependency
                for dependency in item["depends_on"]
                if items[dependency]["status"] != "merged"
            ]
            if unmerged:
                raise StateError(
                    f"{identifier} merged before dependencies: " + ", ".join(unmerged)
                )
            if item["depends_on"] and item["base_ref"] != "origin/main":
                raise StateError(
                    f"{identifier} dependent merge requires refreshed origin/main base"
                )
            if is_authoritative_delivery_projection(item):
                validate_authoritative_delivery_projection(
                    state, item, deep_external=deep_external
                )
                for dependency in item["depends_on"]:
                    dependency_item = items[dependency]
                    if dependency_item["merge_main_sha"] is None:
                        raise StateError(
                            f"{identifier} projected dependency identity is absent"
                        )
                    require_ancestor(
                        dependency_item["merge_main_sha"],
                        item["base_sha"],
                        f"{identifier} projection dependency mismatch",
                    )
            else:
                _, merge_binding = merge_receipt_value(
                    bundle, state, item, item["merge_receipt"], allow_legacy=True
                )
                if any(
                    item[field] != value
                    for field, value in merge_binding.items()
                ):
                    raise StateError(
                        f"{identifier} merge receipt binding is stale"
                    )
    criteria = acceptance_criteria(bundle, state)
    declared = set(criteria)
    allowed_digest_drift = allow_digest_drift or set()
    bounded_acceptance_projection_drift = (
        allow_acceptance_drift and "*" in allowed_digest_drift
    )
    undeclared = sorted(set(state["acceptance"]) - declared)
    locked_undeclared = sorted(
        identifier
        for identifier in undeclared
        if state["acceptance"][identifier]["locked"]
    )
    if locked_undeclared:
        raise StateError(
            "locked acceptance criterion is immutable: "
            + ", ".join(locked_undeclared)
        )
    if undeclared and not bounded_acceptance_projection_drift:
        raise StateError(
            "acceptance id is not declared in ACCEPTANCE.md: " + ", ".join(undeclared)
        )
    missing = sorted(declared - set(state["acceptance"]))
    if missing and not allow_acceptance_drift:
        raise StateError(
            "acceptance id is missing from state; record it as pending: "
            + ", ".join(missing)
        )
    locked_drift = sorted(
        identifier
        for identifier in set(state["acceptance"]) & declared
        if state["acceptance"][identifier]["locked"]
        and state["acceptance"][identifier]["criterion_digest"]
        != criteria[identifier]
    )
    if locked_drift:
        raise StateError(
            "locked acceptance criterion is immutable: " + ", ".join(locked_drift)
        )
    drifted = sorted(
        identifier
        for identifier in set(state["acceptance"]) & declared
        if state["acceptance"][identifier]["criterion_digest"]
        != criteria[identifier]
        and identifier not in allowed_digest_drift
        and "*" not in allowed_digest_drift
    )
    if drifted:
        raise StateError(
            "acceptance criterion digest drift requires refresh-acceptance: "
            + ", ".join(drifted)
        )
    for identifier, record in state["acceptance"].items():
        actual_digests = hash_evidence(bundle, state, identifier, record["evidence"])
        if actual_digests != record["evidence_digests"]:
            raise StateError(f"acceptance evidence digest mismatch: {identifier}")
    provenance_state = (
        {
            **state,
            "acceptance": {
                identifier: record
                for identifier, record in state["acceptance"].items()
                if identifier in declared
            },
        }
        if undeclared
        else state
    )
    validate_acceptance_provenance(
        bundle,
        provenance_state,
        allow_assignment_drift=bounded_acceptance_projection_drift,
    )
    if state["phase"] in {"delivery", "complete"}:
        contract = ui_design_contract(bundle, state)
        if contract is not None:
            final_slice, _ = contract
            for slice_id in sorted(current_ui_epoch_ids(bundle, items, final_slice)):
                plan = state_slice_plan_contract(
                    bundle, state, items[slice_id]
                )
                automated = plan["automated"]
                if automated is None:
                    continue
                record = state["acceptance"].get(automated)
                if record is not None and record["status"] == "waived":
                    raise StateError(
                        f"automated UI acceptance {automated} cannot be waived"
                    )
                if record is not None and record["status"] == "passed":
                    if deep_external:
                        require_recorded_automated_ui_acceptance(
                            bundle, state, slice_id, automated
                        )
                    elif not has_bound_implementation_receipt(
                        bundle, slice_id, automated, plan["proofTarget"],
                        record["evidence"],
                    ):
                        raise StateError(
                            f"{slice_id} automated UI acceptance requires its exact "
                            "typed implementation-proof receipt"
                        )
                if items[slice_id]["status"] == "merged" and (
                    record is None or record["status"] != "passed"
                ):
                    raise StateError(
                        f"merged UI slice {slice_id} lacks passed automated UI acceptance"
                    )
    completion_binding = state["completion_binding"]
    completion_specification_digest = state["completion_specification_digest"]
    inferred_premerge_final = (
        truthful_premerge_final_slice(state)
        if state["phase"] == "complete"
        else None
    )
    design_contract = (
        ui_design_contract(bundle, state)
        if state["phase"] == "complete"
        else None
    )
    deferred_acceptance = (
        design_contract[1]
        if (
            design_contract is not None
            and design_contract[0] == inferred_premerge_final
            and completion_binding is None
        )
        else None
    )
    if (
        state["phase"] == "complete"
        and design_contract is not None
        and completion_binding is None
        and deferred_acceptance is None
    ):
        raise StateError("final UI completion requires completion_binding")
    if completion_binding is not None:
        validate_completion_binding_files(bundle, completion_binding)
    locked_completion_ui_bindings(bundle, state)
    if state["phase"] == "complete":
        if completion_specification_digest is None:
            raise StateError("complete state requires a specification digest")
        if completion_specification_digest != completion_fact_digests(bundle, state)[1]:
            raise StateError("completion specification digest is stale")
        errors = closure_errors(
            state,
            declared,
            deferred_acceptance=deferred_acceptance,
        )
        if errors:
            raise StateError("complete state is invalid: " + "; ".join(errors))
        if deep_external and deferred_acceptance is None:
            validate_completion_binding(bundle, state)
    validate_planning_evidence(
        bundle, state, allow_specification_drift=allow_specification_drift
    )
    evidence_epochs(state)
    return state



def read_state(
    bundle: Path,
    *,
    allow_acceptance_drift: bool = False,
    allow_digest_drift: set[str] | None = None,
    allow_authorization_drift: bool = False,
    allow_task_authorization_drift: bool = False,
    allow_parallel_drift: set[tuple[str, str]] | None = None,
    allow_specification_drift: bool = False,
) -> dict:
    path = bundle / "state.json"
    ensure_regular_file(path, "state.json", required=True)
    try:
        state = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as error:
        raise StateError(f"malformed JSON in state.json: {error.msg}") from error
    except OSError as error:
        raise StateError(f"cannot read state.json: {error}") from error
    if isinstance(state, dict) and state.get("schema") != SCHEMA_ID:
        raise StateError(
            f"unsupported workflow state schema {state.get('schema')!r}; archive the stale bundle or restart it manually"
        )
    validated = validate_state(
        bundle,
        state,
        allow_acceptance_drift=allow_acceptance_drift,
        allow_digest_drift=allow_digest_drift,
        allow_authorization_drift=allow_authorization_drift,
        allow_task_authorization_drift=allow_task_authorization_drift,
        allow_parallel_drift=allow_parallel_drift,
        allow_specification_drift=allow_specification_drift,
        deep_external=True,
    )
    return validated

def fsync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)

def atomic_write_bytes(path: Path, payload: bytes) -> None:
    ensure_regular_file(path, path.name, required=False)
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.", dir=path.parent
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb", closefd=True) as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        ensure_regular_file(path, path.name, required=False)
        os.replace(temporary, path)
        fsync_directory(path.parent)
    except OSError as error:
        raise StateError(f"atomic write failed for {path.name}: {error}") from error
    finally:
        temporary.unlink(missing_ok=True)

def canonical_json_bytes(value: object) -> bytes:
    return (
        json.dumps(value, indent=2, sort_keys=True, ensure_ascii=True).encode("utf-8")
        + b"\n"
    )

def publish_immutable_bytes(path: Path, payload: bytes) -> None:
    ensure_regular_file(path, path.name, required=False)
    path.parent.mkdir(parents=True, exist_ok=True)
    ensure_regular_file(path, path.name, required=False)
    if path.exists():
        if path.read_bytes() != payload:
            raise StateError(f"immutable artifact conflicts at {path.name}")
        return
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.", dir=path.parent
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb", closefd=True) as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        try:
            os.link(temporary, path, follow_symlinks=False)
        except FileExistsError:
            ensure_regular_file(path, path.name, required=True)
            if path.read_bytes() != payload:
                raise StateError(f"immutable artifact conflicts at {path.name}")
        directory = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    except (OSError, StateError) as error:
        if isinstance(error, StateError):
            raise
        raise StateError(
            f"immutable publication failed for {path.name}: {error}"
        ) from error
    finally:
        temporary.unlink(missing_ok=True)

def atomic_write_json(path: Path, value: object) -> None:
    atomic_write_bytes(path, canonical_json_bytes(value))

def atomic_write_text(path: Path, value: str) -> None:
    atomic_write_bytes(path, value.encode("utf-8"))

def earlier_nonterminal_slices(
    items: dict[str, dict], item: dict, *, allowed_open_dependencies: set[str] | None = None
) -> list[str]:
    if item["execution_mode"] != "serial":
        return []
    allowed = allowed_open_dependencies or set()
    item_key = (item["wave"], item["id"])
    return sorted(
        candidate["id"]
        for candidate in items.values()
        if (candidate["wave"], candidate["id"]) < item_key
        and candidate["status"] not in TERMINAL_SLICE_STATUSES
        and candidate["id"] not in allowed
    )

def earlier_nonterminal_waves(items: dict[str, dict], item: dict) -> list[str]:
    return sorted(
        candidate["id"]
        for candidate in items.values()
        if candidate["wave"] < item["wave"]
        and candidate["status"] not in TERMINAL_SLICE_STATUSES
    )

def stackable_chain(items: dict[str, dict], item: dict) -> list[dict] | None:
    """Return the direct open dependency followed by its open ancestor chain."""
    chain: list[dict] = []
    cursor = item
    seen: set[str] = set()
    while True:
        dependencies = [items[identifier] for identifier in cursor["depends_on"]]
        if any(
            dependency["status"] == "pr_open"
            and (
                dependency["implementation_task"]["state"]
                not in {"quiescent", "superseded"}
                or dependency["review_task"]["state"] != "clean"
                or dependency["review_task"]["bound_sha"]
                != dependency["head_sha"]
            )
            for dependency in dependencies
        ):
            return None
        open_dependencies = [
            dependency for dependency in dependencies
            if dependency["status"] == "pr_open"
            and dependency["implementation_task"]["state"] in {
                "quiescent", "superseded"
            }
            and dependency["review_task"]["state"] == "clean"
            and dependency["review_task"]["bound_sha"] == dependency["head_sha"]
        ]
        if any(
            dependency["status"] not in {"pr_open", "merged"}
            for dependency in dependencies
        ):
            return None
        if not open_dependencies:
            return chain or None
        if len(open_dependencies) != 1:
            return None
        upstream = open_dependencies[0]
        if upstream["id"] in seen:
            return None
        seen.add(upstream["id"])
        chain.append(upstream)
        cursor = upstream

def stackable_dependency(items: dict[str, dict], item: dict) -> dict | None:
    chain = stackable_chain(items, item)
    return chain[0] if chain else None

def validate_wave_execution_modes(
    items: dict[str, dict], selected: list[dict]
) -> None:
    for wave in {item["wave"] for item in selected}:
        modes = {
            item["execution_mode"]
            for item in items.values()
            if item["wave"] == wave
            and item["status"] not in TERMINAL_SLICE_STATUSES
        }
        if len(modes) > 1:
            raise StateError(f"wave {wave} mixes serial and parallel execution modes")

def validate_parallel_topology(state: dict, group: list[dict]) -> None:
    all_items = slice_map(state)
    if any(item["execution_mode"] != "parallel" for item in group):
        raise StateError("parallel group contains a non-parallel slice")
    if len({item["wave"] for item in group}) != 1:
        raise StateError("parallel slices must belong to one wave")
    for index, left in enumerate(group):
        for right in group[index + 1 :]:
            if dependency_reaches(all_items, left["id"], right["id"]) or dependency_reaches(
                all_items, right["id"], left["id"]
            ):
                raise StateError(
                    "parallel slices have a dependency edge: "
                    f"{left['id']}, {right['id']}"
                )
            overlap = owned_paths_overlap(left, right)
            if overlap is not None:
                raise StateError(
                    "parallel slice owned paths overlap: "
                    f"{left['id']}:{overlap[0]} and {right['id']}:{overlap[1]}"
                )
    require_independent_pairs(state, group)

def validate_parallel_group(state: dict, group: list[dict]) -> None:
    validate_parallel_topology(state, group)
    if any(item["base_ref"] != "origin/main" for item in group) or len(
        {item["base_sha"] for item in group}
    ) != 1:
        raise StateError("parallel slices require one observed origin/main base SHA")
    if (
        state["observed_main_sha"] is None
        or any(item["base_sha"] != state["observed_main_sha"] for item in group)
    ):
        raise StateError("parallel slices are stale against observed origin/main")
    if len({item["branch"] for item in group}) != len(group):
        raise StateError("parallel slices require distinct branches")

def nonterminal_wave_members(items: dict[str, dict], wave: int) -> list[dict]:
    return sorted(
        (
            item for item in items.values()
            if item["wave"] == wave
            and item["status"] not in TERMINAL_SLICE_STATUSES
        ),
        key=lambda item: item["id"],
    )

def complete_parallel_retry_cohort(
    items: dict[str, dict], item: dict
) -> list[dict] | None:
    if item["execution_mode"] != "parallel":
        return None
    cohort: list[dict] = []
    for candidate in sorted(items.values(), key=lambda value: value["id"]):
        if (
            candidate["wave"] != item["wave"]
            or candidate["execution_mode"] != "parallel"
        ):
            continue
        task = candidate["implementation_task"]
        retry_candidate = candidate["status"] == "pending" and (
            (task["state"] == "superseded" and task["attempt"] >= 1)
            or (
                task["state"] in {"creating", "prepared"}
                and task["attempt"] >= 2
            )
        )
        if retry_candidate:
            cohort.append(candidate)
            continue
        quiescent_peer = (
            candidate["status"] in TERMINAL_SLICE_STATUSES
            or (
                candidate["status"] in QUIESCENT_PARALLEL_STATUSES
                and not nonquiescent_task_labels(candidate)
            )
        )
        if not quiescent_peer:
            return None
    if len(cohort) < 2 or item["id"] not in {candidate["id"] for candidate in cohort}:
        return None
    return cohort

def validate_initial_parallel_group(state: dict, selected: list[dict]) -> None:
    items = slice_map(state)
    if not selected:
        raise StateError("initial parallel group is empty")
    waves = {item["wave"] for item in selected}
    if len(waves) != 1:
        raise StateError("parallel slices must belong to one wave")
    wave = selected[0]["wave"]
    members = nonterminal_wave_members(items, wave)
    selected_ids = {item["id"] for item in selected}
    member_ids = {item["id"] for item in members}
    if selected_ids != member_ids:
        raise StateError(
            "partial parallel wave activation is forbidden: "
            + ", ".join(sorted(member_ids - selected_ids))
        )
    if any(item["execution_mode"] != "parallel" for item in members):
        raise StateError(f"wave {wave} mixes serial and parallel execution modes")
    not_pending = sorted(
        item["id"] for item in members if item["status"] != "pending"
    )
    if not_pending:
        raise StateError(
            "initial parallel wave members are not pending: " + ", ".join(not_pending)
        )
    incomplete = sorted(
        item["id"] for item in members
        if not all(item[field] is not None for field in ("branch", "base_ref", "base_sha"))
    )
    if incomplete:
        raise StateError(
            "initial parallel wave requires complete branch/base bindings: "
            + ", ".join(incomplete)
        )
    validate_parallel_group(state, members)
    unmerged_dependencies = sorted(
        item["id"]
        for item in members
        if any(items[dependency]["status"] != "merged" for dependency in item["depends_on"])
    )
    if unmerged_dependencies:
        raise StateError(
            "parallel slices must be trunk-ready: "
            + ", ".join(unmerged_dependencies)
        )
    predecessors = sorted(
        {
            predecessor
            for item in members
            for predecessor in earlier_nonterminal_waves(items, item)
        }
    )
    if predecessors:
        raise StateError(
            "parallel slices must be trunk-ready: " + ", ".join(predecessors)
        )

def validate_parallel_retry_group(state: dict, selected: list[dict]) -> None:
    if not selected:
        raise StateError("parallel retry cohort is empty")
    items = slice_map(state)
    cohort = complete_parallel_retry_cohort(items, selected[0])
    selected_ids = {item["id"] for item in selected}
    cohort_ids = {item["id"] for item in cohort or []}
    if cohort is None or selected_ids != cohort_ids:
        missing = sorted(cohort_ids - selected_ids)
        suffix = ": " + ", ".join(missing) if missing else ""
        raise StateError("partial parallel retry cohort activation is forbidden" + suffix)
    validate_wave_execution_modes(items, cohort)
    validate_parallel_group(state, cohort)
    unmerged_dependencies = sorted(
        item["id"]
        for item in cohort
        if any(items[dependency]["status"] != "merged" for dependency in item["depends_on"])
    )
    if unmerged_dependencies:
        raise StateError(
            "parallel slices must be trunk-ready: " + ", ".join(unmerged_dependencies)
        )
    predecessors = sorted(
        {
            predecessor
            for item in cohort
            for predecessor in earlier_nonterminal_waves(items, item)
        }
    )
    if predecessors:
        raise StateError(
            "parallel slices must be trunk-ready: " + ", ".join(predecessors)
        )

def validate_parallel_start_group(state: dict, selected: list[dict]) -> None:
    items = slice_map(state)
    cohort = (
        complete_parallel_retry_cohort(items, selected[0]) if selected else None
    )
    if cohort is not None:
        validate_parallel_retry_group(state, selected)
    else:
        validate_initial_parallel_group(state, selected)

def invalidate_slice_acceptance(bundle: Path, state: dict, item: dict) -> None:
    owned_acceptance = set(
        state_slice_plan_contract(bundle, state, item)["ownedAcceptance"]
    )
    owned_acceptance.update(
        identifier
        for identifier, record in state["acceptance"].items()
        if record["scope"] == "slice" and record["producer_slice"] == item["id"]
    )
    for identifier in owned_acceptance:
        if identifier in state["acceptance"]:
            if state["acceptance"][identifier]["locked"]:
                continue
            state["acceptance"][identifier] = empty_acceptance_record(
                state["acceptance"][identifier]["criterion_digest"]
            )


def invalidate_attempt(bundle: Path, state: dict, item: dict) -> None:
    invalidate_slice_acceptance(bundle, state, item)
    item["receipt"] = None
    item["pr"] = None
    item["head_sha"] = None
    item["terminal_freshness"] = None
    item["premerge_drift"] = None
    if item["review_task"]["state"] == "clean":
        item["review_task"]["state"] = "blocked"


def reopen_review_for_base_sync(
    bundle: Path,
    state: dict,
    item: dict,
    observed_sha: str | None,
    *,
    normalize_to_main: bool = False,
) -> None:
    if item["status"] != "pr_open" or item["pr"] is None or item["head_sha"] is None:
        raise StateError("base-sync review reopening requires a current open PR")
    invalidate_slice_acceptance(bundle, state, item)
    review = item["review_task"]
    if review["state"] == "clean":
        terminal, terminal_digest = review_lease_terminal_value(
            bundle,
            state,
            item,
            review,
            review["branch_attachment_receipt"],
            target="clean",
            review_receipt=review["review_receipt"],
            persisted=True,
        )
        if terminal_digest != review["branch_attachment_digest"]:
            raise StateError("clean review terminal lineage digest is stale")
        terminal_lineage = {
            "receipt": review["branch_attachment_receipt"],
            "digest": terminal_digest,
            "epoch": terminal["observationEpoch"],
            "result": "CLEAN",
            "review_receipt": review["review_receipt"],
        }
        if terminal_lineage not in review["head_adoption_terminal_lineage"]:
            review["head_adoption_terminal_lineage"].append(terminal_lineage)
    if normalize_to_main:
        item["base_ref"] = "origin/main"
    if observed_sha is not None:
        item["base_sha"] = observed_sha
    item["replacement_lineage"] = None
    if review["state"] == "clean":
        review["state"] = "blocked"
        for field in (*REVIEW_PROOF_FIELDS, *BRANCH_ATTACHMENT_FIELDS):
            review[field] = None
    elif review["state"] == "blocked":
        for field in REVIEW_PROOF_FIELDS:
            review[field] = None


def readiness(state: dict) -> tuple[list[str], list[str]]:
    items = slice_map(state)
    trunk_ready: list[str] = []
    stackable: list[str] = []
    inspected_parallel_waves: set[int] = set()
    for identifier, item in sorted(items.items()):
        if item["status"] != "pending":
            continue
        if item["execution_mode"] == "parallel":
            if state["phase"] == "delivery":
                retry_cohort = complete_parallel_retry_cohort(items, item)
                if retry_cohort is not None:
                    if item["wave"] in inspected_parallel_waves:
                        continue
                    inspected_parallel_waves.add(item["wave"])
                    try:
                        validate_parallel_retry_group(state, retry_cohort)
                    except StateError:
                        continue
                    trunk_ready.extend(member["id"] for member in retry_cohort)
                    continue
            siblings = [
                candidate
                for candidate in nonterminal_wave_members(items, item["wave"])
                if candidate["id"] != identifier
            ]
            if siblings and all(
                sibling["execution_mode"] == "parallel"
                and sibling["status"] in QUIESCENT_PARALLEL_STATUSES
                and not nonquiescent_task_labels(sibling)
                for sibling in siblings
            ):
                try:
                    validate_parallel_group(state, [item, *siblings])
                except StateError:
                    continue
                if all(
                    items[dependency]["status"] == "merged"
                    for dependency in item["depends_on"]
                ) and not earlier_nonterminal_waves(items, item):
                    trunk_ready.append(identifier)
                continue
            if item["wave"] in inspected_parallel_waves:
                continue
            inspected_parallel_waves.add(item["wave"])
            group = nonterminal_wave_members(items, item["wave"])
            try:
                validate_initial_parallel_group(state, group)
            except StateError:
                continue
            trunk_ready.extend(member["id"] for member in group)
            continue
        modes = {
            candidate["execution_mode"]
            for candidate in nonterminal_wave_members(items, item["wave"])
        }
        if modes != {"serial"}:
            continue
        dependency_statuses = [
            items[dependency]["status"] for dependency in item["depends_on"]
        ]
        if all(status == "merged" for status in dependency_statuses):
            predecessors = earlier_nonterminal_slices(items, item)
            unbound = all(
                item[field] is None for field in ("branch", "base_ref", "base_sha")
            )
            if (
                not predecessors
                and (
                    unbound
                    or (
                        item["base_ref"] == "origin/main"
                        and item["base_sha"] == state["observed_main_sha"]
                    )
                )
            ):
                trunk_ready.append(identifier)
            continue
        chain = stackable_chain(items, item)
        if item["execution_mode"] == "serial" and chain is not None and not earlier_nonterminal_slices(
            items,
            item,
            allowed_open_dependencies={ancestor["id"] for ancestor in chain},
        ):
            stackable.append(identifier)
    return sorted(trunk_ready), sorted(stackable)

def status_list(values: list[str]) -> str:
    return ", ".join(values) if values else "none"

def render_status(state: dict) -> str:
    trunk_ready, stackable = (set(values) for values in readiness(state))
    categories = {
        "Completed": [],
        "Active": [],
        "Trunk ready": [],
        "Stackable": [],
        "Blocked": [],
        "Pending": [],
    }
    for item in sorted(state["slices"], key=lambda value: value["id"]):
        identifier = item["id"]
        status = item["status"]
        if status in TERMINAL_SLICE_STATUSES:
            categories["Completed"].append(identifier)
        elif status in ACTIVE_SLICE_STATUSES:
            categories["Active"].append(identifier)
        elif status == "blocked":
            categories["Blocked"].append(identifier)
        elif identifier in trunk_ready:
            categories["Trunk ready"].append(identifier)
        elif identifier in stackable:
            categories["Stackable"].append(identifier)
        else:
            categories["Pending"].append(identifier)
    acceptance_counts = {
        status: sum(
            1 for item in state["acceptance"].values() if item["status"] == status
        )
        for status in ("passed", "failed", "waived", "pending")
    }
    prs = [
        f"{item['id']}: #{item['pr']}"
        for item in sorted(state["slices"], key=lambda value: value["id"])
        if item["pr"] is not None
    ]
    active = sorted(
        item["id"]
        for item in state["slices"]
        if item["status"] in ACTIVE_SLICE_STATUSES
    )
    task_lines: list[str] = []
    for item in sorted(state["slices"], key=lambda value: value["id"]):
        checkpoint = item["plan_checkpoint_sha"] or "none"
        lineage = item["replacement_lineage"]
        lineage_label = (
            f"#{lineage['pr']}@{lineage['start_sha']}" if lineage is not None else "none"
        )
        for role, field in (
            ("implementation", "implementation_task"),
            ("review", "review_task"),
        ):
            task = item[field]
            history_count = sum(
                1 for entry in item["task_history"] if entry["role"] == role
            )
            task_lines.append(
                f"- {item['id']} {role}: state={task['state']}; "
                f"attempt={task['attempt']}; revision={item['revision_epoch']}; "
                f"history={history_count}; "
                f"thread={task['thread_id'] or 'none'}; "
                f"client_thread={task['client_thread_id'] or 'none'}; "
                f"worktree={task['task_worktree'] or 'none'}; "
                f"launch={task['launch_marker'] or 'none'}; "
                f"bound_sha={task['bound_sha'] or 'none'}; "
                f"adoption_start_sha={task['adoption_start_sha'] or 'none'}; "
                f"roster_entry="
                f"{task['authorization_digest'] or 'none'}; "
                f"probe={task['companion_probe_receipt'] or 'none'}; "
                f"stop={task['stop_proof_receipt'] or 'none'}; "
                f"branch_release={task['branch_release_receipt'] or 'none'}; "
                f"branch_attachment={task['branch_attachment_receipt'] or 'none'}; "
                f"replacement={task['replacement_predicate_digest'] or 'none'}; "
                f"observation={task['replacement_observation_receipt'] or 'none'}; "
                f"implementation_receipt={task['implementation_receipt'] or 'none'}; "
                f"terminal_result={task['terminal_result'] or 'none'}; "
                f"verification_verdict={task['verification_verdict'] or 'none'}; "
                f"output_head={task['output_head_sha'] or 'none'}; "
                f"output_pr={task['output_pr'] or 'none'}; "
                f"review_receipt={task['review_receipt'] or 'none'}; "
                f"review_epoch={task['review_epoch'] or 'none'}; "
                f"replacement_lineage={lineage_label if role == 'implementation' else 'not_applicable'}; "
                f"plan_checkpoint={checkpoint if role == 'implementation' else 'not_applicable'}"
            )
    authorization = state["task_authorization"]
    planning = state["planning"]
    active_evidence = planning["evidence"][-1] if planning["evidence"] else None
    latest_applicability = (
        active_evidence["applicability"][-1]
        if active_evidence is not None and active_evidence["applicability"]
        else None
    )
    fresh_primary_required = (
        active_evidence is None
        or active_evidence["accepted_for_digest"]
        != planning["current_specification_digest"]
        or active_evidence["accepted_source_commit"]
        != planning["current_source_commit"]
    )
    pair_lines = [
        f"- {record['left_slice']} + {record['right_slice']}: "
        f"{record['verdict']}; assessment={record['assessment_digest']}"
        for record in state["parallel_assessments"]
    ]
    blind_binding = planning["blind_requirement"]
    blind_requirement = (
        None if blind_binding is None else blind_binding["requirement"]
    )
    lines = [
        "<!-- GENERATED FILE - DO NOT EDIT. Run work-state render. -->",
        "# Spec Work Status",
        "",
        f"- Work kind: `{state['work_kind']}`",
        f"- Work ID: `{state['work_id']}`",
        f"- Phase: `{state['phase']}`",
        f"- Revision: `{state['revision']}`",
        f"- Observed origin/main: `{state['observed_main_sha'] or 'not recorded'}`",
        f"- Task roster: "
        f"`{authorization['primary_digest'] if authorization else 'not recorded'}`",
        f"- Active slices: `{status_list(active)}`",
        f"- Last update: `{state['updated_at'] or 'not recorded'}`",
        "",
        "## ChatGPT Pro Planning Evidence",
        "",
        f"- Current specification digest: "
        f"`{planning['current_specification_digest'] or 'not recorded'}`",
        f"- Current source commit: "
        f"`{planning['current_source_commit'] or 'not recorded'}`",
        f"- Active response: "
        f"`{planning['active_response_digest'] or 'not recorded'}`",
        f"- Generated for: "
        f"`{active_evidence['generated_for_digest'] if active_evidence else 'not recorded'}`",
        f"- Accepted for: "
        f"`{active_evidence['accepted_for_digest'] if active_evidence else 'not recorded'}`",
        f"- Disposition: "
        f"`{active_evidence['contract_disposition'] if active_evidence else 'not recorded'}`",
        f"- Latest applicability: "
        f"`{latest_applicability['validation_result'] if latest_applicability else 'not recorded'}`",
        f"- Fresh primary required: `{'yes' if fresh_primary_required else 'no'}`",
        f"- Explicit Pro primary waiver: "
        f"`{'bound' if planning['pro_primary_waiver'] else 'not recorded'}`",
        "- Blind completeness: `"
        + (
            "decision required"
            if blind_requirement is None
            else (
                "not required (exact Pro plan)"
                if blind_requirement == "not_required_exact_pro_plan"
                else (
                    f"recorded ({blind_requirement})"
                    if planning["blind_completeness"]
                    else f"required ({blind_requirement})"
                )
            )
        )
        + "`",
        "",
        "## Slices",
        "",
    ]
    for label, identifiers in categories.items():
        lines.append(f"- {label}: {status_list(identifiers)}")
    lines.extend(
        [
            "",
            "## Acceptance",
            "",
            f"- Passed: {acceptance_counts['passed']}",
            f"- Failed: {acceptance_counts['failed']}",
            f"- Waived: {acceptance_counts['waived']}",
            f"- Pending: {acceptance_counts['pending']}",
            "",
            "## Tasks",
            "",
            *(task_lines or ["- none"]),
            "",
            "## Parallel Assessments",
            "",
            *(pair_lines or ["- none"]),
            "",
            "## Blockers",
            "",
            f"- {status_list(sorted(state['blockers']))}",
            "",
            "## Pull Requests",
            "",
            f"- {status_list(prs)}",
            "",
        ]
    )
    return "\n".join(lines)

def write_status(bundle: Path, state: dict) -> Path:
    path = safe_path(
        bundle,
        state["artifacts"]["status"],
        "status",
        required=False,
        markdown=True,
    )
    ensure_regular_file(path, "STATUS.md", required=False)
    atomic_write_text(
        path, render_status(state)
    )
    return path

def rollback_file(path: Path, previous: bytes | None) -> None:
    if previous is None:
        path.unlink(missing_ok=True)
        fsync_directory(path.parent)
        return
    atomic_write_bytes(path, previous)

def projection_warning(state: dict, error: StateError | OSError) -> dict:
    return {
        "artifact": state["artifacts"]["status"],
        "code": "status_projection_write_failed",
        "message": str(error),
        "recoverable": True,
    }

def result_with_projection_warning(
    result: dict,
    warning: dict | None,
) -> dict:
    if warning is None:
        return result
    return {**result, "projection_warning": warning}

def refresh_status_projection(bundle: Path, state: dict) -> dict | None:
    try:
        write_status(bundle, state)
    except (OSError, StateError) as error:
        return projection_warning(state, error)
    return None

def commit_projected_state(bundle: Path, state: dict) -> dict | None:
    state_path = bundle / "state.json"
    previous_state = state_path.read_bytes() if state_path.exists() else None
    try:
        atomic_write_json(state_path, state)
    except StateError as primary:
        try:
            current = state_path.read_bytes() if state_path.exists() else None
            if current != previous_state:
                rollback_file(state_path, previous_state)
        except (OSError, StateError) as error:
            raise StateError(
                f"{primary}; rollback failed for state.json: {error}"
            ) from primary
        raise
    return refresh_status_projection(bundle, state)

def mutate(
    bundle: Path,
    expected_revision: int,
    operation: Callable[[dict], None],
    *,
    allow_acceptance_drift: bool = False,
    allow_complete_reopen: bool = False,
    allow_digest_drift: set[str] | None = None,
    allow_authorization_drift: bool = False,
    allow_task_authorization_drift: bool = False,
    allow_parallel_drift: set[tuple[str, str]] | None = None,
    allow_specification_drift: bool = False,
    result_factory: Callable[[dict, bool], dict] | None = None,
) -> dict:
    with state_write_lock(bundle):
        current = read_state(
            bundle,
            allow_acceptance_drift=allow_acceptance_drift,
            allow_digest_drift=allow_digest_drift,
            allow_authorization_drift=allow_authorization_drift,
            allow_task_authorization_drift=allow_task_authorization_drift,
            allow_parallel_drift=allow_parallel_drift,
            allow_specification_drift=allow_specification_drift,
        )
        if current["revision"] != expected_revision:
            raise StateError(
                f"stale revision: expected {expected_revision}, current {current['revision']}"
            )
        if current["phase"] == "complete" and not allow_complete_reopen:
            raise StateError("complete state is immutable; use transition --reopen")
        updated = deepcopy(current)
        operation(updated)
        if result_factory is not None and updated == current:
            return result_factory(current, False)
        updated["observation_epoch_high_water"] = max(
            updated["observation_epoch_high_water"],
            max(recorded_evidence_epochs(updated), default=0),
        )
        updated["revision"] = current["revision"] + 1
        updated["updated_at"] = utc_now()
        validate_state(
            bundle,
            updated,
            allow_acceptance_drift=allow_acceptance_drift,
            allow_digest_drift=allow_digest_drift,
            allow_authorization_drift=allow_authorization_drift,
            allow_task_authorization_drift=allow_task_authorization_drift,
            allow_parallel_drift=allow_parallel_drift,
            allow_specification_drift=allow_specification_drift,
        )
        warning = commit_projected_state(bundle, updated)
        if result_factory is not None:
            return result_with_projection_warning(
                result_factory(updated, True), warning
            )
        return result_with_projection_warning(updated, warning)

def initialize_bundle(arguments: argparse.Namespace, bundle: Path) -> dict:
    state_path = bundle / "state.json"
    ensure_regular_file(state_path, "state.json", required=False)
    if state_path.exists():
        raise StateError("state.json already exists")
    configuration = work_configuration(arguments.work_kind)
    primary_name = configuration["primary_artifact"]
    feature_template = (
        "# Feature\n\n## Source / Issue\n\n## Goal\n\n## Scope\n\n## Non-Goals\n"
    )
    bug_fix_template = (
        "# Bug Fix\n\n"
        "## Source / Incident\n\n"
        "## Observed Behavior\n\n"
        "## Expected Behavior\n\n"
        "## Failed Invariant\n\n"
        "## Confirmed Owning Seam and Root Cause\n\n"
        "## Goal\n\n"
        "## Scope\n\n"
        "## Non-Goals\n\n"
        "## Compatibility Constraints\n\n"
        "## Document Authority\n\n"
        "## Open Decisions\n\n"
        "## Codex Task Roster\n\n"
        "- Status: pending\n"
    )
    templates = {
        primary_name: (
            feature_template if arguments.work_kind == "feature" else bug_fix_template
        ),
        "INTERVIEW.md": (
            "# Interview\n\n"
            "Record stable `GA-*` and `Q-*` entries. Zero user-asked questions "
            "are valid only when the request and inspected evidence settle "
            "every consequential decision, recorded as closed gray areas. "
            "An empty ledger cannot prove interview completion.\n"
        ),
        "DECISIONS.md": "# Decisions\n\nRecord accepted decisions as `DEC-001`, `DEC-002`, and so on.\n",
        "ACCEPTANCE.md": (
            "# Acceptance\n\n"
            "Record each criterion as one `## AC-NNN: title` block.\n"
        ),
    }
    for name, template in templates.items():
        path = bundle / name
        ensure_regular_file(path, name, required=False)
        if not path.exists():
            atomic_write_text(path, template)
    if arguments.work_kind == "bug_fix":
        discovery_templates = {
            "discovery/root-cause.md": (
                "# Root Cause\n\n"
                "- Status: pending\n"
                "- Owning seam: pending\n"
                "- Failed invariant: pending\n"
                "- Evidence: pending\n"
            ),
            "discovery/regression-test-abstraction.md": (
                "# Regression Test Abstraction\n\n"
                "- Status: pending\n\n"
                "```yaml\n"
                "test_abstraction_record:\n"
                "  incident_evidence: pending\n"
                "  invariant: pending\n"
                "  owning_seam: pending\n"
                "  equivalence_classes: pending\n"
                "  fixture_strategy: pending\n"
                "  essential_inputs: pending\n"
                "  observable_outcomes: pending\n"
                "  generalized_test_name: pending\n"
                "  identity_specific_details: pending\n"
                "  display_contract: pending\n"
                "```\n"
            ),
        }
        for relative, template in discovery_templates.items():
            path = bundle / relative
            ensure_regular_file(path, relative, required=False)
            if not path.exists():
                atomic_write_text(path, template)
    criteria = acceptance_criteria(
        bundle,
        {"artifacts": {"acceptance": "ACCEPTANCE.md"}},
    )
    state = {
        "schema": SCHEMA_ID,
        "work_kind": arguments.work_kind,
        "work_id": arguments.work_id,
        "phase": "discuss",
        "revision": 0,
        "observation_epoch_high_water": 0,
        "observed_main_sha": None,
        "planning": {
            "current_plan_digest": None,
            "current_specification_digest": None,
            "current_source_commit": None,
            "active_response_digest": None,
            "pro_primary_waiver": None,
            "blind_requirement": None,
            "blind_completeness": None,
            "evidence": [],
        },
        "task_authorization": None,
        "parallel_assessments": [],
        "artifacts": {
            "primary": primary_name,
            "interview": "INTERVIEW.md",
            "decisions": "DECISIONS.md",
            "acceptance": "ACCEPTANCE.md",
            "status": "STATUS.md",
        },
        "slices": [],
        "acceptance": {
            identifier: empty_acceptance_record(criteria[identifier])
            for identifier in sorted(criteria)
        },
        "completion_binding": None,
        "completion_specification_digest": None,
        "blockers": [],
        "updated_at": utc_now(),
    }
    validate_state(bundle, state)
    warning = commit_projected_state(bundle, state)
    validate_state(bundle, state)
    return result_with_projection_warning(state, warning)

def command_init(arguments: argparse.Namespace) -> dict:
    requested = validate_init_identity(
        arguments.bundle, arguments.work_kind, arguments.work_id
    )
    bundle = bundle_path(requested, create=True)
    with state_write_lock(bundle):
        return initialize_bundle(arguments, bundle)

def command_show(arguments: argparse.Namespace) -> dict:
    return read_state(bundle_path(arguments.bundle))

def command_record_specification(arguments: argparse.Namespace) -> dict:
    bundle = bundle_path(arguments.bundle)

    def operation(state: dict) -> None:
        if state["phase"] != "plan":
            raise StateError("record-specification applies only during plan")
        require_bug_planning_evidence(bundle, state)
        planning = state["planning"]
        digest = string_value(
            arguments.specification_digest,
            "specification digest",
            pattern=DIGEST_RE,
        )
        actual = completion_fact_digests(bundle, state)[1]
        if digest != actual:
            raise StateError("specification digest does not match current bundle bytes")
        commit = string_value(arguments.source_commit, "source commit", pattern=SHA_RE)
        require_commit_object(commit, "initial source commit")
        current_digest = planning["current_specification_digest"]
        current_commit = planning["current_source_commit"]
        if current_digest is not None:
            if planning["evidence"]:
                raise StateError(
                    "initial specification is already recorded; use Pro applicability "
                    "for a digest or source change"
                )
            if current_digest != digest:
                raise StateError(
                    "initial specification is already recorded; use Pro applicability "
                    "for a digest change"
                )
            if current_commit == commit:
                raise StateError(
                    "initial specification is already recorded for this source commit"
                )
        planning["current_specification_digest"] = digest
        planning["current_source_commit"] = commit

    return mutate(
        bundle,
        arguments.expect_revision,
        operation,
        allow_digest_drift={"*"},
    )


def terminal_fresh_pro_primary_lineage(
    planning: dict,
) -> tuple[dict, dict] | None:
    if not planning["evidence"]:
        return None
    active = planning["evidence"][-1]
    latest = active["applicability"][-1] if active["applicability"] else None
    if not (
        planning["active_response_digest"] == active["response_digest"]
        and latest is not None
        and latest["from_digest"] == active["accepted_for_digest"]
        and latest["from_source_commit"] == active["accepted_source_commit"]
        and latest["to_digest"] != latest["from_digest"]
        and latest["classification"] in {"material", "uncertain"}
        and latest["validation_result"] == "fresh_primary_required"
    ):
        return None
    return active, latest


def fresh_pro_primary_required(planning: dict) -> bool:
    lineage = terminal_fresh_pro_primary_lineage(planning)
    if lineage is None:
        return False
    _active, latest = lineage
    return (
        latest["to_digest"] == planning["current_specification_digest"]
        and latest["to_source_commit"] == planning["current_source_commit"]
    )


def command_record_pro_primary(arguments: argparse.Namespace) -> dict:
    bundle = bundle_path(arguments.bundle)

    def operation(state: dict) -> None:
        if state["phase"] != "plan":
            raise StateError("record-pro-primary applies only during plan")
        planning = state["planning"]
        current_digest = planning["current_specification_digest"]
        current_commit = planning["current_source_commit"]
        if current_digest is None or current_commit is None:
            raise StateError("record-specification is required before a Pro primary")
        prospective_artifacts = {
            relative_path_value(
                arguments.answer_artifact, "Pro answer artifact", markdown=True
            )
        }
        if arguments.repair_artifact is not None:
            prospective_artifacts.add(
                relative_path_value(
                    arguments.repair_artifact,
                    "Pro repair artifact",
                    markdown=True,
                )
            )
        if completion_fact_digests(
            bundle, state, extra_excluded=prospective_artifacts
        )[1] != current_digest:
            raise StateError("current specification digest is stale")
        if planning["evidence"]:
            if not fresh_pro_primary_required(planning):
                raise StateError(
                    "fresh Pro primary is not authorized for this specification digest"
                )
        response_digest = string_value(
            arguments.response_digest, "Pro response digest", pattern=DIGEST_RE
        )
        answer_artifact = relative_path_value(
            arguments.answer_artifact, "Pro answer artifact", markdown=True
        )
        used_artifacts = {
            path
            for evidence in planning["evidence"]
            for path in (
                evidence["answer_artifact"],
                evidence["manifest_artifact"],
                evidence["repair_artifact"],
            )
            if path is not None
        }
        if answer_artifact in used_artifacts:
            raise StateError("Pro artifacts are append-only and cannot be reused")
        answer = safe_path(
            bundle,
            answer_artifact,
            "Pro answer artifact",
            required=True,
            markdown=True,
        )
        if hashlib.sha256(answer.read_bytes()).hexdigest() != response_digest:
            raise StateError("Pro answer artifact digest mismatch")
        manifest_artifact = relative_path_value(
            arguments.manifest_artifact, "Pro context manifest"
        )
        if manifest_artifact in used_artifacts or manifest_artifact == answer_artifact:
            raise StateError("Pro artifacts are append-only and must be distinct")
        manifest_path = safe_path(
            bundle,
            manifest_artifact,
            "Pro context manifest",
            required=True,
        )
        manifest_artifact_digest = string_value(
            arguments.manifest_artifact_digest,
            "Pro context manifest artifact digest",
            pattern=DIGEST_RE,
        )
        if hashlib.sha256(manifest_path.read_bytes()).hexdigest() != (
            manifest_artifact_digest
        ):
            raise StateError("Pro context manifest artifact digest mismatch")
        disposition = enum_value(
            arguments.contract_disposition,
            "Pro contract disposition",
            CONTRACT_DISPOSITIONS,
        )
        annotations = arguments.annotation or []
        string_list(annotations, "Pro annotations")
        repair_artifact = arguments.repair_artifact
        repair_digest = arguments.repair_digest
        if (repair_artifact is None) != (repair_digest is None):
            raise StateError(
                "Pro repair artifact and digest must be provided together"
            )
        if repair_artifact is not None:
            repair_artifact = relative_path_value(
                repair_artifact, "Pro repair artifact", markdown=True
            )
            if repair_artifact in used_artifacts or repair_artifact == answer_artifact:
                raise StateError(
                    "Pro artifacts are append-only and must be distinct"
                )
            repair = safe_path(
                bundle,
                repair_artifact,
                "Pro repair artifact",
                required=True,
                markdown=True,
            )
            string_value(repair_digest, "Pro repair digest", pattern=DIGEST_RE)
            if hashlib.sha256(repair.read_bytes()).hexdigest() != repair_digest:
                raise StateError("Pro repair artifact digest mismatch")
        record = {
            "response_digest": response_digest,
            "answer_artifact": answer_artifact,
            "generated_for_digest": current_digest,
            "accepted_for_digest": current_digest,
            "repository": string_value(
                arguments.repository, "Pro repository", pattern=REPOSITORY_RE
            ),
            "source_branch": string_value(
                arguments.source_branch, "Pro source branch", maximum=240
            ),
            "generated_source_commit": current_commit,
            "accepted_source_commit": current_commit,
            "manifest_artifact": manifest_artifact,
            "manifest_artifact_digest": manifest_artifact_digest,
            "manifest_digest": string_value(
                arguments.manifest_digest,
                "Pro manifest digest",
                pattern=DIGEST_RE,
            ),
            "contract_disposition": disposition,
            "annotations": annotations,
            "repair_artifact": repair_artifact,
            "repair_digest": repair_digest,
            "applicability": [],
        }
        recovery = classify_pro_response_recovery(bundle, state, record)
        if recovery["recovery_class"] != "valid":
            raise StateError(str(recovery["message"]))
        projected_planning = {
            **planning,
            "evidence": [*planning["evidence"], record],
            "active_response_digest": response_digest,
            "current_plan_digest": None,
            "pro_primary_waiver": None,
            "blind_requirement": None,
            "blind_completeness": None,
        }
        projected_state = {**state, "planning": projected_planning}
        validate_pro_response_contract(bundle, projected_state, record)
        validate_planning_schema(projected_planning)
        require_current_pro_evidence(projected_state, bundle)
        planning["evidence"].append(record)
        planning["active_response_digest"] = response_digest
        planning["current_plan_digest"] = None
        planning["pro_primary_waiver"] = None
        planning["blind_requirement"] = None
        planning["blind_completeness"] = None

    return mutate(
        bundle,
        arguments.expect_revision,
        operation,
        allow_acceptance_drift=True,
        allow_digest_drift={"*"},
        allow_parallel_drift={("*", "*")},
        allow_specification_drift=True,
    )

def command_record_pro_applicability(arguments: argparse.Namespace) -> dict:
    bundle = bundle_path(arguments.bundle)

    def operation(state: dict) -> None:
        if state["phase"] != "plan":
            raise StateError("record-pro-applicability applies only during plan")
        planning = state["planning"]
        active = planning["active_response_digest"]
        if active is None:
            raise StateError("Pro applicability requires active primary evidence")
        evidence = planning["evidence"][-1]
        if evidence["accepted_for_digest"] != planning[
            "current_specification_digest"
        ] or evidence["accepted_source_commit"] != planning["current_source_commit"]:
            raise StateError(
                "fresh primary is required before another applicability assessment"
            )
        original_value, original_digest = typed_receipt(
            bundle,
            arguments.receipt,
            "Pro applicability",
            APPLICABILITY_RECEIPT_FIELDS,
        )
        record = {
            "from_digest": original_value["fromDigest"],
            "to_digest": original_value["toDigest"],
            "from_source_commit": original_value["fromSourceCommit"],
            "to_source_commit": original_value["toSourceCommit"],
            "classification": original_value["classification"],
            "changed_paths": original_value["changedPaths"],
            "recommendations_changed": original_value["recommendationsChanged"],
            "implementation_slices_changed": original_value[
                "implementationSlicesChanged"
            ],
            "validation_result": original_value["validationResult"],
            "evidence_anchors": original_value["evidenceAnchors"],
            "receipt": arguments.receipt,
            "receipt_digest": original_digest,
            "original_receipt": None,
            "original_receipt_digest": None,
            "correction_receipt": None,
            "correction_receipt_digest": None,
            "epoch": original_value["assessmentEpoch"],
        }
        correction_projection = None
        try:
            validate_applicability_value(
                bundle,
                state,
                evidence,
                record,
                original_value,
                require_current_binding=True,
            )
            value = original_value
        except StateError:
            if arguments.source_observation is None:
                raise
            string_value(
                original_value["toSourceCommit"],
                "original Pro applicability toSourceCommit",
                maximum=80,
            )
            (
                _source_observation,
                source_observation_digest,
                candidate,
            ) = source_observation_value(
                bundle,
                state,
                evidence,
                arguments.source_observation,
                require_current_head=True,
            )
            record["to_source_commit"] = candidate
            value = {**original_value, "toSourceCommit": candidate}
            validate_applicability_value(
                bundle,
                state,
                evidence,
                record,
                value,
                require_current_binding=True,
            )
            correction_projection = applicability_correction_projection(
                bundle,
                state,
                evidence,
                arguments.receipt,
                original_digest,
                original_value,
                arguments.source_observation,
                source_observation_digest,
                candidate,
            )
            record.update({
                field: correction_projection[field]
                for field in (
                    "receipt",
                    "receipt_digest",
                    "original_receipt",
                    "original_receipt_digest",
                    "correction_receipt",
                    "correction_receipt_digest",
                )
            })
        actual_digest = completion_fact_digests(bundle, state)[1]
        expected = {
            "responseDigest": active,
            "fromDigest": planning["current_specification_digest"],
            "toDigest": actual_digest,
            "fromSourceCommit": planning["current_source_commit"],
        }
        if any(
            value[field] != expected_value
            for field, expected_value in expected.items()
        ):
            raise StateError(
                "Pro applicability is not bound to the active evidence and current "
                "specification transition"
            )
        if value["toDigest"] == value["fromDigest"]:
            raise StateError(
                "Pro applicability requires a changed specification digest"
            )
        if value["assessmentEpoch"] <= max(evidence_epochs(state), default=0):
            raise StateError("Pro applicability epoch must advance monotonically")
        projected = deepcopy(planning)
        projected_evidence = projected["evidence"][-1]
        projected_evidence["applicability"].append(record)
        projected["current_specification_digest"] = value["toDigest"]
        projected["current_source_commit"] = value["toSourceCommit"]
        projected["current_plan_digest"] = None
        projected["pro_primary_waiver"] = None
        projected["blind_requirement"] = None
        projected["blind_completeness"] = None
        if value["classification"] == "non_material":
            projected_evidence["accepted_for_digest"] = value["toDigest"]
            projected_evidence["accepted_source_commit"] = value["toSourceCommit"]
        validate_planning_schema(projected)
        if correction_projection is not None:
            publish_applicability_correction(bundle, correction_projection)
        planning.clear()
        planning.update(projected)

    return mutate(
        bundle,
        arguments.expect_revision,
        operation,
        allow_acceptance_drift=True,
        allow_digest_drift={"*"},
        allow_authorization_drift=True,
        allow_parallel_drift={("*", "*")},
        allow_specification_drift=True,
    )

def command_record_blind_completeness(arguments: argparse.Namespace) -> dict:
    bundle = bundle_path(arguments.bundle)

    def operation(state: dict) -> None:
        if state["phase"] != "plan":
            raise StateError("record-blind-completeness applies only during plan")
        require_current_pro_evidence(state, bundle)
        binding = state["planning"]["blind_requirement"]
        requirement = None if binding is None else binding["requirement"]
        if requirement not in REQUIRED_BLIND_REQUIREMENTS:
            raise StateError(
                "record-blind-completeness requires a current required_* "
                "blind completeness decision"
            )
        if blind_audit_nonquiescent_task_labels(state):
            raise StateError(
                "blind completeness audit requires descendant quiescence"
            )
        value, binding = blind_completeness_receipt_value(
            bundle, state, arguments.receipt
        )
        if value["auditEpoch"] <= max(evidence_epochs(state), default=0):
            raise StateError(
                "blind completeness audit epoch must advance monotonically"
            )
        state["planning"]["blind_completeness"] = binding

    return mutate(
        bundle,
        arguments.expect_revision,
        operation,
        allow_digest_drift={"*"},
    )

def command_record_blind_requirement(arguments: argparse.Namespace) -> dict:
    bundle = bundle_path(arguments.bundle)

    def operation(state: dict) -> None:
        if state["phase"] != "plan":
            raise StateError("record-blind-requirement applies only during plan")
        require_current_pro_evidence(state, bundle)
        require_current_atomic_plan(bundle, state)
        requirement = enum_value(
            arguments.requirement,
            "blind completeness requirement",
            CALLER_SELECTABLE_BLIND_REQUIREMENTS,
        )
        state["planning"]["blind_requirement"] = {
            "requirement": requirement,
            "plan_digest": canonical_plan_digest(bundle, state),
        }
        state["planning"]["blind_completeness"] = None

    return mutate(
        bundle,
        arguments.expect_revision,
        operation,
        allow_digest_drift={"*"},
    )

def command_blind_context(arguments: argparse.Namespace) -> dict:
    bundle = bundle_path(arguments.bundle)
    state = read_state(bundle, allow_digest_drift={"*"})
    require_current_pro_evidence(state, bundle)
    binding = state["planning"]["blind_requirement"]
    requirement = None if binding is None else binding["requirement"]
    if requirement not in REQUIRED_BLIND_REQUIREMENTS:
        raise StateError(
            "blind-context requires a current required_* blind completeness "
            "decision"
        )
    plan_digest, _specification, source_pack_digest, _coverage = (
        completion_fact_digests(bundle, state)
    )
    nonquiescent = blind_audit_nonquiescent_task_labels(state)
    return {
        **generic_receipt_identity(bundle, state),
        "requirement": requirement,
        "planDigest": plan_digest,
        "approvedSourcePackDigest": source_pack_digest,
        "descendantQuiescenceVerdict": (
            "NONQUIESCENT" if nonquiescent else "QUIESCENT"
        ),
        "descendantQuiescenceDigest": descendant_quiescence_digest(state),
        "minimumAuditEpoch": max(evidence_epochs(state), default=0) + 1,
    }

def command_validate(arguments: argparse.Namespace) -> dict:
    bundle = bundle_path(arguments.bundle)
    with state_write_lock(bundle):
        state = read_state(bundle)
        validate_acceptance_provenance(
            bundle, state, validate_pending_assignment=state["phase"] != "discuss"
        )
        warning = refresh_status_projection(bundle, state)
    return result_with_projection_warning(
        {"ok": True, "phase": state["phase"], "revision": state["revision"]},
        warning,
    )

def command_ready(arguments: argparse.Namespace) -> dict:
    bundle = bundle_path(arguments.bundle)
    state = read_state(bundle)
    validate_acceptance_provenance(
        bundle, state, validate_pending_assignment=state["phase"] != "discuss"
    )
    trunk_ready, stackable = readiness(state)
    if (trunk_ready or stackable) and state["planning"]["active_response_digest"] is not None:
        require_current_pro_evidence(state, bundle)
    return {
        "trunk_ready": trunk_ready,
        "stackable": stackable,
        "revision": state["revision"],
    }


def command_reconcile_merged_delivery(arguments: argparse.Namespace) -> dict:
    bundle = bundle_path(arguments.bundle)
    fields = (
        arguments.id,
        arguments.pr,
        arguments.head_sha,
        arguments.merge_sha,
    )
    if not fields[0] or len({len(values) for values in fields}) != 1:
        raise StateError(
            "reconcile-merged-delivery requires aligned id, PR, head, and merge values"
        )
    identifiers = list(fields[0])
    if len(set(identifiers)) != len(identifiers):
        raise StateError("reconcile-merged-delivery contains duplicate slice ids")
    evidence = [
        {
            "id": identifier,
            "pr": pull,
            "head_sha": head,
            "merge_sha": merge,
        }
        for identifier, pull, head, merge in zip(*fields, strict=True)
    ]
    result: dict[str, object] = {}

    def operation(state: dict) -> None:
        if state["phase"] != "plan":
            raise StateError(
                "authoritative merged delivery may reconcile only during plan"
            )
        if state["blockers"]:
            raise StateError(
                "authoritative merged delivery cannot reconcile while blockers remain"
            )
        require_current_atomic_plan(bundle, state, required=True)
        require_current_pro_evidence(state, bundle)
        current_main = string_value(
            arguments.current_main_sha,
            "projected current main",
            pattern=SHA_RE,
        )
        require_commit_object(current_main, "projected current main")
        live_main = live_remote_ref_head(
            "origin", "refs/heads/main", "projected current main"
        )
        if live_main != current_main:
            raise StateError("projected current-main identity mismatch")

        items = slice_map(state)
        ui_contract = ui_design_contract(bundle, state)
        unknown = sorted(set(identifiers) - set(items))
        if unknown:
            raise StateError(
                "projection identity mismatch: unknown slices " + ", ".join(unknown)
            )
        nonterminal = [
            item for item in state["slices"]
            if item["status"] not in TERMINAL_SLICE_STATUSES
        ]
        expected_prefix = [item["id"] for item in nonterminal[:len(evidence)]]
        if identifiers != expected_prefix:
            if set(identifiers) == set(expected_prefix):
                raise StateError("projection dependency mismatch: slices are out of order")
            raise StateError("projection topology mismatch: delivery is not a prefix")

        verified: dict[str, dict[str, object]] = {}
        for record in evidence:
            identifier = str(record["id"])
            item = items[identifier]
            if item["status"] not in {"blocked", "pending", "pr_open"}:
                raise StateError(
                    f"{identifier} projection topology mismatch: unsupported status"
                )
            if item["branch"] is None:
                raise StateError(
                    f"{identifier} projection identity mismatch: planned branch is absent"
                )
            active_tasks = nonquiescent_task_labels(item)
            if active_tasks:
                raise StateError(
                    f"{identifier} projection requires tasks quiescent: "
                    + ", ".join(active_tasks)
                )
            head = string_value(
                record["head_sha"], f"{identifier} projected head", pattern=SHA_RE
            )
            merge = string_value(
                record["merge_sha"], f"{identifier} projected merge", pattern=SHA_RE
            )
            pull = integer_value(record["pr"], f"{identifier} projected PR", 1)
            delivery = live_pull_request_delivery(
                pull, f"{identifier} projected pull request"
            )
            if delivery != {
                "pr": pull,
                "head": head,
                "branch": item["branch"],
                "merge": merge,
            }:
                raise StateError(
                    f"{identifier} projected pull-request delivery identity mismatch"
                )
            retained_lineage = item["replacement_lineage"]
            retained_pr = (
                item["pr"]
                if item["status"] == "pr_open"
                else retained_lineage["pr"]
                if retained_lineage is not None
                else None
            )
            retained_head = (
                item["head_sha"]
                if item["status"] == "pr_open"
                else retained_lineage["start_sha"]
                if retained_lineage is not None
                else None
            )
            if retained_pr is not None and retained_pr != pull:
                raise StateError(
                    f"{identifier} projected retained PR identity mismatch"
                )
            if retained_head is not None:
                require_ancestor(
                    retained_head,
                    head,
                    f"{identifier} projected retained head identity mismatch",
                )
            parents = commit_parents(merge, f"{identifier} projected merge commit")
            if len(parents) != 2 or parents[1] != head:
                raise StateError(f"{identifier} projected merge-parent mismatch")
            require_ancestor(
                merge,
                current_main,
                f"{identifier} projected merge is not reachable from current main",
            )
            item_key = (item["wave"], item["id"])
            planned_predecessors = sorted(
                candidate["id"]
                for candidate in items.values()
                if candidate["status"] != "superseded"
                and (
                    (candidate["wave"], candidate["id"]) < item_key
                    if item["execution_mode"] == "serial"
                    else candidate["wave"] < item["wave"]
                )
            )
            required_predecessors = sorted(
                set(item["depends_on"]) | set(planned_predecessors)
            )
            for predecessor in required_predecessors:
                predecessor_record = verified.get(predecessor)
                predecessor_item = items[predecessor]
                predecessor_merge = (
                    str(predecessor_record["merge_sha"])
                    if predecessor_record is not None
                    else predecessor_item["merge_main_sha"]
                    if predecessor_item["status"] == "merged"
                    else None
                )
                if predecessor_merge is None:
                    raise StateError(
                        f"{identifier} projection planned-order mismatch: {predecessor}"
                    )
                require_ancestor(
                    predecessor_merge,
                    parents[0],
                    (
                        f"{identifier} projection dependency mismatch"
                        if predecessor in item["depends_on"]
                        else f"{identifier} projection planned-order mismatch"
                    ),
                )
            if ui_contract is not None:
                projected_state = deepcopy(state)
                projected_item = slice_map(projected_state)[identifier]
                projected_item.update({
                    "status": "pr_open",
                    "head_sha": head,
                    "pr": pull,
                })
                plan = state_slice_plan_contract(
                    bundle, projected_state, projected_item
                )
                automated = plan["automated"]
                if automated is not None:
                    require_recorded_automated_ui_acceptance(
                        bundle, projected_state, identifier, automated
                    )
                if ui_contract[0] == identifier:
                    require_recorded_final_ui_acceptance(
                        bundle, projected_state, ui_contract[0], ui_contract[1]
                    )
            verified[identifier] = {
                **record,
                "pr": pull,
                "head_sha": head,
                "merge_sha": merge,
                "base_sha": parents[0],
            }

        for identifier in identifiers:
            item = items[identifier]
            record = verified[identifier]
            item.update({
                "status": "merged",
                "receipt": None,
                "base_ref": "origin/main",
                "base_sha": record["base_sha"],
                "head_sha": record["head_sha"],
                "pr": record["pr"],
                "replacement_lineage": None,
                "implementation_task": empty_task(),
                "review_task": empty_task(),
                "task_history": [],
                "merge_receipt": None,
                "merge_receipt_digest": None,
                "merge_epoch": None,
                "merge_main_sha": record["merge_sha"],
                "terminal_freshness": None,
                "premerge_drift": None,
            })

        remaining = [
            item for item in state["slices"]
            if item["status"] not in TERMINAL_SLICE_STATUSES
        ]
        successor = remaining[0] if remaining else None
        if successor is not None:
            if (
                successor["status"] not in {"blocked", "pending"}
                or successor["receipt"] is not None
                or successor["head_sha"] is not None
                or successor["pr"] is not None
                or successor["replacement_lineage"] is not None
                or nonquiescent_task_labels(successor)
            ):
                raise StateError(
                    f"{successor['id']} projection successor identity is not dormant"
                )
            successor.update({
                "status": "pending",
                "base_ref": "origin/main",
                "base_sha": current_main,
                "replacement_lineage": None,
            })
        state["observed_main_sha"] = current_main
        trunk_ready, stackable = readiness(state)
        if successor is not None and successor["id"] not in trunk_ready:
            raise StateError(
                f"{successor['id']} projection did not expose ordinary readiness"
            )
        result.update({
            "projected": identifiers,
            "currentMainSha": current_main,
            "trunk_ready": trunk_ready,
            "stackable": stackable,
        })

    state = mutate(bundle, arguments.expect_revision, operation)
    return {
        **result,
        "revision": state["revision"],
    }

def apply_observed_main(bundle: Path, state: dict, observed_sha: str) -> None:
    string_value(observed_sha, "observed main SHA", pattern=SHA_RE)
    if state["observed_main_sha"] == observed_sha:
        return
    items = slice_map(state)
    deferred_carrier = terminal_snapshot_carrier(state)
    stale_roots = [
        item
        for item in state["slices"]
        if item["status"] not in TERMINAL_SLICE_STATUSES
        and item["id"] != deferred_carrier
        and item["base_ref"] == "origin/main"
        and item["base_sha"] != observed_sha
    ]
    affected_ids = {
        candidate["id"]
        for candidate in state["slices"]
        if candidate["status"] not in TERMINAL_SLICE_STATUSES
        and any(
            candidate["id"] == root["id"]
            or dependency_reaches(items, candidate["id"], root["id"])
            for root in stale_roots
        )
    }
    affected = [items[identifier] for identifier in sorted(affected_ids)]
    active = sorted(
        label
        for item in affected
        for label in base_invalidation_interlock_labels(item)
    )
    if active:
        raise StateError(
            "observed origin/main changed while stale or dependent tasks are nonquiescent: "
            + ", ".join(active)
        )
    for item in affected:
        if item["status"] == "pr_open":
            if item["review_task"]["state"] == "clean":
                persist_terminal_freshness(bundle, state, item, observed_sha)
            reopen_review_for_base_sync(
                bundle,
                state,
                item,
                observed_sha if item["base_ref"] == "origin/main" else None,
            )
        else:
            invalidate_attempt(bundle, state, item)
            if item["status"] != "blocked":
                item["status"] = "blocked"
    state["observed_main_sha"] = observed_sha


def apply_owner_observed_main(
    bundle: Path,
    state: dict,
    owner: dict,
    observed_sha: str,
    *,
    allow_peer_mutation: bool = True,
) -> None:
    string_value(observed_sha, "owner-observed main SHA", pattern=SHA_RE)
    if owner["base_ref"] != "origin/main":
        raise StateError(
            "current-owner base synchronization requires an origin/main slice"
        )
    if (
        state["observed_main_sha"] == observed_sha
        and owner["base_sha"] == observed_sha
    ):
        return
    items = slice_map(state)
    deferred_carrier = terminal_snapshot_carrier(state)
    stale_roots = [
        item
        for item in state["slices"]
        if item["status"] not in TERMINAL_SLICE_STATUSES
        and (
            item["id"] != deferred_carrier
            or item["id"] == owner["id"]
        )
        and item["base_ref"] == "origin/main"
        and item["base_sha"] != observed_sha
    ]
    affected_ids = {
        candidate["id"]
        for candidate in state["slices"]
        if candidate["status"] not in TERMINAL_SLICE_STATUSES
        and any(
            candidate["id"] == root["id"]
            or dependency_reaches(items, candidate["id"], root["id"])
            for root in stale_roots
        )
    }
    other_affected = [
        items[identifier]
        for identifier in sorted(affected_ids)
        if identifier != owner["id"]
    ]
    if other_affected and not allow_peer_mutation:
        raise StateError(
            "current-owner base synchronization cannot mutate peer slices: "
            + ", ".join(item["id"] for item in other_affected)
        )
    active = sorted(
        label
        for item in other_affected
        for label in base_invalidation_interlock_labels(item)
    )
    if active:
        raise StateError(
            "current-owner base synchronization has nonquiescent affected tasks: "
            + ", ".join(active)
        )
    owner["base_sha"] = observed_sha
    for item in other_affected:
        if item["status"] == "pr_open":
            reopen_review_for_base_sync(
                bundle,
                state,
                item,
                observed_sha if item["base_ref"] == "origin/main" else None,
            )
        else:
            invalidate_attempt(bundle, state, item)
            if item["status"] != "blocked":
                item["status"] = "blocked"
    state["observed_main_sha"] = observed_sha


def apply_owner_observed_base(
    bundle: Path,
    state: dict,
    owner: dict,
    observed_sha: str,
    *,
    allow_peer_mutation: bool = True,
) -> None:
    if owner["base_ref"] == "origin/main":
        apply_owner_observed_main(
            bundle,
            state,
            owner,
            observed_sha,
            allow_peer_mutation=allow_peer_mutation,
        )
        return
    string_value(observed_sha, "owner-observed stacked base SHA", pattern=SHA_RE)
    upstream = stackable_dependency(slice_map(state), owner)
    if (
        upstream is None
        or owner["base_ref"] != upstream["branch"]
        or upstream["head_sha"] != observed_sha
    ):
        raise StateError(
            "current-owner stacked base synchronization requires the clean direct "
            "upstream branch and head"
        )
    owner["base_sha"] = observed_sha


def command_observe_main(arguments: argparse.Namespace) -> dict:
    bundle = bundle_path(arguments.bundle)

    def operation(state: dict) -> None:
        apply_observed_main(bundle, state, arguments.sha)

    return mutate(bundle, arguments.expect_revision, operation)

def current_clean_terminal_lineage_entry(
    bundle: Path, state: dict, item: dict
) -> dict:
    task = item["review_task"]
    if task["state"] != "clean" or task["branch_attachment_receipt"] is None:
        raise StateError("terminal-clean delivery requires a current CLEAN review")
    terminal, digest = review_lease_terminal_value(
        bundle,
        state,
        item,
        task,
        task["branch_attachment_receipt"],
        target="clean",
        review_receipt=task["review_receipt"],
        persisted=True,
    )
    if (
        digest != task["branch_attachment_digest"]
        or terminal["observationEpoch"] != task["branch_attachment_epoch"]
    ):
        raise StateError("terminal-clean review receipt binding is stale")
    return {
        "receipt": task["branch_attachment_receipt"],
        "digest": digest,
        "epoch": terminal["observationEpoch"],
        "result": "CLEAN",
        "review_receipt": task["review_receipt"],
    }


def persist_terminal_freshness(
    bundle: Path, state: dict, item: dict, observed_main_sha: str
) -> None:
    if item["terminal_freshness"] is not None:
        return
    current = current_clean_terminal_lineage_entry(bundle, state, item)
    lineage = item["review_task"]["head_adoption_terminal_lineage"]
    if current not in lineage:
        lineage.append(current)
    item["terminal_freshness"] = {
        **{
            field: current[field]
            for field in ("receipt", "digest", "epoch", "review_receipt")
        },
        "observed_main_sha": observed_main_sha,
    }


def terminal_clean_delivery_context(
    bundle: Path, state: dict, item: dict
) -> dict:
    if (
        state["phase"] != "delivery"
        or item["status"] != "pr_open"
        or item["pr"] is None
        or item["head_sha"] is None
        or item["base_ref"] != "origin/main"
        or item["base_sha"] is None
    ):
        raise StateError(
            "terminal-clean delivery requires one open origin/main PR in delivery"
        )
    lineage = item["review_task"]["head_adoption_terminal_lineage"]
    freshness = item["terminal_freshness"]
    if freshness is None:
        raise StateError(
            "terminal-clean delivery requires persisted consumed freshness"
        )
    review_head_adoption_lineage_tip(
        bundle,
        state,
        item,
        item["review_task"],
        None,
        f"{item['id']} terminal-clean delivery",
    )
    current = current_clean_terminal_lineage_entry(bundle, state, item)
    observed = state["observed_main_sha"]
    if observed is None or observed != item["base_sha"]:
        raise StateError(
            "terminal-clean delivery consumed base differs from observed origin/main"
        )
    initial = {
        field: freshness[field]
        for field in ("receipt", "digest", "epoch", "review_receipt")
    }
    if {**initial, "result": "CLEAN"} not in lineage:
        raise StateError("terminal-clean freshness binding is absent from CLEAN lineage")
    precondition = {
        "workKind": state["work_kind"],
        "workId": state["work_id"],
        "sliceId": item["id"],
        "expectedPrNumber": item["pr"],
        "expectedHeadSha": item["head_sha"],
        "expectedBaseRef": item["base_ref"],
        "expectedBaseSha": observed,
        "initialCleanReceipt": initial["receipt"],
        "initialCleanReceiptDigest": initial["digest"],
        "currentCleanReceipt": current["receipt"],
        "currentCleanReceiptDigest": current["digest"],
        "observedMainSha": observed,
    }
    return {
        **precondition,
        "policyPreconditionDigest": canonical_digest(precondition),
        "freshnessComparisonConsumed": True,
        "freshnessComparisonRequired": False,
        "result": "READY_TO_MERGE",
    }


def premerge_transport_digest(value: object) -> str:
    payload = json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n"
    return hashlib.sha256(payload.encode("utf-8")).hexdigest()


def premerge_drift_value(
    bundle: Path,
    state: dict,
    item: dict,
    relative: str | None,
    context: dict,
) -> tuple[dict, str]:
    value, digest = typed_receipt(
        bundle,
        relative,
        f"{item['id']} premerge result",
        PREMERGE_RESULT_FIELDS,
    )
    if (
        value["schema"] != "spec-work-premerge-result"
        or value["result"] not in {
            "HEAD_DRIFT", "BASE_DRIFT_AFTER_CONSUMED_FRESHNESS"
        }
        or value["mergeMethod"] != "merge"
        or value["merged"] is not False
        or value["atomicCommitIdentityEnforced"] is not True
    ):
        raise StateError("premerge result is not a supported typed atomic drift")
    for field in (
        "requestDigest", "operationDigest", "providerCommandDigest",
        "policyPreconditionDigest",
    ):
        string_value(value[field], f"premerge result {field}", pattern=DIGEST_RE)
    provider = string_value(value["provider"], "premerge provider")
    if value["reconciliationCommandDigest"] is not None:
        string_value(
            value["reconciliationCommandDigest"],
            "premerge reconciliation command digest",
            pattern=DIGEST_RE,
        )
    for field in (
        "expectedHeadSha", "expectedBaseSha", "observedHeadSha", "observedBaseSha"
    ):
        string_value(value[field], f"premerge result {field}", pattern=SHA_RE)
    integer_value(value["expectedPrNumber"], "premerge expected PR", 1)
    integer_value(value["observedPrNumber"], "premerge observed PR", 1)
    integer_value(value["providerStatus"], "premerge provider status", 0)
    integer_value(value["observationEpoch"], "premerge observation epoch", 1)
    if value["mergeCommitSha"] is not None or value["mergeCommitParents"] != []:
        raise StateError("premerge drift result cannot contain merge evidence")
    request = {
        "schema": "spec-work-premerge-operation",
        "workKind": state["work_kind"],
        "workId": state["work_id"],
        "sliceId": item["id"],
        "expectedPrNumber": context["expectedPrNumber"],
        "expectedHeadSha": context["expectedHeadSha"],
        "expectedBaseRef": context["expectedBaseRef"],
        "expectedBaseSha": context["expectedBaseSha"],
        "mergeMethod": "merge",
        "policyPreconditionDigest": context["policyPreconditionDigest"],
        "observationEpoch": value["observationEpoch"],
    }
    if value["requestDigest"] != premerge_transport_digest(request):
        raise StateError("premerge result request digest is stale")
    operation = {
        "request": request,
        "provider": provider,
        "providerCommandDigest": value["providerCommandDigest"],
        "reconciliationCommandDigest": value["reconciliationCommandDigest"],
    }
    if value["operationDigest"] != premerge_transport_digest(operation):
        raise StateError("premerge result operation digest is stale")
    expected = {
        "workKind": state["work_kind"],
        "workId": state["work_id"],
        "sliceId": item["id"],
        "expectedPrNumber": context["expectedPrNumber"],
        "expectedHeadSha": context["expectedHeadSha"],
        "expectedBaseRef": context["expectedBaseRef"],
        "expectedBaseSha": context["expectedBaseSha"],
        "observedPrNumber": context["expectedPrNumber"],
        "policyPreconditionDigest": context["policyPreconditionDigest"],
    }
    mismatched = [
        field for field, expected_value in expected.items()
        if value[field] != expected_value
    ]
    if mismatched:
        raise StateError(
            "premerge drift lost the consumed base or request identity: "
            + ", ".join(mismatched)
        )
    if value["result"] == "HEAD_DRIFT":
        if value["observedHeadSha"] == value["expectedHeadSha"]:
            raise StateError("HEAD_DRIFT result contains no head drift")
    else:
        if value["observedHeadSha"] != value["expectedHeadSha"]:
            raise StateError("BASE_DRIFT result also changed the reviewed head")
        if value["observedBaseSha"] == value["expectedBaseSha"]:
            raise StateError("BASE_DRIFT result contains no base drift")
    return value, digest


def persisted_premerge_drift_value(
    bundle: Path, state: dict, item: dict
) -> tuple[dict, str] | None:
    binding = item["premerge_drift"]
    if binding is None:
        return None
    value, digest = typed_receipt(
        bundle,
        binding["receipt"],
        f"{item['id']} persisted premerge drift",
        PREMERGE_RESULT_FIELDS,
    )
    if digest != binding["digest"] or value["observationEpoch"] != binding["epoch"]:
        raise StateError("persisted premerge drift binding is stale")
    if (
        value["schema"] != "spec-work-premerge-result"
        or value["workKind"] != state["work_kind"]
        or value["workId"] != state["work_id"]
        or value["sliceId"] != item["id"]
        or value["result"] not in {
            "HEAD_DRIFT", "BASE_DRIFT_AFTER_CONSUMED_FRESHNESS"
        }
        or value["mergeMethod"] != "merge"
        or value["merged"] is not False
        or value["atomicCommitIdentityEnforced"] is not True
        or value["mergeCommitSha"] is not None
        or value["mergeCommitParents"] != []
    ):
        raise StateError("persisted premerge drift receipt is not authentic")
    for field in (
        "requestDigest", "operationDigest", "providerCommandDigest",
        "policyPreconditionDigest",
    ):
        string_value(value[field], f"persisted premerge drift {field}", pattern=DIGEST_RE)
    if value["reconciliationCommandDigest"] is not None:
        string_value(
            value["reconciliationCommandDigest"],
            "persisted premerge drift reconciliationCommandDigest",
            pattern=DIGEST_RE,
        )
    for field in (
        "expectedHeadSha", "expectedBaseSha", "observedHeadSha", "observedBaseSha"
    ):
        string_value(value[field], f"persisted premerge drift {field}", pattern=SHA_RE)
    integer_value(value["expectedPrNumber"], "persisted premerge expected PR", 1)
    integer_value(value["observedPrNumber"], "persisted premerge observed PR", 1)
    integer_value(value["providerStatus"], "persisted premerge provider status", 0)
    if value["observedPrNumber"] != value["expectedPrNumber"]:
        raise StateError("persisted premerge drift changed PR identity")
    if value["result"] == "HEAD_DRIFT":
        if value["observedHeadSha"] == value["expectedHeadSha"]:
            raise StateError("persisted HEAD_DRIFT contains no head drift")
    elif (
        value["observedHeadSha"] != value["expectedHeadSha"]
        or value["observedBaseSha"] == value["expectedBaseSha"]
    ):
        raise StateError("persisted BASE_DRIFT has invalid head/base evidence")
    request = {
        "schema": "spec-work-premerge-operation",
        "workKind": value["workKind"],
        "workId": value["workId"],
        "sliceId": value["sliceId"],
        "expectedPrNumber": value["expectedPrNumber"],
        "expectedHeadSha": value["expectedHeadSha"],
        "expectedBaseRef": value["expectedBaseRef"],
        "expectedBaseSha": value["expectedBaseSha"],
        "mergeMethod": value["mergeMethod"],
        "policyPreconditionDigest": value["policyPreconditionDigest"],
        "observationEpoch": value["observationEpoch"],
    }
    operation = {
        "request": request,
        "provider": value["provider"],
        "providerCommandDigest": value["providerCommandDigest"],
        "reconciliationCommandDigest": value["reconciliationCommandDigest"],
    }
    if (
        value["requestDigest"] != premerge_transport_digest(request)
        or value["operationDigest"] != premerge_transport_digest(operation)
    ):
        raise StateError("persisted premerge drift transport binding is stale")
    return value, digest


def command_terminal_clean_delivery(arguments: argparse.Namespace) -> dict:
    bundle = bundle_path(arguments.bundle)
    result: dict = {}

    def operation(state: dict) -> None:
        nonlocal result
        item = slice_map(state).get(arguments.id)
        if item is None:
            raise StateError(f"unknown terminal-clean slice: {arguments.id}")
        if (
            arguments.observed_main_sha is not None
            and arguments.merge_result is not None
        ):
            raise StateError(
                "terminal-clean delivery accepts one freshness observation or merge result"
            )
        lineage = item["review_task"]["head_adoption_terminal_lineage"]
        if arguments.observed_main_sha is not None:
            if item["terminal_freshness"] is not None:
                raise StateError("terminal-clean freshness comparison was already consumed")
            observed = string_value(
                arguments.observed_main_sha,
                "terminal-clean observed main SHA",
                pattern=SHA_RE,
            )
            if (
                state["observed_main_sha"] != observed
                or item["base_sha"] != observed
            ):
                raise StateError(
                    "terminal-clean unchanged-main observation differs from the clean base"
                )
            persist_terminal_freshness(bundle, state, item, observed)
        context = terminal_clean_delivery_context(bundle, state, item)
        if arguments.merge_result is None:
            result = context
            return
        drift, drift_digest = premerge_drift_value(
            bundle, state, item, arguments.merge_result, context
        )
        epoch = drift["observationEpoch"]
        if epoch <= max(evidence_epochs(state), default=0):
            raise StateError("premerge observation epoch must advance monotonically")
        item["premerge_drift"] = {
            "receipt": arguments.merge_result,
            "digest": drift_digest,
            "epoch": epoch,
        }
        if drift["result"] == "HEAD_DRIFT":
            base_drifted = drift["observedBaseSha"] != context["expectedBaseSha"]
            if base_drifted:
                apply_owner_observed_main(
                    bundle, state, item, drift["observedBaseSha"]
                )
            reopen_review_for_base_sync(
                bundle,
                state,
                item,
                drift["observedBaseSha"] if base_drifted else None,
            )
            item["head_sha"] = drift["observedHeadSha"]
            item["review_task"]["bound_sha"] = drift["observedHeadSha"]
            result = {
                "result": (
                    "BASE_SYNC_AND_HEAD_REVALIDATION_REQUIRED"
                    if base_drifted
                    else "HEAD_REVALIDATION_REQUIRED"
                ),
                **(
                    {"priorConsumedBaseSha": context["expectedBaseSha"]}
                    if base_drifted
                    else {}
                ),
                "consumedBaseSha": drift["observedBaseSha"],
                "observedHeadSha": drift["observedHeadSha"],
                "mergeResultDigest": drift_digest,
                "freshnessComparisonConsumed": True,
                "freshnessComparisonRequired": False,
            }
        else:
            apply_owner_observed_main(
                bundle, state, item, drift["observedBaseSha"]
            )
            reopen_review_for_base_sync(
                bundle, state, item, drift["observedBaseSha"]
            )
            result = {
                "result": "BASE_SYNC_REQUIRED",
                "priorConsumedBaseSha": context["expectedBaseSha"],
                "consumedBaseSha": drift["observedBaseSha"],
                "mergeResultDigest": drift_digest,
                "freshnessComparisonConsumed": True,
                "freshnessComparisonRequired": False,
            }
        state["observation_epoch_high_water"] = epoch

    return mutate(
        bundle,
        arguments.expect_revision,
        operation,
        result_factory=lambda state, _changed: {**state, **result},
    )


def command_adopt_review_head(arguments: argparse.Namespace) -> dict:
    bundle = bundle_path(arguments.bundle)

    def operation(state: dict) -> None:
        item = slice_map(state).get(arguments.id)
        if item is None:
            raise StateError(f"unknown review head-adoption slice: {arguments.id}")
        task = item["review_task"]
        if (
            state["phase"] != "delivery"
            or item["status"] != "pr_open"
            or item["pr"] is None
            or item["head_sha"] is None
            or item["base_ref"] is None
            or item["base_sha"] is None
        ):
            raise StateError(
                "review head adoption requires a bound open PR in delivery"
            )
        if task["state"] != "creating":
            raise StateError(
                "review head adoption requires the current creating reservation"
            )
        if task["thread_id"] is None and task["client_thread_id"] is None:
            raise StateError(
                "review head adoption requires an observed external task identity"
            )
        if task["head_adoption_receipt"] is not None:
            raise StateError("review head adoption cannot replace existing proof")
        if item["implementation_task"]["state"] != "quiescent":
            raise StateError(
                "review head adoption requires quiescent implementation"
            )
        receipt, digest = review_head_adoption_receipt_value(
            bundle, state, item, task, arguments.receipt
        )
        epoch = receipt["observationEpoch"]
        used_epochs = evidence_epochs(state)
        if epoch in used_epochs or (used_epochs and epoch <= max(used_epochs)):
            raise StateError(
                "review head-adoption epoch must advance monotonically"
            )
        apply_owner_observed_base(bundle, state, item, receipt["newBaseSha"])
        item["head_sha"] = receipt["newHeadSha"]
        task["head_adoption_receipt"] = arguments.receipt
        task["head_adoption_digest"] = digest
        task["head_adoption_epoch"] = epoch

    return mutate(bundle, arguments.expect_revision, operation)


def require_fresh_plan_bootstrap(state: dict) -> None:
    planning = state["planning"]
    has_planning_authority = (
        state["slices"]
        or state["task_authorization"] is not None
        or state["parallel_assessments"]
        or planning["current_plan_digest"] is not None
        or planning["current_specification_digest"] is not None
        or planning["current_source_commit"] is not None
        or planning["active_response_digest"] is not None
        or planning["evidence"]
        or planning["pro_primary_waiver"] is not None
        or planning["blind_requirement"] is not None
        or planning["blind_completeness"] is not None
        or state["completion_binding"] is not None
        or state["completion_specification_digest"] is not None
    )
    has_acceptance_history = any(
        record != empty_acceptance_record(record["criterion_digest"])
        for record in state["acceptance"].values()
    )
    if has_planning_authority or has_acceptance_history:
        raise StateError(
            "Plan bootstrap requires a fresh pre-Pro Plan without prior "
            "planning, delivery, or acceptance authority"
        )


def command_adopt_plan(arguments: argparse.Namespace) -> dict:
    bundle = bundle_path(arguments.bundle)
    proposal_path = plan_proposal_file(arguments.proposal)
    waiver_reason = arguments.pro_primary_waiver_reason
    waiver_receipt = arguments.pro_primary_waiver_blind_receipt
    waiver_disposition = arguments.pro_primary_waiver_disposition
    if waiver_disposition == "source_access_recovery":
        if waiver_receipt is None:
            raise StateError(
                "source-access local Plan recovery requires a blind receipt"
            )
        if waiver_reason is not None:
            raise StateError(
                "source-access local Plan recovery does not accept a "
                "caller-supplied reason"
            )
        waiver_reason = (
            "Coordinator synthesized the exact local Plan after a "
            "source-evidence retrieval limitation."
        )
    waiver_requested = waiver_reason is not None and waiver_receipt is not None
    if (waiver_reason is None) != (waiver_receipt is None):
        raise StateError(
            "Pro primary waiver reason and blind receipt must be supplied together"
        )
    if waiver_reason is not None:
        string_value(waiver_reason, "Pro primary waiver reason", maximum=500)
        if not waiver_reason.strip():
            raise StateError(
                "Pro primary waiver reason must contain non-whitespace content"
            )
    if not waiver_requested and waiver_disposition != "fresh_primary":
        raise StateError(
            "local Plan recovery disposition requires its authority reason "
            "and blind receipt"
        )
    local_recovery_requested = (
        waiver_requested and waiver_disposition != "fresh_primary"
    )
    local_continuation_digest: str | None = None

    def operation(state: dict) -> None:
        nonlocal local_continuation_digest
        if state["phase"] != "plan":
            raise StateError("adopt-plan applies only during plan")
        require_bug_planning_evidence(bundle, state)
        proposal = plan_proposal_value(bundle, state, proposal_path)
        if proposal["semantic_artifacts"] != approved_source_inventory(bundle, state):
            raise StateError(
                "Plan proposal semantic artifact pack is stale against current bytes"
            )
        specification_digest = completion_fact_digests(bundle, state)[1]
        if proposal["specification_digest"] != specification_digest:
            raise StateError(
                "Plan proposal specification digest does not match current bundle bytes"
            )
        require_commit_object(proposal["source_commit"], "Plan proposal source commit")
        bootstrap = proposal["active_response_digest"] is None
        exact_waiver_replay = False
        waiver_amendment = False
        if local_recovery_requested:
            planning = state["planning"]
            if (
                not bootstrap
                or planning["active_response_digest"] is not None
                or planning["evidence"]
                or planning["current_specification_digest"]
                not in {None, proposal["specification_digest"]}
                or planning["current_source_commit"]
                not in {None, proposal["source_commit"]}
            ):
                raise StateError(
                    "local Plan recovery requires an evidenceless exact current candidate"
                )
            require_current_approved_sources_at_commit(
                bundle,
                state,
                proposal["source_commit"],
                "local Plan recovery source commit",
            )
            _, local_continuation_digest = validated_local_plan_continuation(
                bundle,
                state,
                waiver_disposition,
                proposal["specification_digest"],
                proposal["source_commit"],
            )
            state["planning"]["current_specification_digest"] = proposal[
                "specification_digest"
            ]
            state["planning"]["current_source_commit"] = proposal["source_commit"]
            state["planning"]["active_response_digest"] = None
        elif bootstrap:
            require_fresh_plan_bootstrap(state)
        else:
            evidence = state["planning"]["evidence"]
            exact_current_evidence = (
                bool(evidence)
                and evidence[-1]["response_digest"]
                == proposal["active_response_digest"]
                and evidence[-1]["accepted_for_digest"]
                == proposal["specification_digest"]
                and evidence[-1]["accepted_source_commit"]
                == proposal["source_commit"]
            )
            existing_waiver = state["planning"]["pro_primary_waiver"]
            existing_blind = state["planning"]["blind_completeness"]
            existing_blind_receipt_digest = None
            existing_waiver_lineage = None
            if (
                waiver_requested
                and existing_waiver is not None
                and existing_blind is not None
            ):
                _, existing_blind_receipt_digest = typed_receipt(
                    bundle,
                    existing_blind["receipt"],
                    "existing Pro primary waiver blind completeness audit",
                    BLIND_COMPLETENESS_RECEIPT_FIELDS,
                )
                existing_waiver_lineage = terminal_fresh_pro_primary_lineage(
                    state["planning"]
                )
            existing_waiver_transaction = (
                waiver_requested
                and existing_waiver is not None
                and existing_blind is not None
                and existing_blind["receipt_digest"]
                == existing_blind_receipt_digest
                and existing_waiver_lineage is not None
                and existing_waiver["reason"] == waiver_reason
                and existing_waiver["active_response_digest"]
                == state["planning"]["active_response_digest"]
                and existing_waiver["specification_digest"]
                == state["planning"]["current_specification_digest"]
                and existing_waiver["source_commit"]
                == state["planning"]["current_source_commit"]
                and existing_waiver["plan_digest"]
                == state["planning"]["current_plan_digest"]
                and existing_waiver["blind_receipt_digest"]
                == existing_blind["receipt_digest"]
                and state["planning"]["blind_requirement"]
                == {
                    "requirement": "required_user_requested",
                    "plan_digest": state["planning"]["current_plan_digest"],
                }
            )
            if existing_waiver_transaction:
                require_descendant_commit(
                    existing_waiver_lineage[1]["to_source_commit"],
                    existing_waiver["source_commit"],
                    "Existing Pro primary waiver final source commit",
                )
            exact_waiver_replay = (
                existing_waiver_transaction
                and existing_blind["receipt"] == waiver_receipt
                and proposal["active_response_digest"]
                == state["planning"]["active_response_digest"]
                and proposal["specification_digest"]
                == state["planning"]["current_specification_digest"]
                and proposal["source_commit"]
                == state["planning"]["current_source_commit"]
            )
            waiver_amendment = (
                existing_waiver_transaction
                and proposal["active_response_digest"]
                == state["planning"]["active_response_digest"]
                and proposal["source_commit"]
                != state["planning"]["current_source_commit"]
            )
            exact_waiver_candidate = (
                waiver_requested
                and proposal["active_response_digest"]
                == state["planning"]["active_response_digest"]
                and (
                    fresh_pro_primary_required(state["planning"])
                    or exact_waiver_replay
                    or waiver_amendment
                )
            )
            if waiver_requested and not exact_waiver_candidate:
                raise StateError(
                    "Pro primary waiver requires the exact current fresh-primary "
                    "planning candidate"
                )
            if exact_waiver_candidate:
                require_descendant_commit(
                    state["planning"]["current_source_commit"],
                    proposal["source_commit"],
                    "Pro primary waiver final source commit",
                )
                require_current_approved_sources_at_commit(
                    bundle,
                    state,
                    proposal["source_commit"],
                    "Pro primary waiver final source commit",
                )
            if not waiver_requested and not exact_current_evidence:
                raise StateError(
                    "Plan proposal Pro evidence is not applicable to its "
                    "specification and source"
                )

        original = deepcopy(state)
        existing = slice_map(state)
        proposed_ids = [item["id"] for item in proposal["slices"]]
        missing_existing = sorted(set(existing) - set(proposed_ids))
        if missing_existing:
            raise StateError(
                "Plan proposal cannot remove existing slice history: "
                + ", ".join(missing_existing)
            )
        proposed_by_id = {
            item["id"]: item
            for item in proposal["slices"]
        }
        ordered_proposals = [
            proposed_by_id[item["id"]]
            for item in state["slices"]
        ]
        ordered_proposals.extend(
            proposed
            for proposed in proposal["slices"]
            if proposed["id"] not in existing
        )
        merged_slices: list[dict] = []
        for proposed in ordered_proposals:
            item = existing.get(proposed["id"])
            if item is None:
                item = plan_proposal_slice(proposed)
            else:
                current_projection = plan_owned_slice_projection(item)
                proposed_projection = proposal_slice_projection(proposed)
                plan_fields_changed = any(
                    current_projection[field] != proposed_projection[field]
                    for field in (
                        "title", "plan", "depends_on", "wave",
                        "execution_mode", "owned_paths",
                    )
                )
                plan_bytes_changed = (
                    current_projection["plan_digest"]
                    != proposed_projection["plan_digest"]
                )
                binding_changed = any(
                    current_projection[field] != proposed_projection[field]
                    for field in ("branch", "base_ref", "base_sha")
                )
                if (
                    item["status"] in TERMINAL_SLICE_STATUSES
                    and item["plan_checkpoint_sha"] is None
                    and proposed["plan_digest"] != item["plan_digest"]
                ):
                    raise StateError(
                        f"{item['id']} terminal Plan bytes are immutable"
                    )
                retained_checkpoint_digest = None
                if (
                    item["status"] not in {"pending", "blocked"}
                    and item["plan_checkpoint_sha"] is not None
                ):
                    retained_checkpoint_digest = hashlib.sha256(
                        checkpointed_slice_plan_bytes(
                            bundle,
                            item,
                            item["plan_checkpoint_sha"],
                            f"{item['id']} active or shipped Plan checkpoint",
                        )
                    ).hexdigest()
                    if (
                        plan_bytes_changed
                        and item["plan_digest"] != retained_checkpoint_digest
                    ):
                        raise StateError(
                            f"{item['id']} retained Plan digest differs "
                            "from checkpoint"
                        )
                active_reauthorization_candidate = (
                    plan_bytes_changed
                    and item["status"] == "pr_open"
                    and retained_checkpoint_digest is not None
                )
                if active_reauthorization_candidate:
                    implementation = item["implementation_task"]
                    review = item["review_task"]
                    if (
                        implementation["state"] != "quiescent"
                        or implementation["terminal_result"] != "SUCCEEDED"
                        or implementation["output_pr"] != item["pr"]
                        or review["state"] != "blocked"
                        or review["branch_attachment_digest"] is None
                        or review["branch_attachment_epoch"] is None
                        or review["branch_release_digest"] is None
                        or review["branch_release_epoch"] is None
                        or review["branch_release_epoch"]
                        <= review["branch_attachment_epoch"]
                    ):
                        raise StateError(
                            "active Plan adoption requires the blocked review "
                            "owner to record fresh branch-release proof"
                        )
                    evidence = (
                        state["planning"]["evidence"][-1]
                        if state["planning"]["evidence"]
                        else None
                    )
                    source_path = repository_relative_source_path(
                        bundle, item["plan"]
                    )
                    if (
                        evidence is None
                        or evidence["response_digest"]
                        != proposal["active_response_digest"]
                        or context_manifest_source_digest(
                            bundle, state, evidence, source_path
                        ) != proposed_projection["plan_digest"]
                    ):
                        raise StateError(
                            "active Plan candidate is absent from fresh Pro "
                            "context manifest"
                        )
                if (
                    plan_bytes_changed
                    and item["status"] not in {"pending", "blocked"}
                    and not active_reauthorization_candidate
                ):
                    raise StateError(
                        f"{item['id']} active or shipped Plan bytes are immutable"
                    )
                if (
                    plan_fields_changed
                    and item["status"] not in {"pending", "blocked"}
                ):
                    raise StateError(
                        f"{item['id']} active or shipped Plan fields are immutable"
                    )
                merged_dependency_base = any(
                    existing[dependency_id]["status"] == "merged"
                    and existing[dependency_id]["branch"] == item["base_ref"]
                    and existing[dependency_id]["head_sha"] == item["base_sha"]
                    for dependency_id in item["depends_on"]
                )
                observed_base_recovery = (
                    item["status"] in {"pending", "blocked"}
                    and item["branch"] == proposed["branch"]
                    and proposed["base_ref"] == "origin/main"
                    and proposed["base_sha"] == state["observed_main_sha"]
                    and item["implementation_task"]["state"]
                    in {"unbound", "superseded"}
                    and item["review_task"]["state"]
                    in {"unbound", "superseded"}
                    and (
                        (
                            item["base_ref"] == "origin/main"
                            and item["base_sha"] != state["observed_main_sha"]
                        )
                        or merged_dependency_base
                    )
                )
                if (
                    binding_changed
                    and slice_has_delivery_identity(item)
                    and not observed_base_recovery
                ):
                    raise StateError(
                        f"{item['id']} Plan proposal cannot change delivery-owned "
                        "branch/base identity"
                    )
                for field in (
                    "title", "plan", "depends_on", "wave", "execution_mode",
                    "owned_paths", "branch", "base_ref", "base_sha",
                    "plan_digest",
                ):
                    item[field] = deepcopy(proposed[field])
            if (
                item["status"] not in TERMINAL_SLICE_STATUSES
                and item["base_ref"] == "origin/main"
                and item["base_sha"] != state["observed_main_sha"]
            ):
                raise StateError(
                    f"{item['id']} Plan proposal targets a stale origin/main base"
                )
            merged_slices.append(item)
        state["slices"] = merged_slices
        items = slice_map(state)
        validate_dependencies(items)
        for item in items.values():
            if item["status"] in TERMINAL_SLICE_STATUSES:
                continue
            for dependency in item["depends_on"]:
                dependency_item = items[dependency]
                if dependency_item["status"] == "superseded":
                    raise StateError(
                        "Plan proposal dependency is superseded: "
                        f"{item['id']} -> {dependency}"
                    )
        validate_bindings(items)
        nonterminal = [
            item
            for item in items.values()
            if item["status"] not in TERMINAL_SLICE_STATUSES
        ]
        for item in nonterminal:
            if item["execution_mode"] == "serial" and item["branch"] is not None:
                require_current_base(state, item)
        validate_wave_execution_modes(items, nonterminal)
        for item in nonterminal:
            for dependency in item["depends_on"]:
                dependency_item = items[dependency]
                same_parallel_wave = (
                    item["execution_mode"] == "parallel"
                    and dependency_item["execution_mode"] == "parallel"
                    and item["wave"] == dependency_item["wave"]
                )
                if (
                    dependency_item["status"] not in TERMINAL_SLICE_STATUSES
                    and not same_parallel_wave
                    and (dependency_item["wave"], dependency_item["id"])
                    >= (item["wave"], item["id"])
                ):
                    raise StateError(
                        "Plan proposal dependency does not precede dependent: "
                        f"{item['id']} -> {dependency}"
                    )

        state["parallel_assessments"] = deepcopy(
            proposal["parallel_assessments"]
        )
        required_pairs: set[tuple[str, str]] = set()
        parallel_groups: list[list[dict]] = []
        for wave in sorted({item["wave"] for item in nonterminal}):
            group = sorted(
                (
                    item for item in nonterminal
                    if item["wave"] == wave
                    and item["execution_mode"] == "parallel"
                ),
                key=lambda item: item["id"],
            )
            if not group:
                continue
            if len(group) < 2:
                terminal_peers = [
                    item
                    for item in items.values()
                    if item["wave"] == wave
                    and item["execution_mode"] == "parallel"
                    and item["status"] in TERMINAL_SLICE_STATUSES
                ]
                if not terminal_peers:
                    raise StateError(
                        f"parallel wave {wave} requires at least two slices"
                    )
                if group[0]["id"] not in existing:
                    raise StateError(
                        "new singleton parallel slice cannot reuse a terminal wave"
                    )
                if group[0]["implementation_task"]["attempt"] < 1:
                    raise StateError(
                        "residual singleton parallel slice requires "
                        "implementation retry history"
                    )
            parallel_groups.append(group)
            for index, left in enumerate(group):
                for right in group[index + 1 :]:
                    required_pairs.add((left["id"], right["id"]))
        actual_pairs = set(parallel_assessment_map(state))
        if actual_pairs != required_pairs:
            raise StateError(
                "Plan proposal requires complete pair assessments for every "
                "parallel group"
            )
        validate_parallel_assessments(bundle, state)
        for group in parallel_groups:
            if any(item["branch"] is not None for item in group):
                validate_parallel_group(state, group)
            else:
                validate_parallel_topology(state, group)

        retained_authorization_entries = [
            deepcopy(entry)
            for entry in (
                original["task_authorization"] or {"entries": []}
            )["entries"]
            if (
                (retained_item := existing.get(entry["slice_id"])) is not None
                and retained_item["status"] in TERMINAL_SLICE_STATUSES
                and retained_item[f"{entry['role']}_task"]["state"]
                not in {"unbound", "superseded"}
            )
        ]
        proposed_entries = [
            *retained_authorization_entries,
            *deepcopy(proposal["task_authorization"]["entries"]),
        ]
        proposed_entries.sort(
            key=lambda entry: (entry["slice_id"], entry["role"])
        )
        proposed_authorization = (
            {
                "primary_digest": task_authorization_projection_digest(
                    proposed_entries
                ),
                "entries": proposed_entries,
            }
            if proposed_entries
            else None
        )
        expected_authorization = {
            (item["id"], role)
            for item in nonterminal
            for role in ("implementation", "review")
        } | {
            (entry["slice_id"], entry["role"])
            for entry in retained_authorization_entries
        }
        actual_authorization = {
            (entry["slice_id"], entry["role"])
            for entry in (
                proposed_authorization or {"entries": []}
            )["entries"]
        }
        if actual_authorization != expected_authorization:
            missing = sorted(expected_authorization - actual_authorization)
            extra = sorted(actual_authorization - expected_authorization)
            details = []
            if missing:
                details.append(
                    "missing "
                    + ", ".join(f"{slice_id}:{role}" for slice_id, role in missing)
                )
            if extra:
                details.append(
                    "unexpected "
                    + ", ".join(f"{slice_id}:{role}" for slice_id, role in extra)
                )
            raise StateError(
                "Plan proposal task authorization is incomplete: "
                + "; ".join(details)
            )
        state["task_authorization"] = proposed_authorization

        criteria = acceptance_criteria(bundle, state)
        proposed_acceptance = {
            record["id"]: record for record in proposal["acceptance"]
        }
        if set(proposed_acceptance) != set(criteria):
            missing = sorted(set(criteria) - set(proposed_acceptance))
            extra = sorted(set(proposed_acceptance) - set(criteria))
            details = []
            if missing:
                details.append("missing " + ", ".join(missing))
            if extra:
                details.append("unexpected " + ", ".join(extra))
            raise StateError(
                "Plan proposal acceptance projection is incomplete: "
                + "; ".join(details)
            )
        updated_acceptance: dict[str, dict] = {}
        for identifier in sorted(criteria):
            proposed_record = proposed_acceptance[identifier]
            expected_assignment = acceptance_plan_assignment(
                bundle, state, identifier
            )
            expected_record = {
                "id": identifier,
                "criterion_digest": criteria[identifier],
                **expected_assignment,
            }
            if proposed_record != expected_record:
                raise StateError(
                    f"Plan proposal acceptance assignment is stale: {identifier}"
                )
            current_record = original["acceptance"].get(identifier)
            if current_record is None:
                updated_acceptance[identifier] = empty_acceptance_record(
                    criteria[identifier]
                )
                continue
            current_assignment = {
                field: current_record[field]
                for field in ("scope", "producer_slice")
            }
            assignment_changed = (
                current_record["status"] != "pending"
                and current_assignment != expected_assignment
            )
            criterion_changed = (
                current_record["criterion_digest"] != criteria[identifier]
            )
            if current_record["locked"] and (
                assignment_changed or criterion_changed
            ):
                raise StateError(
                    f"locked acceptance record is immutable: {identifier}"
                )
            updated_acceptance[identifier] = (
                empty_acceptance_record(criteria[identifier])
                if assignment_changed or criterion_changed
                else current_record
            )
        state["acceptance"] = updated_acceptance
        if not bootstrap:
            state["planning"]["current_specification_digest"] = proposal[
                "specification_digest"
            ]
            state["planning"]["current_source_commit"] = proposal["source_commit"]
            state["planning"]["active_response_digest"] = proposal[
                "active_response_digest"
            ]

        current_plan_digest = canonical_plan_digest(bundle, state)
        prior_plan_digest = original["planning"]["current_plan_digest"]
        state["planning"]["current_plan_digest"] = current_plan_digest
        blind_requirement = original["planning"]["blind_requirement"]
        plan_evidence_changed = (
            prior_plan_digest != current_plan_digest
        ) or (
            blind_requirement is not None
            and blind_requirement["plan_digest"]
            != current_plan_digest
        ) or retained_plan_checkpoint_changed(bundle, original)
        changed = state != original or plan_evidence_changed
        if changed:
            execution_authority_changed = any(
                original[field] != state[field]
                for field in (
                    "slices",
                    "task_authorization",
                    "parallel_assessments",
                    "acceptance",
                )
            )
            if waiver_amendment and execution_authority_changed:
                raise StateError(
                    "Pro primary waiver amendment must preserve exact Plan authority"
                )
            if execution_authority_changed:
                active_tasks = sorted(
                    label
                    for item in slice_map(original).values()
                    for label in base_invalidation_interlock_labels(item)
                )
                if active_tasks:
                    raise StateError(
                        "adopt-plan requires affected tasks quiescent: "
                        + ", ".join(active_tasks)
                    )
            previous_entries = {
                (entry["slice_id"], entry["role"]): entry
                for entry in (
                    original["task_authorization"] or {"entries": []}
                )["entries"]
            }
            for entry in (
                state["task_authorization"] or {"entries": []}
            )["entries"]:
                prior = previous_entries.get((entry["slice_id"], entry["role"]))
                if prior is None or prior["entry_digest"] == entry["entry_digest"]:
                    continue
                prior_item = slice_map(original).get(entry["slice_id"])
                if prior_item is None:
                    continue
                task = prior_item[f"{entry['role']}_task"]
                if task["state"] not in {"unbound", "superseded"}:
                    raise StateError(
                        "changed task authority requires retained attempts "
                        f"superseded: {entry['slice_id']}:{entry['role']}"
                    )
            state["planning"]["blind_requirement"] = None
            state["planning"]["blind_completeness"] = None
            state["planning"]["pro_primary_waiver"] = None

        if waiver_requested:
            if blind_audit_nonquiescent_task_labels(state):
                raise StateError(
                    "Pro primary waiver blind audit requires descendant quiescence"
                )
            value, blind_binding = blind_completeness_receipt_value(
                bundle, state, waiver_receipt
            )
            waiver = {
                "reason": waiver_reason,
                "disposition": waiver_disposition,
                "active_response_digest": state["planning"][
                    "active_response_digest"
                ],
                "specification_digest": state["planning"][
                    "current_specification_digest"
                ],
                "source_commit": state["planning"]["current_source_commit"],
                "plan_digest": current_plan_digest,
                "blind_receipt_digest": blind_binding["receipt_digest"],
                "continuation_digest": local_continuation_digest,
            }
            replay = (
                original["planning"]["pro_primary_waiver"] == waiver
                and original["planning"]["blind_completeness"] == blind_binding
            )
            if (
                not replay
                and value["auditEpoch"] <= max(evidence_epochs(state), default=0)
            ):
                raise StateError(
                    "Pro primary waiver blind audit epoch must advance monotonically"
                )
            state["planning"]["blind_requirement"] = {
                "requirement": (
                    "required_local_plan_recovery"
                    if local_recovery_requested
                    else "required_user_requested"
                ),
                "plan_digest": current_plan_digest,
            }
            state["planning"]["blind_completeness"] = blind_binding
            state["planning"]["pro_primary_waiver"] = waiver
            if exact_waiver_replay and state != original:
                raise StateError(
                    "Pro primary waiver replay must preserve exact Plan authority"
                )

    def result_factory(state: dict, changed: bool) -> dict:
        return {
            "result": "ADOPTED" if changed else "UNCHANGED",
            "revision": state["revision"],
            "planDigest": canonical_plan_digest(bundle, state),
            "specificationDigest": state["planning"][
                "current_specification_digest"
            ],
            "sourceCommit": state["planning"]["current_source_commit"],
            "proPrimaryWaiver": state["planning"]["pro_primary_waiver"] is not None,
        }

    return mutate(
        bundle,
        arguments.expect_revision,
        operation,
        allow_acceptance_drift=True,
        allow_digest_drift={"*"},
        allow_authorization_drift=True,
        allow_parallel_drift={("*", "*")},
        allow_specification_drift=True,
        result_factory=result_factory,
    )


def command_record_task_roster(arguments: argparse.Namespace) -> dict:
    bundle = bundle_path(arguments.bundle)

    def operation(state: dict) -> None:
        if state["phase"] != "plan":
            raise StateError("Codex task roster may be registered only in plan")
        if state["planning"]["current_plan_digest"] is not None:
            raise StateError(
                "atomic Plan adoption requires adopt-plan for planning changes"
            )
        proposed = task_authorization_contract(bundle, state)
        proposed_entries = {
            (entry["slice_id"], entry["role"]): entry
            for entry in proposed["entries"]
        }
        live = sorted(
            f"{item['id']}:{role}"
            for item in state["slices"]
            if item["status"] not in TERMINAL_SLICE_STATUSES
            for role, field in (
                ("implementation", "implementation_task"),
                ("review", "review_task"),
            )
            if item[field]["state"] in NONQUIESCENT_TASK_STATES
        )
        if live:
            raise StateError(
                "task roster registration requires active attempts quiescent: "
                + ", ".join(live)
            )
        changed_retained = sorted(
            f"{item['id']}:{role}"
            for item in state["slices"]
            for role, field in (
                ("implementation", "implementation_task"),
                ("review", "review_task"),
            )
            if item[field]["state"] not in {"unbound", "superseded"}
            and (
                proposed_entries.get((item["id"], role)) is None
                or proposed_entries[(item["id"], role)]["entry_digest"]
                != item[field]["authorization_digest"]
            )
        )
        if changed_retained:
            raise StateError(
                "changed task roster requires retained attempts superseded: "
                + ", ".join(changed_retained)
            )
        state["task_authorization"] = proposed
        require_complete_task_authorization(state)

    return mutate(
        bundle,
        arguments.expect_revision,
        operation,
        allow_authorization_drift=True,
        allow_parallel_drift={("*", "*")},
        allow_specification_drift=True,
    )

def command_record_parallel_assessment(arguments: argparse.Namespace) -> dict:
    bundle = bundle_path(arguments.bundle)
    identifiers = sorted(set(arguments.slice or []))
    if len(identifiers) != 2:
        raise StateError("record-parallel-assessment requires exactly two --slice values")
    pair = (identifiers[0], identifiers[1])

    def operation(state: dict) -> None:
        if state["phase"] != "plan":
            raise StateError("parallel assessments may be recorded only in plan")
        if state["planning"]["current_plan_digest"] is not None:
            raise StateError(
                "atomic Plan adoption requires adopt-plan for planning changes"
            )
        items = slice_map(state)
        unknown = sorted(set(identifiers) - set(items))
        if unknown:
            raise StateError("unknown parallel-assessment slice: " + ", ".join(unknown))
        live = sorted(
            label
            for identifier in identifiers
            for label in nonquiescent_task_labels(items[identifier])
        )
        if live:
            raise StateError(
                "parallel assessment requires tasks quiescent: " + ", ".join(live)
            )
        record = parallel_assessment_value(bundle, state, *pair)
        preserved: list[dict] = []
        for candidate in state["parallel_assessments"]:
            candidate_pair = (
                candidate["left_slice"], candidate["right_slice"]
            )
            if candidate_pair == pair:
                continue
            try:
                if candidate != parallel_assessment_value(
                    bundle, state, *candidate_pair
                ):
                    continue
            except StateError:
                continue
            preserved.append(candidate)
        state["parallel_assessments"] = sorted(
            preserved + [record],
            key=lambda candidate: (
                candidate["left_slice"], candidate["right_slice"]
            ),
        )

    return mutate(
        bundle,
        arguments.expect_revision,
        operation,
        allow_authorization_drift=True,
        allow_parallel_drift={("*", "*")},
    )

def command_transition(arguments: argparse.Namespace) -> dict:
    bundle = bundle_path(arguments.bundle)

    def operation(state: dict) -> None:
        current = state["phase"]
        target = arguments.phase
        premerge_reopen_owner = None
        if current == "complete":
            if not arguments.reopen or target != "discuss":
                raise StateError(
                    "complete is terminal; use --reopen to return to discuss"
                )
            if not any(
                record["locked"] for record in state["acceptance"].values()
            ):
                raise StateError(
                    "completed work lacks a durable locked acceptance marker; "
                    "reopen requires explicit migration"
                )
            premerge_slice = truthful_premerge_final_slice(state)
            if premerge_slice is not None:
                selected = slice_map(state)[premerge_slice]
                if implementation_attention_handoff(selected):
                    premerge_reopen_owner = f"{premerge_slice}:implementation"
            state["completion_specification_digest"] = None
        elif target not in PHASE_TRANSITIONS[current]:
            raise StateError(f"invalid phase transition: {current} -> {target}")
        elif arguments.reopen:
            raise StateError("--reopen applies only to complete -> discuss")
        items = slice_map(state)
        if current == "plan" and target == "delivery":
            if state["blockers"]:
                raise StateError("cannot enter delivery while blockers remain")
            trunk_ready, stackable = readiness(state)
            closure_only = bool(items) and all(
                item["status"] in TERMINAL_SLICE_STATUSES
                for item in items.values()
            )
            if not trunk_ready and not stackable and not closure_only:
                raise StateError("cannot enter delivery without an executable slice")
            if require_resolved_interview(bundle, state) == 0:
                raise StateError(
                    "plan -> delivery requires at least one recorded "
                    "interview entry"
                )
            require_bug_planning_evidence(bundle, state)
            require_complete_task_authorization(state)
            ui_design_contract(bundle, state)
            validate_acceptance_provenance(
                bundle, state, validate_pending_assignment=True,
            )
            require_current_pro_evidence(state, bundle)
            require_current_blind_completeness(bundle, state)
            require_current_atomic_plan(bundle, state, required=True)
            if (
                state["planning"]["pro_primary_waiver"] is None
                or state["planning"]["pro_primary_waiver"]["disposition"]
                == "fresh_primary"
            ):
                state["planning"]["pro_primary_waiver"] = None
        if current == "delivery" and target == "plan":
            active_tasks = all_nonquiescent_task_labels(items)
            if active_tasks:
                raise StateError(
                    "delivery -> plan requires tasks to quiesce: "
                    + ", ".join(active_tasks)
                )
        if target == "discuss":
            active_tasks = all_nonquiescent_task_labels(items)
            if premerge_reopen_owner is not None:
                active_tasks = [
                    label for label in active_tasks
                    if label != premerge_reopen_owner
                ]
            if active_tasks:
                raise StateError(
                    "entering discuss requires tasks quiescent: "
                    + ", ".join(active_tasks)
                )
        if current == "discuss" and target == "plan":
            active_tasks = all_nonquiescent_task_labels(items)
            if active_tasks:
                raise StateError(
                    "entering plan requires reopened snapshot tasks to reconcile: "
                    + ", ".join(active_tasks)
                )
            if require_resolved_interview(bundle, state) == 0:
                raise StateError(
                    "discuss -> plan requires at least one recorded "
                    "interview entry"
                )
        if target == "plan":
            discard_stale_parallel_assessments(bundle, state)
        if target in {"discuss", "plan"}:
            # A blind audit is a one-way Plan-to-Delivery gate for the exact
            # approved plan/source pack. Re-entry starts a new planning epoch;
            # the historical receipt remains on disk, but cannot be carried as
            # current evidence into that epoch.
            state["planning"]["pro_primary_waiver"] = None
            state["planning"]["blind_requirement"] = None
            state["planning"]["blind_completeness"] = None
        if target == "complete":
            declared_acceptance = acceptance_ids(bundle, state)
            if not declared_acceptance:
                raise StateError(
                    "completion requires at least one acceptance criterion"
                )
            contract = ui_design_contract(bundle, state)
            deferred_acceptance = (
                contract[1]
                if (
                    contract is not None
                    and contract[0] == arguments.premerge_final_slice
                )
                else None
            )
            errors = closure_errors(
                state,
                declared_acceptance,
                premerge_final_slice=arguments.premerge_final_slice,
                deferred_acceptance=deferred_acceptance,
            )
            if errors:
                raise StateError("cannot complete: " + "; ".join(errors))
            next_completion_binding = None
            if contract is not None:
                if deferred_acceptance is not None:
                    if arguments.ui_attestation is not None:
                        raise StateError(
                            "pre-merge final UI projection cannot consume the "
                            "post-review human attestation"
                        )
                elif arguments.ui_attestation is None:
                    raise StateError("final UI completion requires --ui-attestation")
                else:
                    acceptance_status = state["acceptance"][contract[1]]["status"]
                    receipt = validate_typed_ui_attestation(
                        bundle,
                        state,
                        arguments.ui_attestation,
                        mode="completion",
                        expected_status=acceptance_status,
                    )
                    acceptance_id = contract[1]
                    record = state["acceptance"][acceptance_id]
                    record["evidence"] = sorted(
                        set([*record["evidence"], arguments.ui_attestation])
                    )
                    record["evidence_digests"] = hash_evidence(
                        bundle, state, acceptance_id, record["evidence"]
                    )
                    next_completion_binding = completion_binding_value(
                        bundle, state, arguments.ui_attestation, receipt
                    )
            elif arguments.ui_attestation is not None:
                raise StateError("--ui-attestation requires final_pr_design_gate")
            state["completion_binding"] = next_completion_binding
            state["completion_specification_digest"] = completion_fact_digests(
                bundle, state
            )[1]
            for identifier, record in state["acceptance"].items():
                record["locked"] = identifier != deferred_acceptance
        elif arguments.premerge_final_slice is not None:
            raise StateError(
                "--premerge-final-slice applies only to transition --phase complete"
            )
        state["phase"] = target

    return mutate(
        bundle,
        arguments.expect_revision,
        operation,
        allow_complete_reopen=True,
        allow_authorization_drift=arguments.phase == "plan",
        allow_parallel_drift={("*", "*")} if arguments.phase == "plan" else None,
        allow_specification_drift=arguments.phase == "plan",
    )

def command_update_slice(arguments: argparse.Namespace) -> dict:
    bundle = bundle_path(arguments.bundle)

    def operation(state: dict) -> None:
        initial_plan_digest = canonical_plan_digest(bundle, state)
        items = slice_map(state)
        item = items.get(arguments.id)
        creating = item is None
        if creating:
            require_bug_planning_evidence(bundle, state)
        if creating:
            if state["phase"] != "plan":
                raise StateError("new slices may be added only during plan")
            if state["planning"]["current_plan_digest"] is not None:
                raise StateError(
                    "atomic Plan adoption requires adopt-plan for planning changes"
                )
            if (
                not arguments.title
                or not arguments.plan
                or arguments.wave is None
                or arguments.execution_mode is None
                or not arguments.owned_path
            ):
                raise StateError(
                    "new slice requires --title, --plan, --wave, "
                    "--execution-mode, and --owned-path"
                )
            if arguments.status not in {None, "pending"}:
                raise StateError("new slice must start pending")
            if arguments.clear_dependencies:
                raise StateError(
                    "--clear-dependencies applies only to an existing slice"
                )
            item = {
                "id": arguments.id,
                "title": arguments.title,
                "status": "pending",
                "depends_on": arguments.depends_on or [],
                "wave": arguments.wave,
                "execution_mode": arguments.execution_mode,
                "owned_paths": sorted(set(arguments.owned_path)),
                "plan": arguments.plan,
                "plan_digest": "",
                "receipt": None,
                "branch": None,
                "base_ref": None,
                "base_sha": None,
                "head_sha": None,
                "pr": None,
                "plan_checkpoint_sha": None,
                "revision_epoch": 0,
                "revision_history": [],
                "replacement_lineage": None,
                "implementation_task": empty_task(),
                "review_task": empty_task(),
                "task_history": [],
                "merge_receipt": None,
                "merge_receipt_digest": None,
                "merge_epoch": None,
                "merge_main_sha": None,
                "terminal_freshness": None,
                "premerge_drift": None,
            }
            item["plan_digest"] = plan_file_digest(bundle, item)
            state["slices"].append(item)
            if any(
                value is not None
                for value in (arguments.receipt, arguments.head_sha, arguments.pr)
            ):
                raise StateError(
                    "pending slices cannot preload receipt, head SHA, or PR"
                )
        else:
            requested_change = arguments.clear_dependencies or any(
                value is not None
                for value in (
                    arguments.title,
                    arguments.status,
                    arguments.plan,
                    arguments.depends_on,
                    arguments.wave,
                    arguments.execution_mode,
                    arguments.owned_path,
                    arguments.receipt,
                    arguments.branch,
                    arguments.base_ref,
                    arguments.base_sha,
                    arguments.head_sha,
                    arguments.pr,
                    arguments.observed_main_sha,
                )
            )
            if item["status"] in TERMINAL_SLICE_STATUSES and requested_change:
                raise StateError("completed slices are immutable; create a new PR id")
            planning_fields = arguments.clear_dependencies or any(
                value is not None
                for value in (
                    arguments.title,
                    arguments.plan,
                    arguments.depends_on,
                    arguments.wave,
                    arguments.execution_mode,
                    arguments.owned_path,
                )
            )
            if planning_fields and state["phase"] != "plan":
                raise StateError("slice planning fields may change only during plan")
            if (
                planning_fields
                and state["planning"]["current_plan_digest"] is not None
            ):
                raise StateError(
                    "atomic Plan adoption requires adopt-plan for planning changes"
                )
            if planning_fields:
                require_bug_planning_evidence(bundle, state)
            if planning_fields and item["status"] not in {"pending", "blocked"}:
                raise StateError("active or shipped slice plans are immutable")
            if planning_fields and nonquiescent_task_labels(item):
                raise StateError(
                    "slice planning requires its tasks quiescent: "
                    + ", ".join(nonquiescent_task_labels(item))
                )
            if planning_fields:
                state["parallel_assessments"] = [
                    record
                    for record in state["parallel_assessments"]
                    if item["id"] not in {
                        record["left_slice"], record["right_slice"]
                    }
                ]
            if arguments.title is not None:
                item["title"] = arguments.title
            if arguments.plan is not None:
                item["plan"] = arguments.plan
            if arguments.clear_dependencies:
                item["depends_on"] = []
            elif arguments.depends_on is not None:
                item["depends_on"] = arguments.depends_on
            if arguments.wave is not None:
                item["wave"] = arguments.wave
            if arguments.execution_mode is not None:
                item["execution_mode"] = arguments.execution_mode
            if arguments.owned_path is not None:
                item["owned_paths"] = sorted(set(arguments.owned_path))
            if planning_fields:
                item["plan_digest"] = plan_file_digest(bundle, item)
        resulting_status = arguments.status or item["status"]
        if (
            arguments.receipt is not None or arguments.head_sha is not None
        ) and resulting_status not in {"verified", "pr_open", "merged"}:
            raise StateError(
                f"status {resulting_status} cannot accept receipt or head SHA"
            )
        if arguments.pr is not None and resulting_status not in {"pr_open", "merged"}:
            raise StateError(f"status {resulting_status} cannot accept a PR number")
        if arguments.merge_receipt is not None and resulting_status != "merged":
            raise StateError("typed merge receipt applies only to merged status")
        if arguments.receipt is not None:
            if (
                not creating
                and item["receipt"] is not None
                and arguments.receipt != item["receipt"]
            ):
                raise StateError(
                    "active attempt evidence is immutable; invalidate it first"
                )
            item["receipt"] = arguments.receipt
        if arguments.head_sha is not None:
            active_review_head_rotation = (
                not creating
                and item["status"] == "pr_open"
                and resulting_status == "pr_open"
                and arguments.status == "pr_open"
                and arguments.pr is not None
                and arguments.pr == item["pr"]
                and item["review_task"]["state"] == "active"
            )
            if (
                not creating
                and item["head_sha"] is not None
                and arguments.head_sha != item["head_sha"]
                and not active_review_head_rotation
            ):
                raise StateError(
                    "active attempt evidence is immutable; invalidate it first"
                )
            item["head_sha"] = arguments.head_sha
        if arguments.pr is not None:
            if not creating and item["pr"] is not None and arguments.pr != item["pr"]:
                raise StateError(
                    "active attempt evidence is immutable; invalidate it first"
                )
            item["pr"] = arguments.pr
        binding_values = (arguments.branch, arguments.base_ref, arguments.base_sha)
        if any(value is not None for value in binding_values):
            if not creating and item["status"] not in {"pending", "blocked"}:
                raise StateError("binding may change only while pending or blocked")
            if not creating and any(
                item[field]["state"] not in {"unbound", "superseded"}
                for field in ("implementation_task", "review_task")
            ):
                raise StateError(
                    "binding refresh requires prior tasks superseded"
                )
            if not all(value is not None for value in binding_values):
                raise StateError(
                    "binding update requires branch, base ref, and base SHA"
                )
            if (
                arguments.base_ref == "origin/main"
                and arguments.base_sha != state["observed_main_sha"]
            ):
                raise StateError(
                    "origin/main binding must use the current observed_main_sha"
                )
            item["branch"], item["base_ref"], item["base_sha"] = binding_values
        invalidation_descendants: set[str] = set()
        if (
            not creating
            and arguments.status == "pr_open"
            and arguments.status != item["status"]
            and item["replacement_lineage"] is not None
            and item["pr"] != item["replacement_lineage"]["pr"]
        ):
            raise StateError("replacement publication must preserve the original PR")
        if (
            not creating
            and arguments.status in {"verified", "pr_open"}
            and arguments.status != item["status"]
            and not review_has_head_authority(item)
        ):
            require_initial_implementation_handoff(item)
        if (
            not creating
            and arguments.status is not None
            and arguments.status != item["status"]
        ):
            previous = item["status"]
            if previous == "pending" and arguments.status == "in_progress":
                raise StateError("use start-wave to activate a pending slice")
            if arguments.status not in SLICE_TRANSITIONS[previous]:
                raise StateError(
                    f"invalid slice transition: {previous} -> {arguments.status}"
                )
            if state["phase"] != "delivery" and arguments.status not in {
                "blocked",
                "pending",
                "superseded",
            }:
                raise StateError("active slice transitions require delivery phase")
            if arguments.status in {"blocked", "superseded"}:
                active_tasks = nonquiescent_task_labels(item)
                if active_tasks:
                    raise StateError(
                        f"{arguments.status} requires tasks quiescent: "
                        + ", ".join(active_tasks)
                    )
            if (
                previous == "pr_open"
                and arguments.status == "in_progress"
                and item["review_task"]["state"] == "active"
            ):
                raise StateError(
                    "active review must quiesce and be superseded before implementation re-entry"
                )
            if arguments.status == "in_progress" and not any(
                item[field]["state"] == "active"
                for field in ("implementation_task", "review_task")
            ):
                raise StateError(
                    "in_progress remediation requires an active owning task"
                )
            if arguments.status == "merged":
                if arguments.observed_main_sha is None:
                    raise StateError(
                        "merge recording requires --observed-main-sha"
                    )
                if item["implementation_task"]["state"] not in {
                    "quiescent", "superseded"
                }:
                    raise StateError("merge requires a quiescent implementation task")
                if item["review_task"]["state"] != "clean":
                    raise StateError("merge requires a clean review task")
                current_items = slice_map(state)
                contract = ui_design_contract(bundle, state)
                if contract is not None:
                    plan = state_slice_plan_contract(bundle, state, item)
                    automated = plan["automated"]
                    if automated is not None:
                        require_recorded_automated_ui_acceptance(
                            bundle, state, item["id"], automated
                        )
                    if contract[0] == item["id"]:
                        require_recorded_final_ui_acceptance(
                            bundle, state, contract[0], contract[1]
                        )
                deferred_carrier = terminal_snapshot_carrier(state)
                mutating_affected = sorted(
                    label
                    for sibling in current_items.values()
                    if sibling["id"] != item["id"]
                    and sibling["id"] != deferred_carrier
                    and (
                        (
                            sibling["wave"] == item["wave"]
                            and sibling["execution_mode"] == "parallel"
                            and item["execution_mode"] == "parallel"
                        )
                        or dependency_reaches(
                            current_items, sibling["id"], item["id"]
                        )
                    )
                    for label in nonquiescent_task_labels(sibling)
                )
                if mutating_affected:
                    raise StateError(
                        "cannot merge while affected slice task is mutating: "
                        + ", ".join(mutating_affected)
                    )
            if arguments.status == "pr_open":
                carrier = terminal_parallel_snapshot_carrier(state)
                if carrier == item["id"]:
                    if not implementation_attention_handoff(item):
                        raise StateError(
                            "terminal parallel snapshot carrier requires its active "
                            "implementation attention handoff at publication"
                        )
                    nonterminal_peers = sorted(
                        sibling["id"]
                        for sibling in state["slices"]
                        if sibling["id"] != item["id"]
                        and sibling["wave"] == item["wave"]
                        and sibling["execution_mode"] == "parallel"
                        and sibling["status"] not in TERMINAL_SLICE_STATUSES
                    )
                    if nonterminal_peers:
                        raise StateError(
                            "terminal parallel snapshot carrier waits for peers: "
                            + ", ".join(nonterminal_peers)
                        )
            if previous == "pr_open" and arguments.status in {
                "in_progress",
                "blocked",
                "superseded",
            }:
                current_items = slice_map(state)
                invalidation_descendants = {
                    sibling["id"]
                    for sibling in current_items.values()
                    if sibling["id"] != item["id"]
                    and dependency_reaches(
                        current_items, sibling["id"], item["id"]
                    )
                }
                mutating_descendants = sorted(
                    label
                    for identifier in invalidation_descendants
                    for label in nonquiescent_task_labels(current_items[identifier])
                )
                if mutating_descendants:
                    raise StateError(
                        "cannot invalidate upstream while dependent task is mutating: "
                        + ", ".join(mutating_descendants)
                    )
                if arguments.status in {"in_progress", "blocked"}:
                    retain_replacement_lineage(item)
            if arguments.status == "superseded" and any(
                item[field]["state"] not in {"unbound", "superseded"}
                for field in ("implementation_task", "review_task")
            ):
                raise StateError(
                    "slice supersession requires proof-bound task supersession first"
                )
            item["status"] = arguments.status
            if arguments.status in {"pr_open", "superseded"}:
                item["replacement_lineage"] = None
            if arguments.status in {"in_progress", "blocked", "superseded"}:
                invalidate_attempt(bundle, state, item)
        refreshed = slice_map(state)
        validate_dependencies(refreshed)
        for identifier in sorted(invalidation_descendants):
            descendant = refreshed[identifier]
            if descendant["status"] in {"verified", "pr_open"}:
                if descendant["status"] == "pr_open":
                    retain_replacement_lineage(descendant)
                descendant["status"] = "blocked"
                invalidate_attempt(bundle, state, descendant)
        if item["status"] == "merged":
            unmerged = [
                dependency
                for dependency in item["depends_on"]
                if refreshed[dependency]["status"] != "merged"
            ]
            if unmerged:
                raise StateError(
                    "cannot merge before dependencies: " + ", ".join(unmerged)
                )
            if item["depends_on"] and item["base_ref"] != "origin/main":
                raise StateError(
                    "dependent slice must refresh onto origin/main before merge"
                )
            for sibling in refreshed.values():
                if sibling["id"] == item["id"]:
                    continue
                if sibling["id"] == deferred_carrier:
                    if dependency_reaches(
                        refreshed, sibling["id"], item["id"]
                    ):
                        sibling["base_ref"] = "origin/main"
                        sibling["base_sha"] = arguments.observed_main_sha
                        sibling["replacement_lineage"] = None
                    continue
                same_parallel_wave = (
                    sibling["wave"] == item["wave"]
                    and sibling["execution_mode"] == "parallel"
                    and item["execution_mode"] == "parallel"
                )
                depends_on_merged = dependency_reaches(
                    refreshed, sibling["id"], item["id"]
                )
                if (
                    (same_parallel_wave or depends_on_merged)
                    and (
                        sibling["status"] in ACTIVE_SLICE_STATUSES
                        or (
                            sibling["status"] == "pending"
                            and sibling["implementation_task"]["state"]
                            != "unbound"
                        )
                    )
                ):
                    if sibling["status"] == "pr_open":
                        if sibling["review_task"]["state"] == "clean":
                            persist_terminal_freshness(
                                bundle,
                                state,
                                sibling,
                                arguments.observed_main_sha,
                            )
                        reopen_review_for_base_sync(
                            bundle,
                            state,
                            sibling,
                            arguments.observed_main_sha,
                            normalize_to_main=depends_on_merged,
                        )
                    else:
                        sibling["status"] = "blocked"
                        invalidate_attempt(bundle, state, sibling)
            apply_observed_main(bundle, state, arguments.observed_main_sha)
            receipt_value, merge_binding = merge_receipt_value(
                bundle, state, item, arguments.merge_receipt,
                expected_main=arguments.observed_main_sha,
            )
            epochs = evidence_epochs(state)
            if epochs and receipt_value["observationEpoch"] <= max(epochs):
                raise StateError("merge observation epoch must advance monotonically")
            item.update(merge_binding)
        elif arguments.observed_main_sha is not None:
            carrier = terminal_snapshot_carrier(state)
            if (
                item["status"] != "pr_open"
                or carrier != item["id"]
                or item["base_ref"] != "origin/main"
                or arguments.observed_main_sha != state["observed_main_sha"]
            ):
                raise StateError(
                    "--observed-main-sha applies only when recording a merge or "
                    "publishing the synchronized terminal snapshot carrier"
                )
            apply_owner_observed_main(
                bundle, state, item, arguments.observed_main_sha
            )
        carrier = terminal_snapshot_carrier(state)
        if (
            item["status"] == "pr_open"
            and carrier == item["id"]
            and item["base_ref"] == "origin/main"
            and item["base_sha"] != state["observed_main_sha"]
        ):
            raise StateError(
                "terminal snapshot carrier must consume observed main "
                "before publication"
            )
        if canonical_plan_digest(bundle, state) != initial_plan_digest:
            state["planning"]["blind_requirement"] = None
            state["planning"]["blind_completeness"] = None

    return mutate(bundle, arguments.expect_revision, operation)

def pre_pr_observation_receipt_value(
    bundle: Path,
    state: dict,
    item: dict,
    task: dict,
    *,
    relative: str | None,
    checkpoint: str,
    plan_digest: str,
    authorization_digest: str,
    owned_paths: list[str],
    specification_digest: str,
    acceptance_digest: str,
    prerequisite_terminal: dict | None = None,
) -> tuple[dict, str]:
    label = f"{item['id']} pre-PR implementation observation receipt"
    relative = relative_path_value(relative, label)
    if not relative.endswith(".json"):
        raise StateError(f"{label} must be a JSON path")
    prerequisite_resume = prerequisite_terminal is not None
    value, digest = typed_receipt(
        bundle,
        relative,
        label,
        (
            PREREQUISITE_PRE_PR_OBSERVATION_RECEIPT_FIELDS
            if prerequisite_resume
            else PRE_PR_OBSERVATION_RECEIPT_FIELDS
        ),
    )
    expected_kind = (
        "pre_pr_prerequisite_observation"
        if prerequisite_resume
        else "pre_pr_implementation_observation"
    )
    expected_result = (
        "PREREQUISITE_SATISFIED" if prerequisite_resume else "OBSERVED"
    )
    if (
        value["schema"] != "spec-work-task-git-binding"
        or value["kind"] != expected_kind
        or value["result"] != expected_result
    ):
        raise StateError(f"{label} has an unsupported schema, kind, or result")
    for field in (
        "stateRevision", "attempt", "revisionEpoch", "observationEpoch"
    ):
        integer_value(value[field], f"{label} {field}", 1)
    for field in (
        "boundSha", "baseSha", "terminalReceiptDigest",
        "planCheckpointSha", "planDigest", "authorizationDigest",
        "specificationDigest", "acceptanceDigest", "dirtyManifestDigest",
        "worktreeHeadSha", "localBranchSha", "precursorAuthorityDigest",
    ):
        string_value(
            value[field],
            f"{label} {field}",
            pattern=SHA_RE if field in {
                "boundSha", "baseSha", "planCheckpointSha",
                "worktreeHeadSha", "localBranchSha",
            } else DIGEST_RE,
        )
    if prerequisite_resume:
        for field in (
            "priorBaseSha", "requiredBaseSha", "prerequisiteMergeSha",
        ):
            string_value(value[field], f"{label} {field}", pattern=SHA_RE)
        for field in (
            "prerequisiteFingerprint", "prerequisiteDeliveryDigest",
        ):
            string_value(value[field], f"{label} {field}", pattern=DIGEST_RE)
        canonical_remote_branch_ref(value["requiredBaseRef"])
        relative_path_value(
            value["prerequisiteDeliveryReceipt"],
            f"{label} prerequisiteDeliveryReceipt",
        )
    for field in (
        "workKind", "workId", "workBundle", "sliceId", "taskType",
        "launchMarker", "branch", "branchRef", "terminalReceipt", "result",
    ):
        string_value(value[field], f"{label} {field}")
    optional_string(value["threadId"], f"{label} threadId")
    optional_string(value["clientThreadId"], f"{label} clientThreadId")
    for field in ("gitCommonDir", "taskWorktree"):
        normalized = absolute_path_value(value[field], f"{label} {field}")
        if normalized != value[field]:
            raise StateError(f"{label} {field} must be canonical")
    if value["gitCommonDir"] != coordinator_git_common_dir():
        raise StateError(f"{label} does not match coordinator Git common directory")
    receipt_owned_paths = [
        repo_path_value(path, f"{label} ownedPaths")
        for path in string_list(value["ownedPaths"], f"{label} ownedPaths", nonempty=True)
    ]
    if receipt_owned_paths != sorted(set(receipt_owned_paths)):
        raise StateError(f"{label} ownedPaths must be sorted and unique")
    dirty_paths = [
        repo_path_value(path, f"{label} dirtyPaths")
        for path in string_list(value["dirtyPaths"], f"{label} dirtyPaths")
    ]
    if dirty_paths != sorted(set(dirty_paths)):
        raise StateError(f"{label} dirtyPaths must be sorted and unique")
    if not isinstance(value["dirtyManifest"], list):
        raise StateError(f"{label} dirtyManifest must be an array")
    manifest: list[dict] = []
    manifest_paths: set[str] = set()
    prior_key: tuple[str, str] | None = None
    for index, raw_record in enumerate(value["dirtyManifest"]):
        record = exact_object(
            raw_record,
            f"{label} dirtyManifest.{index}",
            PRE_PR_DIRTY_MANIFEST_FIELDS,
        )
        path = repo_path_value(
            record["path"], f"{label} dirtyManifest.{index}.path"
        )
        source = record["sourcePath"]
        if source is not None:
            source = repo_path_value(
                source, f"{label} dirtyManifest.{index}.sourcePath"
            )
        key = (path, source or "")
        if prior_key is not None and key <= prior_key:
            raise StateError(f"{label} dirtyManifest must be canonically ordered")
        prior_key = key
        record_type = enum_value(
            record["recordType"],
            f"{label} dirtyManifest.{index}.recordType",
            {"ordinary", "rename", "copy", "untracked"},
        )
        for status_field in ("indexStatus", "worktreeStatus"):
            string_value(
                record[status_field],
                f"{label} dirtyManifest.{index}.{status_field}",
                pattern=re.compile(r"^[.MADRCTU?]$"),
            )
        if record_type in {"rename", "copy"}:
            if source is None:
                raise StateError(
                    f"{label} rename/copy record requires sourcePath"
                )
            expected_status = "R" if record_type == "rename" else "C"
            if expected_status not in {
                record["indexStatus"], record["worktreeStatus"]
            }:
                raise StateError(
                    f"{label} rename/copy record has contradictory status"
                )
        elif source is not None:
            raise StateError(
                f"{label} non-rename record cannot claim sourcePath"
            )
        if record_type == "untracked" and (
            record["indexStatus"], record["worktreeStatus"]
        ) != ("?", "?"):
            raise StateError(f"{label} untracked record has contradictory status")
        index_mode = record["indexMode"]
        index_digest = record["indexContentSha256"]
        if (index_mode is None) != (index_digest is None):
            raise StateError(
                f"{label} index mode and content digest must be paired"
            )
        if index_mode is not None:
            enum_value(
                index_mode,
                f"{label} dirtyManifest.{index}.indexMode",
                {"100644", "100755", "120000"},
            )
            string_value(
                index_digest,
                f"{label} dirtyManifest.{index}.indexContentSha256",
                pattern=DIGEST_RE,
            )
        if record_type == "untracked" and index_mode is not None:
            raise StateError(f"{label} untracked record cannot claim index content")
        object_type = enum_value(
            record["objectType"],
            f"{label} dirtyManifest.{index}.objectType",
            {"regular", "symlink", "absent"},
        )
        if object_type == "absent":
            if record["contentSha256"] is not None:
                raise StateError(f"{label} absent object cannot claim content")
            if "D" not in {
                record["indexStatus"], record["worktreeStatus"]
            }:
                raise StateError(f"{label} absent object lacks deletion status")
        else:
            string_value(
                record["contentSha256"],
                f"{label} dirtyManifest.{index}.contentSha256",
                pattern=DIGEST_RE,
            )
        for claimed in (path, source):
            if claimed is None:
                continue
            if claimed in manifest_paths:
                raise StateError(f"{label} dirtyManifest paths must be unique")
            manifest_paths.add(claimed)
            if not any(
                claimed == owned or claimed.startswith(f"{owned}/")
                for owned in receipt_owned_paths
            ):
                raise StateError(f"{label} contains a path outside ownedPaths")
        manifest.append(record)
    if dirty_paths != sorted(manifest_paths):
        raise StateError(f"{label} dirtyPaths differ from dirtyManifest")
    if value["dirtyManifestDigest"] != canonical_digest(manifest):
        raise StateError(f"{label} dirty manifest digest is stale")
    if value["clean"] is not (not manifest):
        raise StateError(f"{label} clean verdict differs from dirty manifest")
    branch_ref = f"refs/heads/{item['branch']}"
    expected_owner = [{
        "worktree": task["task_worktree"],
        "headSha": task["bound_sha"],
        "branchRef": branch_ref,
    }]
    owners = value["branchOwners"]
    if not isinstance(owners, list):
        raise StateError(f"{label} branchOwners must be an array")
    owners = [
        exact_object(
            owner, f"{label} branchOwners.{index}", GIT_BINDING_OWNER_FIELDS
        )
        for index, owner in enumerate(owners)
    ]
    terminal_digest = task["implementation_receipt_digest"]
    expected = {
        **generic_receipt_identity(bundle, state),
        "stateRevision": state["revision"],
        "sliceId": item["id"],
        "taskType": "slice_implementation",
        "attempt": task["attempt"],
        "revisionEpoch": item["revision_epoch"],
        "launchMarker": task["launch_marker"],
        "threadId": task["thread_id"],
        "clientThreadId": task["client_thread_id"],
        "gitCommonDir": coordinator_git_common_dir(),
        "taskWorktree": task["task_worktree"],
        "branch": item["branch"],
        "branchRef": branch_ref,
        "boundSha": task["bound_sha"],
        "baseSha": item["base_sha"],
        "terminalReceipt": task["implementation_receipt"],
        "terminalReceiptDigest": terminal_digest,
        "planCheckpointSha": checkpoint,
        "planDigest": plan_digest,
        "authorizationDigest": authorization_digest,
        "ownedPaths": owned_paths,
        "specificationDigest": specification_digest,
        "acceptanceDigest": acceptance_digest,
        "worktreeHeadSha": task["bound_sha"],
        "localBranchSha": task["bound_sha"],
        "symbolicRef": branch_ref,
        "branchOwners": expected_owner,
    }
    if prerequisite_resume:
        assert prerequisite_terminal is not None
        expected.update({
            "priorBaseSha": item["base_sha"],
            "requiredBaseRef": prerequisite_terminal["requiredBaseRef"],
            "prerequisiteFingerprint": prerequisite_terminal[
                "prerequisiteFingerprint"
            ],
        })
    if any(value[field] != expected_value for field, expected_value in expected.items()):
        raise StateError(f"{label} is not bound to the exact reauthorization context")
    precursor_fields = (
        "workKind", "workId", "workBundle", "stateRevision", "sliceId",
        "taskType", "attempt", "revisionEpoch", "launchMarker", "threadId",
        "clientThreadId", "gitCommonDir", "taskWorktree", "branch", "branchRef",
        "boundSha", "baseSha", "terminalReceipt", "terminalReceiptDigest",
        "planCheckpointSha", "planDigest", "authorizationDigest", "ownedPaths",
        "specificationDigest", "acceptanceDigest", "observationEpoch",
        "dirtyManifestDigest",
    )
    if prerequisite_resume:
        precursor_fields += (
            "priorBaseSha", "requiredBaseRef", "requiredBaseSha",
            "prerequisiteFingerprint", "prerequisiteDeliveryReceipt",
            "prerequisiteDeliveryDigest", "prerequisiteMergeSha",
        )
    precursor = {field: value[field] for field in precursor_fields}
    if value["precursorAuthorityDigest"] != canonical_digest(precursor):
        raise StateError(f"{label} precursor authority digest is stale")
    return value, digest


def prerequisite_delivery_merge_value(
    bundle: Path,
    state: dict,
    item: dict,
    terminal: dict,
    observation: dict,
) -> tuple[dict, str]:
    label = f"{item['id']} prerequisite delivery merge receipt"
    value, digest = typed_receipt(
        bundle,
        observation["prerequisiteDeliveryReceipt"],
        label,
        MERGE_RECEIPT_FIELDS,
    )
    if digest != observation["prerequisiteDeliveryDigest"]:
        raise StateError("prerequisite delivery merge receipt digest is stale")
    if (
        value["schema"] != "spec-work-merge-observation"
        or value["result"] != "MERGED"
    ):
        raise StateError("prerequisite delivery is not a successful merge receipt")
    for field in ("reviewedHeadSha", "resultMainSha"):
        string_value(value[field], f"{label} {field}", pattern=SHA_RE)
    integer_value(value["pr"], f"{label} pr", 1)
    integer_value(value["observationEpoch"], f"{label} observationEpoch", 1)
    expected = {
        **generic_receipt_identity(bundle, state),
        "pr": terminal["prerequisitePr"],
        "reviewedHeadSha": terminal["prerequisiteHeadSha"],
        "resultMainSha": observation["prerequisiteMergeSha"],
    }
    if any(value[field] != expected_value for field, expected_value in expected.items()):
        raise StateError(
            "prerequisite delivery merge receipt differs from the declared prerequisite"
        )
    relative_path_value(value["premergeReceipt"], f"{label} premergeReceipt")
    string_value(
        value["premergeReceiptDigest"],
        f"{label} premergeReceiptDigest",
        pattern=DIGEST_RE,
    )
    premerge, premerge_digest = typed_receipt(
        bundle,
        value["premergeReceipt"],
        f"{label} premerge result",
        PREMERGE_RESULT_FIELDS,
    )
    if premerge_digest != value["premergeReceiptDigest"]:
        raise StateError("prerequisite delivery premerge receipt digest is stale")
    if (
        premerge["schema"] != "spec-work-premerge-result"
        or premerge["result"] != "MERGED"
        or premerge["mergeMethod"] != "merge"
        or premerge["merged"] is not True
        or premerge["atomicCommitIdentityEnforced"] is not True
    ):
        raise StateError(
            "prerequisite delivery lacks a successful atomic commit identity"
        )
    for field in (
        "requestDigest", "operationDigest", "providerCommandDigest",
        "policyPreconditionDigest",
    ):
        string_value(premerge[field], f"{label} {field}", pattern=DIGEST_RE)
    if premerge["reconciliationCommandDigest"] is not None:
        string_value(
            premerge["reconciliationCommandDigest"],
            f"{label} reconciliationCommandDigest",
            pattern=DIGEST_RE,
        )
    premerge_expected = {
        "workKind": state["work_kind"],
        "workId": state["work_id"],
        "expectedPrNumber": terminal["prerequisitePr"],
        "expectedHeadSha": terminal["prerequisiteHeadSha"],
        "expectedBaseRef": terminal["requiredBaseRef"],
        "expectedBaseSha": item["base_sha"],
        "observedPrNumber": terminal["prerequisitePr"],
        "observedHeadSha": terminal["prerequisiteHeadSha"],
        "observedBaseSha": item["base_sha"],
        "mergeCommitSha": observation["prerequisiteMergeSha"],
        "mergeCommitParents": [item["base_sha"], terminal["prerequisiteHeadSha"]],
    }
    if any(
        premerge[field] != expected_value
        for field, expected_value in premerge_expected.items()
    ):
        raise StateError(
            "prerequisite delivery premerge result differs from the declared prerequisite"
        )
    request = {
        "schema": "spec-work-premerge-operation",
        "workKind": state["work_kind"],
        "workId": state["work_id"],
        "sliceId": premerge["sliceId"],
        "expectedPrNumber": terminal["prerequisitePr"],
        "expectedHeadSha": terminal["prerequisiteHeadSha"],
        "expectedBaseRef": terminal["requiredBaseRef"],
        "expectedBaseSha": item["base_sha"],
        "mergeMethod": "merge",
        "policyPreconditionDigest": premerge["policyPreconditionDigest"],
        "observationEpoch": premerge["observationEpoch"],
    }
    operation = {
        "request": request,
        "provider": premerge["provider"],
        "providerCommandDigest": premerge["providerCommandDigest"],
        "reconciliationCommandDigest": premerge["reconciliationCommandDigest"],
    }
    if premerge["requestDigest"] != premerge_transport_digest(request):
        raise StateError("prerequisite delivery request digest is stale")
    if premerge["operationDigest"] != premerge_transport_digest(operation):
        raise StateError("prerequisite delivery operation digest is stale")
    return value, digest


def command_reauthorize_satisfied_prerequisite(
    arguments: argparse.Namespace,
) -> dict:
    bundle = bundle_path(arguments.bundle)
    prior_epoch = 0
    receipt_context: dict[str, object] = {}

    def operation(state: dict) -> None:
        nonlocal prior_epoch
        if state["phase"] != "delivery":
            raise StateError(
                "satisfied prerequisite reauthorization applies only during delivery"
            )
        require_current_pro_evidence(state, bundle)
        if arguments.add_owned_path:
            raise StateError(
                "satisfied prerequisite reauthorization cannot add owned paths"
            )
        item = slice_map(state).get(arguments.id)
        if item is None:
            raise StateError(
                f"unknown reauthorize-implementation slice: {arguments.id}"
            )
        implementation = item["implementation_task"]
        review = item["review_task"]
        if (
            item["status"] != "blocked"
            or item["pr"] is not None
            or item["head_sha"] is not None
            or item["branch"] is None
            or item["replacement_lineage"] is not None
        ):
            raise StateError(
                "satisfied prerequisite reauthorization requires one blocked "
                "unpublished slice"
            )
        if (
            implementation["state"] != "quiescent"
            or implementation["terminal_result"] != "FAILED"
            or implementation["output_pr"] is not None
            or implementation["output_head_sha"] != implementation["bound_sha"]
        ):
            raise StateError(
                "satisfied prerequisite reauthorization requires the exact failed "
                "current implementation owner"
            )
        if review["state"] not in {"unbound", "superseded"}:
            raise StateError(
                "satisfied prerequisite reauthorization requires no active review owner"
            )
        active_peers = sorted(
            label
            for candidate in state["slices"]
            if candidate["id"] != item["id"]
            for label in nonquiescent_task_labels(candidate)
        )
        if active_peers:
            raise StateError(
                "satisfied prerequisite reauthorization requires peer quiescence: "
                + ", ".join(active_peers)
            )
        checkpoint = string_value(
            arguments.plan_checkpoint_sha,
            "reauthorization plan checkpoint",
            pattern=SHA_RE,
        )
        if checkpoint != item["plan_checkpoint_sha"]:
            raise StateError(
                "satisfied prerequisite reauthorization requires the unchanged "
                "plan checkpoint"
            )
        require_checkpointed_slice_plan(bundle, item, checkpoint)
        plan_digest = checkpointed_plan_digest(
            bundle,
            state,
            checkpoint,
            "satisfied prerequisite plan checkpoint",
        )
        current_plan_digest = canonical_plan_digest(bundle, state)
        if (
            plan_digest != current_plan_digest
            or current_plan_digest != state["planning"]["current_plan_digest"]
        ):
            raise StateError(
                "satisfied prerequisite reauthorization changed current plan authority"
            )
        (
            _plan_digest, specification_digest, _source_digest, acceptance_digest
        ) = completion_fact_digests(bundle, state)
        if specification_digest != state["planning"]["current_specification_digest"]:
            raise StateError(
                "satisfied prerequisite reauthorization changed the accepted specification"
            )
        authorized = authorization_entry(state, item["id"], "implementation")
        if arguments.authorization_digest != authorized["entry_digest"]:
            raise StateError(
                "reauthorization digest does not match the registered roster entry"
            )
        terminal, terminal_digest = typed_receipt(
            bundle,
            implementation["implementation_receipt"],
            f"{item['id']} prerequisite failure terminal receipt",
            PREREQUISITE_IMPLEMENTATION_RECEIPT_FIELDS,
        )
        if (
            terminal_digest != implementation["implementation_receipt_digest"]
            or terminal["result"] != "FAILED"
        ):
            raise StateError("prerequisite failure terminal digest is stale")
        if terminal["requiredBaseRef"] != item["base_ref"]:
            raise StateError(
                "prerequisite failure required base differs from the current slice"
            )
        prior_epoch = item["revision_epoch"]
        prior_base_sha = item["base_sha"]
        owned_paths = sorted(item["owned_paths"])
        observation, observation_digest = pre_pr_observation_receipt_value(
            bundle,
            state,
            item,
            implementation,
            relative=arguments.pre_pr_observation_receipt,
            checkpoint=checkpoint,
            plan_digest=current_plan_digest,
            authorization_digest=authorized["entry_digest"],
            owned_paths=owned_paths,
            specification_digest=specification_digest,
            acceptance_digest=acceptance_digest,
            prerequisite_terminal=terminal,
        )
        prerequisite_delivery_merge_value(
            bundle,
            state,
            item,
            terminal,
            observation,
        )
        required_base_sha = observation["requiredBaseSha"]
        if required_base_sha == prior_base_sha:
            raise StateError(
                "satisfied prerequisite requires an advanced live required base"
            )
        used_epochs = evidence_epochs(state)
        observation_epoch = observation["observationEpoch"]
        if (
            observation_epoch in used_epochs
            or (used_epochs and observation_epoch <= max(used_epochs))
        ):
            raise StateError(
                "pre-PR observation epoch must advance monotonically"
            )
        reauthorization_digest = canonical_digest({
            "workKind": state["work_kind"],
            "workId": state["work_id"],
            "sliceId": item["id"],
            "priorRevisionEpoch": prior_epoch,
            "revisionEpoch": prior_epoch + 1,
            "planCheckpointSha": checkpoint,
            "planDigest": current_plan_digest,
            "authorizationDigest": authorized["entry_digest"],
            "branch": item["branch"],
            "priorBaseSha": prior_base_sha,
            "requiredBaseRef": item["base_ref"],
            "requiredBaseSha": required_base_sha,
            "disposition": "satisfied_prerequisite",
            "specificationDigest": specification_digest,
            "acceptanceDigest": acceptance_digest,
            "ownedPaths": owned_paths,
            "implementationTerminalReceipt": implementation[
                "implementation_receipt"
            ],
            "implementationTerminalDigest": terminal_digest,
            "prePrObservationReceipt": arguments.pre_pr_observation_receipt,
            "prePrObservationDigest": observation_digest,
            "prerequisiteFingerprint": terminal["prerequisiteFingerprint"],
            "prerequisiteDeliveryReceipt": observation[
                "prerequisiteDeliveryReceipt"
            ],
            "prerequisiteDeliveryDigest": observation[
                "prerequisiteDeliveryDigest"
            ],
            "prerequisiteMergeSha": observation["prerequisiteMergeSha"],
        })
        item["revision_history"].append({
            "revision_epoch": prior_epoch,
            "plan_checkpoint_sha": checkpoint,
            "plan_digest": current_plan_digest,
            "authorization_digest": implementation["authorization_digest"],
            "pr": None,
            "head_sha": None,
            "base_ref": item["base_ref"],
            "base_sha": prior_base_sha,
            "required_base_sha": required_base_sha,
            "implementation_receipt_digest": terminal_digest,
            "implementation_terminal_receipt": implementation[
                "implementation_receipt"
            ],
            "implementation_terminal_digest": terminal_digest,
            "pre_pr_observation_receipt": arguments.pre_pr_observation_receipt,
            "pre_pr_observation_digest": observation_digest,
            "pre_pr_observation_epoch": observation_epoch,
            "owned_paths": owned_paths,
            "reauthorization_disposition": "satisfied_prerequisite",
            "specification_digest": specification_digest,
            "acceptance_digest": acceptance_digest,
            "prerequisite_fingerprint": terminal["prerequisiteFingerprint"],
            "prerequisite_delivery_receipt": observation[
                "prerequisiteDeliveryReceipt"
            ],
            "prerequisite_delivery_digest": observation[
                "prerequisiteDeliveryDigest"
            ],
            "prerequisite_merge_sha": observation["prerequisiteMergeSha"],
            "reauthorization_digest": reauthorization_digest,
        })
        apply_owner_observed_base(
            bundle,
            state,
            item,
            required_base_sha,
            allow_peer_mutation=False,
        )
        item["status"] = "pending"
        item["revision_epoch"] = prior_epoch + 1
        implementation["state"] = "authorized"
        implementation["authorization_digest"] = authorized["entry_digest"]
        for field in (
            "implementation_receipt", "implementation_receipt_digest",
            "terminal_result", "verification_verdict", "output_head_sha",
            "output_pr", "verification_digest", "changed_paths_digest",
            "descendant_quiescence_digest", "branch_release_receipt",
            "branch_release_digest", "branch_release_epoch",
        ):
            implementation[field] = None
        state["observation_epoch_high_water"] = observation_epoch
        receipt_context.update({
            "disposition": "satisfied_prerequisite",
            "planDigest": current_plan_digest,
            "specificationDigest": specification_digest,
            "acceptanceDigest": acceptance_digest,
            "ownedPaths": owned_paths,
            "priorBaseSha": prior_base_sha,
            "requiredBaseRef": item["base_ref"],
            "requiredBaseSha": required_base_sha,
            "prerequisiteFingerprint": terminal["prerequisiteFingerprint"],
            "prerequisiteDeliveryReceipt": observation[
                "prerequisiteDeliveryReceipt"
            ],
            "prerequisiteDeliveryDigest": observation[
                "prerequisiteDeliveryDigest"
            ],
            "prerequisiteMergeSha": observation["prerequisiteMergeSha"],
            "prePrObservationReceipt": arguments.pre_pr_observation_receipt,
            "prePrObservationDigest": observation_digest,
            "reauthorizationDigest": reauthorization_digest,
            "nextAction": "merge_required_base_and_rerun_verification",
        })

    state = mutate(bundle, arguments.expect_revision, operation)
    item = slice_map(state)[arguments.id]
    task = item["implementation_task"]
    return {
        "schema": "spec-work-task-reauthorization",
        **generic_receipt_identity(bundle, state),
        "stateRevision": state["revision"],
        "sliceId": item["id"],
        "taskType": "slice_implementation",
        "attempt": task["attempt"],
        "threadId": task["thread_id"],
        "clientThreadId": task["client_thread_id"],
        "taskWorktree": task["task_worktree"],
        "priorRevisionEpoch": prior_epoch,
        "revisionEpoch": item["revision_epoch"],
        "planCheckpointSha": item["plan_checkpoint_sha"],
        "authorizationDigest": task["authorization_digest"],
        "branch": item["branch"],
        "pr": None,
        "headSha": None,
        "baseRef": item["base_ref"],
        "baseSha": item["base_sha"],
        **receipt_context,
        "result": "REAUTHORIZED",
    }


def command_reauthorize_pre_pr_implementation(
    arguments: argparse.Namespace,
) -> dict:
    bundle = bundle_path(arguments.bundle)
    prior_epoch = 0
    receipt_context: dict[str, object] = {}
    disposition = arguments.disposition
    coordinator_expansion = disposition == "coordinator_scope_expansion"

    def operation(state: dict) -> None:
        nonlocal prior_epoch
        required_phase = "delivery" if coordinator_expansion else "plan"
        if state["phase"] != required_phase:
            raise StateError(
                f"{disposition} reauthorization applies only during {required_phase}"
            )
        if coordinator_expansion:
            require_current_atomic_plan(bundle, state, required=True)
            require_current_pro_evidence(
                state, bundle, allow_admitted_delivery_authority=True
            )
        else:
            require_current_pro_evidence(state, bundle)
        blind_requirement = None
        if not coordinator_expansion:
            if state["planning"]["blind_requirement"] is None:
                raise StateError(
                    "pre-PR reauthorization requires a typed blind completeness requirement"
                )
            blind_requirement = state["planning"]["blind_requirement"]["requirement"]
        item = slice_map(state).get(arguments.id)
        if item is None:
            raise StateError(
                f"unknown reauthorize-implementation slice: {arguments.id}"
            )
        implementation = item["implementation_task"]
        review = item["review_task"]
        if (
            item["status"] != "blocked"
            or item["pr"] is not None
            or item["head_sha"] is not None
            or item["branch"] is None
            or item["replacement_lineage"] is not None
        ):
            raise StateError(
                "pre-PR reauthorization requires one blocked unpublished slice"
            )
        if (
            implementation["state"] != "quiescent"
            or implementation["terminal_result"] != "SCOPE_EXPANSION_REQUIRED"
            or implementation["output_pr"] is not None
            or implementation["output_head_sha"] != implementation["bound_sha"]
        ):
            raise StateError(
                "pre-PR reauthorization requires the scope-blocked current "
                "implementation owner"
            )
        if review["state"] not in {"unbound", "superseded"}:
            raise StateError("pre-PR reauthorization requires no active review owner")
        active_peers = sorted(
            label
            for candidate in state["slices"]
            if candidate["id"] != item["id"]
            for label in nonquiescent_task_labels(candidate)
        )
        if active_peers:
            raise StateError(
                "pre-PR reauthorization requires peer quiescence: "
                + ", ".join(active_peers)
            )
        checkpoint = string_value(
            arguments.plan_checkpoint_sha,
            "reauthorization plan checkpoint",
            pattern=SHA_RE,
        )
        if coordinator_expansion and checkpoint != item["plan_checkpoint_sha"]:
            raise StateError(
                "coordinator scope expansion must preserve the current plan checkpoint"
            )
        if not coordinator_expansion and checkpoint == item["plan_checkpoint_sha"]:
            raise StateError(
                "same-task reauthorization requires a changed plan checkpoint"
            )
        require_checkpointed_slice_plan(bundle, item, checkpoint)
        prior_owned_paths = sorted(item["owned_paths"])
        added_owned_paths = sorted(set(arguments.add_owned_path or []))
        if not added_owned_paths:
            raise StateError("pre-PR scope expansion requires added owned paths")
        for path in added_owned_paths:
            repo_path_value(path, "reauthorization added owned path")
        if any(path in prior_owned_paths for path in added_owned_paths):
            raise StateError("reauthorization added paths must be new to the slice")
        revised_owned_paths = sorted([*prior_owned_paths, *added_owned_paths])
        parallel_peers = [
            candidate
            for candidate in state["slices"]
            if (
                candidate["id"] != item["id"]
                and candidate["wave"] == item["wave"]
                and candidate["execution_mode"] == "parallel"
                and item["execution_mode"] == "parallel"
                and candidate["status"] not in TERMINAL_SLICE_STATUSES
            )
        ]
        if parallel_peers:
            require_independent_pairs(state, [item, *parallel_peers])
            revised_item = {**item, "owned_paths": revised_owned_paths}
            overlap = next(
                (
                    (peer, owned_paths_overlap(revised_item, peer))
                    for peer in parallel_peers
                    if owned_paths_overlap(revised_item, peer) is not None
                ),
                None,
            )
            if overlap is not None:
                peer, paths = overlap
                raise StateError(
                    "pre-PR revised owned paths overlap a parallel peer: "
                    f"{item['id']}:{paths[0]} and {peer['id']}:{paths[1]}"
                )
        plan = safe_path(
            bundle, item["plan"], f"{item['id']} reauthorization plan",
            required=True, markdown=True,
        )
        revised_plan = plan.read_bytes()
        _preamble, revised_sections = markdown_h2_sections(
            revised_plan.decode("utf-8"), "reauthorization plan"
        )
        revised_scope = dict(revised_sections).get("Scope and Ownership")
        if revised_scope is None:
            raise StateError(
                "owned-path expansion requires a Scope and Ownership section"
            )
        plan_paths, _normalized = normalized_scope_owned_paths(
            revised_scope, "reauthorization plan"
        )
        expected_plan_paths = (
            prior_owned_paths if coordinator_expansion else revised_owned_paths
        )
        if plan_paths != expected_plan_paths:
            raise StateError(
                "reauthorization plan owned paths differ from the revised inventory"
            )
        (
            _plan_digest, specification_digest, _source_digest, acceptance_digest
        ) = completion_fact_digests(bundle, state)
        if specification_digest != state["planning"]["current_specification_digest"]:
            raise StateError("reauthorization changed the accepted specification")
        authorized = authorization_entry(state, item["id"], "implementation")
        if arguments.authorization_digest != authorized["entry_digest"]:
            raise StateError(
                "reauthorization digest does not match the registered roster entry"
            )
        if item["plan_checkpoint_sha"] is None:
            raise StateError(
                "same-task reauthorization requires the prior plan checkpoint"
            )
        prior_plan = checkpointed_slice_plan_bytes(
            bundle, item, item["plan_checkpoint_sha"],
            "prior reauthorization plan checkpoint",
        )
        prior_plan_digest = checkpointed_plan_digest(
            bundle, state, item["plan_checkpoint_sha"],
            "prior reauthorization plan checkpoint",
        )
        if plan_digest_with_overrides(
            bundle, state, slice_id=item["id"], plan_bytes=prior_plan,
            owned_paths=prior_owned_paths,
        ) != prior_plan_digest:
            raise StateError(
                "pre-PR scope expansion changed the accepted slice topology"
            )
        terminal, terminal_digest = typed_receipt(
            bundle,
            implementation["implementation_receipt"],
            f"{item['id']} implementation terminal receipt",
            SCOPE_IMPLEMENTATION_RECEIPT_FIELDS,
        )
        if (
            terminal_digest != implementation["implementation_receipt_digest"]
            or terminal["result"] != "SCOPE_EXPANSION_REQUIRED"
        ):
            raise StateError("pre-PR implementation terminal digest is stale")
        required_paths = sorted(terminal["requiredOwnedPaths"])
        if required_paths != added_owned_paths:
            raise StateError(
                "pre-PR required paths differ from the implementation terminal"
            )
        acceptance_id = terminal["acceptanceId"]
        if acceptance_id not in state["acceptance"]:
            raise StateError(
                "pre-PR implementation cites an unknown acceptance criterion"
            )
        if coordinator_expansion:
            validate_coordinator_scope_expansion_contract(
                slice_id=item["id"],
                plan=prior_plan,
                prior_owned_paths=prior_owned_paths,
                acceptance_id=acceptance_id,
                owning_seam=terminal["owningSeam"],
            )
        else:
            validate_required_by_intent_plan_amendment(
                slice_id=item["id"],
                prior_plan=prior_plan,
                revised_plan=revised_plan,
                prior_owned_paths=prior_owned_paths,
                revised_owned_paths=revised_owned_paths,
                acceptance_id=acceptance_id,
                owning_seam=terminal["owningSeam"],
                regression_obligations=terminal["regressionObligations"],
                verification_obligations=terminal["verificationObligations"],
            )
        prior_epoch = item["revision_epoch"]
        authorized_plan_digest = plan_digest_with_overrides(
            bundle, state, slice_id=item["id"], plan_bytes=revised_plan,
            owned_paths=revised_owned_paths,
        )
        observation, observation_digest = pre_pr_observation_receipt_value(
            bundle,
            state,
            item,
            implementation,
            relative=arguments.pre_pr_observation_receipt,
            checkpoint=checkpoint,
            plan_digest=authorized_plan_digest,
            authorization_digest=authorized["entry_digest"],
            owned_paths=revised_owned_paths,
            specification_digest=specification_digest,
            acceptance_digest=acceptance_digest,
        )
        used_epochs = evidence_epochs(state)
        observation_epoch = observation["observationEpoch"]
        if (
            observation_epoch in used_epochs
            or (used_epochs and observation_epoch <= max(used_epochs))
        ):
            raise StateError(
                "pre-PR observation epoch must advance monotonically"
            )
        reauthorization_digest = canonical_digest({
            "workKind": state["work_kind"],
            "workId": state["work_id"],
            "sliceId": item["id"],
            "priorRevisionEpoch": prior_epoch,
            "revisionEpoch": prior_epoch + 1,
            "planCheckpointSha": checkpoint,
            "authorizationDigest": authorized["entry_digest"],
            "branch": item["branch"],
            "pr": None,
            "headSha": None,
            "baseRef": item["base_ref"],
            "baseSha": item["base_sha"],
            "disposition": disposition,
            "priorPlanDigest": prior_plan_digest,
            "planDigest": authorized_plan_digest,
            "specificationDigest": specification_digest,
            "acceptanceDigest": acceptance_digest,
            "addedOwnedPaths": added_owned_paths,
            "ownedPaths": revised_owned_paths,
            "scopeExpansionAcceptanceId": acceptance_id,
            "implementationTerminalReceipt": implementation[
                "implementation_receipt"
            ],
            "implementationTerminalDigest": terminal_digest,
            "prePrObservationReceipt": arguments.pre_pr_observation_receipt,
            "prePrObservationDigest": observation_digest,
        })
        item["revision_history"].append({
            "revision_epoch": prior_epoch,
            "plan_checkpoint_sha": item["plan_checkpoint_sha"],
            "authorization_digest": implementation["authorization_digest"],
            "pr": None,
            "head_sha": None,
            "base_ref": item["base_ref"],
            "base_sha": item["base_sha"],
            "implementation_receipt_digest": terminal_digest,
            "implementation_terminal_receipt": implementation[
                "implementation_receipt"
            ],
            "implementation_terminal_digest": terminal_digest,
            "pre_pr_observation_receipt": arguments.pre_pr_observation_receipt,
            "pre_pr_observation_digest": observation_digest,
            "pre_pr_observation_epoch": observation_epoch,
            "owned_paths": prior_owned_paths,
            "reauthorization_disposition": disposition,
            "specification_digest": specification_digest,
            "acceptance_digest": acceptance_digest,
            "added_owned_paths": added_owned_paths,
            "scope_expansion_acceptance_id": acceptance_id,
            "reauthorization_digest": reauthorization_digest,
        })
        item["status"] = "pending"
        item["revision_epoch"] = prior_epoch + 1
        item["plan_checkpoint_sha"] = checkpoint
        item["plan_digest"] = plan_file_digest(bundle, item)
        item["owned_paths"] = revised_owned_paths
        implementation["state"] = "authorized"
        implementation["authorization_digest"] = authorized["entry_digest"]
        for field in (
            "implementation_receipt", "implementation_receipt_digest",
            "terminal_result", "verification_verdict", "output_head_sha",
            "output_pr", "verification_digest", "changed_paths_digest",
            "descendant_quiescence_digest",
            "branch_release_receipt", "branch_release_digest",
            "branch_release_epoch",
        ):
            implementation[field] = None
        state["observation_epoch_high_water"] = observation_epoch
        state["planning"]["blind_completeness"] = None
        revised_plan_digest = canonical_plan_digest(bundle, state)
        if revised_plan_digest != authorized_plan_digest:
            raise StateError("reauthorization plan authority digest is inconsistent")
        state["planning"]["current_plan_digest"] = revised_plan_digest
        if blind_requirement is not None:
            state["planning"]["blind_requirement"] = {
                "requirement": blind_requirement,
                "plan_digest": revised_plan_digest,
            }
        elif state["planning"]["blind_requirement"] is not None:
            state["planning"]["blind_requirement"][
                "plan_digest"
            ] = revised_plan_digest
        receipt_context.update({
            "disposition": disposition,
            "priorPlanDigest": prior_plan_digest,
            "planDigest": revised_plan_digest,
            "specificationDigest": specification_digest,
            "acceptanceDigest": acceptance_digest,
            "addedOwnedPaths": added_owned_paths,
            "ownedPaths": revised_owned_paths,
            "scopeExpansionAcceptanceId": acceptance_id,
            "prePrObservationReceipt": arguments.pre_pr_observation_receipt,
            "prePrObservationDigest": observation_digest,
            "reauthorizationDigest": reauthorization_digest,
        })

    state = mutate(
        bundle,
        arguments.expect_revision,
        operation,
        allow_authorization_drift=not coordinator_expansion,
    )
    item = slice_map(state)[arguments.id]
    task = item["implementation_task"]
    return {
        "schema": "spec-work-task-reauthorization",
        **generic_receipt_identity(bundle, state),
        "stateRevision": state["revision"],
        "sliceId": item["id"],
        "taskType": "slice_implementation",
        "attempt": task["attempt"],
        "threadId": task["thread_id"],
        "clientThreadId": task["client_thread_id"],
        "taskWorktree": task["task_worktree"],
        "priorRevisionEpoch": prior_epoch,
        "revisionEpoch": item["revision_epoch"],
        "planCheckpointSha": item["plan_checkpoint_sha"],
        "authorizationDigest": task["authorization_digest"],
        "branch": item["branch"],
        "pr": None,
        "headSha": None,
        "baseRef": item["base_ref"],
        "baseSha": item["base_sha"],
        **receipt_context,
        "result": "REAUTHORIZED",
    }


def command_reopen_final_ui_remediation(arguments: argparse.Namespace) -> dict:
    bundle = bundle_path(arguments.bundle)

    def operation(state: dict) -> None:
        if state["phase"] != "delivery":
            raise StateError(
                "final UI remediation reopening applies only during delivery"
            )
        contract = ui_design_contract(bundle, state)
        if contract is None:
            raise StateError(
                "final UI remediation reopening requires final_pr_design_gate"
            )
        final_slice, final_acceptance = contract
        if arguments.id != final_slice:
            raise StateError(
                "final UI remediation reopening requires the designated final UI slice"
            )
        item = slice_map(state).get(arguments.id)
        if item is None:
            raise StateError(f"unknown final UI remediation slice: {arguments.id}")
        implementation = item["implementation_task"]
        review = item["review_task"]
        adoption_task = causal_review_head_adoption_task(item)
        if (
            item["status"] != "pr_open"
            or item["pr"] is None
            or item["head_sha"] is None
            or item["branch"] is None
        ):
            raise StateError(
                "final UI remediation reopening requires the current open PR"
            )
        implementation_head_is_current = (
            implementation["output_head_sha"] == item["head_sha"]
        )
        if not implementation_head_is_current and adoption_task is not None:
            adoption, _adoption_digest = review_head_adoption_receipt_value(
                bundle,
                state,
                item,
                adoption_task,
                adoption_task["head_adoption_receipt"],
                persisted=True,
            )
            lineage_head, lineage_base, _lineage_result = (
                review_head_adoption_lineage_tip(
                    bundle,
                    state,
                    item,
                    adoption_task,
                    adoption,
                    f"{item['id']} review head-adoption receipt",
                )
            )
            implementation_head_is_current = (
                adoption["priorHeadSha"] == implementation["output_head_sha"]
                and lineage_head == item["head_sha"]
                and lineage_base == item["base_sha"]
            )
        if not implementation_head_is_current and review["state"] == "clean":
            # Review-owned remediation rotates the head inside the rolling
            # lease; the archived CLEAN lease terminal authenticates the
            # contiguous chain from the implementation output head to the
            # current slice head, so it is the same causal proof a head
            # adoption receipt provides.
            lease_relative = review["branch_attachment_receipt"]
            if lease_relative is not None and receipt_kind(
                bundle, lease_relative, f"{item['id']} review lease terminal"
            ) == "review_lease_terminal":
                lease_path = safe_path(
                    bundle, lease_relative,
                    f"{item['id']} review lease terminal", required=True,
                )
                lease_digest = hashlib.sha256(lease_path.read_bytes()).hexdigest()
                lease = json.loads(lease_path.read_text(encoding="utf-8"))
                implementation_head_is_current = (
                    lease_digest == review["branch_attachment_digest"]
                    and lease.get("clean") is True
                    and lease.get("initialHeadSha")
                    == implementation["output_head_sha"]
                    and lease.get("finalHeadSha") == item["head_sha"]
                    and lease.get("finalBaseSha") == item["base_sha"]
                )
        if (
            implementation["state"] != "quiescent"
            or implementation["terminal_result"] != "SUCCEEDED"
            or implementation["verification_verdict"] != "PASS"
            or implementation["output_pr"] != item["pr"]
            or not implementation_head_is_current
        ):
            raise StateError(
                "final UI remediation reopening requires the successful current "
                "implementation owner"
            )
        if review["state"] != "clean" or review["bound_sha"] != item["head_sha"]:
            raise StateError(
                "final UI remediation reopening requires exact-head CLEAN review"
            )
        final_record = state["acceptance"][final_acceptance]
        if final_record["status"] != "pending" or final_record["locked"]:
            raise StateError(
                "final UI remediation reopening requires pending unlocked final design acceptance"
            )
        mutating = all_nonquiescent_task_labels(slice_map(state))
        if mutating:
            raise StateError(
                "final UI remediation reopening requires quiescent task ownership: "
                + ", ".join(mutating)
            )
        authorized = authorization_entry(state, item["id"], "implementation")
        if arguments.authorization_digest != authorized["entry_digest"]:
            raise StateError(
                "final UI remediation authorization digest does not match the registered roster entry"
            )
        issue_digest = validate_final_ui_issue_receipt(
            bundle, state, item, arguments.ui_receipt
        )
        if item["revision_epoch"] < 1:
            raise StateError(
                "final UI remediation reopening requires an existing implementation revision"
            )
        _plan_digest, specification_digest, _source_digest, acceptance_digest = (
            completion_fact_digests(bundle, state)
        )
        prior_epoch = item["revision_epoch"]
        reauthorization_digest = canonical_digest({
            "workKind": state["work_kind"],
            "workId": state["work_id"],
            "sliceId": item["id"],
            "priorRevisionEpoch": prior_epoch,
            "revisionEpoch": prior_epoch + 1,
            "planCheckpointSha": item["plan_checkpoint_sha"],
            "authorizationDigest": authorized["entry_digest"],
            "branch": item["branch"],
            "pr": item["pr"],
            "headSha": item["head_sha"],
            "baseRef": item["base_ref"],
            "baseSha": item["base_sha"],
            "disposition": "final_ui_checkpoint_issue",
            "specificationDigest": specification_digest,
            "acceptanceDigest": acceptance_digest,
            "ownedPaths": sorted(item["owned_paths"]),
            "finalUiIssueReceipt": arguments.ui_receipt,
            "finalUiIssueReceiptDigest": issue_digest,
            "cleanReviewTerminalDigest": review["branch_attachment_digest"],
            "cleanReviewReceipt": review["review_receipt"],
            "cleanReviewReceiptDigest": review["review_receipt_digest"],
        })
        item["revision_history"].append({
            "revision_epoch": prior_epoch,
            "plan_checkpoint_sha": item["plan_checkpoint_sha"],
            "authorization_digest": implementation["authorization_digest"],
            "pr": item["pr"],
            "head_sha": item["head_sha"],
            "base_ref": item["base_ref"],
            "base_sha": item["base_sha"],
            "implementation_receipt_digest": implementation[
                "implementation_receipt_digest"
            ],
            "review_receipt_digest": review["review_receipt_digest"],
            "final_ui_review_receipt": review["review_receipt"],
            "review_terminal_receipt": review["branch_attachment_receipt"],
            "review_terminal_digest": review["branch_attachment_digest"],
            "head_adoption_receipt": review["head_adoption_receipt"],
            "head_adoption_digest": review["head_adoption_digest"],
            "head_adoption_epoch": review["head_adoption_epoch"],
            "head_adoption_terminal_lineage": deepcopy(
                review["head_adoption_terminal_lineage"]
            ),
            "final_ui_issue_receipt": arguments.ui_receipt,
            "final_ui_issue_receipt_digest": issue_digest,
            "owned_paths": sorted(item["owned_paths"]),
            "reauthorization_disposition": "final_ui_checkpoint_issue",
            "specification_digest": specification_digest,
            "acceptance_digest": acceptance_digest,
            "added_owned_paths": [],
            "required_by_intent_acceptance_id": None,
            "reauthorization_digest": reauthorization_digest,
        })
        retain_replacement_lineage(item)
        invalidate_attempt(bundle, state, item)
        item["status"] = "pending"
        item["revision_epoch"] = prior_epoch + 1
        implementation["state"] = "authorized"
        implementation["authorization_digest"] = authorized["entry_digest"]
        implementation["bound_sha"] = item["replacement_lineage"]["start_sha"]
        for field in (
            "implementation_receipt", "implementation_receipt_digest",
            "terminal_result", "verification_verdict", "output_head_sha",
            "output_pr", "verification_digest", "changed_paths_digest",
            "descendant_quiescence_digest", "branch_release_receipt",
            "branch_release_digest", "branch_release_epoch",
            "branch_attachment_receipt", "branch_attachment_digest",
            "branch_attachment_epoch", "snapshot_authorization",
        ):
            implementation[field] = None
        review["state"] = "blocked"
        for field in (*REVIEW_PROOF_FIELDS, *BRANCH_ATTACHMENT_FIELDS):
            review[field] = None
        for field in (
            "head_adoption_receipt", "head_adoption_digest",
            "head_adoption_epoch",
        ):
            review[field] = None
        review["head_adoption_terminal_lineage"] = []

    return mutate(bundle, arguments.expect_revision, operation)


def command_reauthorize_implementation(arguments: argparse.Namespace) -> dict:
    if arguments.disposition == "satisfied_prerequisite":
        return command_reauthorize_satisfied_prerequisite(arguments)
    if arguments.disposition in {
        "coordinator_scope_expansion", "pre_pr_scope_expansion",
    }:
        return command_reauthorize_pre_pr_implementation(arguments)
    if arguments.pre_pr_observation_receipt is not None:
        raise StateError(
            "pre-PR observation receipt applies only to unpublished reauthorization"
        )
    bundle = bundle_path(arguments.bundle)
    prior_epoch = 0
    receipt_context: dict[str, object] = {}

    def operation(state: dict) -> None:
        nonlocal prior_epoch
        if state["phase"] != "plan":
            raise StateError(
                "reauthorize-implementation applies only during plan"
            )
        disposition = enum_value(
            arguments.disposition,
            "reauthorization disposition",
            REAUTHORIZATION_DISPOSITIONS,
        )
        if disposition == "required_by_intent_scope_expansion":
            require_existing_accepted_pro_evidence(state, bundle)
        else:
            require_current_pro_evidence(state, bundle)
        if (
            disposition == "fresh_pro_plan"
            and state["planning"]["blind_requirement"] is None
        ):
            raise StateError(
                "reauthorization requires a typed blind completeness requirement"
            )
        item = slice_map(state).get(arguments.id)
        if item is None:
            raise StateError(
                f"unknown reauthorize-implementation slice: {arguments.id}"
            )
        implementation = item["implementation_task"]
        review = item["review_task"]
        adoption_task = causal_review_head_adoption_task(item)
        if (
            item["status"] != "pr_open"
            or item["pr"] is None
            or item["head_sha"] is None
            or item["branch"] is None
        ):
            raise StateError(
                "same-task reauthorization requires the current open PR"
            )
        implementation_head_is_current = (
            implementation["output_head_sha"] == item["head_sha"]
        )
        if (
            not implementation_head_is_current
            and adoption_task is not None
        ):
            adoption, _adoption_digest = review_head_adoption_receipt_value(
                bundle,
                state,
                item,
                adoption_task,
                adoption_task["head_adoption_receipt"],
                persisted=True,
            )
            adoption_starts_at_implementation = (
                adoption["priorHeadSha"] == implementation["output_head_sha"]
            )
            lineage_head, lineage_base, _lineage_result = (
                review_head_adoption_lineage_tip(
                    bundle,
                    state,
                    item,
                    adoption_task,
                    adoption,
                    f"{item['id']} review head-adoption receipt",
                )
            )
            implementation_head_is_current = (
                adoption_starts_at_implementation
                and lineage_head == item["head_sha"]
                and lineage_base == item["base_sha"]
            )
            if (
                adoption_starts_at_implementation
                and not implementation_head_is_current
                and review["state"] == "blocked"
                and review["branch_attachment_receipt"] is not None
                and receipt_schema(
                    bundle,
                    review["branch_attachment_receipt"],
                    f"{item['id']} review attachment",
                ) == "spec-work-review-lease-terminal"
            ):
                terminal, terminal_digest = review_lease_terminal_value(
                    bundle,
                    state,
                    item,
                    review,
                    review["branch_attachment_receipt"],
                    target="blocked",
                    review_receipt=None,
                    persisted=True,
                )
                implementation_head_is_current = (
                    terminal_digest == review["branch_attachment_digest"]
                    and terminal["initialHeadSha"] == lineage_head
                    and (
                        terminal["initialBaseSha"] == lineage_base
                        or _lineage_result == "CLEAN"
                    )
                    and terminal["finalHeadSha"] == item["head_sha"]
                    and terminal["finalBaseSha"] == item["base_sha"]
                )
        if (
            not implementation_head_is_current
            and adoption_task is None
            and review["state"] == "blocked"
            and review["branch_attachment_receipt"] is not None
            and receipt_schema(
                bundle,
                review["branch_attachment_receipt"],
                f"{item['id']} review attachment",
            ) == "spec-work-review-lease-terminal"
        ):
            terminal, terminal_digest = review_lease_terminal_value(
                bundle,
                state,
                item,
                review,
                review["branch_attachment_receipt"],
                target="blocked",
                review_receipt=None,
                persisted=True,
            )
            implementation_head_is_current = (
                terminal_digest == review["branch_attachment_digest"]
                and terminal["initialHeadSha"]
                == implementation["output_head_sha"]
                and terminal["finalHeadSha"] == item["head_sha"]
                and terminal["finalBaseSha"] == item["base_sha"]
            )
        if (
            implementation["state"] != "quiescent"
            or implementation["terminal_result"] != "SUCCEEDED"
            or implementation["output_pr"] != item["pr"]
            or not implementation_head_is_current
        ):
            raise StateError(
                "same-task reauthorization requires the successful current "
                "implementation owner"
            )
        if (
            review["state"] != "blocked"
            or review["branch_release_digest"] is None
            or review["branch_release_epoch"] is None
            or review["branch_attachment_epoch"] is None
            or review["branch_release_epoch"]
            <= review["branch_attachment_epoch"]
        ):
            raise StateError(
                "same-task reauthorization requires the blocked review owner "
                "to record fresh branch-release proof after its terminal lease"
            )
        checkpoint = string_value(
            arguments.plan_checkpoint_sha,
            "reauthorization plan checkpoint",
            pattern=SHA_RE,
        )
        if checkpoint == item["plan_checkpoint_sha"]:
            raise StateError(
                "same-task reauthorization requires a changed plan checkpoint"
            )
        require_checkpointed_slice_plan(bundle, item, checkpoint)
        prior_owned_paths = sorted(item["owned_paths"])
        added_owned_paths = sorted(set(arguments.add_owned_path or []))
        for path in added_owned_paths:
            repo_path_value(path, "reauthorization added owned path")
        if any(path in prior_owned_paths for path in added_owned_paths):
            raise StateError(
                "reauthorization added paths must be new to the slice"
            )
        revised_owned_paths = sorted(
            [*prior_owned_paths, *added_owned_paths]
        )
        plan = safe_path(
            bundle,
            item["plan"],
            f"{item['id']} reauthorization plan",
            required=True,
            markdown=True,
        )
        revised_plan = plan.read_bytes()
        try:
            revised_plan_text = revised_plan.decode("utf-8")
        except UnicodeDecodeError as error:
            raise StateError("reauthorization plan must be UTF-8") from error
        _preamble, revised_sections = markdown_h2_sections(
            revised_plan_text, "reauthorization plan"
        )
        revised_scope = dict(revised_sections).get("Scope and Ownership")
        if revised_scope is None:
            if added_owned_paths:
                raise StateError(
                    "owned-path expansion requires a Scope and Ownership section"
                )
        else:
            plan_paths, _normalized = normalized_scope_owned_paths(
                revised_scope, "reauthorization plan"
            )
            if plan_paths != revised_owned_paths:
                raise StateError(
                    "reauthorization plan owned paths differ from the revised inventory"
                )
        _plan_digest, specification_digest, _source_digest, acceptance_digest = (
            completion_fact_digests(bundle, state)
        )
        if (
            specification_digest
            != state["planning"]["current_specification_digest"]
        ):
            raise StateError(
                "reauthorization changed the accepted specification"
            )
        required_acceptance_id = None
        blocked_terminal_digest = review["branch_attachment_digest"]
        if item["plan_checkpoint_sha"] is None:
            raise StateError(
                "same-task reauthorization requires the prior plan checkpoint"
            )
        prior_plan = checkpointed_slice_plan_bytes(
            bundle,
            item,
            item["plan_checkpoint_sha"],
            "prior reauthorization plan checkpoint",
        )
        prior_plan_digest = checkpointed_plan_digest(
            bundle,
            state,
            item["plan_checkpoint_sha"],
            "prior reauthorization plan checkpoint",
        )
        if disposition == "required_by_intent_scope_expansion":
            terminal, terminal_digest = review_lease_terminal_value(
                bundle,
                state,
                item,
                review,
                review["branch_attachment_receipt"],
                target="blocked",
                review_receipt=None,
                persisted=True,
            )
            if terminal_digest != blocked_terminal_digest:
                raise StateError(
                    "required-by-intent blocked review terminal digest is stale"
                )
            if terminal["blockedDisposition"] != disposition:
                raise StateError(
                    "blocked review did not classify required-by-intent expansion"
                )
            required_paths = sorted(terminal["requiredOwnedPaths"])
            if not added_owned_paths or required_paths != added_owned_paths:
                raise StateError(
                    "required-by-intent paths differ from the blocked review"
                )
            required_acceptance_id = terminal["acceptanceId"]
            if required_acceptance_id not in state["acceptance"]:
                raise StateError(
                    "required-by-intent review cites an unknown acceptance criterion"
                )
            if plan_digest_with_overrides(
                bundle,
                state,
                slice_id=item["id"],
                plan_bytes=prior_plan,
                owned_paths=prior_owned_paths,
            ) != prior_plan_digest:
                raise StateError(
                    "required-by-intent expansion changed the accepted slice topology"
                )
            validate_required_by_intent_plan_amendment(
                slice_id=item["id"],
                prior_plan=prior_plan,
                revised_plan=revised_plan,
                prior_owned_paths=prior_owned_paths,
                revised_owned_paths=revised_owned_paths,
                acceptance_id=required_acceptance_id,
                owning_seam=terminal["owningSeam"],
                regression_obligations=terminal["regressionObligations"],
                verification_obligations=terminal["verificationObligations"],
                prior_authenticated_cohesion_evidence=(
                    persisted_required_by_intent_cohesion_evidence(bundle, item)
                ),
                authenticated_cohesion_evidence=terminal,
            )
        authorized = authorization_entry(
            state, item["id"], "implementation"
        )
        if arguments.authorization_digest != authorized["entry_digest"]:
            raise StateError(
                "reauthorization digest does not match the registered roster entry"
            )
        prior_epoch = item["revision_epoch"]
        if prior_epoch < 1:
            raise StateError(
                "same-task reauthorization requires an existing revision"
            )
        authorized_plan_digest = plan_digest_with_overrides(
            bundle,
            state,
            slice_id=item["id"],
            plan_bytes=revised_plan,
            owned_paths=revised_owned_paths,
        )
        reauthorization_digest = canonical_digest({
            "workKind": state["work_kind"],
            "workId": state["work_id"],
            "sliceId": item["id"],
            "priorRevisionEpoch": prior_epoch,
            "revisionEpoch": prior_epoch + 1,
            "planCheckpointSha": checkpoint,
            "authorizationDigest": authorized["entry_digest"],
            "branch": item["branch"],
            "pr": item["pr"],
            "headSha": item["head_sha"],
            "baseRef": item["base_ref"],
            "baseSha": item["base_sha"],
            "disposition": disposition,
            "priorPlanDigest": prior_plan_digest,
            "planDigest": authorized_plan_digest,
            "specificationDigest": specification_digest,
            "acceptanceDigest": acceptance_digest,
            "addedOwnedPaths": added_owned_paths,
            "ownedPaths": revised_owned_paths,
            "requiredByIntentAcceptanceId": required_acceptance_id,
            "blockedReviewTerminalDigest": blocked_terminal_digest,
        })
        item["revision_history"].append({
            "revision_epoch": prior_epoch,
            "plan_checkpoint_sha": item["plan_checkpoint_sha"],
            "authorization_digest": implementation["authorization_digest"],
            "pr": item["pr"],
            "head_sha": item["head_sha"],
            "base_ref": item["base_ref"],
            "base_sha": item["base_sha"],
            "implementation_receipt_digest": implementation[
                "implementation_receipt_digest"
            ],
            "review_receipt_digest": review["review_receipt_digest"],
            "review_terminal_receipt": review[
                "branch_attachment_receipt"
            ],
            "review_terminal_digest": review[
                "branch_attachment_digest"
            ],
            "head_adoption_receipt": (
                adoption_task["head_adoption_receipt"]
                if adoption_task is not None
                else None
            ),
            "head_adoption_digest": (
                adoption_task["head_adoption_digest"]
                if adoption_task is not None
                else None
            ),
            "head_adoption_epoch": (
                adoption_task["head_adoption_epoch"]
                if adoption_task is not None
                else None
            ),
            "head_adoption_terminal_lineage": deepcopy(
                adoption_task["head_adoption_terminal_lineage"]
                if adoption_task is not None
                else []
            ),
            "final_ui_issue_receipt": None,
            "final_ui_issue_receipt_digest": None,
            "final_ui_review_receipt": None,
            "owned_paths": prior_owned_paths,
            "reauthorization_disposition": disposition,
            "specification_digest": specification_digest,
            "acceptance_digest": acceptance_digest,
            "added_owned_paths": added_owned_paths,
            "required_by_intent_acceptance_id": required_acceptance_id,
            "reauthorization_digest": reauthorization_digest,
        })
        retain_replacement_lineage(item)
        invalidate_attempt(bundle, state, item)
        criteria = acceptance_criteria(bundle, state)
        if set(criteria) != set(state["acceptance"]):
            raise StateError(
                "reauthorization cannot add or remove acceptance identifiers"
            )
        for identifier, criterion_digest in criteria.items():
            acceptance = state["acceptance"][identifier]
            if acceptance["criterion_digest"] == criterion_digest:
                continue
            if acceptance["locked"]:
                raise StateError(
                    f"locked acceptance record is immutable: {identifier}"
                )
            state["acceptance"][identifier] = empty_acceptance_record(
                criterion_digest
            )
        item["status"] = "pending"
        item["revision_epoch"] = prior_epoch + 1
        item["plan_checkpoint_sha"] = checkpoint
        item["plan_digest"] = plan_file_digest(bundle, item)
        item["owned_paths"] = revised_owned_paths
        implementation["state"] = "authorized"
        implementation["authorization_digest"] = authorized["entry_digest"]
        implementation["bound_sha"] = item["replacement_lineage"]["start_sha"]
        for field in (
            "implementation_receipt", "implementation_receipt_digest",
            "terminal_result", "verification_verdict", "output_head_sha",
            "output_pr", "verification_digest", "changed_paths_digest",
            "descendant_quiescence_digest", "branch_release_receipt",
            "branch_release_digest", "branch_release_epoch",
            "branch_attachment_receipt", "branch_attachment_digest",
            "branch_attachment_epoch", "snapshot_authorization",
        ):
            implementation[field] = None
        for field in (
            "head_adoption_receipt",
            "head_adoption_digest",
            "head_adoption_epoch",
        ):
            review[field] = None
        review["head_adoption_terminal_lineage"] = []
        state["planning"]["blind_completeness"] = None
        revised_plan_digest = canonical_plan_digest(bundle, state)
        if revised_plan_digest != authorized_plan_digest:
            raise StateError("reauthorization plan authority digest is inconsistent")
        state["planning"]["current_plan_digest"] = revised_plan_digest
        if disposition == "required_by_intent_scope_expansion":
            state["planning"]["blind_requirement"] = {
                "requirement": "not_required_exact_pro_plan",
                "plan_digest": revised_plan_digest,
            }
        elif state["planning"]["blind_requirement"] is not None:
            state["planning"]["blind_requirement"] = {
                "requirement": state["planning"]["blind_requirement"][
                    "requirement"
                ],
                "plan_digest": revised_plan_digest,
            }
        receipt_context.update({
            "disposition": disposition,
            "priorPlanDigest": prior_plan_digest,
            "planDigest": revised_plan_digest,
            "specificationDigest": specification_digest,
            "acceptanceDigest": acceptance_digest,
            "addedOwnedPaths": added_owned_paths,
            "ownedPaths": revised_owned_paths,
            "requiredByIntentAcceptanceId": required_acceptance_id,
            "blockedReviewTerminalDigest": blocked_terminal_digest,
            "reauthorizationDigest": reauthorization_digest,
        })

    state = mutate(
        bundle,
        arguments.expect_revision,
        operation,
        allow_digest_drift={"*"},
        allow_authorization_drift=True,
    )
    item = slice_map(state)[arguments.id]
    task = item["implementation_task"]
    lineage = item["replacement_lineage"]
    return {
        "schema": "spec-work-task-reauthorization",
        **generic_receipt_identity(bundle, state),
        "stateRevision": state["revision"],
        "sliceId": item["id"],
        "taskType": "slice_implementation",
        "attempt": task["attempt"],
        "threadId": task["thread_id"],
        "clientThreadId": task["client_thread_id"],
        "taskWorktree": task["task_worktree"],
        "priorRevisionEpoch": prior_epoch,
        "revisionEpoch": item["revision_epoch"],
        "planCheckpointSha": item["plan_checkpoint_sha"],
        "authorizationDigest": task["authorization_digest"],
        "branch": item["branch"],
        "pr": lineage["pr"],
        "headSha": lineage["start_sha"],
        "baseRef": item["base_ref"],
        "baseSha": item["base_sha"],
        **receipt_context,
        "result": "REAUTHORIZED",
    }

def apply_implementation_callback_chain(
    bundle: Path,
    state: dict,
    item: dict,
    task: dict,
    receipts: list[str],
    record_observation: Callable[[str, str | None], tuple[str, int]],
) -> None:
    if (
        len(receipts) not in {1, 2}
        or len(receipts) != len(set(receipts))
    ):
        raise StateError(
            "callback chain must contain one terminal and at most one release"
        )
    if receipts[0] is None:
        raise StateError(
            f"{item['id']} implementation terminal receipt requires a typed receipt"
        )
    if receipt_schema(
        bundle,
        receipts[0],
        f"{item['id']} callback terminal",
    ) != "spec-work-implementation-terminal":
        raise StateError(
            "callback chain must begin with the implementation terminal"
        )
    if len(receipts) == 2 and (
        receipt_schema(
            bundle,
            receipts[1],
            f"{item['id']} callback branch release",
        ) != "spec-work-task-git-binding"
        or receipt_kind(
            bundle,
            receipts[1],
            f"{item['id']} callback branch release",
        ) != "branch_release"
    ):
        raise StateError(
            "callback chain may end only with the exact branch release"
        )

    snapshot_completion = (
        item["status"] == "pr_open"
        and item["pr"] is not None
        and item["head_sha"] is not None
        and implementation_attention_handoff(item)
    )
    task["implementation_receipt"] = receipts[0]
    task.update(implementation_receipt_value(bundle, state, item, task))
    if (
        task["terminal_result"] == "SUCCEEDED"
        and item["id"] == terminal_snapshot_carrier(state)
        and (
            item["status"] != "pr_open"
            or any(
                sibling["id"] != item["id"]
                and sibling["status"] not in TERMINAL_SLICE_STATUSES
                for sibling in state["slices"]
            )
        )
    ):
        if item["id"] == terminal_stacked_snapshot_carrier(state):
            raise StateError(
                "stacked final snapshot carrier remains active until upstream "
                "delivery permits its completed projection"
            )
        raise StateError(
            "terminal parallel snapshot carrier remains active until its pr_open "
            "final snapshot handoff"
        )
    retains_branch = implementation_terminal_retains_branch(
        bundle, receipts[0]
    )
    if (
        item["pr"] is not None
        and task["output_pr"] is not None
        and task["output_pr"] != item["pr"]
    ):
        raise StateError(
            "implementation terminal output PR differs from current slice PR"
        )
    if (
        item["replacement_lineage"] is not None
        and task["output_pr"] != item["replacement_lineage"]["pr"]
    ):
        raise StateError(
            "implementation terminal output PR differs from retained replacement PR"
        )
    if item["head_sha"] is not None and task["output_head_sha"] != item["head_sha"]:
        if not snapshot_completion or task["terminal_result"] != "SUCCEEDED":
            raise StateError(
                "implementation terminal output head differs from current slice head"
            )
        previous_head = item["head_sha"]
        for identifier, record in state["acceptance"].items():
            if (
                record["status"] != "pending"
                and record["producer_slice"] == item["id"]
            ):
                if record["producer_head_sha"] != previous_head:
                    raise StateError(
                        f"acceptance provenance is stale before snapshot adoption: "
                        f"{identifier}"
                    )
                record["producer_head_sha"] = task["output_head_sha"]
        item["head_sha"] = task["output_head_sha"]
    if not retains_branch and len(receipts) != 2:
        raise StateError(
            "ordinary implementation terminal requires branch-release proof"
        )
    if retains_branch and len(receipts) != 1:
        raise StateError(
            "retained-owner implementation terminal cannot release the branch"
        )
    if len(receipts) == 2:
        task["branch_release_receipt"] = receipts[1]
        digest, epoch = record_observation("branch_release", receipts[1])
        task["branch_release_digest"] = digest
        task["branch_release_epoch"] = epoch
    if not retains_branch:
        retain_adopted_replacement_lineage(bundle, state, item, task)
        for field in (
            "branch_attachment_receipt",
            "branch_attachment_digest",
            "branch_attachment_epoch",
        ):
            task[field] = None
    task["state"] = "quiescent"


def command_reconcile_callback_chain(arguments: argparse.Namespace) -> dict:
    bundle = bundle_path(arguments.bundle)
    receipts = list(arguments.receipt)

    def operation(state: dict) -> None:
        item = slice_map(state).get(arguments.id)
        if item is None:
            raise StateError(
                f"unknown reconcile-callback-chain slice: {arguments.id}"
            )
        task = item["implementation_task"]
        expected = [task["implementation_receipt"]]
        if task["branch_release_receipt"] is not None:
            expected.append(task["branch_release_receipt"])
        if task["state"] == "quiescent":
            if receipts != expected:
                raise StateError(
                    "callback replay must exactly match the current typed receipts"
                )
            implementation_receipt_value(
                bundle, state, item, task, persisted=True
            )
            if task["branch_release_receipt"] is not None:
                git_binding_receipt_value(
                    bundle,
                    state,
                    item,
                    "implementation",
                    task,
                    kind="branch_release",
                    relative=task["branch_release_receipt"],
                    persisted=True,
                )
            return
        if item["status"] in TERMINAL_SLICE_STATUSES:
            raise StateError("completed slices cannot reconcile task callbacks")
        if task["state"] != "active":
            raise StateError(
                "callback reconciliation requires the current active implementation"
            )
        if arguments.observed_main_sha is not None:
            apply_owner_observed_main(
                bundle, state, item, arguments.observed_main_sha
            )
        used_epochs = evidence_epochs(state)

        def record_observation(
            kind: str, relative: str | None
        ) -> tuple[str, int]:
            value, digest = observation_receipt_value(
                bundle,
                state,
                item,
                "implementation",
                task,
                kind=kind,
                relative=relative,
            )
            epoch = value["observationEpoch"]
            if epoch in used_epochs or (used_epochs and epoch <= max(used_epochs)):
                raise StateError(
                    "task observation epoch must advance monotonically"
                )
            used_epochs.add(epoch)
            return digest, epoch

        apply_implementation_callback_chain(
            bundle,
            state,
            item,
            task,
            receipts,
            record_observation,
        )
        if not has_admitted_local_plan_authority(state):
            state["planning"]["blind_completeness"] = None

    return mutate(
        bundle,
        arguments.expect_revision,
        operation,
        result_factory=lambda state, _changed: state,
    )


def command_task_transition(arguments: argparse.Namespace) -> dict:
    bundle = bundle_path(arguments.bundle)

    def operation(state: dict) -> None:
        items = slice_map(state)
        item = items.get(arguments.id)
        if item is None:
            raise StateError(f"unknown task-transition slice: {arguments.id}")
        if item["status"] in TERMINAL_SLICE_STATUSES:
            raise StateError("completed slices cannot create or transition tasks")
        role = arguments.role
        field = f"{role}_task"
        task = item[field]
        current = task["state"]
        prior_task = deepcopy(task) if current == "superseded" else None
        previous_attempt = task["attempt"]
        target = arguments.state
        authorized = (
            None
            if target == "superseded"
            else authorization_entry(state, arguments.id, role)
        )
        states = (
            IMPLEMENTATION_TASK_STATES
            if role == "implementation"
            else REVIEW_TASK_STATES
        )
        if target not in states:
            if role == "implementation":
                raise StateError(
                    f"invalid implementation task state: {target}; "
                    "implementation states: "
                    + ", ".join(sorted(IMPLEMENTATION_TASK_STATES))
                )
            raise StateError(
                f"invalid review task state: {target}; review states: "
                + ", ".join(sorted(REVIEW_TASK_STATES))
                + "; clean = exact-head review passed; "
                "blocked = unresolved material review finding"
            )
        if role == "review" and arguments.plan_checkpoint_sha is not None:
            raise StateError("plan checkpoints apply only to implementation tasks")
        if role == "review" and arguments.adoption_start_sha is not None:
            raise StateError(
                "implementation adoption starts apply only to implementation tasks"
            )
        if (
            arguments.adoption_start_sha is not None
            and not (role == "implementation" and target == "creating")
        ):
            raise StateError(
                "--adoption-start-sha applies only to implementation task creation"
            )
        owner_base_sync = arguments.observed_main_sha is not None
        owner_base_sync_allowed = (
            role == "implementation"
            and current == "active"
            and target == "quiescent"
        ) or (
            role == "review"
            and current == "active"
            and target in {"clean", "blocked"}
        )
        if owner_base_sync and not owner_base_sync_allowed:
            raise StateError(
                "--observed-main-sha applies only to current-owner implementation "
                "handoff or review terminal transitions"
            )
        if owner_base_sync:
            apply_owner_observed_main(
                bundle, state, item, arguments.observed_main_sha
            )
        used_epochs = evidence_epochs(state)

        def record_observation(
            kind: str, relative: str | None, *, prior: dict | None = None
        ) -> tuple[str, int]:
            value, digest = observation_receipt_value(
                bundle, state, item, role, task, kind=kind, relative=relative,
                prior_task=prior,
            )
            epoch = value["observationEpoch"]
            if epoch in used_epochs or (used_epochs and epoch <= max(used_epochs)):
                raise StateError("task observation epoch must advance monotonically")
            used_epochs.add(epoch)
            return digest, epoch

        def record_branch_attachment(
            relative: str | None, *, kind: str | None = None
        ) -> dict:
            receipt_kind = kind or f"{role}_attachment"
            value, digest = git_binding_receipt_value(
                bundle, state, item, role, task,
                kind=receipt_kind, relative=relative,
            )
            epoch = value["observationEpoch"]
            if epoch in used_epochs or (used_epochs and epoch <= max(used_epochs)):
                raise StateError("task observation epoch must advance monotonically")
            used_epochs.add(epoch)
            task["branch_attachment_receipt"] = relative
            task["branch_attachment_digest"] = digest
            task["branch_attachment_epoch"] = epoch
            return value

        def set_immutable(name: str, value: str | None) -> None:
            if value is None:
                return
            if task[name] is not None and task[name] != value:
                raise StateError(
                    f"{arguments.id} {role} {name} is immutable within an attempt"
                )
            task[name] = value

        def bind_resolved_task() -> None:
            set_immutable("thread_id", arguments.thread_id)
            set_immutable("client_thread_id", arguments.client_thread_id)
            set_immutable("task_worktree", arguments.task_worktree)
            set_immutable("bound_sha", arguments.bound_sha)
            if task["thread_id"] is None:
                raise StateError("active or prepared task requires --thread-id")
            if task["task_worktree"] is None:
                raise StateError("active or prepared task requires --task-worktree")
            normalized = absolute_path_value(
                task["task_worktree"], "task-transition task worktree"
            )
            if normalized != task["task_worktree"]:
                raise StateError("task worktree must be a canonical absolute path")
            if task["task_worktree"] == REPO.as_posix():
                raise StateError("task worktree must be distinct from the coordinator")
            if task["bound_sha"] is None:
                raise StateError("active or prepared task requires --bound-sha")

        def isolated_parallel_retry() -> bool:
            peers = [
                candidate
                for candidate in items.values()
                if candidate["id"] != item["id"]
                and candidate["wave"] == item["wave"]
                and candidate["execution_mode"] == "parallel"
            ]
            return (
                previous_attempt >= 1
                and bool(peers)
                and all(
                    candidate["status"] in TERMINAL_SLICE_STATUSES
                    or (
                        candidate["status"] in QUIESCENT_PARALLEL_STATUSES
                        and not nonquiescent_task_labels(candidate)
                    )
                    for candidate in peers
                )
            )

        def require_direct_implementation_admission(
            attempt: int, *, plan_replacement_reservation: bool = False
        ) -> None:
            if state["phase"] != "delivery" and not (
                plan_replacement_reservation and state["phase"] == "plan"
            ):
                raise StateError("direct implementation launch requires delivery phase")
            if state["blockers"]:
                raise StateError("cannot launch implementation while feature blockers remain")
            if not all(
                item[name] is not None for name in ("branch", "base_ref", "base_sha")
            ):
                raise StateError("implementation launch requires branch/base binding")
            require_current_base(state, item)
            mutating = sorted(
                candidate["id"]
                for candidate in items.values()
                if candidate["id"] != item["id"]
                and candidate["status"] in MUTATING_SLICE_STATUSES
            )
            if mutating:
                raise StateError(
                    "another implementation is still mutating: " + ", ".join(mutating)
                )

            allowed_active: set[str] = set()
            for candidate in items.values():
                if candidate["id"] == item["id"]:
                    continue
                same_parallel_wave = (
                    item["execution_mode"] == "parallel"
                    and candidate["execution_mode"] == "parallel"
                    and candidate["wave"] == item["wave"]
                    and candidate["status"] in QUIESCENT_PARALLEL_STATUSES
                    and not nonquiescent_task_labels(candidate)
                )
                clean_open_ancestor = (
                    dependency_reaches(items, item["id"], candidate["id"])
                    and candidate["status"] == "pr_open"
                    and candidate["implementation_task"]["state"]
                    in {"quiescent", "superseded"}
                    and candidate["review_task"]["state"] == "clean"
                    and candidate["review_task"]["bound_sha"] == candidate["head_sha"]
                )
                if same_parallel_wave or clean_open_ancestor:
                    allowed_active.add(candidate["id"])
            unexpected_active = sorted(
                candidate["id"]
                for candidate in items.values()
                if candidate["id"] != item["id"]
                and candidate["status"] in ACTIVE_SLICE_STATUSES
                and candidate["id"] not in allowed_active
            )
            if unexpected_active:
                raise StateError(
                    "prior slice lifecycle remains active: "
                    + ", ".join(unexpected_active)
                )

            if item["status"] == "pr_open":
                if attempt < 2 or item["head_sha"] is None or item["pr"] is None:
                    raise StateError("open-PR replacement requires a current PR head")
                if item["review_task"]["state"] not in {"unbound", "superseded"}:
                    raise StateError("open-PR replacement requires the prior review superseded")
                return

            lineage = item["replacement_lineage"]
            if lineage is not None:
                if item["status"] != "pending" or attempt < 2:
                    raise StateError(
                        "retained open-PR lineage requires a pending replacement attempt"
                    )
                if item["review_task"]["state"] not in {"unbound", "superseded"}:
                    raise StateError(
                        "open-PR replacement requires the prior review superseded"
                    )
                return

            if item["status"] != "pending":
                raise StateError("direct implementation launch requires a pending slice")
            trunk_ready, stackable = (set(values) for values in readiness(state))
            if item["execution_mode"] == "parallel":
                if not isolated_parallel_retry():
                    raise StateError(
                        "initial parallel implementation requires prepared multi-slice start-wave"
                    )
            elif item["id"] not in trunk_ready | stackable:
                raise StateError(f"slice is not executable: {item['id']}")
            candidate_chain = stackable_chain(items, item)
            predecessors = earlier_nonterminal_slices(
                items,
                item,
                allowed_open_dependencies={
                    ancestor["id"] for ancestor in (candidate_chain or [])
                },
            )
            if predecessors and not isolated_parallel_retry():
                raise StateError(
                    "earlier slice remains nonterminal: " + ", ".join(predecessors)
                )

        def require_direct_implementation_start() -> None:
            require_direct_implementation_admission(task["attempt"])
            if item["status"] == "pr_open":
                retain_replacement_lineage(item)
                if task["bound_sha"] != expected_start_sha(item):
                    raise StateError("open-PR replacement must start from the exact PR head")
                invalidate_attempt(bundle, state, item)
                item["status"] = "in_progress"
                return
            if item["replacement_lineage"] is not None:
                if task["bound_sha"] != expected_start_sha(item):
                    raise StateError(
                        "open-PR replacement must start from the retained exact PR head"
                    )
                item["status"] = "in_progress"
                return
            if task["bound_sha"] != item["base_sha"]:
                if (
                    task["attempt"] != 1
                    or arguments.branch_attachment_receipt is None
                ):
                    raise StateError(
                        "fresh implementation must start from its required base"
                    )
                adoption = record_branch_attachment(
                    arguments.branch_attachment_receipt,
                    kind="implementation_pr_adoption",
                )
                item["status"] = "in_progress"
                return
            if (
                task["attempt"] == 1
                and task["bound_sha"] != task["adoption_start_sha"]
            ):
                raise StateError(
                    "fresh implementation must start from its durable adoption start"
                )
            if arguments.branch_attachment_receipt is not None:
                raise StateError(
                    "fresh implementation cannot claim existing PR adoption"
                )
            item["status"] = "in_progress"

        def require_review_start_safe() -> None:
            if state["phase"] != "delivery":
                raise StateError("review tasks may start only during delivery")
            if item["status"] != "pr_open" or item["pr"] is None:
                raise StateError("review task requires an open PR")
            if item["implementation_task"]["state"] not in {
                "quiescent", "superseded"
            }:
                raise StateError("review task requires quiescent implementation")
            if item["implementation_task"]["branch_release_digest"] is None:
                raise StateError("review task requires implementation branch-release proof")
            descendants = [
                candidate
                for candidate in items.values()
                if candidate["id"] != item["id"]
                and dependency_reaches(items, candidate["id"], item["id"])
            ]
            active_descendants = sorted(
                label
                for candidate in descendants
                for label in nonquiescent_task_labels(candidate)
            )
            if active_descendants:
                raise StateError(
                    "upstream review cannot restart while dependent tasks are active: "
                    + ", ".join(active_descendants)
                )

        if target == "creating" and current != "creating":
            parallel_preparation = False
            plan_replacement_reservation = False
            allowed = {"unbound", "superseded"}
            if current not in allowed:
                raise StateError(
                    f"invalid {role} task transition: {current} -> creating"
                )
            if arguments.launch_marker is None:
                raise StateError("task creation requires a pre-create --launch-marker")
            if arguments.authorization_digest != authorized["entry_digest"]:
                raise StateError(
                    "task creation digest does not match the registered roster entry"
                )
            if any(
                value is not None
                for value in (
                    arguments.thread_id, arguments.client_thread_id,
                    arguments.task_worktree, arguments.bound_sha,
                    arguments.stop_proof_receipt,
                    arguments.branch_release_receipt,
                    arguments.branch_attachment_receipt,
                    arguments.review_receipt,
                    arguments.implementation_receipt,
                )
            ):
                raise StateError(
                    "reserve the launch before create_thread returns an external identity"
                )
            if role == "implementation" and arguments.plan_checkpoint_sha is None:
                raise StateError(
                    "implementation task creation requires --plan-checkpoint-sha"
                )
            if (
                role == "implementation"
                and current == "superseded"
                and arguments.adoption_start_sha is not None
            ):
                raise StateError(
                    "replacement implementation cannot carry an adoption start SHA"
                )
            if current == "superseded":
                allowed_predicates = authorized_replacement_predicates(
                    bundle, state, arguments.id, role
                )
                if arguments.replacement_predicate not in allowed_predicates:
                    raise StateError(
                        "replacement task must select an exact authorized predicate"
                    )
                if arguments.observation_proof_receipt is None:
                    raise StateError(
                        "replacement task requires current observation proof"
                    )
            elif (
                arguments.replacement_predicate is not None
                or arguments.observation_proof_receipt is not None
            ):
                raise StateError("first task attempt cannot claim replacement proof")
            if role == "implementation":
                if state["phase"] not in {"plan", "delivery"}:
                    raise StateError(
                        "implementation task reservations are allowed only in plan or delivery"
                    )
                if item["status"] not in {"pending", "pr_open"}:
                    raise StateError(
                        "implementation task attempts require a pending slice or open-PR replacement"
                    )
                if item["status"] == "pr_open" and (
                    current != "superseded"
                    or item["pr"] is None
                    or item["head_sha"] is None
                ):
                    raise StateError(
                        "open-PR implementation replacement requires a superseded prior attempt and current PR head"
                    )
                if item["status"] == "pending" and (
                    any(
                        items[dependency]["status"] != "merged"
                        for dependency in item["depends_on"]
                    )
                    and stackable_chain(items, item) is None
                ):
                    raise StateError(
                        "dependency-edge task preparation requires a clean upstream review"
                    )
                if item["review_task"]["state"] not in {"unbound", "superseded"}:
                    raise StateError(
                        "supersede the prior review task before a new implementation attempt"
                    )
                checkpoint = arguments.plan_checkpoint_sha
                if checkpoint is None:
                    raise StateError(
                        "implementation task creation requires --plan-checkpoint-sha"
                    )
                if (
                    item["plan_checkpoint_sha"] is not None
                    and checkpoint != item["plan_checkpoint_sha"]
                    and current != "superseded"
                ):
                    raise StateError(
                        "plan checkpoint is immutable until the prior task is superseded"
                    )
                if (
                    item["plan_checkpoint_sha"] is not None
                    and checkpoint != item["plan_checkpoint_sha"]
                    and state["phase"] != "plan"
                ):
                    raise StateError(
                        "a changed plan checkpoint may be bound only during plan"
                    )
                plan_replacement_reservation = (
                    state["phase"] == "plan"
                    and current == "superseded"
                    and item["status"] == "pending"
                    and item["execution_mode"] == "serial"
                    and item["replacement_lineage"] is not None
                    and item["plan_checkpoint_sha"] is not None
                    and checkpoint != item["plan_checkpoint_sha"]
                )
                require_current_base(state, item)
                if item["status"] == "pending":
                    if item["execution_mode"] == "serial":
                        if (
                            state["phase"] != "delivery"
                            and not plan_replacement_reservation
                        ):
                            raise StateError(
                                "serial implementation tasks may launch only during delivery"
                            )
                        trunk_ready, stackable = (set(values) for values in readiness(state))
                        if item["id"] not in trunk_ready | stackable:
                            predecessors = earlier_nonterminal_slices(items, item)
                            if predecessors:
                                raise StateError(
                                    "prior slice lifecycle remains active: "
                                    + ", ".join(predecessors)
                                )
                            raise StateError(f"slice is not executable: {item['id']}")
                    elif previous_attempt >= 1:
                        retry_cohort = complete_parallel_retry_cohort(items, item)
                        if retry_cohort is not None:
                            validate_parallel_retry_group(state, retry_cohort)
                            parallel_preparation = True
                        elif not isolated_parallel_retry():
                            raise StateError(
                                "parallel retry requires same-wave siblings to be "
                                "quiescent or terminal"
                            )
                    else:
                        initial_group = nonterminal_wave_members(items, item["wave"])
                        validate_initial_parallel_group(state, initial_group)
                        parallel_preparation = len(initial_group) >= 2
                if (
                    parallel_preparation
                    and state["phase"] == "plan"
                    and state["planning"]["active_response_digest"] is None
                ):
                    raise StateError(
                        "implementation task reservation in plan requires Pro evidence"
                    )
                if state["blockers"] and not parallel_preparation:
                    raise StateError(
                        "cannot reserve a mutating implementation launch while "
                        "feature blockers remain"
                    )
                if not parallel_preparation:
                    require_direct_implementation_admission(
                        previous_attempt + 1,
                        plan_replacement_reservation=plan_replacement_reservation,
                    )
                if arguments.companion_probe_receipt is not None:
                    raise StateError(
                        "implementation reservation cannot carry a review companion probe"
                    )
                require_checkpointed_slice_plan(
                    bundle,
                    item,
                    checkpoint,
                    "implementation plan checkpoint",
                )
                if checkpointed_plan_digest(
                    bundle,
                    state,
                    checkpoint,
                    "implementation plan checkpoint",
                ) != canonical_plan_digest(bundle, state):
                    raise StateError(
                        "implementation plan checkpoint does not match the "
                        "current planning snapshot"
                    )
                require_current_base(state, item)
                item["plan_checkpoint_sha"] = checkpoint
                item["plan_digest"] = plan_file_digest(bundle, item)
                if item["revision_epoch"] == 0:
                    item["revision_epoch"] = 1
            else:
                if state["blockers"]:
                    raise StateError(
                        "cannot reserve a review launch while feature blockers remain"
                    )
                require_review_start_safe()
                if arguments.companion_probe_receipt is None:
                    raise StateError(
                        "review reservation requires a typed gitnexus-pr-review probe"
                    )
            if (
                role == "implementation"
                and current == "unbound"
                and arguments.adoption_start_sha is None
            ):
                raise StateError(
                    "first implementation task creation requires "
                    "--adoption-start-sha"
                )
            if current == "superseded":
                item["task_history"].append(
                    {"role": role, "task": deepcopy(task)}
                )
            task.clear()
            task.update(empty_task())
            task["attempt"] = previous_attempt + 1
            task["state"] = "creating"
            set_immutable("launch_marker", arguments.launch_marker)
            set_immutable("authorization_digest", arguments.authorization_digest)
            if role == "implementation":
                set_immutable(
                    "adoption_start_sha", arguments.adoption_start_sha
                )
            if arguments.replacement_predicate is not None:
                task["replacement_predicate_digest"] = text_digest(
                    arguments.replacement_predicate
                )
                task["replacement_observation_receipt"] = arguments.observation_proof_receipt
                digest, epoch = record_observation(
                    "replacement_predicate", arguments.observation_proof_receipt,
                    prior=prior_task,
                )
                task["replacement_observation_digest"] = digest
                task["replacement_observation_epoch"] = epoch
            if role == "review":
                task["companion_probe_receipt"] = arguments.companion_probe_receipt
                digest, epoch = record_observation(
                    "companion_probe", arguments.companion_probe_receipt
                )
                task["companion_probe_digest"] = digest
                task["companion_probe_epoch"] = epoch
        elif target == "creating":
            set_immutable("launch_marker", arguments.launch_marker)
            set_immutable("authorization_digest", arguments.authorization_digest)
            set_immutable("adoption_start_sha", arguments.adoption_start_sha)
            if task["authorization_digest"] != authorized["entry_digest"]:
                raise StateError("task reservation roster binding is stale")
            if arguments.bound_sha is not None:
                raise StateError("creating task binds its start SHA only when active or prepared")
            if arguments.task_worktree is not None:
                raise StateError("creating task binds its worktree only when it becomes active or prepared")
            if arguments.stop_proof_receipt is not None or arguments.branch_release_receipt is not None:
                raise StateError("creating task cannot preload stop/release proof")
            if (
                arguments.replacement_predicate is not None
                or arguments.observation_proof_receipt is not None
                or arguments.review_receipt is not None
                or arguments.implementation_receipt is not None
                or arguments.companion_probe_receipt is not None
                or arguments.branch_attachment_receipt is not None
            ):
                raise StateError("creating identity binding cannot change reservation proof")
            if arguments.thread_id is None and arguments.client_thread_id is None:
                raise StateError(
                    "creating task identity transition requires one observed external ID"
                )
            set_immutable("thread_id", arguments.thread_id)
            set_immutable("client_thread_id", arguments.client_thread_id)
            if (
                arguments.plan_checkpoint_sha is not None
                and arguments.plan_checkpoint_sha != item["plan_checkpoint_sha"]
            ):
                raise StateError("plan checkpoint is immutable within an attempt")
        elif role == "implementation" and target == "prepared":
            if current != "creating":
                raise StateError(
                    f"invalid implementation task transition: {current} -> prepared"
                )
            members = nonterminal_wave_members(items, item["wave"])
            if len(members) < 2:
                raise StateError(
                    "prepared is reserved for a parallel wave with at least two slices"
                )
            preparation_group = (
                complete_parallel_retry_cohort(items, item) or members
            )
            validate_parallel_start_group(state, preparation_group)
            bind_resolved_task()
            if item["plan_checkpoint_sha"] is None:
                raise StateError("prepared implementation requires a plan checkpoint")
            if not all(item[name] is not None for name in ("branch", "base_ref", "base_sha")):
                raise StateError("prepared implementation requires branch/base binding")
            if task["bound_sha"] != expected_start_sha(item):
                raise StateError("prepared implementation must bind its exact START SHA")
            require_current_base(state, item)
            task["state"] = "prepared"
        elif role == "implementation" and target == "active":
            if current == "authorized":
                if state["phase"] != "delivery":
                    raise StateError(
                        "reauthorized implementation activates only during delivery"
                    )
                pre_pr_resume = (
                    bool(item["revision_history"])
                    and item["revision_history"][-1][
                        "reauthorization_disposition"
                    ] in PRE_PR_REAUTHORIZATION_DISPOSITIONS
                )
                if pre_pr_resume:
                    if (
                        item["status"] != "pending"
                        or item["replacement_lineage"] is not None
                        or item["pr"] is not None
                        or item["head_sha"] is not None
                    ):
                        raise StateError(
                            "pre-PR reauthorized implementation is stale"
                        )
                    if arguments.branch_attachment_receipt is not None:
                        raise StateError(
                            "pre-PR resume cannot create a second Git attachment"
                        )
                else:
                    if (
                        item["status"] != "pending"
                        or item["replacement_lineage"] is None
                        or task["bound_sha"]
                        != item["replacement_lineage"]["start_sha"]
                    ):
                        raise StateError(
                            "reauthorized implementation is stale against its retained PR"
                        )
                    if arguments.branch_attachment_receipt is None:
                        raise StateError(
                            "reauthorized implementation requires branch-attachment proof"
                        )
                    record_branch_attachment(arguments.branch_attachment_receipt)
                item["status"] = "in_progress"
                task["state"] = "active"
            elif current != "creating":
                raise StateError(
                    f"invalid implementation task transition: {current} -> active"
                )
            else:
                bind_resolved_task()
                require_direct_implementation_start()
                task["state"] = "active"
        elif role == "implementation" and target == "quiescent":
            if current != "active":
                raise StateError(
                    f"invalid implementation task transition: {current} -> quiescent"
                )
            receipts = [arguments.implementation_receipt]
            if arguments.branch_release_receipt is not None:
                receipts.append(arguments.branch_release_receipt)
            apply_implementation_callback_chain(
                bundle,
                state,
                item,
                task,
                receipts,
                record_observation,
            )
        elif role == "implementation" and target == "superseded":
            if current not in {"creating", "prepared", "active", "quiescent"}:
                raise StateError(
                    f"invalid implementation task transition: {current} -> superseded"
                )
            if arguments.stop_proof_receipt is None:
                raise StateError("implementation supersession requires stop proof")
            if (
                task["thread_id"] is not None or task["client_thread_id"] is not None
            ) and arguments.branch_release_receipt is None and task[
                "branch_release_receipt"
            ] is None:
                raise StateError(
                    "implementation supersession requires branch-release proof"
                )
            task["stop_proof_receipt"] = arguments.stop_proof_receipt
            digest, epoch = record_observation("stop", arguments.stop_proof_receipt)
            task["stop_proof_digest"], task["stop_proof_epoch"] = digest, epoch
            if arguments.branch_release_receipt is not None:
                if task["branch_release_receipt"] is not None:
                    raise StateError(
                        "implementation supersession cannot replace existing "
                        "branch-release proof"
                    )
                task["branch_release_receipt"] = arguments.branch_release_receipt
                digest, epoch = record_observation(
                    "branch_release", arguments.branch_release_receipt
                )
                task["branch_release_digest"], task["branch_release_epoch"] = digest, epoch
            retain_adopted_replacement_lineage(bundle, state, item, task)
            for field in (
                "branch_attachment_receipt", "branch_attachment_digest",
                "branch_attachment_epoch",
            ):
                task[field] = None
            task["state"] = "superseded"
        elif role == "review" and target == "active" and current == "active":
            raise StateError(
                "active review head rotations are task-local; advance the rolling lease"
            )
        elif role == "review" and target == "active":
            if current not in {"creating", "blocked"}:
                raise StateError(
                    f"invalid review task transition: {current} -> active"
                )
            require_review_start_safe()
            if current == "blocked":
                for name, value in (
                    ("thread_id", arguments.thread_id),
                    ("client_thread_id", arguments.client_thread_id),
                    ("task_worktree", arguments.task_worktree),
                ):
                    set_immutable(name, value)
                requested_head = arguments.bound_sha or item["head_sha"]
                task["bound_sha"] = requested_head
                task["authorization_digest"] = authorized["entry_digest"]
                if (
                    task["head_adoption_receipt"] is not None
                    and task["branch_attachment_receipt"] is not None
                ):
                    terminal, terminal_digest = review_lease_terminal_value(
                        bundle,
                        state,
                        item,
                        task,
                        task["branch_attachment_receipt"],
                        target="blocked",
                        review_receipt=None,
                        persisted=True,
                    )
                    if terminal_digest != task["branch_attachment_digest"]:
                        raise StateError(
                            "blocked review terminal lineage digest is stale"
                        )
                    task["head_adoption_terminal_lineage"].append({
                        "receipt": task["branch_attachment_receipt"],
                        "digest": terminal_digest,
                        "epoch": terminal["observationEpoch"],
                        "result": "BLOCKED",
                        "review_receipt": None,
                    })
                for field in (
                    "branch_attachment_receipt", "branch_attachment_digest",
                    "branch_attachment_epoch",
                ):
                    task[field] = None
                bind_resolved_task()
            else:
                bind_resolved_task()
            if task["bound_sha"] != item["head_sha"]:
                raise StateError("review launch is stale against the current head")
            if arguments.branch_attachment_receipt is None:
                raise StateError("review activation requires branch-attachment receipt")
            record_branch_attachment(arguments.branch_attachment_receipt)
            task["state"] = "active"
        elif role == "review" and target in {"clean", "blocked"}:
            if current != "active":
                raise StateError(
                    f"invalid review task transition: {current} -> {target}"
                )
            if arguments.branch_attachment_receipt is None:
                raise StateError(
                    f"{target} review requires a terminal rolling-lease receipt"
                )
            terminal, terminal_digest = review_lease_terminal_value(
                bundle,
                state,
                item,
                task,
                arguments.branch_attachment_receipt,
                target=target,
                review_receipt=arguments.review_receipt,
                allow_final_head_adoption=True,
            )
            epoch = terminal["observationEpoch"]
            if epoch in used_epochs or (used_epochs and epoch <= max(used_epochs)):
                raise StateError("task observation epoch must advance monotonically")
            used_epochs.add(epoch)
            if terminal["finalHeadSha"] != item["head_sha"]:
                invalidate_slice_acceptance(bundle, state, item)
            item["head_sha"] = terminal["finalHeadSha"]
            item["base_sha"] = terminal["finalBaseSha"]
            task["bound_sha"] = terminal["finalHeadSha"]
            task["branch_attachment_receipt"] = arguments.branch_attachment_receipt
            task["branch_attachment_digest"] = terminal_digest
            task["branch_attachment_epoch"] = epoch
            if target == "clean":
                if item["status"] != "pr_open" or task["bound_sha"] != item["head_sha"]:
                    raise StateError("clean review must bind the current open PR head")
                require_review_dependency_quiescence(items, item)
                task["review_receipt"] = arguments.review_receipt
                proof = review_clean_receipt_value(bundle, state, item, task)
                task.update(proof)
            elif arguments.review_receipt is not None:
                raise StateError("blocked review cannot carry a clean receipt")
            if target == "blocked" and arguments.branch_release_receipt is not None:
                task["branch_release_receipt"] = arguments.branch_release_receipt
                digest, release_epoch = record_observation(
                    "branch_release", arguments.branch_release_receipt
                )
                task["branch_release_digest"] = digest
                task["branch_release_epoch"] = release_epoch
            if target == "clean":
                for field in (
                    "branch_release_receipt", "branch_release_digest",
                    "branch_release_epoch",
                ):
                    task[field] = None
            task["state"] = target
        elif role == "review" and target == "superseded":
            if current not in {"creating", "active", "clean", "blocked"}:
                raise StateError(
                    f"invalid review task transition: {current} -> superseded"
                )
            if current == "clean" and item["status"] == "pr_open":
                require_review_start_safe()
            if arguments.branch_attachment_receipt is not None:
                raise StateError("review supersession cannot replace attachment proof")
            if arguments.stop_proof_receipt is None:
                raise StateError("review supersession requires stop proof")
            attachment_epoch = task["branch_attachment_epoch"]
            fresh_release_required = (
                current == "active"
                and attachment_epoch is not None
                and (
                    task["branch_release_epoch"] is None
                    or task["branch_release_epoch"] <= attachment_epoch
                )
            )
            if (
                task["thread_id"] is not None or task["client_thread_id"] is not None
            ) and arguments.branch_release_receipt is None and (
                task["branch_release_receipt"] is None
                or fresh_release_required
            ):
                raise StateError(
                    "review supersession requires fresh branch-release proof"
                )
            task["stop_proof_receipt"] = arguments.stop_proof_receipt
            digest, epoch = record_observation("stop", arguments.stop_proof_receipt)
            task["stop_proof_digest"], task["stop_proof_epoch"] = digest, epoch
            if arguments.branch_release_receipt is not None:
                if (
                    task["branch_release_receipt"] is not None
                    and not fresh_release_required
                ):
                    raise StateError(
                        "review supersession cannot replace existing "
                        "branch-release proof"
                    )
                task["branch_release_receipt"] = arguments.branch_release_receipt
                digest, epoch = record_observation(
                    "branch_release", arguments.branch_release_receipt
                )
                if (
                    fresh_release_required
                    and attachment_epoch is not None
                    and epoch <= attachment_epoch
                ):
                    raise StateError(
                        "review supersession requires fresh branch-release proof"
                    )
                task["branch_release_digest"], task["branch_release_epoch"] = digest, epoch
            if fresh_release_required:
                for field in BRANCH_ATTACHMENT_FIELDS:
                    task[field] = None
            task["state"] = "superseded"
        else:
            raise StateError(f"invalid {role} task transition: {current} -> {target}")
        if not has_admitted_local_plan_authority(state):
            state["planning"]["blind_completeness"] = None

    return mutate(
        bundle,
        arguments.expect_revision,
        operation,
        allow_authorization_drift=arguments.state == "superseded",
        allow_task_authorization_drift=arguments.state == "superseded",
    )

def command_start_wave(arguments: argparse.Namespace) -> dict:
    bundle = bundle_path(arguments.bundle)

    def operation(state: dict) -> None:
        if state["phase"] != "delivery":
            raise StateError("start-wave requires delivery phase")
        if state["blockers"]:
            raise StateError("cannot start a wave while feature blockers remain")
        identifiers = arguments.slice or []
        if len(identifiers) < 2:
            raise StateError("start-wave requires at least two prepared slices")
        if len(identifiers) != len(set(identifiers)):
            raise StateError("start-wave slice ids must be unique")
        items = slice_map(state)
        unknown = sorted(set(identifiers) - set(items))
        if unknown:
            raise StateError("unknown start-wave slice: " + ", ".join(unknown))
        selected = [items[identifier] for identifier in identifiers]
        validate_wave_execution_modes(items, selected)
        not_pending = [item["id"] for item in selected if item["status"] != "pending"]
        if not_pending:
            raise StateError(
                "start-wave slices are not pending: " + ", ".join(not_pending)
            )
        unprepared = sorted(
            item["id"]
            for item in selected
            if item["implementation_task"]["state"] != "prepared"
        )
        if unprepared:
            raise StateError(
                "start-wave requires prepared implementation tasks: "
                + ", ".join(unprepared)
            )
        validate_parallel_start_group(state, selected)
        mutating = sorted(
            identifier
            for identifier, item in items.items()
            if item["status"] in MUTATING_SLICE_STATUSES
            and identifier not in identifiers
        )
        if mutating:
            raise StateError(
                "another implementation is still mutating: " + ", ".join(mutating)
            )
        for item in selected:
            if not all(
                item[field] is not None for field in ("branch", "base_ref", "base_sha")
            ):
                raise StateError(
                    f"{item['id']} requires a complete branch/base binding"
                )
            if item["implementation_task"]["bound_sha"] != expected_start_sha(item):
                raise StateError(
                    f"{item['id']} prepared implementation must bind its exact START SHA"
                )
            require_current_base(state, item)
        trunk_ready = set(readiness(state)[0])
        selected_ids = set(identifiers)
        selected_wave = selected[0]["wave"]
        outside_active = [
            item
            for item in items.values()
            if item["id"] not in selected_ids
            and item["status"] in ACTIVE_SLICE_STATUSES
        ]
        unexpected_active = [
            item["id"]
            for item in outside_active
            if not (
                item["execution_mode"] == "parallel"
                and item["wave"] == selected_wave
                and item["status"] in QUIESCENT_PARALLEL_STATUSES
                and not nonquiescent_task_labels(item)
            )
        ]
        if unexpected_active:
            raise StateError(
                "prior slice lifecycle remains active: "
                + ", ".join(sorted(unexpected_active))
            )
        waves = {item["wave"] for item in selected}
        if len(waves) != 1:
            raise StateError("parallel slices must belong to one wave")
        if any(item["execution_mode"] != "parallel" for item in selected):
            raise StateError("multi-slice wave requires parallel execution mode")
        not_ready = sorted(selected_ids - trunk_ready)
        if not_ready:
            raise StateError(
                "parallel slices must be trunk-ready: " + ", ".join(not_ready)
            )
        for item in selected:
            item["status"] = "in_progress"
            item["implementation_task"]["state"] = "active"

    return mutate(bundle, arguments.expect_revision, operation)

def command_record_acceptance(arguments: argparse.Namespace) -> dict:
    bundle = bundle_path(arguments.bundle)

    def operation(state: dict) -> None:
        if (
            arguments.status == "pending"
            and state["planning"]["current_plan_digest"] is not None
        ):
            raise StateError(
                "atomic Plan adoption requires adopt-plan for planning changes"
            )
        criteria = acceptance_criteria(bundle, state)
        declared = set(criteria)
        if arguments.id not in declared:
            raise StateError(
                f"acceptance id is not declared in ACCEPTANCE.md: {arguments.id}"
            )
        evidence = sorted(set(arguments.evidence or []))
        evidence_digests = hash_evidence(bundle, state, arguments.id, evidence)
        provenance = (
            acceptance_assignment_value(bundle, state, arguments.id, evidence)
            if arguments.status != "pending"
            else {
                "scope": None,
                "producer_slice": None,
                "producer_head_sha": None,
                "assignment_digest": None,
            }
        )
        proposed = {
            "status": arguments.status,
            "evidence": evidence,
            "evidence_digests": evidence_digests,
            "criterion_digest": criteria[arguments.id],
            **provenance,
            "locked": False,
        }
        existing = state["acceptance"].get(arguments.id)
        if existing is not None and existing["locked"]:
            raise StateError("locked acceptance record is immutable")
        if existing is not None and existing["status"] in {"passed", "waived"}:
            if existing != proposed:
                raise StateError("completed acceptance evidence is immutable")
        if arguments.status == "pending" and evidence:
            raise StateError("pending acceptance cannot carry evidence")
        if arguments.status != "pending" and not evidence:
            raise StateError(f"acceptance status {arguments.status} requires evidence")
        for path in evidence:
            safe_path(bundle, path, f"{arguments.id} evidence", required=True)
        contract = (
            ui_design_contract(bundle, state)
            if arguments.status in {"passed", "waived"}
            or arguments.ui_attestation is not None
            else None
        )
        automated_owner: tuple[str, str] | None = None
        if contract is not None:
            items = slice_map(state)
            for slice_id in sorted(
                current_ui_epoch_ids(bundle, items, contract[0])
            ):
                plan = state_slice_plan_contract(
                    bundle, state, items[slice_id]
                )
                if plan["automated"] == arguments.id:
                    automated_owner = (slice_id, arguments.id)
                    break
        if automated_owner is not None:
            if arguments.status == "waived":
                raise StateError(
                    f"automated UI acceptance {arguments.id} cannot be waived"
                )
            if arguments.status == "passed":
                slice_id, _ = automated_owner
                matching_receipt = None
                receipt_error = None
                for path in evidence:
                    try:
                        matching_receipt = validate_typed_implementation_receipt(
                            bundle, state, slice_id, path
                        )
                        break
                    except StateError as error:
                        receipt_error = error
                if matching_receipt is None:
                    detail = f": {receipt_error}" if receipt_error is not None else ""
                    raise StateError(
                        f"automated UI acceptance {arguments.id} requires its exact "
                        f"typed implementation-proof receipt{detail}"
                    )
        if (
            contract is not None
            and arguments.id == contract[1]
            and arguments.status in {"passed", "waived"}
        ):
            final_slice = slice_map(state)[contract[0]]
            final_review = final_slice["review_task"]
            if (
                final_review["state"] != "clean"
                or final_review["bound_sha"] != final_slice["head_sha"]
            ):
                raise StateError(
                    "final UI design acceptance requires an exact-head clean review"
                )
            if arguments.ui_attestation is None:
                raise StateError("final UI design acceptance requires --ui-attestation")
            receipt = validate_typed_ui_attestation(
                bundle,
                state,
                arguments.ui_attestation,
                mode="final-design-acceptance",
                expected_status=arguments.status,
            )
            if arguments.ui_attestation not in evidence or receipt not in evidence:
                raise StateError(
                    "final UI acceptance evidence must include attestation and receipt"
                )
        elif arguments.ui_attestation is not None:
            raise StateError("--ui-attestation applies only to final UI design acceptance")
        if arguments.status == "pending":
            for identifier in sorted(declared - set(state["acceptance"])):
                state["acceptance"][identifier] = empty_acceptance_record(
                    criteria[identifier]
                )
        state["acceptance"][arguments.id] = proposed

    return mutate(
        bundle,
        arguments.expect_revision,
        operation,
        allow_acceptance_drift=arguments.status == "pending",
    )

def command_refresh_acceptance(arguments: argparse.Namespace) -> dict:
    bundle = bundle_path(arguments.bundle)
    identifiers = sorted(set(arguments.id or []))
    if not identifiers:
        raise StateError("refresh-acceptance requires at least one --id")

    def operation(state: dict) -> None:
        if state["planning"]["current_plan_digest"] is not None:
            raise StateError(
                "atomic Plan adoption requires adopt-plan for planning changes"
            )
        active_tasks = all_nonquiescent_task_labels(slice_map(state))
        if active_tasks:
            raise StateError(
                "refresh-acceptance requires tasks quiescent: "
                + ", ".join(active_tasks)
            )
        criteria = acceptance_criteria(bundle, state)
        unknown = sorted(set(identifiers) - set(criteria))
        if unknown:
            raise StateError(
                "refresh-acceptance criterion is missing: " + ", ".join(unknown)
            )
        absent = sorted(set(identifiers) - set(state["acceptance"]))
        if absent:
            raise StateError(
                "new acceptance IDs must first sync as pending: " + ", ".join(absent)
            )
        locked = [
            identifier for identifier in identifiers
            if state["acceptance"][identifier]["locked"]
        ]
        if locked:
            raise StateError(
                "locked acceptance record is immutable: " + ", ".join(locked)
            )
        for identifier in identifiers:
            state["acceptance"][identifier] = empty_acceptance_record(
                criteria[identifier]
            )
        state["planning"]["blind_completeness"] = None

    return mutate(
        bundle,
        arguments.expect_revision,
        operation,
        allow_digest_drift=set(identifiers),
        allow_specification_drift=True,
    )

def command_set_blocker(arguments: argparse.Namespace) -> dict:
    bundle = bundle_path(arguments.bundle)

    def operation(state: dict) -> None:
        if arguments.id in state["blockers"]:
            raise StateError(f"blocker already exists: {arguments.id}")
        state["blockers"] = sorted([*state["blockers"], arguments.id])

    return mutate(bundle, arguments.expect_revision, operation)

def clear_blocker(state: dict, identifier: str) -> None:
    if identifier not in state["blockers"]:
        raise StateError(f"blocker does not exist: {identifier}")
    state["blockers"].remove(identifier)

def command_clear_blocker(arguments: argparse.Namespace) -> dict:
    bundle = bundle_path(arguments.bundle)

    def operation(state: dict) -> None:
        clear_blocker(state, arguments.id)

    return mutate(bundle, arguments.expect_revision, operation)

def command_render(arguments: argparse.Namespace) -> dict:
    bundle = bundle_path(arguments.bundle)
    with state_write_lock(bundle):
        state = read_state(
            bundle,
            allow_acceptance_drift=True,
        )
        path = bundle / state["artifacts"]["status"]
        warning = refresh_status_projection(bundle, state)
        return result_with_projection_warning(
            {
                "rendered": path.relative_to(bundle).as_posix(),
                "revision": state["revision"],
            },
            warning,
        )

def local_bundle_manifest(bundle: Path) -> list[dict[str, str]]:
    entries: list[dict[str, str]] = []
    for path in sorted(bundle.rglob("*")):
        relative = path.relative_to(bundle).as_posix()
        try:
            metadata = path.lstat()
        except OSError as error:
            raise StateError(f"cannot inspect bundle path {relative}: {error}") from error
        if stat.S_ISDIR(metadata.st_mode):
            continue
        if not stat.S_ISREG(metadata.st_mode):
            raise StateError(
                f"bundle publication forbids non-regular path: {relative}"
            )
        entries.append({
            "path": relative,
            "mode": "100755" if metadata.st_mode & stat.S_IXUSR else "100644",
            "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
        })
    return entries

def commit_bundle_manifest(commit: str, bundle: Path) -> list[dict[str, str]]:
    relative_root = bundle.relative_to(REPO).as_posix()
    process = subprocess.run(
        [
            "git", "-C", str(REPO), "ls-tree", "-r", "-z", "--full-tree",
            commit, "--", relative_root,
        ],
        check=False, capture_output=True, timeout=20,
    )
    if process.returncode != 0:
        detail = process.stderr.decode(errors="replace").strip() or "git ls-tree failed"
        raise StateError(detail)
    entries: list[dict[str, str]] = []
    for raw in process.stdout.split(b"\0"):
        if not raw:
            continue
        metadata, separator, encoded_path = raw.partition(b"\t")
        if not separator:
            raise StateError("committed bundle tree is malformed")
        parts = metadata.decode("ascii", errors="strict").split()
        if len(parts) != 3 or parts[1] != "blob":
            raise StateError("committed bundle contains a non-blob entry")
        mode, _kind, object_id = parts
        repository_path = encoded_path.decode("utf-8", errors="strict")
        prefix = relative_root + "/"
        if not repository_path.startswith(prefix):
            raise StateError("committed bundle tree escaped its path")
        blob = subprocess.run(
            ["git", "-C", str(REPO), "cat-file", "blob", object_id],
            check=False, capture_output=True, timeout=20,
        )
        if blob.returncode != 0:
            raise StateError("committed bundle blob cannot be read")
        entries.append({
            "path": repository_path.removeprefix(prefix),
            "mode": mode,
            "sha256": hashlib.sha256(blob.stdout).hexdigest(),
        })
    return sorted(entries, key=lambda entry: entry["path"])


@contextmanager
def materialized_commit_bundle(
    commit: str,
    bundle: Path,
    manifest: list[dict[str, str]],
):
    """Expose authenticated committed bundle bytes to existing validators."""
    repository_root = bundle.relative_to(REPO)
    with tempfile.TemporaryDirectory(prefix="spec-work-snapshot-") as root:
        materialized = Path(root) / bundle.name
        materialized.mkdir()
        for entry in manifest:
            relative = PurePosixPath(entry["path"])
            if (
                relative.is_absolute()
                or not relative.parts
                or any(part in {"", ".", ".."} for part in relative.parts)
                or entry["mode"] not in {"100644", "100755"}
            ):
                raise StateError("committed bundle contains an unsafe path or mode")
            repository_path = (repository_root / Path(*relative.parts)).as_posix()
            blob = subprocess.run(
                ["git", "-C", str(REPO), "show", f"{commit}:{repository_path}"],
                check=False,
                capture_output=True,
                timeout=20,
            )
            if blob.returncode != 0:
                raise StateError("committed bundle blob cannot be materialized")
            destination = materialized / Path(*relative.parts)
            destination.parent.mkdir(parents=True, exist_ok=True)
            destination.write_bytes(blob.stdout)
            destination.chmod(0o755 if entry["mode"] == "100755" else 0o644)
        yield materialized


def snapshot_bundle_path(value: str | Path) -> Path:
    """Resolve an authenticated bundle path without requiring mutable local bytes."""
    bundle = Path(value).expanduser().absolute()
    if bundle != bundle.resolve():
        raise StateError("spec-work snapshot bundle must use its exact canonical path")
    try:
        relative = PurePosixPath(bundle.relative_to(REPO).as_posix())
    except ValueError as error:
        raise StateError(
            "spec-work snapshot bundle must be inside the coordinator repository"
        ) from error
    if len(relative.parts) < 3 or relative.parts[-2] not in {
        "in_progress", "completed",
    }:
        raise StateError("spec-work snapshot bundle lifecycle path is invalid")
    return bundle


def commit_bundle_state(commit: str, bundle: Path) -> dict:
    relative = (bundle.relative_to(REPO) / "state.json").as_posix()
    process = subprocess.run(
        ["git", "-C", str(REPO), "show", f"{commit}:{relative}"],
        check=False, capture_output=True, timeout=20,
    )
    if process.returncode != 0:
        raise StateError("snapshot commit is missing canonical state.json")
    try:
        value = json.loads(process.stdout.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise StateError("snapshot commit contains malformed state.json") from error
    if not isinstance(value, dict):
        raise StateError("snapshot state must be a JSON object")
    return value


def validate_snapshot_identity(
    state: dict,
    bundle: Path,
    *,
    slice_id: str,
    content_bundle: Path | None = None,
) -> str:
    try:
        work_kind = enum_value(state["work_kind"], "snapshot work_kind", WORK_KINDS)
        work_id = string_value(state["work_id"], "snapshot work_id", pattern=WORK_ID_RE)
        phase = enum_value(
            state["phase"], "snapshot phase", set(PHASE_TRANSITIONS)
        )
        enum_value(state["schema"], "snapshot schema", {SCHEMA_ID})
        configuration = work_configuration(work_kind)
        expected_parent = configuration["bundle_parent"]
        relative = PurePosixPath(bundle.relative_to(REPO).as_posix())
        if PurePosixPath(*relative.parts[:-2]) != expected_parent:
            raise StateError("snapshot bundle is under the wrong documentation root")
        if bundle.name != work_id:
            raise StateError("snapshot bundle basename must equal work_id")
        items = slice_map(state)
        selected = items.get(slice_id)
        if selected is None or selected.get("status") != "pr_open":
            raise StateError("snapshot slice must identify the exact open PR")
        if not implementation_attention_handoff(selected):
            raise StateError(
                "snapshot requires the selected active implementation "
                "awaiting snapshot bytes"
            )
        active_tasks = all_nonquiescent_task_labels(items)
    except (KeyError, TypeError) as error:
        raise StateError("snapshot state is missing required lifecycle facts") from error
    lifecycle = bundle.parent.name
    if lifecycle == "in_progress":
        if phase == "complete":
            raise StateError("intermediate snapshot cannot have phase complete")
        later_nonterminal = [
            item["id"] for item in state["slices"]
            if (
                item["id"] != slice_id
                and item["status"] not in TERMINAL_SLICE_STATUSES
            )
        ]
        if not later_nonterminal:
            raise StateError(
                "designated final PR snapshot must use the completed lifecycle path"
            )
        classification = "intermediate"
    else:
        if phase != "complete":
            raise StateError("final snapshot must have phase complete")
        if truthful_premerge_final_slice(state) != slice_id:
            raise StateError(
                "final snapshot must retain only its designated PR as merge pending"
            )
        if state.get("blockers"):
            raise StateError("final snapshot cannot retain blockers")
        acceptance = state.get("acceptance")
        design_contract = ui_design_contract(content_bundle or bundle, state)
        deferred_acceptance = (
            design_contract[1]
            if design_contract is not None and design_contract[0] == slice_id
            else None
        )
        if not isinstance(acceptance, dict) or not acceptance or any(
            not isinstance(record, dict)
            or (
                identifier == deferred_acceptance
                and (
                    record.get("status") != "pending"
                    or record.get("locked") is not False
                )
            )
            or (
                identifier != deferred_acceptance
                and (
                    record.get("status") not in {"passed", "waived"}
                    or record.get("locked") is not True
                )
            )
            for identifier, record in acceptance.items()
        ):
            raise StateError(
                "final snapshot requires locked completed pre-review acceptance "
                "and only the final human design gate pending"
            )
        if deferred_acceptance is not None and state.get("completion_binding") is not None:
            raise StateError(
                "pre-review final UI snapshot cannot carry a completion binding"
            )
        expected_snapshot_owner = [f"{slice_id}:implementation"]
        if active_tasks != expected_snapshot_owner:
            raise StateError(
                "final snapshot requires only its selected implementation active"
            )
        classification = "final"
    return classification


def validate_snapshot_authorization(
    value: object,
    *,
    expected_slice: str,
    candidate_head: str,
) -> dict | None:
    if value is None:
        return None
    authorization = exact_object(
        value, "snapshotAuthorization", SNAPSHOT_AUTHORIZATION_FIELDS
    )
    slice_id = string_value(
        authorization["sliceId"],
        "snapshotAuthorization.sliceId",
        pattern=SLICE_ID_RE,
    )
    if slice_id != expected_slice:
        raise StateError("snapshot authorization is bound to another slice")
    snapshot_commit = string_value(
        authorization["snapshotCommit"],
        "snapshotAuthorization.snapshotCommit",
        pattern=SHA_RE,
    )
    snapshot_path = repo_path_value(
        authorization["snapshotPath"], "snapshotAuthorization.snapshotPath"
    )
    classification = enum_value(
        authorization["classification"],
        "snapshotAuthorization.classification",
        {"intermediate", "final"},
    )
    manifest_digest = string_value(
        authorization["manifestDigest"],
        "snapshotAuthorization.manifestDigest",
        pattern=DIGEST_RE,
    )
    require_commit_object(snapshot_commit, "snapshot authorization commit")
    require_commit_object(candidate_head, "snapshot authorization candidate head")
    ancestry = subprocess.run(
        [
            "git", "-C", str(REPO), "merge-base", "--is-ancestor",
            snapshot_commit, candidate_head,
        ],
        check=False,
        capture_output=True,
        text=True,
        timeout=20,
    )
    if ancestry.returncode == 1:
        raise StateError(
            "snapshot authorization commit must be an ancestor of the candidate head"
        )
    if ancestry.returncode != 0:
        raise StateError("cannot verify snapshot authorization commit ancestry")
    bundle = snapshot_bundle_path(REPO / snapshot_path)
    approved = commit_bundle_manifest(snapshot_commit, bundle)
    if not approved or canonical_digest(approved) != manifest_digest:
        raise StateError("snapshot authorization does not authenticate frozen bytes")
    state = commit_bundle_state(snapshot_commit, bundle)
    with materialized_commit_bundle(snapshot_commit, bundle, approved) as content_bundle:
        observed_classification = validate_snapshot_identity(
            state,
            bundle,
            slice_id=slice_id,
            content_bundle=content_bundle,
        )
    if observed_classification != classification:
        raise StateError("snapshot authorization classification is stale")
    if commit_bundle_manifest(candidate_head, bundle) != approved:
        raise StateError("review head does not materialize the authenticated snapshot")
    alternate_phase = (
        "in_progress" if bundle.parent.name == "completed" else "completed"
    )
    alternate = bundle.parent.parent / alternate_phase / bundle.name
    if (
        commit_bundle_manifest(snapshot_commit, alternate)
        or commit_bundle_manifest(candidate_head, alternate)
    ):
        raise StateError("snapshot authorization permits only one lifecycle path")
    return authorization


def command_authorize_pr_snapshot(arguments: argparse.Namespace) -> dict:
    bundle = bundle_path(arguments.bundle)

    def operation(state: dict) -> None:
        item = slice_map(state).get(arguments.id)
        if item is None:
            raise StateError(f"unknown snapshot authorization slice: {arguments.id}")
        task = item["implementation_task"]
        if not implementation_attention_handoff(item) or item["status"] != "pr_open":
            raise StateError(
                "snapshot authorization requires the active implementation "
                "attention handoff for an open PR"
            )
        if task["snapshot_authorization"] is not None:
            raise StateError("snapshot authorization is already coordinator-recorded")
        authorization = {
            "sliceId": item["id"],
            "snapshotCommit": arguments.snapshot_commit,
            "snapshotPath": arguments.snapshot_path,
            "classification": arguments.classification,
            "manifestDigest": arguments.manifest_digest,
        }
        task["snapshot_authorization"] = validate_snapshot_authorization(
            authorization,
            expected_slice=item["id"],
            candidate_head=arguments.snapshot_commit,
        )

    return mutate(bundle, arguments.expect_revision, operation)


def command_verify_pr_snapshot(arguments: argparse.Namespace) -> dict:
    bundle = snapshot_bundle_path(arguments.bundle)
    snapshot_commit = string_value(
        arguments.snapshot_commit,
        "snapshot commit",
        pattern=SHA_RE,
    )
    pr_head = string_value(arguments.pr_head, "PR head", pattern=SHA_RE)
    require_commit_object(snapshot_commit, "snapshot commit")
    require_commit_object(pr_head, "PR head")
    ancestry = subprocess.run(
        [
            "git", "-C", str(REPO), "merge-base", "--is-ancestor",
            snapshot_commit, pr_head,
        ],
        check=False,
        capture_output=True,
        text=True,
        timeout=20,
    )
    if ancestry.returncode == 1:
        raise StateError("snapshot commit must be an ancestor of the PR head")
    if ancestry.returncode != 0:
        raise StateError("cannot verify snapshot commit ancestry")

    approved = commit_bundle_manifest(snapshot_commit, bundle)
    if not approved:
        raise StateError("snapshot commit is missing the canonical spec-work bundle")
    manifest_digest = canonical_digest(approved)
    supplied_digest = string_value(
        arguments.manifest_digest,
        "snapshot manifest digest",
        pattern=DIGEST_RE,
    )
    if supplied_digest != manifest_digest:
        raise StateError("snapshot manifest digest does not authenticate the commit")
    state = commit_bundle_state(snapshot_commit, bundle)
    with materialized_commit_bundle(snapshot_commit, bundle, approved) as content_bundle:
        classification = validate_snapshot_identity(
            state,
            bundle,
            slice_id=string_value(
                arguments.slice_id, "snapshot slice", pattern=SLICE_ID_RE
            ),
            content_bundle=content_bundle,
        )
    candidate = commit_bundle_manifest(pr_head, bundle)
    if approved != candidate:
        raise StateError(
            "PR head is missing or stale against the coordinator-approved "
            "spec-work bundle snapshot"
        )

    alternate_phase = (
        "in_progress" if bundle.parent.name == "completed" else "completed"
    )
    alternate = bundle.parent.parent / alternate_phase / bundle.name
    if commit_bundle_manifest(snapshot_commit, alternate):
        raise StateError(
            "coordinator-approved snapshot contains inconsistent spec-work bundle "
            "lifecycle paths"
        )
    if commit_bundle_manifest(pr_head, alternate):
        raise StateError(
            "PR head contains inconsistent spec-work bundle lifecycle paths"
        )

    return {
        "workKind": state["work_kind"],
        "workId": state["work_id"],
        "classification": classification,
        "bundle": bundle.relative_to(REPO).as_posix(),
        "snapshotCommit": snapshot_commit,
        "prHead": pr_head,
        "manifestDigest": manifest_digest,
        "fileCount": len(approved),
        "result": "MATCH",
    }

def command_verify_publication(arguments: argparse.Namespace) -> dict:
    bundle = bundle_path(arguments.bundle)
    state = read_state(bundle)
    validate_bundle_identity(bundle, state)
    if state["phase"] != "complete" or bundle.parent.name != "completed":
        raise StateError(
            "publication verification requires a completed spec-work bundle"
        )
    status_path = safe_path(
        bundle,
        state["artifacts"]["status"],
        "status",
        required=True,
        markdown=True,
    )
    try:
        status_bytes = status_path.read_bytes()
    except OSError as error:
        raise StateError(f"cannot read STATUS.md: {error}") from error
    if status_bytes != render_status(state).encode("utf-8"):
        raise StateError(
            "STATUS.md differs from state.json; run work-state render"
        )
    commit = string_value(
        arguments.default_branch_commit,
        "default-branch commit",
        pattern=SHA_RE,
    )
    require_commit_object(commit, "default-branch commit")
    local = local_bundle_manifest(bundle)
    published = commit_bundle_manifest(commit, bundle)
    if local != published:
        raise StateError(
            "completed spec-work bundle is not exactly reachable from "
            "the default-branch commit"
        )
    encoded = json.dumps(
        local, sort_keys=True, separators=(",", ":")
    ).encode("utf-8")
    return {
        "schema": "spec-work-bundle-publication",
        "workKind": state["work_kind"],
        "workId": state["work_id"],
        "bundle": bundle.relative_to(REPO).as_posix(),
        "defaultBranchCommit": commit,
        "manifestDigest": hashlib.sha256(encoded).hexdigest(),
        "fileCount": len(local),
        "result": "REACHABLE",
    }

def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(
        description="Validate and mutate one spec-work bundle state.",
    )
    commands = result.add_subparsers(dest="command", required=True)

    def add_bundle(
        command: str, handler: Callable[[argparse.Namespace], dict]
    ) -> argparse.ArgumentParser:
        child = commands.add_parser(command)
        child.add_argument("--work-bundle", dest="bundle", required=True, type=Path)
        child.set_defaults(handler=handler)
        return child

    init = add_bundle("init", command_init)
    init.add_argument("--work-kind", choices=sorted(WORK_KINDS), required=True)
    init.add_argument("--work-id", required=True)
    add_bundle("show", command_show)
    add_bundle("validate", command_validate)
    add_bundle("ready", command_ready)
    add_bundle("blind-context", command_blind_context)
    specification = add_bundle(
        "record-specification", command_record_specification
    )
    specification.add_argument("--expect-revision", required=True, type=int)
    specification.add_argument("--specification-digest", required=True)
    specification.add_argument("--source-commit", required=True)
    primary = add_bundle("record-pro-primary", command_record_pro_primary)
    primary.add_argument("--expect-revision", required=True, type=int)
    primary.add_argument("--answer-artifact", required=True)
    primary.add_argument("--response-digest", required=True)
    primary.add_argument("--repository", required=True)
    primary.add_argument("--source-branch", required=True)
    primary.add_argument("--manifest-artifact", required=True)
    primary.add_argument("--manifest-artifact-digest", required=True)
    primary.add_argument("--manifest-digest", required=True)
    primary.add_argument(
        "--contract-disposition",
        required=True,
        choices=sorted(CONTRACT_DISPOSITIONS),
    )
    primary.add_argument("--annotation", action="append")
    primary.add_argument("--repair-artifact")
    primary.add_argument("--repair-digest")
    applicability = add_bundle(
        "record-pro-applicability", command_record_pro_applicability
    )
    applicability.add_argument("--expect-revision", required=True, type=int)
    applicability.add_argument("--receipt", required=True)
    applicability.add_argument("--source-observation")
    blind = add_bundle(
        "record-blind-completeness", command_record_blind_completeness
    )
    blind.add_argument("--expect-revision", required=True, type=int)
    blind.add_argument("--receipt", required=True)
    blind_requirement = add_bundle(
        "record-blind-requirement", command_record_blind_requirement
    )
    blind_requirement.add_argument("--expect-revision", required=True, type=int)
    blind_requirement.add_argument(
        "--requirement",
        required=True,
        choices=sorted(CALLER_SELECTABLE_BLIND_REQUIREMENTS),
    )
    observe_main = add_bundle("observe-main", command_observe_main)
    observe_main.add_argument("--expect-revision", required=True, type=int)
    observe_main.add_argument("--sha", required=True)
    reconcile_delivery = add_bundle(
        "reconcile-merged-delivery", command_reconcile_merged_delivery
    )
    reconcile_delivery.add_argument("--expect-revision", required=True, type=int)
    reconcile_delivery.add_argument("--current-main-sha", required=True)
    reconcile_delivery.add_argument("--id", action="append", required=True)
    reconcile_delivery.add_argument("--pr", action="append", required=True, type=int)
    reconcile_delivery.add_argument("--head-sha", action="append", required=True)
    reconcile_delivery.add_argument("--merge-sha", action="append", required=True)
    terminal_clean = add_bundle(
        "terminal-clean-delivery", command_terminal_clean_delivery
    )
    terminal_clean.add_argument("--expect-revision", required=True, type=int)
    terminal_clean.add_argument("--id", required=True)
    terminal_clean.add_argument("--observed-main-sha")
    terminal_clean.add_argument("--merge-result")
    adopt_review_head = add_bundle(
        "adopt-review-head", command_adopt_review_head
    )
    adopt_review_head.add_argument("--expect-revision", required=True, type=int)
    adopt_review_head.add_argument("--id", required=True)
    adopt_review_head.add_argument("--receipt", required=True)
    adopt_plan = add_bundle("adopt-plan", command_adopt_plan)
    adopt_plan.add_argument("--expect-revision", required=True, type=int)
    adopt_plan.add_argument("--proposal", required=True, type=Path)
    adopt_plan.add_argument("--pro-primary-waiver-reason")
    adopt_plan.add_argument("--pro-primary-waiver-blind-receipt")
    adopt_plan.add_argument(
        "--pro-primary-waiver-disposition",
        choices=sorted(PRO_PRIMARY_WAIVER_DISPOSITIONS),
        default="fresh_primary",
    )
    roster = add_bundle("record-task-roster", command_record_task_roster)
    roster.add_argument("--expect-revision", required=True, type=int)
    assessment = add_bundle(
        "record-parallel-assessment", command_record_parallel_assessment
    )
    assessment.add_argument("--expect-revision", required=True, type=int)
    assessment.add_argument("--slice", action="append", required=True)
    transition = add_bundle("transition", command_transition)
    transition.add_argument("--expect-revision", required=True, type=int)
    transition.add_argument("--phase", required=True, choices=sorted(PHASE_TRANSITIONS))
    transition.add_argument("--reopen", action="store_true")
    transition.add_argument("--ui-attestation")
    transition.add_argument("--premerge-final-slice")
    update = add_bundle("update-slice", command_update_slice)
    update.add_argument("--expect-revision", required=True, type=int)
    update.add_argument("--id", required=True)
    update.add_argument("--title")
    update.add_argument("--status", choices=sorted(SLICE_TRANSITIONS))
    dependencies = update.add_mutually_exclusive_group()
    dependencies.add_argument("--depends-on", action="append")
    dependencies.add_argument("--clear-dependencies", action="store_true")
    update.add_argument("--wave", type=int)
    update.add_argument("--execution-mode", choices=["serial", "parallel"])
    update.add_argument("--owned-path", action="append")
    update.add_argument("--plan")
    update.add_argument("--receipt")
    update.add_argument("--branch")
    update.add_argument("--base-ref")
    update.add_argument("--base-sha")
    update.add_argument("--head-sha")
    update.add_argument("--pr", type=int)
    update.add_argument("--observed-main-sha")
    update.add_argument("--merge-receipt")
    reauthorize = add_bundle(
        "reauthorize-implementation", command_reauthorize_implementation
    )
    reauthorize.add_argument("--expect-revision", required=True, type=int)
    reauthorize.add_argument("--id", required=True)
    reauthorize.add_argument(
        "--disposition",
        choices=sorted(REAUTHORIZATION_DISPOSITIONS),
        default="fresh_pro_plan",
    )
    reauthorize.add_argument("--add-owned-path", action="append")
    reauthorize.add_argument("--plan-checkpoint-sha", required=True)
    reauthorize.add_argument("--authorization-digest", required=True)
    reauthorize.add_argument("--pre-pr-observation-receipt")
    final_ui_remediation = add_bundle(
        "reopen-final-ui-remediation", command_reopen_final_ui_remediation
    )
    final_ui_remediation.add_argument("--expect-revision", required=True, type=int)
    final_ui_remediation.add_argument("--id", required=True)
    final_ui_remediation.add_argument("--authorization-digest", required=True)
    final_ui_remediation.add_argument("--ui-receipt", required=True)
    task = add_bundle("task-transition", command_task_transition)
    task.formatter_class = argparse.RawDescriptionHelpFormatter
    task.epilog = (
        "implementation states: active, authorized, creating, prepared, "
        "quiescent, superseded, unbound\n"
        "review states: active, blocked, clean, creating, superseded, unbound\n"
        "clean = exact-head review passed\n"
        "blocked = unresolved material review finding"
    )
    task.add_argument("--expect-revision", required=True, type=int)
    task.add_argument("--id", required=True)
    task.add_argument(
        "--role", required=True, choices=["implementation", "review"]
    )
    task.add_argument(
        "--state",
        required=True,
        help="role-specific task state; see the state vocabularies below",
    )
    task.add_argument("--launch-marker")
    task.add_argument("--thread-id")
    task.add_argument("--client-thread-id")
    task.add_argument("--task-worktree")
    task.add_argument("--bound-sha")
    task.add_argument("--adoption-start-sha")
    task.add_argument("--plan-checkpoint-sha")
    task.add_argument("--authorization-digest")
    task.add_argument("--companion-probe-receipt")
    task.add_argument("--stop-proof-receipt")
    task.add_argument("--branch-release-receipt")
    task.add_argument("--branch-attachment-receipt")
    task.add_argument("--replacement-predicate")
    task.add_argument("--observation-proof-receipt")
    task.add_argument("--implementation-receipt")
    task.add_argument("--review-receipt")
    task.add_argument("--observed-main-sha")
    reconcile = add_bundle(
        "reconcile-callback-chain", command_reconcile_callback_chain
    )
    reconcile.add_argument("--expect-revision", required=True, type=int)
    reconcile.add_argument("--id", required=True)
    reconcile.add_argument("--receipt", action="append", required=True)
    reconcile.add_argument("--observed-main-sha")
    start_wave = add_bundle("start-wave", command_start_wave)
    start_wave.add_argument("--expect-revision", required=True, type=int)
    start_wave.add_argument("--slice", action="append")
    acceptance = add_bundle("record-acceptance", command_record_acceptance)
    acceptance.add_argument("--expect-revision", required=True, type=int)
    acceptance.add_argument("--id", required=True)
    acceptance.add_argument(
        "--status", required=True, choices=["pending", "passed", "failed", "waived"]
    )
    acceptance.add_argument("--evidence", action="append")
    acceptance.add_argument("--ui-attestation")
    refresh = add_bundle("refresh-acceptance", command_refresh_acceptance)
    refresh.add_argument("--expect-revision", required=True, type=int)
    refresh.add_argument("--id", required=True, action="append")
    for name, handler in (
        ("set-blocker", command_set_blocker),
        ("clear-blocker", command_clear_blocker),
    ):
        blocker = add_bundle(name, handler)
        blocker.add_argument("--expect-revision", required=True, type=int)
        blocker.add_argument("--id", required=True)
    add_bundle("render", command_render)
    authorize_snapshot = add_bundle(
        "authorize-pr-snapshot", command_authorize_pr_snapshot
    )
    authorize_snapshot.add_argument("--expect-revision", required=True, type=int)
    authorize_snapshot.add_argument("--id", required=True)
    authorize_snapshot.add_argument("--snapshot-commit", required=True)
    authorize_snapshot.add_argument("--snapshot-path", required=True)
    authorize_snapshot.add_argument(
        "--classification",
        required=True,
        choices=["intermediate", "final"],
    )
    authorize_snapshot.add_argument("--manifest-digest", required=True)
    pr_snapshot = add_bundle("verify-pr-snapshot", command_verify_pr_snapshot)
    pr_snapshot.add_argument("--snapshot-commit", required=True)
    pr_snapshot.add_argument("--pr-head", required=True)
    pr_snapshot.add_argument("--slice-id", required=True)
    pr_snapshot.add_argument("--manifest-digest", required=True)
    publication = add_bundle("verify-publication", command_verify_publication)
    publication.add_argument("--default-branch-commit", required=True)
    return result

def main() -> int:
    try:
        arguments = parser().parse_args()
        output_json(arguments.handler(arguments))
        return 0
    except StateError as error:
        print(f"work-state: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
