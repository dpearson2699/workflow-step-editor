ACCEPTANCE_ID_RE = re.compile(r"\bAC-[0-9]{3}\b")
WORK_ID_RE = re.compile(r"^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$")
SLICE_ID_RE = re.compile(r"^PR-[0-9]{2,}$")
