SHA_RE = re.compile(r"^[0-9a-f]{40}$")
DIGEST_RE = re.compile(r"^[0-9a-f]{64}$")
REPOSITORY_RE = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
DATE_TIME_RE = re.compile(
    r"^(?P<year>[0-9]{4})-(?P<month>[0-9]{2})-(?P<day>[0-9]{2})[Tt]"
    r"(?P<hour>[0-9]{2}):(?P<minute>[0-9]{2}):(?P<second>[0-9]{2})"
    r"(?P<fraction>\.[0-9]+)?(?:[Zz]|(?P<offset_sign>[+-])"
    r"(?P<offset_hour>[0-9]{2}):(?P<offset_minute>[0-9]{2}))$"
)
FORBIDDEN_REPO_PATH_CHARACTERS = set("\\*?[]{}!")

class StateError(ValueError):
    """A deterministic state precondition or validation failure."""


class ProResponseContractError(StateError):
    """A response-output failure eligible for bounded lifecycle compensation."""

    def __init__(self, reason_code: str, message: str):
        super().__init__(message)
        self.reason_code = reason_code


def utc_now() -> str:
    override = (
        os.environ.get("PRO_LIFECYCLE_TEST_NOW")
        if os.environ.get("PRO_LIFECYCLE_TEST_MODE") == "1"
        else None
    )
    if override:
        return override
    return (
        datetime.now(timezone.utc)
        .replace(microsecond=0)
        .isoformat()
        .replace("+00:00", "Z")
    )

def is_valid_rfc3339_datetime(value: object) -> bool:
    if not isinstance(value, str):
        return False
    match = DATE_TIME_RE.fullmatch(value)
    if match is None:
        return False
    fields = {name: int(match.group(name)) for name in (
        "year", "month", "day", "hour", "minute", "second"
    )}
    try:
        date(fields["year"], fields["month"], fields["day"])
    except ValueError:
        return False
    if fields["hour"] > 23 or fields["minute"] > 59 or fields["second"] > 59:
        return False
    if match.group("offset_sign") is not None:
        offset_hour = int(match.group("offset_hour"))
        offset_minute = int(match.group("offset_minute"))
        if offset_hour > 23 or offset_minute > 59:
            return False
    return True

def output_json(value: object) -> None:
    json.dump(value, sys.stdout, indent=2, sort_keys=True)
    sys.stdout.write("\n")

def bundle_path(value: str | Path, *, create: bool = False) -> Path:
    bundle = Path(value).expanduser().absolute()
    if bundle != bundle.resolve():
        raise StateError("spec-work bundle must use its exact canonical path")
    if create and not bundle.exists():
        bundle.mkdir(parents=True)
    if not bundle.is_dir():
        raise StateError(f"spec-work bundle is not a directory: {bundle}")
    return bundle

def validate_init_identity(value: str | Path, work_kind: str, work_id: str) -> Path:
    if not isinstance(work_id, str) or WORK_ID_RE.fullmatch(work_id) is None:
        raise StateError("work_id is invalid")
    bundle = Path(value).expanduser().absolute()
    if bundle != bundle.resolve():
        raise StateError("spec-work bundle must use its exact canonical path")
    try:
        relative = PurePosixPath(
            bundle.resolve().relative_to(REPO).as_posix()
        )
    except ValueError as error:
        raise StateError(
            "spec-work bundle must be inside the coordinator repository"
        ) from error
    configuration = work_configuration(work_kind)
    expected = configuration["bundle_parent"] / "in_progress" / work_id
    if relative != expected:
        raise StateError(
            "spec-work init requires docs/<kind>/in_progress/<work-id> identity"
        )
    return bundle

def work_configuration(work_kind: str) -> dict:
    if work_kind not in WORK_CONFIGURATION:
        raise StateError(f"unsupported work kind: {work_kind}")
    return WORK_CONFIGURATION[work_kind]

def validate_bundle_identity(bundle: Path, state: dict) -> str:
    if bundle != bundle.resolve():
        raise StateError("spec-work bundle must use its exact canonical path")
    try:
        relative = PurePosixPath(bundle.resolve().relative_to(REPO).as_posix())
    except ValueError as error:
        raise StateError(
            "typed task evidence requires a coordinator-repository bundle"
        ) from error
    configuration = work_configuration(state["work_kind"])
    expected_parent = configuration["bundle_parent"]
    if len(relative.parts) != len(expected_parent.parts) + 2:
        raise StateError("spec-work bundle must be directly below a lifecycle directory")
    if PurePosixPath(*relative.parts[: len(expected_parent.parts)]) != expected_parent:
        raise StateError("spec-work bundle is under the wrong documentation root")
    if relative.parts[-2] not in {"in_progress", "completed"}:
        raise StateError("spec-work bundle lifecycle directory is invalid")
    if relative.parts[-2] == "completed" and state["phase"] != "complete":
        raise StateError("completed spec-work bundle must have phase complete")
    if bundle.name != state["work_id"]:
        raise StateError("spec-work bundle basename must equal work_id")
    expected_primary = configuration["primary_artifact"]
    if state["artifacts"]["primary"] != expected_primary:
        raise StateError(
            f"{state['work_kind']} requires primary artifact {expected_primary}"
        )
    return state["work_id"]

def ensure_regular_file(path: Path, label: str, *, required: bool) -> None:
    if path.is_symlink():
        raise StateError(f"{label} must not be a symlink")
    if path.exists() and not path.is_file():
        raise StateError(f"{label} must be a regular file")
    if required and not path.is_file():
        raise StateError(f"{label} is missing")

@contextmanager
def state_write_lock(bundle: Path):
    descriptor: int | None = None
    try:
        descriptor = os.open(bundle, os.O_RDONLY)
        fcntl.flock(descriptor, fcntl.LOCK_EX)
    except OSError as error:
        if descriptor is not None:
            os.close(descriptor)
        raise StateError(f"cannot lock spec-work bundle: {error}") from error
    try:
        yield
    finally:
        assert descriptor is not None
        os.close(descriptor)

def safe_path(
    bundle: Path,
    value: str,
    label: str,
    *,
    required: bool,
    markdown: bool = False,
) -> Path:
    if not isinstance(value, str) or not value or "\x00" in value or "\\" in value:
        raise StateError(f"unsafe relative path for {label}")
    relative = PurePosixPath(value)
    if relative.is_absolute() or any(
        part in {"", ".", ".."} for part in relative.parts
    ):
        raise StateError(f"unsafe relative path for {label}: {value}")
    if markdown and relative.suffix.lower() != ".md":
        raise StateError(f"Markdown artifact path required for {label}: {value}")
    target = bundle.joinpath(*relative.parts)
    current = bundle
    for part in relative.parts:
        current = current / part
        if current.is_symlink():
            raise StateError(f"symlinked path is forbidden for {label}: {value}")
    if target.exists() and not target.is_file():
        raise StateError(f"artifact is not a regular file for {label}: {value}")
    if required and not target.is_file():
        raise StateError(f"required artifact is missing for {label}: {value}")
    return target

def repo_path_parts(value: str, label: str) -> tuple[str, ...]:
    if (
        not isinstance(value, str)
        or not value
        or "\x00" in value
        or "//" in value
        or any(character in value for character in FORBIDDEN_REPO_PATH_CHARACTERS)
    ):
        raise StateError(f"unsafe repository path for {label}")
    relative = PurePosixPath(value)
    if relative.is_absolute() or any(
        part in {"", ".", ".."} for part in relative.parts
    ):
        raise StateError(f"unsafe repository path for {label}: {value}")
    return relative.parts

def paths_overlap(left: str, right: str) -> bool:
    left_parts = repo_path_parts(left, "owned path")
    right_parts = repo_path_parts(right, "owned path")
    limit = min(len(left_parts), len(right_parts))
    return left_parts[:limit] == right_parts[:limit]

def owned_paths_overlap(left: dict, right: dict) -> tuple[str, str] | None:
    for left_path in left["owned_paths"]:
        for right_path in right["owned_paths"]:
            if paths_overlap(left_path, right_path):
                return left_path, right_path
    return None

def schema_error(location: str, message: str) -> None:
    raise StateError(f"schema validation failed at {location}: {message}")

def exact_object(value: object, location: str, fields: set[str]) -> dict:
    if not isinstance(value, dict):
        schema_error(location, "must be an object")
    missing = sorted(fields - set(value))
    extra = sorted(set(value) - fields)
    if missing:
        schema_error(location, f"missing required property: {missing[0]}")
    if extra:
        schema_error(location, f"unexpected property: {extra[0]}")
    return value

def string_value(
    value: object,
    location: str,
    *,
    pattern: re.Pattern[str] | None = None,
    maximum: int | None = None,
) -> str:
    if not isinstance(value, str) or not value:
        schema_error(location, "must be a non-empty string")
    if maximum is not None and len(value) > maximum:
        schema_error(location, f"must contain at most {maximum} characters")
    if pattern is not None and pattern.fullmatch(value) is None:
        schema_error(location, "has an invalid format")
    return value

def integer_value(value: object, location: str, minimum: int) -> int:
    if type(value) is not int or value < minimum:
        schema_error(location, f"must be an integer greater than or equal to {minimum}")
    return value

def enum_value(value: object, location: str, choices: set[str]) -> str:
    if not isinstance(value, str) or value not in choices:
        schema_error(location, "must be one of: " + ", ".join(sorted(choices)))
    return value

def string_list(
    value: object,
    location: str,
    *,
    pattern: re.Pattern[str] | None = None,
    nonempty: bool = False,
) -> list[str]:
    if not isinstance(value, list) or (nonempty and not value):
        schema_error(
            location, "must be a non-empty array" if nonempty else "must be an array"
        )
    result = [
        string_value(item, f"{location}.{index}", pattern=pattern)
        for index, item in enumerate(value)
    ]
    if len(result) != len(set(result)):
        schema_error(location, "must contain unique items")
    return result


def canonical_replacement_predicates(values: list[str]) -> list[str]:
    selected = set(values)
    return [
        predicate
        for predicate in REPLACEMENT_PREDICATE_ORDER
        if predicate in selected
    ]


def relative_path_value(value: object, location: str, *, markdown: bool = False) -> str:
    result = string_value(value, location)
    parts = result.split("/")
    if (
        result.startswith("/")
        or "\\" in result
        or "\x00" in result
        or "" in parts
        or "." in parts
        or ".." in parts
    ):
        schema_error(location, "must be a safe relative path")
    if markdown and not result.endswith(".md"):
        schema_error(location, "must end in .md")
    return result

def completion_ui_binding_schema(value: object, location: str) -> dict:
    binding = exact_object(value, location, COMPLETION_BINDING_FIELDS)
    relative_path_value(binding["receipt"], f"{location}.receipt")
    relative_path_value(binding["attestation"], f"{location}.attestation")
    for field in ("receipt_digest", "attestation_digest"):
        string_value(binding[field], f"{location}.{field}", pattern=DIGEST_RE)
    for field in ("head_sha", "head_tree"):
        string_value(binding[field], f"{location}.{field}", pattern=SHA_RE)
    integer_value(binding["pr"], f"{location}.pr", 1)
    string_value(
        binding["final_slice"], f"{location}.final_slice", pattern=SLICE_ID_RE
    )
    string_value(
        binding["acceptance_id"],
        f"{location}.acceptance_id",
        pattern=ACCEPTANCE_ID_RE,
    )
    enum_value(binding["verdict"], f"{location}.verdict", {"PASS", "WAIVED"})
    return binding

def absolute_path_value(value: object, location: str) -> str:
    result = string_value(value, location)
    path = Path(result)
    if not path.is_absolute() or "\x00" in result:
        schema_error(location, "must be an absolute path")
    return path.resolve().as_posix()

def repo_path_value(value: object, location: str) -> str:
    result = relative_path_value(value, location)
    if any(character in result for character in FORBIDDEN_REPO_PATH_CHARACTERS):
        schema_error(location, "contains a forbidden repository-path character")
    return result

def optional_string(value: object, location: str, *, sha: bool = False) -> None:
    if value is None:
        return
    string_value(
        value, location, pattern=SHA_RE if sha else None, maximum=None if sha else 240
    )

def optional_digest(value: object, location: str) -> None:
    if value is not None:
        string_value(value, location, pattern=DIGEST_RE)

def validate_task_schema(
    value: object, location: str, *, states: set[str]
) -> dict:
    task = exact_object(value, location, TASK_FIELDS)
    attempt = integer_value(task["attempt"], f"{location}.attempt", 0)
    state = enum_value(task["state"], f"{location}.state", states)
    optional_string(task["launch_marker"], f"{location}.launch_marker")
    optional_string(task["thread_id"], f"{location}.thread_id")
    optional_string(task["client_thread_id"], f"{location}.client_thread_id")
    if task["task_worktree"] is not None:
        normalized = absolute_path_value(
            task["task_worktree"], f"{location}.task_worktree"
        )
        if normalized != task["task_worktree"]:
            schema_error(
                f"{location}.task_worktree", "must be a canonical absolute path"
            )
    optional_string(task["bound_sha"], f"{location}.bound_sha", sha=True)
    optional_string(
        task["adoption_start_sha"],
        f"{location}.adoption_start_sha",
        sha=True,
    )
    if task["terminal_result"] is not None:
        enum_value(task["terminal_result"], f"{location}.terminal_result", TERMINAL_RESULTS)
    if task["verification_verdict"] is not None:
        enum_value(
            task["verification_verdict"],
            f"{location}.verification_verdict",
            VERIFICATION_VERDICTS,
        )
    optional_string(task["output_head_sha"], f"{location}.output_head_sha", sha=True)
    if task["output_pr"] is not None:
        integer_value(task["output_pr"], f"{location}.output_pr", 1)
    if task["snapshot_authorization"] is not None:
        authorization = exact_object(
            task["snapshot_authorization"],
            f"{location}.snapshot_authorization",
            SNAPSHOT_AUTHORIZATION_FIELDS,
        )
        validate_snapshot_authorization(
            authorization,
            expected_slice=string_value(
                authorization["sliceId"],
                f"{location}.snapshot_authorization.sliceId",
                pattern=SLICE_ID_RE,
            ),
            candidate_head=string_value(
                authorization["snapshotCommit"],
                f"{location}.snapshot_authorization.snapshotCommit",
                pattern=SHA_RE,
            ),
        )
    optional_string(task["review_receipt"], f"{location}.review_receipt")
    lineage = task["head_adoption_terminal_lineage"]
    if not isinstance(lineage, list):
        schema_error(
            f"{location}.head_adoption_terminal_lineage",
            "must be an array",
        )
    for index, raw_entry in enumerate(lineage):
        entry_location = f"{location}.head_adoption_terminal_lineage.{index}"
        entry = exact_object(
            raw_entry,
            entry_location,
            HEAD_ADOPTION_TERMINAL_ENTRY_FIELDS,
        )
        relative_path_value(entry["receipt"], f"{entry_location}.receipt")
        string_value(
            entry["digest"],
            f"{entry_location}.digest",
            pattern=DIGEST_RE,
        )
        integer_value(entry["epoch"], f"{entry_location}.epoch", 1)
        enum_value(
            entry["result"],
            f"{entry_location}.result",
            {"BLOCKED", "CLEAN"},
        )
        if entry["review_receipt"] is not None:
            relative_path_value(
                entry["review_receipt"],
                f"{entry_location}.review_receipt",
            )
        if (
            entry["result"] == "CLEAN"
            and entry["review_receipt"] is None
        ) or (
            entry["result"] == "BLOCKED"
            and entry["review_receipt"] is not None
        ):
            schema_error(
                entry_location,
                "terminal lineage review receipt does not match its result",
            )
    for field in (
        "companion_probe_receipt", "stop_proof_receipt",
        "branch_release_receipt", "replacement_observation_receipt",
        "branch_attachment_receipt", "head_adoption_receipt",
        "implementation_receipt",
    ):
        if task[field] is not None:
            relative_path_value(task[field], f"{location}.{field}")
    if task["review_epoch"] is not None:
        integer_value(task["review_epoch"], f"{location}.review_epoch", 1)
    for field in (
        "companion_probe_epoch", "stop_proof_epoch", "branch_release_epoch",
        "branch_attachment_epoch", "head_adoption_epoch",
        "replacement_observation_epoch",
    ):
        if task[field] is not None:
            integer_value(task[field], f"{location}.{field}", 1)
    for field in (
        "authorization_digest", "companion_probe_digest", "stop_proof_digest",
        "branch_release_digest", "branch_attachment_digest",
        "head_adoption_digest",
        "replacement_predicate_digest",
        "replacement_observation_digest", "review_receipt_digest",
        "review_disposition_digest", "review_task_quiescence_digest",
        "review_dependency_quiescence_digest", "implementation_receipt_digest",
        "verification_digest", "changed_paths_digest",
        "descendant_quiescence_digest",
    ):
        optional_digest(task[field], f"{location}.{field}")
    if state == "unbound":
        if attempt != 0:
            schema_error(f"{location}.attempt", "unbound task attempt must be zero")
        if lineage:
            schema_error(
                f"{location}.head_adoption_terminal_lineage",
                "unbound task cannot carry review head-adoption terminal lineage",
            )
        for field in (
            "launch_marker", "thread_id", "client_thread_id", "task_worktree",
            "bound_sha", "adoption_start_sha",
            "authorization_digest", "companion_probe_digest", "stop_proof_digest",
            "branch_release_digest", "branch_attachment_digest",
            "head_adoption_digest",
            "replacement_predicate_digest",
            "replacement_observation_digest", "review_receipt",
            "review_receipt_digest", "review_epoch", "review_disposition_digest",
            "review_task_quiescence_digest", "review_dependency_quiescence_digest",
            "companion_probe_receipt", "companion_probe_epoch",
            "stop_proof_receipt", "stop_proof_epoch",
            "branch_release_receipt", "branch_release_epoch",
            "branch_attachment_receipt", "branch_attachment_epoch",
            "head_adoption_receipt", "head_adoption_epoch",
            "replacement_observation_receipt", "replacement_observation_epoch",
            "implementation_receipt", "implementation_receipt_digest",
            "terminal_result", "verification_verdict", "output_head_sha",
            "output_pr", "verification_digest",
            "changed_paths_digest", "descendant_quiescence_digest",
        ):
            if task[field] is not None:
                schema_error(f"{location}.{field}", f"unbound task cannot carry {field}")
        return task
    if attempt < 1:
        schema_error(f"{location}.attempt", "bound task attempt must be positive")
    if states == IMPLEMENTATION_TASK_STATES:
        if attempt == 1 and task["adoption_start_sha"] is None:
            schema_error(
                f"{location}.adoption_start_sha",
                "first implementation attempt requires its adoption start SHA",
            )
        if attempt > 1 and task["adoption_start_sha"] is not None:
            schema_error(
                f"{location}.adoption_start_sha",
                "replacement implementation cannot carry an adoption start SHA",
            )
    elif task["adoption_start_sha"] is not None:
        schema_error(
            f"{location}.adoption_start_sha",
            "review task cannot carry an implementation adoption start SHA",
        )
    if task["launch_marker"] is None or task["authorization_digest"] is None:
        schema_error(location, "bound task requires launch and authorization digests")
    replacement_fields = (
        task["replacement_predicate_digest"],
        task["replacement_observation_receipt"],
        task["replacement_observation_digest"],
        task["replacement_observation_epoch"],
    )
    if attempt == 1 and any(value is not None for value in replacement_fields):
        schema_error(location, "first task attempt cannot claim replacement proof")
    if attempt > 1 and any(value is None for value in replacement_fields):
        schema_error(location, "replacement task requires predicate and observation proof")
    if state == "superseded" and any(
        task[field] is None
        for field in ("stop_proof_receipt", "stop_proof_digest", "stop_proof_epoch")
    ):
        schema_error(location, "superseded task requires stop proof")
    if state not in {"creating", "superseded"}:
        if task["thread_id"] is None:
            schema_error(f"{location}.thread_id", f"state {state} requires a thread id")
        if task["task_worktree"] is None:
            schema_error(
                f"{location}.task_worktree", f"state {state} requires a task worktree"
            )
        if task["bound_sha"] is None:
            schema_error(f"{location}.bound_sha", f"state {state} requires a bound SHA")
    if state != "superseded" and (
        task["stop_proof_receipt"] is not None
        or task["stop_proof_digest"] is not None
        or task["stop_proof_epoch"] is not None
    ):
        schema_error(location, "stop proof applies only to superseded tasks")
    release_fields = (
        task["branch_release_receipt"], task["branch_release_digest"],
        task["branch_release_epoch"],
    )
    if any(value is not None for value in release_fields) and any(
        value is None for value in release_fields
    ):
        schema_error(location, "branch-release proof is incomplete")
    release_allowed = (
        state == "superseded"
        or (states == IMPLEMENTATION_TASK_STATES and state == "quiescent")
        or (states == REVIEW_TASK_STATES and state in {"active", "blocked"})
    )
    if any(value is not None for value in release_fields) and not release_allowed:
        schema_error(location, "branch-release proof is not valid for this task state")
    if (
        state == "superseded"
        and (task["thread_id"] is not None or task["client_thread_id"] is not None)
        and any(value is None for value in release_fields)
    ):
        schema_error(location, "identified superseded task requires branch-release proof")
    attachment_fields = tuple(task[field] for field in BRANCH_ATTACHMENT_FIELDS)
    if any(value is not None for value in attachment_fields) and any(
        value is None for value in attachment_fields
    ):
        schema_error(location, "branch-attachment proof is incomplete")
    adoption_fields = (
        task["head_adoption_receipt"],
        task["head_adoption_digest"],
        task["head_adoption_epoch"],
    )
    if any(value is not None for value in adoption_fields) and any(
        value is None for value in adoption_fields
    ):
        schema_error(location, "review head-adoption proof is incomplete")
    review_proof = [task[field] for field in REVIEW_PROOF_FIELDS]
    if states == IMPLEMENTATION_TASK_STATES and any(
        value is not None for value in review_proof
    ):
        schema_error(location, "implementation task cannot carry review proof")
    if states == IMPLEMENTATION_TASK_STATES and any(
        value is not None for value in adoption_fields
    ):
        schema_error(location, "implementation task cannot carry review head adoption")
    if states == IMPLEMENTATION_TASK_STATES and lineage:
        schema_error(
            location,
            "implementation task cannot carry review head-adoption terminal lineage",
        )
    if (
        states == IMPLEMENTATION_TASK_STATES
        and state not in {"active", "authorized"}
        and not (
            state == "quiescent"
            and task["terminal_result"] == "SCOPE_EXPANSION_REQUIRED"
        )
        and any(value is not None for value in attachment_fields)
    ):
        schema_error(
            location,
            "implementation branch-attachment proof applies only while active "
            "or authorized",
        )
    terminal_fields = (
        "implementation_receipt", "implementation_receipt_digest",
        "terminal_result", "verification_verdict", "output_head_sha",
        "verification_digest", "changed_paths_digest",
        "descendant_quiescence_digest",
    )
    if states == IMPLEMENTATION_TASK_STATES:
        if state == "quiescent" and any(task[field] is None for field in terminal_fields):
            schema_error(location, "quiescent implementation proof is incomplete")
        if (
            state == "quiescent"
            and task["output_pr"] is not None
            and any(value is None for value in release_fields)
        ):
            schema_error(location, "published implementation requires branch-release proof")
        if task["terminal_result"] == "SUCCEEDED" and task["verification_verdict"] != "PASS":
            schema_error(location, "SUCCEEDED terminal requires PASS verification")
        if (
            task["terminal_result"] in TERMINAL_RESULTS - {"SUCCEEDED"}
            and task["verification_verdict"] not in {"FAIL", "NOT_RUN"}
        ):
            schema_error(location, "non-success terminal cannot carry PASS verification")
        if state in {
            "unbound", "creating", "prepared", "authorized", "active"
        } and any(
            task[field] is not None for field in (*terminal_fields, "output_pr")
        ):
            schema_error(location, "nonquiescent implementation cannot carry terminal proof")
    elif any(
        task[field] is not None for field in (*terminal_fields, "output_pr")
    ):
        schema_error(location, "review task cannot carry implementation proof")
    if states == REVIEW_TASK_STATES:
        if state in {"active", "clean"} and any(
            value is None for value in attachment_fields
        ):
            schema_error(location, f"{state} review requires branch-attachment proof")
        if state == "creating" and any(value is not None for value in attachment_fields):
            schema_error(location, "creating review cannot carry branch-attachment proof")
        if state == "clean" and any(value is None for value in review_proof):
            schema_error(location, "clean review proof is incomplete")
    return task

def validate_task_history(value: object, location: str) -> list[dict]:
    if not isinstance(value, list):
        schema_error(location, "must be an array")
    entries: list[dict] = []
    for index, raw in enumerate(value):
        entry_location = f"{location}.{index}"
        entry = exact_object(raw, entry_location, TASK_HISTORY_ENTRY_FIELDS)
        role = enum_value(
            entry["role"], f"{entry_location}.role", {"implementation", "review"}
        )
        task = validate_task_schema(
            entry["task"],
            f"{entry_location}.task",
            states=(
                IMPLEMENTATION_TASK_STATES
                if role == "implementation"
                else REVIEW_TASK_STATES
            ),
        )
        if task["state"] != "superseded":
            schema_error(entry_location, "task history contains only superseded attempts")
        entries.append(entry)
    return entries

def validate_planning_schema(value: object) -> dict:
    planning = exact_object(value, "planning", PLANNING_FIELDS)
    optional_digest(
        planning["current_plan_digest"],
        "planning.current_plan_digest",
    )
    optional_digest(
        planning["current_specification_digest"],
        "planning.current_specification_digest",
    )
    optional_string(
        planning["current_source_commit"],
        "planning.current_source_commit",
        sha=True,
    )
    optional_digest(
        planning["active_response_digest"], "planning.active_response_digest"
    )
    waiver = planning["pro_primary_waiver"]
    if waiver is not None:
        waiver = exact_object(
            waiver, "planning.pro_primary_waiver", PRO_PRIMARY_WAIVER_FIELDS
        )
        string_value(
            waiver["reason"], "planning.pro_primary_waiver.reason", maximum=500
        )
        if not waiver["reason"].strip():
            schema_error(
                "planning.pro_primary_waiver.reason",
                "must contain non-whitespace content",
            )
        disposition = enum_value(
            waiver["disposition"],
            "planning.pro_primary_waiver.disposition",
            PRO_PRIMARY_WAIVER_DISPOSITIONS,
        )
        for field in ("specification_digest", "plan_digest", "blind_receipt_digest"):
            string_value(
                waiver[field], f"planning.pro_primary_waiver.{field}",
                pattern=DIGEST_RE,
            )
        optional_digest(
            waiver["active_response_digest"],
            "planning.pro_primary_waiver.active_response_digest",
        )
        optional_digest(
            waiver["continuation_digest"],
            "planning.pro_primary_waiver.continuation_digest",
        )
        if disposition == "fresh_primary":
            if waiver["active_response_digest"] is None:
                schema_error(
                    "planning.pro_primary_waiver.active_response_digest",
                    "fresh_primary requires completed Pro evidence",
                )
            if waiver["continuation_digest"] is not None:
                schema_error(
                    "planning.pro_primary_waiver.continuation_digest",
                    "fresh_primary must not bind local recovery continuation",
                )
        elif (
            waiver["active_response_digest"] is not None
            or waiver["continuation_digest"] is None
        ):
            schema_error(
                "planning.pro_primary_waiver",
                "local recovery requires no active response and one continuation digest",
            )
        string_value(
            waiver["source_commit"],
            "planning.pro_primary_waiver.source_commit",
            pattern=SHA_RE,
        )
    if planning["blind_requirement"] is not None:
        requirement = exact_object(
            planning["blind_requirement"],
            "planning.blind_requirement",
            BLIND_REQUIREMENT_FIELDS,
        )
        enum_value(
            requirement["requirement"],
            "planning.blind_requirement.requirement",
            BLIND_REQUIREMENTS,
        )
        string_value(
            requirement["plan_digest"],
            "planning.blind_requirement.plan_digest",
            pattern=DIGEST_RE,
        )
    blind = planning["blind_completeness"]
    if blind is not None:
        blind = exact_object(
            blind, "planning.blind_completeness", PROOF_BINDING_FIELDS
        )
        receipt = relative_path_value(
            blind["receipt"], "planning.blind_completeness.receipt"
        )
        if not receipt.endswith(".json"):
            schema_error(
                "planning.blind_completeness.receipt", "must be a JSON path"
            )
        string_value(
            blind["receipt_digest"],
            "planning.blind_completeness.receipt_digest",
            pattern=DIGEST_RE,
        )
        integer_value(blind["epoch"], "planning.blind_completeness.epoch", 1)
    if (
        planning["current_specification_digest"] is None
    ) != (planning["current_source_commit"] is None):
        schema_error(
            "planning", "current specification digest and source commit must be paired"
        )
    if not isinstance(planning["evidence"], list):
        schema_error("planning.evidence", "must be an array")
    for evidence_index, raw_evidence in enumerate(planning["evidence"]):
        location = f"planning.evidence.{evidence_index}"
        evidence = exact_object(raw_evidence, location, PRO_EVIDENCE_FIELDS)
        string_value(
            evidence["response_digest"],
            f"{location}.response_digest",
            pattern=DIGEST_RE,
        )
        relative_path_value(
            evidence["answer_artifact"],
            f"{location}.answer_artifact",
            markdown=True,
        )
        for field in (
            "generated_for_digest",
            "accepted_for_digest",
            "manifest_artifact_digest",
            "manifest_digest",
        ):
            string_value(evidence[field], f"{location}.{field}", pattern=DIGEST_RE)
        manifest_artifact = relative_path_value(
            evidence["manifest_artifact"], f"{location}.manifest_artifact"
        )
        if not manifest_artifact.endswith(".json"):
            schema_error(f"{location}.manifest_artifact", "must be a JSON path")
        string_value(
            evidence["repository"], f"{location}.repository", pattern=REPOSITORY_RE
        )
        string_value(
            evidence["source_branch"], f"{location}.source_branch", maximum=240
        )
        for field in ("generated_source_commit", "accepted_source_commit"):
            string_value(evidence[field], f"{location}.{field}", pattern=SHA_RE)
        disposition = enum_value(
            evidence["contract_disposition"],
            f"{location}.contract_disposition",
            CONTRACT_DISPOSITIONS,
        )
        annotations = string_list(
            evidence["annotations"], f"{location}.annotations"
        )
        for annotation_index, annotation in enumerate(annotations):
            if len(annotation) > 500:
                schema_error(
                    f"{location}.annotations.{annotation_index}",
                    "must contain at most 500 characters",
                )
        repair_present = evidence["repair_artifact"] is not None
        if repair_present:
            relative_path_value(
                evidence["repair_artifact"],
                f"{location}.repair_artifact",
                markdown=True,
            )
        optional_digest(evidence["repair_digest"], f"{location}.repair_digest")
        if repair_present != (evidence["repair_digest"] is not None):
            schema_error(location, "repair artifact and digest must be paired")
        if disposition == "clean" and (annotations or repair_present):
            schema_error(location, "clean evidence cannot carry annotations or repair")
        if disposition == "accepted_with_annotations" and (
            not annotations or repair_present
        ):
            schema_error(
                location,
                "accepted_with_annotations requires annotations and forbids repair",
            )
        if disposition.startswith("repaired_") and (
            not annotations or not repair_present
        ):
            schema_error(location, "repaired evidence requires annotations and repair")
        if not isinstance(evidence["applicability"], list):
            schema_error(f"{location}.applicability", "must be an array")
        expected_digest = evidence["generated_for_digest"]
        expected_commit = evidence["generated_source_commit"]
        prior_epoch = 0
        for applicability_index, raw_applicability in enumerate(
            evidence["applicability"]
        ):
            applicability_location = (
                f"{location}.applicability.{applicability_index}"
            )
            applicability = exact_object(
                raw_applicability, applicability_location, APPLICABILITY_FIELDS
            )
            for field in ("from_digest", "to_digest", "receipt_digest"):
                string_value(
                    applicability[field],
                    f"{applicability_location}.{field}",
                    pattern=DIGEST_RE,
                )
            for field in ("from_source_commit", "to_source_commit"):
                string_value(
                    applicability[field],
                    f"{applicability_location}.{field}",
                    pattern=SHA_RE,
                )
            classification = enum_value(
                applicability["classification"],
                f"{applicability_location}.classification",
                APPLICABILITY_CLASSIFICATIONS,
            )
            changed_paths = string_list(
                applicability["changed_paths"],
                f"{applicability_location}.changed_paths",
                nonempty=True,
            )
            for path_index, path in enumerate(changed_paths):
                repo_path_value(
                    path, f"{applicability_location}.changed_paths.{path_index}"
                )
            for field in (
                "recommendations_changed",
                "implementation_slices_changed",
            ):
                if type(applicability[field]) is not bool:
                    schema_error(
                        f"{applicability_location}.{field}", "must be a boolean"
                    )
            result = enum_value(
                applicability["validation_result"],
                f"{applicability_location}.validation_result",
                APPLICABILITY_RESULTS,
            )
            anchors = string_list(
                applicability["evidence_anchors"],
                f"{applicability_location}.evidence_anchors",
                nonempty=True,
            )
            for anchor_index, anchor in enumerate(anchors):
                repo_path_value(
                    anchor,
                    f"{applicability_location}.evidence_anchors.{anchor_index}",
                )
            receipt = relative_path_value(
                applicability["receipt"], f"{applicability_location}.receipt"
            )
            if not receipt.endswith(".json"):
                schema_error(
                    f"{applicability_location}.receipt", "must be a JSON path"
                )
            correction_present = applicability["correction_receipt"] is not None
            for field in ("original_receipt", "correction_receipt"):
                relative = applicability[field]
                if relative is not None:
                    relative = relative_path_value(
                        relative, f"{applicability_location}.{field}"
                    )
                    if not relative.endswith(".json"):
                        schema_error(
                            f"{applicability_location}.{field}",
                            "must be a JSON path",
                        )
            for field in (
                "original_receipt_digest",
                "correction_receipt_digest",
            ):
                optional_digest(
                    applicability[field],
                    f"{applicability_location}.{field}",
                )
            lineage_present = all(
                applicability[field] is not None
                for field in (
                    "original_receipt",
                    "original_receipt_digest",
                    "correction_receipt",
                    "correction_receipt_digest",
                )
            )
            if correction_present != lineage_present or any(
                applicability[field] is not None
                for field in (
                    "original_receipt",
                    "original_receipt_digest",
                    "correction_receipt_digest",
                )
            ) != correction_present:
                schema_error(
                    applicability_location,
                    "applicability correction lineage must be wholly null or present",
                )
            if correction_present and applicability["receipt"] in {
                applicability["original_receipt"],
                applicability["correction_receipt"],
            }:
                schema_error(
                    applicability_location,
                    "effective, original, and correction receipts must be distinct",
                )
            epoch = integer_value(
                applicability["epoch"], f"{applicability_location}.epoch", 1
            )
            if epoch <= prior_epoch:
                schema_error(
                    applicability_location, "epochs must increase monotonically"
                )
            prior_epoch = epoch
            if applicability["from_digest"] != expected_digest or (
                applicability["from_source_commit"] != expected_commit
            ):
                schema_error(
                    applicability_location, "breaks the accepted evidence chain"
                )
            if applicability["to_digest"] == applicability["from_digest"]:
                schema_error(applicability_location, "must bind a changed digest")
            if classification == "non_material":
                if (
                    applicability["recommendations_changed"]
                    or applicability["implementation_slices_changed"]
                    or result != "prior_evidence_applicable"
                ):
                    schema_error(
                        applicability_location,
                        "non_material requires unchanged recommendations and slices "
                        "with prior_evidence_applicable",
                    )
                expected_digest = applicability["to_digest"]
                expected_commit = applicability["to_source_commit"]
            else:
                if result != "fresh_primary_required":
                    schema_error(
                        applicability_location,
                        "material and uncertain changes require a fresh primary",
                    )
                if applicability_index != len(evidence["applicability"]) - 1:
                    schema_error(
                        applicability_location,
                        "fresh-primary-required applicability must end this "
                        "evidence chain",
                    )
        if evidence["accepted_for_digest"] != expected_digest or (
            evidence["accepted_source_commit"] != expected_commit
        ):
            schema_error(location, "accepted evidence binding is stale")
    active = planning["active_response_digest"]
    if planning["evidence"] and planning["current_specification_digest"] is None:
        schema_error("planning", "Pro evidence requires a current specification")
    if not planning["evidence"] and active is not None:
        schema_error(
            "planning.active_response_digest", "requires Pro evidence"
        )
    if planning["evidence"] and active != planning["evidence"][-1]["response_digest"]:
        schema_error(
            "planning.active_response_digest", "must select the latest Pro evidence"
        )
    return planning


def is_authoritative_delivery_projection(item: dict) -> bool:
    return (
        item["status"] == "merged"
        and item["merge_receipt"] is None
        and item["merge_receipt_digest"] is None
        and item["merge_epoch"] is None
        and item["merge_main_sha"] is not None
    )


def validate_schema(state: object) -> dict:
    state_fields = {
        "schema",
        "work_kind",
        "work_id",
        "phase",
        "revision",
        "observation_epoch_high_water",
        "artifacts",
        "planning",
        "observed_main_sha",
        "task_authorization",
        "parallel_assessments",
        "slices",
        "acceptance",
        "completion_binding",
        "completion_specification_digest",
        "blockers",
        "updated_at",
    }
    state = exact_object(
        state,
        "state",
        state_fields,
    )
    if state["schema"] != SCHEMA_ID:
        schema_error("schema", f"must equal {SCHEMA_ID}")
    enum_value(state["work_kind"], "work_kind", WORK_KINDS)
    string_value(state["work_id"], "work_id", pattern=WORK_ID_RE)
    enum_value(state["phase"], "phase", set(PHASE_TRANSITIONS))
    integer_value(state["revision"], "revision", 0)
    integer_value(
        state["observation_epoch_high_water"],
        "observation_epoch_high_water",
        0,
    )
    optional_string(state["observed_main_sha"], "observed_main_sha", sha=True)
    validate_planning_schema(state["planning"])
    artifacts = exact_object(
        state["artifacts"],
        "artifacts",
        {"primary", "interview", "decisions", "acceptance", "status"},
    )
    for name, value in artifacts.items():
        relative_path_value(value, f"artifacts.{name}", markdown=True)
    authorization = state["task_authorization"]
    if authorization is not None:
        authorization = exact_object(
            authorization, "task_authorization", {"primary_digest", "entries"}
        )
        string_value(
            authorization["primary_digest"],
            "task_authorization.primary_digest",
            pattern=DIGEST_RE,
        )
        if not isinstance(authorization["entries"], list) or not authorization["entries"]:
            schema_error("task_authorization.entries", "must be a non-empty array")
        entry_keys: set[tuple[str, str]] = set()
        for index, raw_entry in enumerate(authorization["entries"]):
            location = f"task_authorization.entries.{index}"
            entry = exact_object(raw_entry, location, AUTHORIZATION_ENTRY_FIELDS)
            slice_id = string_value(
                entry["slice_id"], f"{location}.slice_id", pattern=SLICE_ID_RE
            )
            role = enum_value(
                entry["role"], f"{location}.role", {"implementation", "review"}
            )
            route = string_value(entry["route"], f"{location}.route")
            if not route.strip():
                schema_error(
                    f"{location}.route",
                    "must contain non-whitespace content",
                )
            predicates = string_list(
                entry["replacement_predicates"],
                f"{location}.replacement_predicates",
                nonempty=True,
            )
            unsupported = sorted(set(predicates) - REPLACEMENT_PREDICATES)
            if unsupported:
                schema_error(
                    f"{location}.replacement_predicates",
                    "contains unsupported values: " + ", ".join(unsupported),
                )
            if predicates != canonical_replacement_predicates(predicates):
                schema_error(
                    f"{location}.replacement_predicates",
                    "must use canonical predicate order",
                )
            string_value(
                entry["entry_digest"], f"{location}.entry_digest", pattern=DIGEST_RE
            )
            if (slice_id, role) in entry_keys:
                schema_error(location, "duplicates a slice/role authorization")
            entry_keys.add((slice_id, role))
    if not isinstance(state["parallel_assessments"], list):
        schema_error("parallel_assessments", "must be an array")
    assessment_keys: set[tuple[str, str]] = set()
    for index, raw_assessment in enumerate(state["parallel_assessments"]):
        location = f"parallel_assessments.{index}"
        assessment = exact_object(
            raw_assessment, location, PARALLEL_ASSESSMENT_FIELDS
        )
        left = string_value(
            assessment["left_slice"], f"{location}.left_slice", pattern=SLICE_ID_RE
        )
        right = string_value(
            assessment["right_slice"], f"{location}.right_slice", pattern=SLICE_ID_RE
        )
        if left >= right:
            schema_error(location, "slice pair must be strictly sorted")
        for field in (
            "left_plan_digest", "right_plan_digest", "assessment_digest"
        ):
            string_value(assessment[field], f"{location}.{field}", pattern=DIGEST_RE)
        enum_value(
            assessment["verdict"], f"{location}.verdict", {"independent", "coupled"}
        )
        if (left, right) in assessment_keys:
            schema_error(location, "duplicates a slice pair")
        assessment_keys.add((left, right))
    binding = state["completion_binding"]
    if binding is not None:
        completion_ui_binding_schema(binding, "completion_binding")
    optional_digest(
        state["completion_specification_digest"],
        "completion_specification_digest",
    )
    if not isinstance(state["slices"], list):
        schema_error("slices", "must be an array")
    slice_fields = {
        "id",
        "title",
        "status",
        "depends_on",
        "wave",
        "execution_mode",
        "owned_paths",
        "plan",
        "plan_digest",
        "receipt",
        "branch",
        "base_ref",
        "base_sha",
        "head_sha",
        "pr",
        "plan_checkpoint_sha",
        "revision_epoch",
        "revision_history",
        "replacement_lineage",
        "implementation_task",
        "review_task",
        "task_history",
        "merge_receipt",
        "merge_receipt_digest",
        "merge_epoch",
        "merge_main_sha",
        "terminal_freshness",
        "premerge_drift",
    }
    for index, raw in enumerate(state["slices"]):
        location = f"slices.{index}"
        item = exact_object(raw, location, slice_fields)
        string_value(item["id"], f"{location}.id", pattern=SLICE_ID_RE)
        string_value(item["title"], f"{location}.title", maximum=160)
        enum_value(item["status"], f"{location}.status", set(SLICE_TRANSITIONS))
        string_list(item["depends_on"], f"{location}.depends_on", pattern=SLICE_ID_RE)
        integer_value(item["wave"], f"{location}.wave", 1)
        enum_value(
            item["execution_mode"],
            f"{location}.execution_mode",
            {"serial", "parallel"},
        )
        for index, owned_path in enumerate(
            string_list(item["owned_paths"], f"{location}.owned_paths", nonempty=True)
        ):
            repo_path_value(owned_path, f"{location}.owned_paths.{index}")
        relative_path_value(item["plan"], f"{location}.plan", markdown=True)
        string_value(
            item["plan_digest"],
            f"{location}.plan_digest",
            pattern=DIGEST_RE,
        )
        if item["receipt"] is not None:
            relative_path_value(item["receipt"], f"{location}.receipt", markdown=True)
        optional_string(item["branch"], f"{location}.branch")
        optional_string(item["base_ref"], f"{location}.base_ref")
        optional_string(item["base_sha"], f"{location}.base_sha", sha=True)
        optional_string(item["head_sha"], f"{location}.head_sha", sha=True)
        optional_string(
            item["plan_checkpoint_sha"],
            f"{location}.plan_checkpoint_sha",
            sha=True,
        )
        revision_epoch = integer_value(
            item["revision_epoch"], f"{location}.revision_epoch", 0
        )
        if not isinstance(item["revision_history"], list):
            schema_error(f"{location}.revision_history", "must be an array")
        prior_revision = 0
        for revision_index, raw_revision in enumerate(item["revision_history"]):
            revision_location = (
                f"{location}.revision_history.{revision_index}"
            )
            disposition = (
                raw_revision.get("reauthorization_disposition")
                if isinstance(raw_revision, dict)
                else None
            )
            prerequisite_revision = disposition == "satisfied_prerequisite"
            scope_pre_pr_revision = disposition in {
                "coordinator_scope_expansion", "pre_pr_scope_expansion",
            }
            pre_pr_revision = prerequisite_revision or scope_pre_pr_revision
            revision = exact_object(
                raw_revision,
                revision_location,
                (
                    PREREQUISITE_RESUME_SLICE_REVISION_FIELDS
                    if prerequisite_revision
                    else PRE_PR_SLICE_REVISION_FIELDS
                    if scope_pre_pr_revision
                    else SLICE_REVISION_FIELDS
                ),
            )
            epoch = integer_value(
                revision["revision_epoch"],
                f"{revision_location}.revision_epoch",
                1,
            )
            if epoch != prior_revision + 1:
                schema_error(
                    revision_location,
                    "revision history must be contiguous and one-based",
                )
            prior_revision = epoch
            for field in ("plan_checkpoint_sha", "head_sha", "base_sha"):
                optional_string(
                    revision[field],
                    f"{revision_location}.{field}",
                    sha=True,
                )
            optional_string(
                revision["base_ref"], f"{revision_location}.base_ref"
            )
            optional_digest(
                revision["authorization_digest"],
                f"{revision_location}.authorization_digest",
            )
            optional_digest(
                revision["implementation_receipt_digest"],
                f"{revision_location}.implementation_receipt_digest",
            )
            if not pre_pr_revision:
                optional_digest(
                    revision["review_receipt_digest"],
                    f"{revision_location}.review_receipt_digest",
                )
                adoption_fields = (
                    revision["head_adoption_receipt"],
                    revision["head_adoption_digest"],
                    revision["head_adoption_epoch"],
                )
                if any(value is not None for value in adoption_fields) and any(
                    value is None for value in adoption_fields
                ):
                    schema_error(
                        revision_location,
                        "historical review head-adoption proof is incomplete",
                    )
                if revision["head_adoption_receipt"] is not None:
                    relative_path_value(
                        revision["head_adoption_receipt"],
                        f"{revision_location}.head_adoption_receipt",
                    )
                    string_value(
                        revision["head_adoption_digest"],
                        f"{revision_location}.head_adoption_digest",
                        pattern=DIGEST_RE,
                    )
                    integer_value(
                        revision["head_adoption_epoch"],
                        f"{revision_location}.head_adoption_epoch",
                        1,
                    )
                lineage = revision["head_adoption_terminal_lineage"]
                if not isinstance(lineage, list):
                    schema_error(
                        f"{revision_location}.head_adoption_terminal_lineage",
                        "must be an array",
                    )
                for lineage_index, raw_entry in enumerate(lineage):
                    entry_location = (
                        f"{revision_location}.head_adoption_terminal_lineage."
                        f"{lineage_index}"
                    )
                    entry = exact_object(
                        raw_entry,
                        entry_location,
                        HEAD_ADOPTION_TERMINAL_ENTRY_FIELDS,
                    )
                    relative_path_value(
                        entry["receipt"],
                        f"{entry_location}.receipt",
                    )
                    string_value(
                        entry["digest"],
                        f"{entry_location}.digest",
                        pattern=DIGEST_RE,
                    )
                    integer_value(
                        entry["epoch"],
                        f"{entry_location}.epoch",
                        1,
                    )
                    enum_value(
                        entry["result"],
                        f"{entry_location}.result",
                        {"BLOCKED", "CLEAN"},
                    )
                    if entry["review_receipt"] is not None:
                        relative_path_value(
                            entry["review_receipt"],
                            f"{entry_location}.review_receipt",
                        )
                    if (
                        entry["result"] == "CLEAN"
                        and entry["review_receipt"] is None
                    ) or (
                        entry["result"] == "BLOCKED"
                        and entry["review_receipt"] is not None
                    ):
                        schema_error(
                            entry_location,
                            "terminal lineage review receipt does not match its result",
                        )
            for owned_index, owned_path in enumerate(
                string_list(
                    revision["owned_paths"],
                    f"{revision_location}.owned_paths",
                    nonempty=True,
                )
            ):
                repo_path_value(
                    owned_path,
                    f"{revision_location}.owned_paths.{owned_index}",
                )
            enum_value(
                revision["reauthorization_disposition"],
                f"{revision_location}.reauthorization_disposition",
                REVISION_DISPOSITIONS,
            )
            if not pre_pr_revision:
                issue_receipt = revision["final_ui_issue_receipt"]
                issue_digest = revision["final_ui_issue_receipt_digest"]
                clean_review_receipt = revision["final_ui_review_receipt"]
                if disposition == "final_ui_checkpoint_issue":
                    if (
                        issue_receipt is None
                        or issue_digest is None
                        or clean_review_receipt is None
                    ):
                        schema_error(
                            revision_location,
                            "final UI checkpoint archived proof is incomplete",
                        )
                    relative_path_value(
                        issue_receipt,
                        f"{revision_location}.final_ui_issue_receipt",
                    )
                    string_value(
                        issue_digest,
                        f"{revision_location}.final_ui_issue_receipt_digest",
                        pattern=DIGEST_RE,
                    )
                    relative_path_value(
                        clean_review_receipt,
                        f"{revision_location}.final_ui_review_receipt",
                    )
                elif (
                    issue_receipt is not None
                    or issue_digest is not None
                    or clean_review_receipt is not None
                ):
                    schema_error(
                        revision_location,
                        "non-checkpoint revision cannot retain final UI archived proof",
                    )
            for field in ("specification_digest", "acceptance_digest"):
                string_value(
                    revision[field],
                    f"{revision_location}.{field}",
                    pattern=DIGEST_RE,
                )
            string_value(
                revision["reauthorization_digest"],
                f"{revision_location}.reauthorization_digest",
                pattern=DIGEST_RE,
            )
            if prerequisite_revision:
                string_value(
                    revision["plan_checkpoint_sha"],
                    f"{revision_location}.plan_checkpoint_sha",
                    pattern=SHA_RE,
                )
                string_value(
                    revision["base_sha"],
                    f"{revision_location}.base_sha",
                    pattern=SHA_RE,
                )
                canonical_remote_branch_ref(revision["base_ref"])
                for field in (
                    "plan_digest", "authorization_digest",
                    "implementation_receipt_digest",
                    "prerequisite_fingerprint", "prerequisite_delivery_digest",
                ):
                    string_value(
                        revision[field],
                        f"{revision_location}.{field}",
                        pattern=DIGEST_RE,
                    )
                string_value(
                    revision["required_base_sha"],
                    f"{revision_location}.required_base_sha",
                    pattern=SHA_RE,
                )
                string_value(
                    revision["prerequisite_merge_sha"],
                    f"{revision_location}.prerequisite_merge_sha",
                    pattern=SHA_RE,
                )
                relative_path_value(
                    revision["prerequisite_delivery_receipt"],
                    f"{revision_location}.prerequisite_delivery_receipt",
                )
                if revision["required_base_sha"] == revision["base_sha"]:
                    schema_error(
                        revision_location,
                        "satisfied prerequisite must advance the required base",
                    )
            else:
                for path_index, path in enumerate(
                    string_list(
                        revision["added_owned_paths"],
                        f"{revision_location}.added_owned_paths",
                    )
                ):
                    repo_path_value(
                        path,
                        f"{revision_location}.added_owned_paths.{path_index}",
                    )
                required_acceptance = revision[
                    (
                        "scope_expansion_acceptance_id"
                        if scope_pre_pr_revision
                        else "required_by_intent_acceptance_id"
                    )
                ]
            if scope_pre_pr_revision:
                string_value(
                    required_acceptance,
                    f"{revision_location}.scope_expansion_acceptance_id",
                    pattern=ACCEPTANCE_ID_RE,
                )
                if not revision["added_owned_paths"]:
                    schema_error(
                        f"{revision_location}.added_owned_paths",
                        "pre-PR scope reauthorization must add a path",
                    )
            elif not prerequisite_revision and disposition == "required_by_intent_scope_expansion":
                string_value(
                    required_acceptance,
                    f"{revision_location}.required_by_intent_acceptance_id",
                    pattern=ACCEPTANCE_ID_RE,
                )
                if not revision["added_owned_paths"]:
                    schema_error(
                        f"{revision_location}.added_owned_paths",
                        "required-by-intent reauthorization must add a path",
                    )
            elif not prerequisite_revision and required_acceptance is not None:
                schema_error(
                    f"{revision_location}.required_by_intent_acceptance_id",
                    "fresh-Pro reauthorization cannot claim required-by-intent acceptance",
                )
            terminal_receipt = revision[
                (
                    "implementation_terminal_receipt"
                    if pre_pr_revision
                    else "review_terminal_receipt"
                )
            ]
            terminal_digest = revision[
                (
                    "implementation_terminal_digest"
                    if pre_pr_revision
                    else "review_terminal_digest"
                )
            ]
            if (terminal_receipt is None) != (terminal_digest is None):
                schema_error(
                    revision_location,
                    "historical review terminal path and digest must be paired",
                )
            if terminal_receipt is not None:
                relative_path_value(
                    terminal_receipt,
                    f"{revision_location}.terminal_receipt",
                )
                if not terminal_receipt.endswith(".json"):
                    schema_error(
                        f"{revision_location}.terminal_receipt",
                        "must be a JSON path",
                    )
                string_value(
                    terminal_digest,
                    f"{revision_location}.terminal_digest",
                    pattern=DIGEST_RE,
                )
            if pre_pr_revision:
                relative_path_value(
                    revision["pre_pr_observation_receipt"],
                    f"{revision_location}.pre_pr_observation_receipt",
                )
                string_value(
                    revision["pre_pr_observation_digest"],
                    f"{revision_location}.pre_pr_observation_digest",
                    pattern=DIGEST_RE,
                )
                integer_value(
                    revision["pre_pr_observation_epoch"],
                    f"{revision_location}.pre_pr_observation_epoch",
                    1,
                )
                if (
                    revision["implementation_receipt_digest"]
                    != revision["implementation_terminal_digest"]
                ):
                    schema_error(
                        revision_location,
                        "implementation receipt digests must match",
                    )
                if revision["pr"] is not None or revision["head_sha"] is not None:
                    schema_error(
                        revision_location,
                        "pre-PR revision cannot claim a PR or head",
                    )
            if revision["pr"] is not None:
                integer_value(
                    revision["pr"], f"{revision_location}.pr", 1
                )
        if revision_epoch == 0 and item["revision_history"]:
            schema_error(
                f"{location}.revision_history",
                "unstarted slice cannot carry revision history",
            )
        if revision_epoch > 0 and len(item["revision_history"]) != revision_epoch - 1:
            schema_error(
                f"{location}.revision_history",
                "revision history must archive every prior revision",
            )
        lineage = item["replacement_lineage"]
        if lineage is not None:
            lineage = exact_object(
                lineage, f"{location}.replacement_lineage", {"pr", "start_sha"}
            )
            integer_value(lineage["pr"], f"{location}.replacement_lineage.pr", 1)
            string_value(
                lineage["start_sha"],
                f"{location}.replacement_lineage.start_sha",
                pattern=SHA_RE,
            )
        if item["merge_receipt"] is not None:
            relative_path_value(item["merge_receipt"], f"{location}.merge_receipt")
        optional_digest(item["merge_receipt_digest"], f"{location}.merge_receipt_digest")
        if item["merge_epoch"] is not None:
            integer_value(item["merge_epoch"], f"{location}.merge_epoch", 1)
        optional_string(item["merge_main_sha"], f"{location}.merge_main_sha", sha=True)
        freshness = item["terminal_freshness"]
        if freshness is not None:
            freshness = exact_object(
                freshness,
                f"{location}.terminal_freshness",
                {
                    "receipt", "digest", "epoch", "review_receipt",
                    "observed_main_sha",
                },
            )
            relative_path_value(
                freshness["receipt"], f"{location}.terminal_freshness.receipt"
            )
            string_value(
                freshness["digest"],
                f"{location}.terminal_freshness.digest",
                pattern=DIGEST_RE,
            )
            integer_value(
                freshness["epoch"], f"{location}.terminal_freshness.epoch", 1
            )
            relative_path_value(
                freshness["review_receipt"],
                f"{location}.terminal_freshness.review_receipt",
            )
            string_value(
                freshness["observed_main_sha"],
                f"{location}.terminal_freshness.observed_main_sha",
                pattern=SHA_RE,
            )
        drift = item["premerge_drift"]
        if drift is not None:
            drift = exact_object(
                drift,
                f"{location}.premerge_drift",
                {"receipt", "digest", "epoch"},
            )
            relative_path_value(
                drift["receipt"], f"{location}.premerge_drift.receipt"
            )
            string_value(
                drift["digest"], f"{location}.premerge_drift.digest",
                pattern=DIGEST_RE,
            )
            integer_value(drift["epoch"], f"{location}.premerge_drift.epoch", 1)
        validate_task_schema(
            item["implementation_task"],
            f"{location}.implementation_task",
            states=IMPLEMENTATION_TASK_STATES,
        )
        validate_task_schema(
            item["review_task"],
            f"{location}.review_task",
            states=REVIEW_TASK_STATES,
        )
        validate_task_history(item["task_history"], f"{location}.task_history")
        if item["pr"] is not None:
            integer_value(item["pr"], f"{location}.pr", 1)
        status = item["status"]
        projected_delivery = is_authoritative_delivery_projection(item)
        if status in {"verified", "pr_open"} or (
            status == "merged" and not projected_delivery
        ):
            if item["receipt"] is None:
                schema_error(f"{location}.receipt", f"status {status} requires a receipt")
        if status in {"verified", "pr_open", "merged"}:
            if item["head_sha"] is None:
                schema_error(f"{location}.head_sha", f"status {status} requires a head SHA")
        if status in {"pr_open", "merged"} and item["pr"] is None:
            schema_error(f"{location}.pr", f"status {status} requires a PR number")
        if status in {"pending", "blocked", "in_progress", "verifying"}:
            for field in ("receipt", "head_sha", "pr"):
                if item[field] is not None:
                    schema_error(
                        f"{location}.{field}",
                        f"status {status} cannot preload {field}",
                    )
        if status == "verified" and item["pr"] is not None:
            schema_error(f"{location}.pr", "verified status cannot preload a PR")
        merge_fields = (
            item["merge_receipt"], item["merge_receipt_digest"],
            item["merge_epoch"], item["merge_main_sha"],
        )
        if (
            status == "merged"
            and not projected_delivery
            and any(value is None for value in merge_fields)
        ):
            schema_error(location, "merged status requires typed merge proof")
        if (
            status != "merged"
            and any(value is not None for value in merge_fields)
        ):
            schema_error(location, "non-merged status cannot carry merge proof")
        if lineage is not None and status not in {
            "blocked", "pending", "in_progress", "verifying", "verified"
        }:
            schema_error(
                f"{location}.replacement_lineage",
                f"status {status} cannot carry replacement lineage",
            )
    acceptance = state["acceptance"]
    if not isinstance(acceptance, dict):
        schema_error("acceptance", "must be an object")
    for identifier, raw in acceptance.items():
        string_value(identifier, "acceptance id", pattern=re.compile(r"^AC-[0-9]{3}$"))
        record = exact_object(
            raw,
            f"acceptance.{identifier}",
            {
                "status", "evidence", "evidence_digests", "criterion_digest",
                "scope", "producer_slice", "producer_head_sha",
                "assignment_digest", "locked",
            },
        )
        if not isinstance(record["locked"], bool):
            schema_error(f"acceptance.{identifier}.locked", "must be a boolean")
        string_value(
            record["criterion_digest"],
            f"acceptance.{identifier}.criterion_digest",
            pattern=DIGEST_RE,
        )
        if record["scope"] is not None:
            enum_value(record["scope"], f"acceptance.{identifier}.scope", {"feature", "slice"})
        optional_string(
            record["producer_slice"], f"acceptance.{identifier}.producer_slice"
        )
        if (
            record["producer_slice"] is not None
            and SLICE_ID_RE.fullmatch(record["producer_slice"]) is None
        ):
            schema_error(
                f"acceptance.{identifier}.producer_slice", "has an invalid format"
            )
        optional_string(
            record["producer_head_sha"],
            f"acceptance.{identifier}.producer_head_sha",
            sha=True,
        )
        optional_digest(
            record["assignment_digest"],
            f"acceptance.{identifier}.assignment_digest",
        )
        enum_value(
            record["status"],
            f"acceptance.{identifier}.status",
            {"pending", "passed", "failed", "waived"},
        )
        evidence_paths = string_list(
            record["evidence"], f"acceptance.{identifier}.evidence"
        )
        for index, evidence in enumerate(evidence_paths):
            relative_path_value(evidence, f"acceptance.{identifier}.evidence.{index}")
        digest_map = record["evidence_digests"]
        if not isinstance(digest_map, dict):
            schema_error(
                f"acceptance.{identifier}.evidence_digests", "must be an object"
            )
        for path, digest in digest_map.items():
            relative_path_value(
                path, f"acceptance.{identifier}.evidence_digests path"
            )
            string_value(
                digest,
                f"acceptance.{identifier}.evidence_digests.{path}",
                pattern=DIGEST_RE,
            )
        if set(digest_map) != set(evidence_paths):
            schema_error(
                f"acceptance.{identifier}.evidence_digests",
                "keys must exactly match evidence",
            )
        if record["status"] == "pending" and record["evidence"]:
            schema_error(
                f"acceptance.{identifier}.evidence",
                "pending status cannot carry evidence",
            )
        if record["status"] == "pending" and record["evidence_digests"]:
            schema_error(
                f"acceptance.{identifier}.evidence_digests",
                "pending status cannot carry evidence digests",
            )
        if record["status"] == "pending" and any(
            record[field] is not None
            for field in (
                "scope", "producer_slice", "producer_head_sha", "assignment_digest"
            )
        ):
            schema_error(
                f"acceptance.{identifier}", "pending status cannot carry provenance"
            )
        if record["status"] != "pending" and not record["evidence"]:
            schema_error(
                f"acceptance.{identifier}.evidence",
                f"status {record['status']} requires evidence",
            )
        if record["status"] != "pending":
            if record["scope"] is None or record["assignment_digest"] is None:
                schema_error(
                    f"acceptance.{identifier}",
                    "completed evidence requires scope and assignment provenance",
                )
            if record["scope"] == "slice" and (
                record["producer_slice"] is None
                or record["producer_head_sha"] is None
            ):
                schema_error(
                    f"acceptance.{identifier}",
                    "slice evidence requires producer slice and head",
                )
            if record["scope"] == "feature" and (
                record["producer_slice"] is not None
                or record["producer_head_sha"] is not None
            ):
                schema_error(
                    f"acceptance.{identifier}",
                    "feature evidence cannot carry slice producer provenance",
                )
        if record["locked"] and record["status"] not in {"passed", "waived"}:
            schema_error(
                f"acceptance.{identifier}.locked",
                "locked acceptance must be passed or waived",
            )
    string_list(state["blockers"], "blockers", pattern=BLOCKER_ID_RE)
    updated_at = state["updated_at"]
    if updated_at is not None:
        string_value(updated_at, "updated_at")
        if not is_valid_rfc3339_datetime(updated_at):
            schema_error("updated_at", "must be a calendar-valid RFC3339 date-time")
    return state

def acceptance_contract(bundle: Path, state: dict) -> dict[str, dict[str, str]]:
    path = safe_path(
        bundle,
        state["artifacts"]["acceptance"],
        "acceptance",
        required=True,
        markdown=True,
    )
    text = path.read_text(encoding="utf-8").replace("\r\n", "\n").replace("\r", "\n")
    headings = list(re.finditer(r"(?m)^##\s+([^\n]+?)\s*$", text))
    criteria: dict[str, dict[str, str]] = {}
    for index, heading in enumerate(headings):
        candidate = re.fullmatch(r"(AC-[0-9]{3}):\s+\S.*", heading.group(1))
        if heading.group(1).startswith("AC-") and candidate is None:
            raise StateError("malformed acceptance criterion heading")
        if candidate is None:
            continue
        identifier = candidate.group(1)
        if identifier in criteria:
            raise StateError(f"duplicate acceptance criterion block: {identifier}")
        end = headings[index + 1].start() if index + 1 < len(headings) else len(text)
        lines = [line.rstrip() for line in text[heading.start():end].split("\n")]
        while lines and not lines[-1]:
            lines.pop()
        normalized = "\n".join(lines) + "\n"
        digest = hashlib.sha256(normalized.encode("utf-8")).hexdigest()
        ownership = markdown_list_values(normalized, "Ownership")
        if len(ownership) == 1 and ownership[0] in {"feature", "slice"}:
            declared_ownership = ownership[0]
        else:
            raise StateError(
                f"acceptance {identifier} requires exactly one Ownership: feature | slice"
            )
        criteria[identifier] = {
            "digest": digest,
            "ownership": declared_ownership,
        }
    mentioned = set(ACCEPTANCE_ID_RE.findall(text))
    undeclared_mentions = sorted(mentioned - set(criteria))
    if undeclared_mentions:
        raise StateError(
            "acceptance IDs require canonical `## AC-NNN: title` blocks: "
            + ", ".join(undeclared_mentions)
        )
    return criteria

def acceptance_criteria(bundle: Path, state: dict) -> dict[str, str]:
    return {
        identifier: record["digest"]
        for identifier, record in acceptance_contract(bundle, state).items()
    }

def acceptance_ids(bundle: Path, state: dict) -> set[str]:
    return set(acceptance_criteria(bundle, state))

def hash_evidence(
    bundle: Path, state: dict, identifier: str, paths: list[str]
) -> dict[str, str]:
    digests: dict[str, str] = {}
    projected = {"state.json", state["artifacts"]["status"]}
    for value in sorted(paths):
        if value in projected:
            raise StateError(f"projected lifecycle file cannot be evidence: {value}")
        path = safe_path(bundle, value, f"{identifier} evidence", required=True)
        try:
            payload = path.read_bytes()
        except OSError as error:
            raise StateError(f"cannot read {identifier} evidence {value}: {error}") from error
        digests[value] = hashlib.sha256(payload).hexdigest()
    return digests

def markdown_list_values(text: str, label: str) -> list[str]:
    declaration = re.compile(
        rf"^[ \t]*-[ \t]+{re.escape(label)}:[ \t]*(.*?)[ \t]*$",
        re.IGNORECASE,
    )
    nested_list_item = re.compile(r"(?:[-+*]|\d+[.)])(?:[ \t]+|$)")
    lines = text.splitlines()
    values: list[str] = []
    for index, line in enumerate(lines):
        match = declaration.fullmatch(line)
        if match is None:
            continue
        leading = line[: len(line) - len(line.lstrip(" \t"))]
        continuation_indent = len(leading.expandtabs(4)) + 2
        parts = [match.group(1).strip()]
        for continuation in lines[index + 1:]:
            if not continuation.strip():
                break
            indentation = continuation[
                : len(continuation) - len(continuation.lstrip(" \t"))
            ]
            content = continuation.lstrip(" \t")
            if (
                len(indentation.expandtabs(4)) < continuation_indent
                or nested_list_item.match(content)
            ):
                break
            parts.append(content.strip())
        values.append(" ".join(part for part in parts if part))
    return values

def canonical_slice_directory(identifier: str) -> PurePosixPath:
    return PurePosixPath("pr") / identifier

def validate_slice_artifact_paths(item: dict) -> PurePosixPath:
    directory = canonical_slice_directory(item["id"])
    expected_plan = (directory / "PLAN.md").as_posix()
    if item["plan"] != expected_plan:
        raise StateError(
            f"{item['id']} plan must use canonical path {expected_plan}"
        )
    expected_receipt = (directory / "RECEIPT.md").as_posix()
    if item["receipt"] is not None and item["receipt"] != expected_receipt:
        raise StateError(
            f"{item['id']} receipt must use canonical path {expected_receipt}"
        )
    return directory

def markdown_section(text: str, heading: str) -> str:
    match = re.search(
        rf"(?ms)^##\s+{re.escape(heading)}\s*$\n(.*?)(?=^##\s+|\Z)", text
    )
    return match.group(1) if match is not None else ""

def normalized_markdown(value: str) -> str:
    lines = [line.rstrip() for line in value.replace("\r\n", "\n").replace("\r", "\n").split("\n")]
    while lines and not lines[0]:
        lines.pop(0)
    while lines and not lines[-1]:
        lines.pop()
    return "\n".join(lines) + "\n"

def text_digest(value: str) -> str:
    return hashlib.sha256(value.encode("utf-8")).hexdigest()

def canonical_digest(value: object) -> str:
    return text_digest(json.dumps(value, sort_keys=True, separators=(",", ":")))

def authorization_entry_digest(
    entry: dict,
    *,
    work_kind: str,
    work_id: str,
    replacement_predicates_text: str | None = None,
) -> str:
    payload = {
        "work_kind": work_kind,
        "work_id": work_id,
        "slice_id": entry["slice_id"],
        "role": entry["role"],
        "route_digest": text_digest(entry["route"]),
        "replacement_predicates_digest": text_digest(
            (
                "; ".join(entry["replacement_predicates"])
                if replacement_predicates_text is None
                else replacement_predicates_text
            )
        ),
    }
    return hashlib.sha256(
        json.dumps(payload, sort_keys=True, separators=(",", ":")).encode("utf-8")
    ).hexdigest()


def task_authorization_projection_digest(entries: list[dict]) -> str:
    return canonical_digest([
        {
            "slice_id": entry["slice_id"],
            "role": entry["role"],
            "route": entry["route"],
            "replacement_predicates": entry["replacement_predicates"],
        }
        for entry in sorted(
            entries, key=lambda item: (item["slice_id"], item["role"])
        )
    ])


def task_roster_section(primary: str) -> str:
    roster = markdown_section(primary, "Codex Task Roster")
    authorization = markdown_section(primary, "Codex Task Authorization")
    if roster and authorization:
        raise StateError(
            "primary specification must not contain both Codex Task Roster "
            "and Codex Task Authorization"
        )
    if roster:
        return roster
    raise StateError("primary specification requires Codex Task Roster")


def task_authorization_contract(
    bundle: Path, state: dict, *, canonicalize_predicates: bool = True
) -> dict:
    primary_path = safe_path(
        bundle, state["artifacts"]["primary"], "primary", required=True, markdown=True
    )
    primary = primary_path.read_text(encoding="utf-8")
    section = task_roster_section(primary)
    statuses = markdown_list_values(section, "Status")
    raw_entries = markdown_list_values(section, "Entry")
    if statuses != ["registered"]:
        raise StateError("Codex Task Roster must have Status: registered")
    if markdown_list_values(section, "Evidence"):
        raise StateError(
            "Codex Task Roster must not contain an Evidence field; registration is root-owned"
        )
    entries: list[dict] = []
    keys: set[tuple[str, str]] = set()
    for raw in raw_entries:
        parts = [part.strip() for part in raw.split("|")]
        if len(parts) != 4:
            raise StateError(
                "Codex Task Roster Entry requires slice | role | route | replacement predicates"
            )
        slice_id, role, route, replacement_predicates = parts
        if SLICE_ID_RE.fullmatch(slice_id) is None or role not in {
            "implementation", "review"
        }:
            raise StateError("Codex Task Roster Entry has invalid slice or role")
        if not route or not replacement_predicates:
            raise StateError("Codex Task Roster Entry route/predicates are required")
        predicates = [
            predicate.strip()
            for predicate in replacement_predicates.split(";")
            if predicate.strip()
        ]
        unsupported = sorted(set(predicates) - REPLACEMENT_PREDICATES)
        if not predicates or unsupported:
            raise StateError(
                "Codex Task Roster Entry has unsupported replacement predicates"
                + (": " + ", ".join(unsupported) if unsupported else "")
            )
        if (slice_id, role) in keys:
            raise StateError(
                f"duplicate Codex Task Roster Entry: {slice_id}:{role}"
            )
        keys.add((slice_id, role))
        entry = {
            "slice_id": slice_id,
            "role": role,
            "route": route,
            "replacement_predicates": (
                canonical_replacement_predicates(predicates)
                if canonicalize_predicates
                else predicates
            ),
        }
        entry["entry_digest"] = authorization_entry_digest(
            entry,
            work_kind=state["work_kind"],
            work_id=state["work_id"],
            replacement_predicates_text=(
                None if canonicalize_predicates else replacement_predicates
            ),
        )
        entries.append(entry)
    if not entries:
        raise StateError("Codex Task Roster requires at least one Entry")
    return {
        "primary_digest": text_digest(normalized_markdown(section)),
        "entries": sorted(entries, key=lambda item: (item["slice_id"], item["role"])),
    }

def authorized_replacement_predicates(
    bundle: Path, state: dict, slice_id: str, role: str
) -> list[str]:
    del bundle
    return list(
        authorization_entry(state, slice_id, role)["replacement_predicates"]
    )

def authorization_entry(state: dict, slice_id: str, role: str) -> dict:
    authorization = state["task_authorization"]
    if authorization is None:
        raise StateError("Codex task roster is not registered")
    for entry in authorization["entries"]:
        if entry["slice_id"] == slice_id and entry["role"] == role:
            return entry
    raise StateError(f"Codex task is not in the registered roster: {slice_id}:{role}")

def validate_task_authorization(
    bundle: Path, state: dict, *, allow_drift: bool = False
) -> None:
    authorization = state["task_authorization"]
    if authorization is None:
        return
    if (
        not allow_drift
        and authorization["primary_digest"]
        != task_authorization_projection_digest(authorization["entries"])
    ):
        if authorization != task_authorization_contract(bundle, state):
            raise StateError(
                "Codex Task Roster changed; register the exact current roster again"
            )
    for entry in authorization["entries"]:
        if entry["slice_id"] not in slice_map(state):
            raise StateError(
                f"Codex task roster references unknown slice: {entry['slice_id']}"
            )
        unsupported = sorted(
            set(entry["replacement_predicates"]) - REPLACEMENT_PREDICATES
        )
        if unsupported:
            raise StateError(
                "Codex task roster has unsupported replacement predicates: "
                + ", ".join(unsupported)
            )
        if entry["entry_digest"] != authorization_entry_digest(
            entry,
            work_kind=state["work_kind"],
            work_id=state["work_id"],
        ):
            raise StateError("Codex task roster entry digest mismatch")

def require_complete_task_authorization(
    state: dict, *, allow_current_task_drift: bool = False
) -> None:
    expected = {
        (item["id"], role)
        for item in state["slices"]
        if item["status"] not in TERMINAL_SLICE_STATUSES
        for role in ("implementation", "review")
        if item[f"{role}_task"]["state"] != "superseded"
        and not (
            allow_current_task_drift
            and item[f"{role}_task"]["state"] != "unbound"
        )
    }
    authorization = state["task_authorization"]
    actual = (
        {(entry["slice_id"], entry["role"]) for entry in authorization["entries"]}
        if authorization is not None
        else set()
    )
    if not expected.issubset(actual):
        missing = sorted(expected - actual)
        raise StateError(
            "Codex task roster mismatch: missing "
            + ", ".join(f"{a}:{b}" for a, b in missing)
        )

PAIR_FIELDS = (
    "Dependency edge", "Owned-path overlap", "Shared API",
    "Shared schema or migration", "Shared canonical document",
    "Shared test fixture or generated file", "Shared backend resource",
    "Shared UI acceptance dependency", "Separate branches and worktrees",
    "Independent build and verification", "Verdict",
)

def plan_file_digest(bundle: Path, item: dict) -> str:
    path = safe_path(
        bundle, item["plan"], f"{item['id']} plan", required=True, markdown=True
    )
    return hashlib.sha256(path.read_bytes()).hexdigest()

def pair_assessment_block(bundle: Path, item: dict, other_id: str) -> dict:
    text = safe_path(
        bundle, item["plan"], f"{item['id']} plan", required=True, markdown=True
    ).read_text(encoding="utf-8")
    section = markdown_section(text, "Parallelization Assessment")
    left, right = sorted((item["id"], other_id))
    pattern = re.compile(
        rf"(?ms)^###\s+Pair\s+{re.escape(left)}\s+\+\s+{re.escape(right)}\s*$\n"
        r"(.*?)(?=^###\s+|\Z)"
    )
    matches = list(pattern.finditer(section))
    if len(matches) != 1:
        raise StateError(
            f"{item['id']} plan requires exactly one Pair {left} + {right} assessment"
        )
    block = matches[0].group(1)
    labels = re.findall(r"(?mi)^\s*-\s*([^:\n]+):", block)
    if sorted(labels) != sorted(PAIR_FIELDS):
        raise StateError(
            f"{item['id']} pair assessment fields are incomplete or duplicated"
        )
    values: dict[str, str] = {}
    for label in PAIR_FIELDS:
        matches_for_label = markdown_list_values(block, label)
        if len(matches_for_label) != 1:
            raise StateError(f"{item['id']} pair assessment requires {label}")
        values[label] = matches_for_label[0]
    verdict = values["Verdict"]
    if verdict not in {"independent", "coupled"}:
        raise StateError(f"{item['id']} pair assessment has invalid verdict")
    if verdict == "independent":
        for label in PAIR_FIELDS[:8]:
            if values[label] != "none":
                raise StateError(
                    f"{item['id']} independent pair assessment requires {label}: none"
                )
        if values["Separate branches and worktrees"] != "planned":
            raise StateError(
                f"{item['id']} independent pair requires separate planned worktrees"
            )
        if values["Independent build and verification"] != "yes":
            raise StateError(
                f"{item['id']} independent pair requires independent verification"
            )
    return {"normalized": normalized_markdown(block), "verdict": verdict}

def parallel_assessment_value(
    bundle: Path, state: dict, left_id: str, right_id: str
) -> dict:
    left_id, right_id = sorted((left_id, right_id))
    if left_id == right_id:
        raise StateError("parallel assessment requires two distinct slices")
    items = slice_map(state)
    if left_id not in items or right_id not in items:
        raise StateError("parallel assessment references an unknown slice")
    left_block = pair_assessment_block(bundle, items[left_id], right_id)
    right_block = pair_assessment_block(bundle, items[right_id], left_id)
    verdict = (
        "independent"
        if left_block["verdict"] == right_block["verdict"] == "independent"
        else "coupled"
    )
    return {
        "left_slice": left_id,
        "right_slice": right_id,
        "left_plan_digest": plan_file_digest(bundle, items[left_id]),
        "right_plan_digest": plan_file_digest(bundle, items[right_id]),
        "assessment_digest": text_digest(
            left_block["normalized"] + "\0" + right_block["normalized"]
        ),
        "verdict": verdict,
    }

def parallel_assessment_map(state: dict) -> dict[tuple[str, str], dict]:
    return {
        (record["left_slice"], record["right_slice"]): record
        for record in state["parallel_assessments"]
    }

def require_independent_pairs(state: dict, group: list[dict]) -> None:
    records = parallel_assessment_map(state)
    ordered = sorted(item["id"] for item in group)
    for index, left in enumerate(ordered):
        for right in ordered[index + 1 :]:
            record = records.get((left, right))
            if record is None or record["verdict"] != "independent":
                raise StateError(
                    f"parallel slices lack an independent pair assessment: {left}, {right}"
                )

def validate_parallel_assessments(
    bundle: Path,
    state: dict,
    *,
    allow_drift: set[tuple[str, str]] | None = None,
) -> None:
    allowed = allow_drift or set()
    for pair, record in parallel_assessment_map(state).items():
        if (
            ("*", "*") in allowed
            or pair in allowed
            or any((identifier, "*") in allowed for identifier in pair)
        ):
            continue
        if record != parallel_assessment_value(bundle, state, *pair):
            raise StateError(
                f"parallel assessment changed; record pair again: {pair[0]}, {pair[1]}"
            )

def discard_stale_parallel_assessments(bundle: Path, state: dict) -> None:
    current: list[dict] = []
    for record in state["parallel_assessments"]:
        pair = (record["left_slice"], record["right_slice"])
        try:
            if record == parallel_assessment_value(bundle, state, *pair):
                current.append(record)
        except StateError:
            continue
    state["parallel_assessments"] = current


def rendered_owning_seam_identity(value: str) -> str:
    """Remove only Markdown inline-code presentation from an owning seam."""
    return re.sub(r"(?<!`)`([^`\r\n]+)`(?!`)", r"\1", value)


COHESIVE_CONSUMER_SWEEP_LABEL = (
    "Persistence/schema compatibility plus cross-screen consumer sweep"
)


def slice_cohesion_contract(
    text: str,
    identifier: str,
    *,
    required: bool,
    authenticated_required_by_intent_evidence: dict | None = None,
) -> dict | None:
    headings = re.findall(r"(?mi)^\s*##\s+Slice Cohesion\s*$", text)
    if not headings:
        if required:
            raise StateError(
                f"{identifier} plan requires a Slice Cohesion section"
            )
        return None
    if len(headings) != 1:
        raise StateError(f"{identifier} plan has duplicate Slice Cohesion sections")
    section = markdown_section(text, "Slice Cohesion")
    labels = (
        "Primary outcome",
        "Primary execution flow",
        "Owning observable seam",
        "Primary acceptance criterion",
        "Regression guards",
        "New high-cost verification mechanism",
        "Independent execution flows",
        COHESIVE_CONSUMER_SWEEP_LABEL,
        "New acceptance harness plus unrelated production behavior",
        "Final UI slice adds substantial production semantics",
        "Aggregate/closure/final integration slice",
        "Unresolved implementation work",
        "Cohesion proof",
        "Path-count warning",
    )
    values: dict[str, str] = {}
    for label in labels:
        found = markdown_list_values(section, label)
        if len(found) != 1:
            raise StateError(
                f"{identifier} Slice Cohesion requires exactly one {label} declaration"
            )
        values[label] = found[0]
    values["Owning observable seam"] = rendered_owning_seam_identity(
        values["Owning observable seam"]
    )
    placeholders = {"none", "tbd", "todo", "unknown", "n/a"}
    for label in (
        "Primary outcome",
        "Primary execution flow",
        "Owning observable seam",
        "Primary acceptance criterion",
    ):
        if values[label].strip().lower() in placeholders:
            raise StateError(f"{identifier} Slice Cohesion has no concrete {label}")
    boolean_labels = (
        "Independent execution flows",
        "Persistence/schema compatibility plus cross-screen consumer sweep",
        "New acceptance harness plus unrelated production behavior",
        "Final UI slice adds substantial production semantics",
        "Aggregate/closure/final integration slice",
        "Unresolved implementation work",
    )
    for label in boolean_labels:
        if values[label] not in {"yes", "no"}:
            raise StateError(
                f"{identifier} Slice Cohesion {label} must be yes or no"
            )
    split_reasons = [
        label for label in boolean_labels[:4] if values[label] == "yes"
    ]
    if split_reasons:
        consumer_expansion = split_reasons == [COHESIVE_CONSUMER_SWEEP_LABEL]
        if consumer_expansion and authenticated_required_by_intent_evidence is None:
            raise StateError(
                f"{identifier} consumer sweep is eligible only through "
                "authenticated required-by-intent reauthorization; otherwise "
                "the plan must split independent concerns"
            )
        if consumer_expansion:
            evidence = authenticated_required_by_intent_evidence
            assert evidence is not None
            evidence_seam = evidence.get("owningSeam")
            if isinstance(evidence_seam, str):
                evidence_seam = rendered_owning_seam_identity(evidence_seam)
            if (
                evidence.get("acceptanceId")
                != values["Primary acceptance criterion"]
                or evidence_seam != values["Owning observable seam"]
                or not evidence.get("requiredOwnedPaths")
            ):
                raise StateError(
                    f"{identifier} cohesive consumer expansion evidence differs "
                    "from the plan acceptance criterion, owning seam, or added paths"
                )
        else:
            raise StateError(
                f"{identifier} plan must split independent concerns: "
                + ", ".join(split_reasons)
            )
    if (
        values["Aggregate/closure/final integration slice"] == "yes"
        and values["Unresolved implementation work"] == "yes"
        and values["Cohesion proof"].strip().lower() in placeholders
    ):
        raise StateError(
            f"{identifier} aggregate slice with unresolved work requires cohesion proof"
        )
    return values


def slice_plan_contract(
    bundle: Path,
    item: dict,
    *,
    require_cohesion: bool = False,
    authenticated_required_by_intent_evidence: dict | None = None,
) -> dict:
    directory = validate_slice_artifact_paths(item)
    text = safe_path(
        bundle, item["plan"], f"{item['id']} plan", required=True, markdown=True
    ).read_text(encoding="utf-8")
    cohesion = slice_cohesion_contract(
        text,
        item["id"],
        required=require_cohesion,
        authenticated_required_by_intent_evidence=(
            authenticated_required_by_intent_evidence
        ),
    )
    gates = markdown_list_values(text, "UI gate")
    if len(gates) != 1 or gates[0] not in UI_GATE_VALUES:
        raise StateError(
            f"{item['id']} plan requires exactly one valid UI gate classification"
        )
    automated = markdown_list_values(text, "Automated UI acceptance")
    targets = markdown_list_values(text, "UI proof target")
    automated_id: str | None = None
    proof_target: str | None = None
    if gates[0] == "not_applicable":
        if automated not in ([], ["none"]) or targets not in ([], ["none"]):
            raise StateError(
                f"{item['id']} non-UI plan must not claim UI proof authority"
            )
    else:
        if len(automated) != 1 or re.fullmatch(r"AC-[0-9]{3}", automated[0]) is None:
            raise StateError(
                f"{item['id']} plan requires one automated UI acceptance ID"
            )
        if len(targets) != 1 or PROOF_TARGET_RE.fullmatch(targets[0]) is None:
            raise StateError(f"{item['id']} plan requires one stable UI proof target")
        automated_id = automated[0]
        proof_target = targets[0]
    declarations = markdown_list_values(text, "Final design acceptance")
    if len(declarations) > 1:
        raise StateError(
            f"{item['id']} plan has duplicate final design acceptance declarations"
        )
    final_acceptance = declarations[0] if declarations else None
    if final_acceptance == "none":
        final_acceptance = None
    elif final_acceptance is not None and re.fullmatch(
        r"AC-[0-9]{3}", final_acceptance
    ) is None:
        raise StateError(f"{item['id']} plan has invalid final design acceptance")
    ordinary = set(
        ACCEPTANCE_ID_RE.findall(markdown_section(text, "Acceptance Coverage"))
    )
    owned = ordinary | {
        identifier
        for identifier in (automated_id, final_acceptance)
        if identifier is not None
    }
    return {
        "directory": directory,
        "text": text,
        "gate": gates[0],
        "automated": automated_id,
        "proofTarget": proof_target,
        "finalAcceptance": final_acceptance,
        "ownedAcceptance": owned,
        "cohesion": cohesion,
    }

def empty_acceptance_record(criterion_digest: str) -> dict:
    return {
        "status": "pending",
        "evidence": [],
        "evidence_digests": {},
        "criterion_digest": criterion_digest,
        "scope": None,
        "producer_slice": None,
        "producer_head_sha": None,
        "assignment_digest": None,
        "locked": False,
    }

def acceptance_plan_assignment(
    bundle: Path, state: dict, identifier: str
) -> dict:
    declared_ownership = acceptance_contract(bundle, state)[identifier]["ownership"]
    items = slice_map(state)
    plan_owners = sorted(
        item["id"]
        for item in items.values()
        if identifier
        in state_slice_plan_contract(bundle, state, item)["ownedAcceptance"]
    )
    if len(plan_owners) > 1:
        raise StateError(
            f"acceptance {identifier} has multiple slice owners: "
            + ", ".join(plan_owners)
        )
    if declared_ownership == "feature":
        if plan_owners:
            raise StateError(
                f"acceptance {identifier} declares feature ownership but has plan owner "
                + plan_owners[0]
            )
        producer = None
        scope = "feature"
    else:
        if not plan_owners:
            raise StateError(
                f"acceptance {identifier} declares slice ownership but has no plan owner"
            )
        producer = plan_owners[0]
        scope = "slice"
    return {
        "scope": scope,
        "producer_slice": producer,
    }

def acceptance_assignment_value(
    bundle: Path, state: dict, identifier: str, evidence: list[str],
    plan_assignment: dict | None = None,
) -> dict:
    assignment = plan_assignment or acceptance_plan_assignment(
        bundle, state, identifier
    )
    producer = assignment["producer_slice"]
    evidence_owners = sorted(
        {
            match.group(1)
            for path in evidence
            for match in [re.match(r"^pr/(PR-[0-9]{2,})/", path)]
            if match is not None
        }
    )
    if len(evidence_owners) > 1:
        raise StateError(
            f"acceptance {identifier} evidence spans multiple slices: "
            + ", ".join(evidence_owners)
        )
    expected_evidence_owners = [] if producer is None else [producer]
    if evidence_owners and expected_evidence_owners != evidence_owners:
        raise StateError(
            f"acceptance {identifier} evidence producer differs from plan ownership"
        )
    if producer is None:
        head = None
    else:
        head = slice_map(state)[producer]["head_sha"]
        if head is None:
            raise StateError(
                f"acceptance {identifier} slice producer requires a current head"
            )
    digest_assignment = {
        "acceptance": identifier,
        "scope": assignment["scope"],
        "producer_slice": producer,
    }
    return {
        "scope": assignment["scope"],
        "producer_slice": producer,
        "producer_head_sha": head,
        "assignment_digest": hashlib.sha256(
            json.dumps(digest_assignment, sort_keys=True, separators=(",", ":")).encode(
                "utf-8"
            )
        ).hexdigest(),
    }

def validate_acceptance_provenance(
    bundle: Path,
    state: dict,
    *,
    validate_pending_assignment: bool = False,
    allow_assignment_drift: bool = False,
) -> None:
    for identifier, record in state["acceptance"].items():
        if record["status"] == "pending" and not validate_pending_assignment:
            continue
        plan_assignment = acceptance_plan_assignment(bundle, state, identifier)
        if record["status"] == "pending":
            continue
        actual_assignment = {
            field: record[field] for field in ("scope", "producer_slice")
        }
        if (
            allow_assignment_drift
            and not record["locked"]
            and actual_assignment != plan_assignment
        ):
            continue
        expected = acceptance_assignment_value(
            bundle, state, identifier, record["evidence"], plan_assignment
        )
        actual = {
            field: record[field]
            for field in (
                "scope", "producer_slice", "producer_head_sha", "assignment_digest"
            )
        }
        if actual != expected:
            raise StateError(f"acceptance provenance is stale: {identifier}")


def plan_proposal_file(value: str | Path) -> Path:
    path = Path(value)
    if not path.is_absolute():
        path = REPO / path
    ensure_regular_file(path, "Plan proposal", required=True)
    return path


def plan_proposal_value(bundle: Path, state: dict, value: str | Path) -> dict:
    path = plan_proposal_file(value)
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as error:
        raise StateError(f"malformed Plan proposal JSON: {error.msg}") from error
    except OSError as error:
        raise StateError(f"cannot read Plan proposal: {error}") from error
    proposal = exact_object(raw, "plan proposal", PLAN_PROPOSAL_FIELDS)
    string_value(
        proposal["specification_digest"],
        "plan proposal.specification_digest",
        pattern=DIGEST_RE,
    )
    string_value(
        proposal["source_commit"],
        "plan proposal.source_commit",
        pattern=SHA_RE,
    )
    if proposal["active_response_digest"] is not None:
        string_value(
            proposal["active_response_digest"],
            "plan proposal.active_response_digest",
            pattern=DIGEST_RE,
        )

    artifacts = proposal["semantic_artifacts"]
    if not isinstance(artifacts, list) or not artifacts:
        schema_error(
            "plan proposal.semantic_artifacts", "must be a non-empty array"
        )
    normalized_artifacts: list[dict[str, str]] = []
    artifact_paths: set[str] = set()
    for index, raw_artifact in enumerate(artifacts):
        location = f"plan proposal.semantic_artifacts.{index}"
        artifact = exact_object(
            raw_artifact, location, PLAN_PROPOSAL_ARTIFACT_FIELDS
        )
        relative = relative_path_value(
            artifact["path"], f"{location}.path", markdown=True
        )
        digest = string_value(
            artifact["sha256"], f"{location}.sha256", pattern=DIGEST_RE
        )
        if relative in artifact_paths:
            schema_error(location, "duplicates a semantic artifact path")
        artifact_paths.add(relative)
        normalized_artifacts.append({"path": relative, "sha256": digest})
    if normalized_artifacts != sorted(
        normalized_artifacts, key=lambda artifact: artifact["path"]
    ):
        schema_error(
            "plan proposal.semantic_artifacts",
            "must use canonical path order",
        )

    raw_slices = proposal["slices"]
    if not isinstance(raw_slices, list) or not raw_slices:
        schema_error("plan proposal.slices", "must be a non-empty array")
    normalized_slices: list[dict] = []
    slice_ids: set[str] = set()
    for index, raw_slice in enumerate(raw_slices):
        location = f"plan proposal.slices.{index}"
        item = exact_object(raw_slice, location, PLAN_PROPOSAL_SLICE_FIELDS)
        identifier = string_value(
            item["id"], f"{location}.id", pattern=SLICE_ID_RE
        )
        if identifier in slice_ids:
            schema_error(location, "duplicates a slice id")
        slice_ids.add(identifier)
        plan = relative_path_value(
            item["plan"], f"{location}.plan", markdown=True
        )
        expected_plan = (canonical_slice_directory(identifier) / "PLAN.md").as_posix()
        if plan != expected_plan:
            schema_error(
                f"{location}.plan",
                f"must use canonical path {expected_plan}",
            )
        plan_path = safe_path(
            bundle, plan, f"{identifier} proposed plan", required=True, markdown=True
        )
        plan_digest = string_value(
            item["plan_digest"], f"{location}.plan_digest", pattern=DIGEST_RE
        )
        if hashlib.sha256(plan_path.read_bytes()).hexdigest() != plan_digest:
            raise StateError(
                f"{identifier} Plan proposal digest does not match current plan bytes"
            )
        dependencies = string_list(
            item["depends_on"],
            f"{location}.depends_on",
            pattern=SLICE_ID_RE,
        )
        if dependencies != sorted(dependencies):
            schema_error(f"{location}.depends_on", "must use canonical sorted order")
        owned_paths = string_list(
            item["owned_paths"], f"{location}.owned_paths", nonempty=True
        )
        for owned_index, owned_path in enumerate(owned_paths):
            repo_path_value(
                owned_path, f"{location}.owned_paths.{owned_index}"
            )
        if owned_paths != sorted(owned_paths):
            schema_error(
                f"{location}.owned_paths", "must use canonical sorted order"
            )
        branch = item["branch"]
        base_ref = item["base_ref"]
        base_sha = item["base_sha"]
        optional_string(branch, f"{location}.branch")
        if (
            branch is not None
            and git_output(
                ["check-ref-format", "--branch", branch], check=False
            )
            != branch
        ):
            schema_error(
                f"{location}.branch", "is not a valid Git branch name"
            )
        optional_string(base_ref, f"{location}.base_ref")
        optional_string(base_sha, f"{location}.base_sha", sha=True)
        if any(value is not None for value in (branch, base_ref, base_sha)) and not all(
            value is not None for value in (branch, base_ref, base_sha)
        ):
            schema_error(
                location,
                "branch, base_ref, and base_sha must be supplied together",
            )
        normalized_slices.append({
            "id": identifier,
            "title": string_value(item["title"], f"{location}.title"),
            "plan": plan,
            "plan_digest": plan_digest,
            "depends_on": dependencies,
            "wave": integer_value(item["wave"], f"{location}.wave", 1),
            "execution_mode": enum_value(
                item["execution_mode"],
                f"{location}.execution_mode",
                {"serial", "parallel"},
            ),
            "owned_paths": owned_paths,
            "branch": branch,
            "base_ref": base_ref,
            "base_sha": base_sha,
        })
    if normalized_slices != sorted(
        normalized_slices, key=lambda item: item["id"]
    ):
        schema_error("plan proposal.slices", "must use canonical slice order")

    raw_assessments = proposal["parallel_assessments"]
    if not isinstance(raw_assessments, list):
        schema_error("plan proposal.parallel_assessments", "must be an array")
    assessments: list[dict] = []
    pairs: set[tuple[str, str]] = set()
    for index, raw_assessment in enumerate(raw_assessments):
        location = f"plan proposal.parallel_assessments.{index}"
        assessment = exact_object(
            raw_assessment, location, PARALLEL_ASSESSMENT_FIELDS
        )
        left = string_value(
            assessment["left_slice"],
            f"{location}.left_slice",
            pattern=SLICE_ID_RE,
        )
        right = string_value(
            assessment["right_slice"],
            f"{location}.right_slice",
            pattern=SLICE_ID_RE,
        )
        if left >= right:
            schema_error(location, "slice pair must be strictly sorted")
        for field in (
            "left_plan_digest", "right_plan_digest", "assessment_digest"
        ):
            string_value(
                assessment[field], f"{location}.{field}", pattern=DIGEST_RE
            )
        enum_value(
            assessment["verdict"],
            f"{location}.verdict",
            {"independent", "coupled"},
        )
        if (left, right) in pairs:
            schema_error(location, "duplicates a slice pair")
        pairs.add((left, right))
        assessments.append(deepcopy(assessment))
    if assessments != sorted(
        assessments,
        key=lambda assessment: (
            assessment["left_slice"], assessment["right_slice"]
        ),
    ):
        schema_error(
            "plan proposal.parallel_assessments",
            "must use canonical pair order",
        )

    raw_authorization = exact_object(
        proposal["task_authorization"],
        "plan proposal.task_authorization",
        PLAN_PROPOSAL_AUTHORIZATION_FIELDS,
    )
    raw_entries = raw_authorization["entries"]
    if not isinstance(raw_entries, list):
        schema_error(
            "plan proposal.task_authorization.entries",
            "must be an array",
        )
    entries: list[dict] = []
    entry_keys: set[tuple[str, str]] = set()
    for index, raw_entry in enumerate(raw_entries):
        location = f"plan proposal.task_authorization.entries.{index}"
        entry = exact_object(
            raw_entry, location, PLAN_PROPOSAL_AUTHORIZATION_ENTRY_FIELDS
        )
        slice_id = string_value(
            entry["slice_id"], f"{location}.slice_id", pattern=SLICE_ID_RE
        )
        role = enum_value(
            entry["role"], f"{location}.role", {"implementation", "review"}
        )
        route = string_value(entry["route"], f"{location}.route")
        if not route.strip():
            schema_error(
                f"{location}.route",
                "must contain non-whitespace content",
            )
        predicates = string_list(
            entry["replacement_predicates"],
            f"{location}.replacement_predicates",
            nonempty=True,
        )
        unsupported = sorted(set(predicates) - REPLACEMENT_PREDICATES)
        if unsupported:
            schema_error(
                f"{location}.replacement_predicates",
                "contains unsupported values: " + ", ".join(unsupported),
            )
        predicates = canonical_replacement_predicates(predicates)
        if (slice_id, role) in entry_keys:
            schema_error(location, "duplicates a slice/role authorization")
        entry_keys.add((slice_id, role))
        normalized = {
            "slice_id": slice_id,
            "role": role,
            "route": route,
            "replacement_predicates": predicates,
        }
        normalized["entry_digest"] = authorization_entry_digest(
            normalized,
            work_kind=state["work_kind"],
            work_id=state["work_id"],
        )
        entries.append(normalized)
    entries.sort(key=lambda entry: (entry["slice_id"], entry["role"]))

    raw_acceptance = proposal["acceptance"]
    if not isinstance(raw_acceptance, list):
        schema_error("plan proposal.acceptance", "must be an array")
    acceptance: list[dict] = []
    acceptance_ids_seen: set[str] = set()
    for index, raw_record in enumerate(raw_acceptance):
        location = f"plan proposal.acceptance.{index}"
        record = exact_object(
            raw_record, location, PLAN_PROPOSAL_ACCEPTANCE_FIELDS
        )
        identifier = string_value(
            record["id"], f"{location}.id", pattern=ACCEPTANCE_ID_RE
        )
        if identifier in acceptance_ids_seen:
            schema_error(location, "duplicates an acceptance id")
        acceptance_ids_seen.add(identifier)
        producer = record["producer_slice"]
        optional_string(producer, f"{location}.producer_slice")
        if producer is not None and SLICE_ID_RE.fullmatch(producer) is None:
            schema_error(f"{location}.producer_slice", "has an invalid format")
        acceptance.append({
            "id": identifier,
            "criterion_digest": string_value(
                record["criterion_digest"],
                f"{location}.criterion_digest",
                pattern=DIGEST_RE,
            ),
            "scope": enum_value(
                record["scope"], f"{location}.scope", {"feature", "slice"}
            ),
            "producer_slice": producer,
        })
    if acceptance != sorted(acceptance, key=lambda record: record["id"]):
        schema_error(
            "plan proposal.acceptance", "must use canonical acceptance order"
        )

    return {
        "specification_digest": proposal["specification_digest"],
        "source_commit": proposal["source_commit"],
        "active_response_digest": proposal["active_response_digest"],
        "semantic_artifacts": normalized_artifacts,
        "slices": normalized_slices,
        "parallel_assessments": assessments,
        "task_authorization": {"entries": entries},
        "acceptance": acceptance,
    }


def plan_proposal_slice(proposed: dict) -> dict:
    return {
        "id": proposed["id"],
        "title": proposed["title"],
        "status": "pending",
        "depends_on": proposed["depends_on"],
        "wave": proposed["wave"],
        "execution_mode": proposed["execution_mode"],
        "owned_paths": proposed["owned_paths"],
        "plan": proposed["plan"],
        "plan_digest": proposed["plan_digest"],
        "receipt": None,
        "branch": proposed["branch"],
        "base_ref": proposed["base_ref"],
        "base_sha": proposed["base_sha"],
        "head_sha": None,
        "pr": None,
        "plan_checkpoint_sha": None,
        "revision_epoch": 0,
        "revision_history": [],
        "replacement_lineage": None,
        "implementation_task": empty_task(),
        "review_task": empty_task(),
        "task_history": [],
        "merge_receipt": None,
        "merge_receipt_digest": None,
        "merge_epoch": None,
        "merge_main_sha": None,
        "terminal_freshness": None,
        "premerge_drift": None,
    }


def slice_has_delivery_identity(item: dict) -> bool:
    return (
        item["status"] not in {"pending", "blocked"}
        or item["plan_checkpoint_sha"] is not None
        or item["revision_epoch"] > 0
        or bool(item["revision_history"])
        or bool(item["task_history"])
        or item["replacement_lineage"] is not None
        or any(
            item[field] is not None
            for field in (
                "receipt", "head_sha", "pr", "merge_receipt",
                "merge_receipt_digest", "merge_epoch", "merge_main_sha",
            )
        )
        or any(
            item[field]["attempt"] > 0
            or item[field]["state"] not in {"unbound", "superseded"}
            for field in ("implementation_task", "review_task")
        )
    )


def plan_owned_slice_projection(item: dict) -> dict:
    return {
        field: item[field]
        for field in (
            "id", "title", "plan", "depends_on", "wave", "execution_mode",
            "owned_paths", "branch", "base_ref", "base_sha", "plan_digest",
        )
    }


def proposal_slice_projection(item: dict) -> dict:
    return {
        field: item[field]
        for field in (
            "id", "title", "plan", "depends_on", "wave", "execution_mode",
            "owned_paths", "branch", "base_ref", "base_sha", "plan_digest",
        )
    }

def current_ui_epoch_ids(
    bundle: Path, items: dict[str, dict], final_slice: str
) -> set[str]:
    ordered = list(items)
    selected_index = ordered.index(final_slice)
    boundary = -1
    for index in range(selected_index - 1, -1, -1):
        identifier = ordered[index]
        item = items[identifier]
        if item["status"] not in TERMINAL_SLICE_STATUSES:
            continue
        plan = safe_path(
            bundle, item["plan"], f"{identifier} historical plan",
            required=True, markdown=True,
        ).read_text(encoding="utf-8")
        if markdown_list_values(plan, "UI gate") == ["final_human_required"]:
            boundary = index
            break
    current = set(ordered[boundary + 1 :])
    current.update(
        identifier
        for identifier, item in items.items()
        if item["status"] not in TERMINAL_SLICE_STATUSES
    )
    current.add(final_slice)
    return current

def ui_design_contract(bundle: Path, state: dict) -> tuple[str, str] | None:
    primary = safe_path(
        bundle, state["artifacts"]["primary"], "primary", required=True, markdown=True
    ).read_text(encoding="utf-8")
    items = slice_map(state)
    headings = re.findall(r"(?mi)^\s*##\s+UI Acceptance Policy\s*$", primary)
    policies = markdown_list_values(primary, "Policy")
    final_slices = markdown_list_values(primary, "Final UI slice")
    explicit_policy = bool(
        headings
        or policies
        or final_slices
        or "final_pr_design_gate" in primary
    )
    selected_final = (
        final_slices[0]
        if len(final_slices) == 1
        and SLICE_ID_RE.fullmatch(final_slices[0]) is not None
        else None
    )
    if selected_final in items:
        current_ids = current_ui_epoch_ids(bundle, items, selected_final)
    else:
        current_ids = {
            identifier
            for identifier, item in items.items()
            if item["status"] not in TERMINAL_SLICE_STATUSES
        }
        if state["phase"] == "delivery":
            current_ids.update(items)

    classifications: dict[str, str] = {}
    design_acceptance: dict[str, str | None] = {}
    automated_acceptance: dict[str, str | None] = {}
    for identifier in sorted(current_ids):
        plan = state_slice_plan_contract(bundle, state, items[identifier])
        classifications[identifier] = plan["gate"]
        automated_acceptance[identifier] = plan["automated"]
        if plan["automated"] is not None:
            if plan["automated"] not in acceptance_ids(bundle, state):
                raise StateError(
                    f"{identifier} automated UI acceptance is not declared"
                )
        design_acceptance[identifier] = plan["finalAcceptance"]

    ui_affecting = any(
        gate != "not_applicable" for gate in classifications.values()
    ) or any(value is not None for value in design_acceptance.values())
    automated_owners = [
        value for value in automated_acceptance.values() if value is not None
    ]
    if len(automated_owners) != len(set(automated_owners)):
        raise StateError("automated UI acceptance IDs must have one slice owner")
    if not ui_affecting and not explicit_policy:
        return None
    if len(headings) != 1:
        raise StateError(
            "UI-affecting or explicit UI policy requires exactly one "
            "primary specification UI Acceptance Policy section"
        )
    if len(policies) != 1 or policies[0] != "final_pr_design_gate":
        raise StateError(
            "UI Acceptance Policy requires exactly one Policy: final_pr_design_gate"
        )
    if len(final_slices) != 1 or SLICE_ID_RE.fullmatch(final_slices[0]) is None:
        raise StateError("final_pr_design_gate requires exactly one valid final UI slice")
    final_slice = final_slices[0]
    if final_slice not in items:
        raise StateError("final UI slice is missing from state")
    final_owners = [
        identifier
        for identifier, gate in classifications.items()
        if gate == "final_human_required"
    ]
    if final_owners != [final_slice]:
        raise StateError(
            "final UI slice must be the only slice classified final_human_required"
        )
    for identifier, gate in classifications.items():
        if identifier != final_slice and gate not in {
            "not_applicable", "snapshot_required_human_deferred"
        }:
            raise StateError(f"{identifier} has an invalid intermediate UI gate")
        if identifier != final_slice and gate == "snapshot_required_human_deferred":
            if not dependency_reaches(items, final_slice, identifier):
                raise StateError(
                    f"final UI slice is not ordered after {identifier}"
                )
    acceptance = design_acceptance[final_slice]
    if acceptance is None:
        raise StateError("final UI slice plan requires final design acceptance")
    if acceptance == automated_acceptance[final_slice]:
        raise StateError(
            "final design acceptance must remain separate from automated UI acceptance"
        )
    other_owners = [
        identifier
        for identifier, value in design_acceptance.items()
        if identifier != final_slice and value is not None
    ]
    if other_owners:
        raise StateError(
            "only the final UI slice may declare final design acceptance"
        )
    if acceptance not in acceptance_ids(bundle, state):
        raise StateError("final design acceptance is not declared in ACCEPTANCE.md")
    return final_slice, acceptance

def validate_ui_attestation(
    bundle: Path,
    state: dict,
    relative: str,
    *,
    mode: str,
    expected_status: str,
    require_current_revision: bool = True,
) -> str:
    contract = ui_design_contract(bundle, state)
    if contract is None:
        raise StateError("UI attestation supplied without final_pr_design_gate")
    final_slice, acceptance_id = contract
    path = safe_path(bundle, relative, "UI attestation", required=True)
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as error:
        raise StateError(f"malformed UI attestation: {error.msg}") from error
    attestation = exact_object(
        raw,
        "UI attestation",
        {
            "schema", "mode", "receipt", "receiptSha256",
            "bundleRevision", "finalSlice", "acceptanceId", "headSha",
            "headTree", "prNumber", "verdict",
        },
    )
    if attestation["schema"] != UI_ATTESTATION_SCHEMA or attestation["mode"] != mode:
        raise StateError("UI attestation schema or mode mismatch")
    if require_current_revision and attestation["bundleRevision"] != state["revision"]:
        raise StateError("UI attestation bundle revision is stale")
    if attestation["finalSlice"] != final_slice or attestation["acceptanceId"] != acceptance_id:
        raise StateError("UI attestation final slice or acceptance mismatch")
    item = slice_map(state)[final_slice]
    if attestation["headSha"] != item["head_sha"] or attestation["prNumber"] != item["pr"]:
        raise StateError("UI attestation head or PR is stale")
    string_value(
        attestation["headTree"], "UI attestation headTree", pattern=SHA_RE
    )
    verdict_status = "passed" if attestation["verdict"] == "PASS" else "waived" if attestation["verdict"] == "WAIVED" else None
    if verdict_status != expected_status:
        raise StateError("UI attestation verdict does not match acceptance status")
    receipt = relative_path_value(attestation["receipt"], "UI attestation receipt")
    receipt_path = safe_path(bundle, receipt, "UI attestation receipt", required=True)
    digest = string_value(
        attestation["receiptSha256"],
        "UI attestation receiptSha256",
        pattern=re.compile(r"^[0-9a-f]{64}$"),
    )
    if hashlib.sha256(receipt_path.read_bytes()).hexdigest() != digest:
        raise StateError("UI attestation receipt digest mismatch")
    validate_slice_artifact_paths(item)
    owner = (
        bundle / canonical_slice_directory(final_slice) / "evidence"
    ).resolve()
    if owner not in path.resolve().parents or owner not in receipt_path.resolve().parents:
        raise StateError("UI attestation or receipt is outside final slice ownership")
    return receipt

def validate_typed_ui_attestation(
    bundle: Path,
    state: dict,
    relative: str,
    *,
    mode: str,
    expected_status: str,
    allow_recorded_revision: bool = False,
) -> str:
    receipt = validate_ui_attestation(
        bundle,
        state,
        relative,
        mode=mode,
        expected_status=expected_status,
        require_current_revision=not allow_recorded_revision,
    )
    configuration = work_configuration(state["work_kind"])
    bundle_relative = (
        configuration["bundle_parent"] / "in_progress" / state["work_id"]
    ).as_posix()
    final_slice, _ = ui_design_contract(bundle, state) or (None, None)
    item = slice_map(state)[final_slice]
    command = [
        sys.executable,
        str(UI_RECEIPT_VALIDATOR),
        "--receipt", str(bundle / receipt),
        "--mode", mode,
        "--expected-work-kind", state["work_kind"],
        "--expected-work-bundle", bundle_relative,
        "--expected-slice-id", final_slice,
        "--expected-final-ui-slice-id", final_slice,
        "--expected-head-sha", item["head_sha"],
        "--expected-pr-number", str(item["pr"]),
        "--verify-attestation", str(bundle / relative),
    ]
    if allow_recorded_revision:
        command.append("--allow-recorded-revision")
    process = subprocess.run(
        command, cwd=REPO, text=True, capture_output=True, check=False
    )
    if process.returncode != 0:
        raise StateError(
            "typed final UI validation failed: " + process.stderr.strip()
        )
    return receipt


def validate_final_ui_issue_receipt(
    bundle: Path,
    state: dict,
    item: dict,
    relative: str,
    *,
    allow_archived: bool = False,
    archived_plan_checkpoint_sha: str | None = None,
) -> str:
    path = safe_path(
        bundle, relative, "final UI checkpoint issue receipt", required=True
    )
    configuration = work_configuration(state["work_kind"])
    bundle_relative = (
        configuration["bundle_parent"] / "in_progress" / state["work_id"]
    ).as_posix()
    command = [
        sys.executable,
        str(UI_RECEIPT_VALIDATOR),
        "--receipt", str(path),
        "--mode", "final-checkpoint-issue",
        "--expected-work-kind", state["work_kind"],
        "--expected-work-bundle", bundle_relative,
        "--expected-slice-id", item["id"],
        "--expected-final-ui-slice-id", item["id"],
        "--expected-head-sha", item["head_sha"],
        "--expected-pr-number", str(item["pr"]),
    ]
    if allow_archived:
        command.extend([
            "--allow-archived-final-checkpoint",
            "--archived-plan-checkpoint-sha",
            str(archived_plan_checkpoint_sha),
        ])
    process = subprocess.run(
        command, cwd=REPO, text=True, capture_output=True, check=False
    )
    if process.returncode != 0:
        raise StateError(
            "typed final UI checkpoint issue validation failed: "
            + process.stderr.strip()
        )
    return hashlib.sha256(path.read_bytes()).hexdigest()

def completion_binding_value(
    bundle: Path, state: dict, attestation_relative: str, receipt_relative: str
) -> dict:
    attestation_path = safe_path(
        bundle, attestation_relative, "completion attestation", required=True
    )
    receipt_path = safe_path(
        bundle, receipt_relative, "completion receipt", required=True
    )
    try:
        attestation = json.loads(attestation_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise StateError(f"invalid completion attestation: {error}") from error
    final_slice, acceptance_id = ui_design_contract(bundle, state) or (None, None)
    item = slice_map(state)[final_slice]
    return {
        "receipt": receipt_relative,
        "receipt_digest": hashlib.sha256(receipt_path.read_bytes()).hexdigest(),
        "attestation": attestation_relative,
        "attestation_digest": hashlib.sha256(attestation_path.read_bytes()).hexdigest(),
        "head_sha": item["head_sha"],
        "head_tree": attestation.get("headTree"),
        "pr": item["pr"],
        "final_slice": final_slice,
        "acceptance_id": acceptance_id,
        "verdict": attestation.get("verdict"),
    }

def validate_completion_binding_files(
    bundle: Path, binding: dict, *, location: str = "completion_binding"
) -> None:
    completion_ui_binding_schema(binding, location)
    for field, digest_field in (
        ("receipt", "receipt_digest"),
        ("attestation", "attestation_digest"),
    ):
        path = safe_path(
            bundle, binding[field], f"{location} {field}", required=True
        )
        if hashlib.sha256(path.read_bytes()).hexdigest() != binding[digest_field]:
            raise StateError(f"{location} {field} digest mismatch")
    try:
        attestation = json.loads(
            (bundle / binding["attestation"]).read_text(encoding="utf-8")
        )
    except (OSError, json.JSONDecodeError) as error:
        raise StateError(f"invalid {location} attestation: {error}") from error
    expected = {
        "receipt": binding["receipt"],
        "receiptSha256": binding["receipt_digest"],
        "headSha": binding["head_sha"],
        "headTree": binding["head_tree"],
        "prNumber": binding["pr"],
        "finalSlice": binding["final_slice"],
        "acceptanceId": binding["acceptance_id"],
        "verdict": binding["verdict"],
    }
    if not isinstance(attestation, dict) or any(
        attestation.get(field) != expected_value
        for field, expected_value in expected.items()
    ):
        raise StateError(f"{location} differs from typed completion sidecar")

def validate_completion_binding(bundle: Path, state: dict) -> None:
    contract = ui_design_contract(bundle, state)
    if contract is None:
        return
    binding = state["completion_binding"]
    if binding is None:
        raise StateError("completed UI feature requires completion_binding")
    validate_completion_binding_files(bundle, binding)
    final_slice, acceptance_id = contract
    item = slice_map(state)[final_slice]
    record = state["acceptance"][acceptance_id]
    expected_status = "passed" if binding["verdict"] == "PASS" else "waived"
    if (
        binding["final_slice"] != final_slice
        or binding["acceptance_id"] != acceptance_id
        or binding["head_sha"] != item["head_sha"]
        or binding["pr"] != item["pr"]
        or record["status"] != expected_status
    ):
        raise StateError("completion_binding differs from completed UI authority")
    try:
        attestation = json.loads(
            (bundle / binding["attestation"]).read_text(encoding="utf-8")
        )
    except (OSError, json.JSONDecodeError) as error:
        raise StateError(f"invalid completion_binding attestation: {error}") from error
    if (
        not isinstance(attestation, dict)
        or binding["head_tree"] != attestation.get("headTree")
        or binding["receipt_digest"] != attestation.get("receiptSha256")
        or binding["verdict"] != attestation.get("verdict")
    ):
        raise StateError("completion_binding differs from typed completion sidecar")
    receipt = validate_typed_ui_attestation(
        bundle,
        state,
        binding["attestation"],
        mode="completion",
        expected_status=record["status"],
        allow_recorded_revision=True,
    )
    if receipt != binding["receipt"]:
        raise StateError("completion_binding receipt differs from typed attestation")

def validate_typed_implementation_receipt(
    bundle: Path, state: dict, slice_id: str, relative: str
) -> str:
    item = slice_map(state)[slice_id]
    if item["status"] not in {"pr_open", "merged"}:
        raise StateError(
            "automated UI acceptance requires a published current-head slice"
        )
    contract = ui_design_contract(bundle, state)
    if contract is None:
        raise StateError("automated UI acceptance requires an active UI contract")
    final_slice, _ = contract
    plan = state_slice_plan_contract(bundle, state, item)
    if plan["automated"] is None:
        raise StateError(f"{slice_id} does not own automated UI acceptance")
    receipt_path = safe_path(
        bundle, relative, f"{slice_id} typed implementation receipt", required=True
    )
    evidence_prefix = bundle / canonical_slice_directory(slice_id) / "evidence"
    try:
        receipt_path.resolve().relative_to(evidence_prefix.resolve())
    except ValueError as error:
        raise StateError(
            f"{slice_id} typed implementation receipt is outside canonical evidence"
        ) from error
    try:
        payload = json.loads(receipt_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise StateError(f"invalid typed implementation receipt: {error}") from error
    tree = payload.get("worktreeTree") if isinstance(payload, dict) else None
    string_value(tree, "typed implementation receipt worktreeTree", pattern=SHA_RE)
    configuration = work_configuration(state["work_kind"])
    bundle_relative = (
        configuration["bundle_parent"] / "in_progress" / state["work_id"]
    ).as_posix()
    command = [
        sys.executable,
        str(UI_RECEIPT_VALIDATOR),
        "--receipt", str(receipt_path),
        "--mode", "implementation-proof",
        "--expected-work-kind", state["work_kind"],
        "--expected-work-bundle", bundle_relative,
        "--expected-slice-id", slice_id,
        "--expected-final-ui-slice-id", final_slice,
        "--expected-worktree-tree", tree,
    ]
    process = subprocess.run(
        command, cwd=REPO, text=True, capture_output=True, check=False
    )
    if process.returncode != 0:
        raise StateError(
            "typed implementation UI validation failed: " + process.stderr.strip()
        )
    return receipt_path.resolve().relative_to(bundle.resolve()).as_posix()

def require_recorded_automated_ui_acceptance(
    bundle: Path, state: dict, slice_id: str, acceptance_id: str
) -> str:
    record = state["acceptance"].get(acceptance_id)
    if record is None or record["status"] != "passed":
        raise StateError(
            f"{slice_id} cannot merge before automated UI acceptance "
            f"{acceptance_id} is passed"
        )
    for evidence in record["evidence"]:
        try:
            return validate_typed_implementation_receipt(
                bundle, state, slice_id, evidence
            )
        except StateError:
            continue
    raise StateError(
        f"{slice_id} automated UI acceptance requires its exact typed "
        "implementation-proof receipt"
    )

def has_bound_implementation_receipt(
    bundle: Path, slice_id: str, acceptance_id: str,
    proof_target: str, evidence: list[str],
) -> bool:
    prefix = (bundle / canonical_slice_directory(slice_id) / "evidence").resolve()
    for relative in evidence:
        try:
            path = safe_path(
                bundle, relative, f"{slice_id} implementation receipt", required=True
            )
            path.resolve().relative_to(prefix)
            value = json.loads(path.read_text(encoding="utf-8"))
        except (StateError, ValueError, OSError, json.JSONDecodeError):
            continue
        if not isinstance(value, dict):
            continue
        if (
            value.get("schema") == UI_RECEIPT_SCHEMA
            and value.get("gatePhase") == "implementation_proof"
            and value.get("sliceId") == slice_id
            and value.get("acceptanceCriterion") == acceptance_id
            and value.get("proofTarget") == proof_target
            and value.get("worktreeTree") is not None
        ):
            return True
    return False

def require_recorded_final_ui_acceptance(
    bundle: Path, state: dict, final_slice: str, acceptance_id: str
) -> None:
    record = state["acceptance"].get(acceptance_id)
    if record is None or record["status"] not in {"passed", "waived"}:
        raise StateError(
            "final UI slice cannot merge before final design acceptance is passed or waived"
        )
    for evidence in record["evidence"]:
        try:
            validate_typed_ui_attestation(
                bundle,
                state,
                evidence,
                mode="final-design-acceptance",
                expected_status=record["status"],
                allow_recorded_revision=True,
            )
            return
        except StateError:
            continue
    raise StateError(
        "final UI slice cannot merge without its recorded final-design attestation"
    )

def slice_map(state: dict) -> dict[str, dict]:
    result: dict[str, dict] = {}
    for item in state["slices"]:
        identifier = item["id"]
        if identifier in result:
            raise StateError(f"duplicate slice id: {identifier}")
        result[identifier] = item
    return result

def dependency_reaches(
    items: dict[str, dict], source: str, target: str, seen: set[str] | None = None
) -> bool:
    visited = set() if seen is None else seen
    if source in visited:
        return False
    visited.add(source)
    for dependency in items[source]["depends_on"]:
        if dependency == target or dependency_reaches(
            items, dependency, target, visited
        ):
            return True
    return False

def validate_dependencies(items: dict[str, dict]) -> None:
    for identifier, item in items.items():
        for dependency in item["depends_on"]:
            if dependency not in items:
                raise StateError(f"unknown dependency for {identifier}: {dependency}")
            if dependency == identifier:
                raise StateError(f"dependency cycle includes {identifier}")
    visiting: set[str] = set()
    visited: set[str] = set()

    def visit(identifier: str) -> None:
        if identifier in visiting:
            raise StateError(f"dependency cycle includes {identifier}")
        if identifier in visited:
            return
        visiting.add(identifier)
        for dependency in items[identifier]["depends_on"]:
            visit(dependency)
        visiting.remove(identifier)
        visited.add(identifier)

    for identifier in sorted(items):
        visit(identifier)

def validate_mutation_interlocks(state: dict) -> None:
    items = slice_map(state)
    if state["phase"] == "discuss":
        active_labels = all_nonquiescent_task_labels(items)
        snapshot_owner = reopened_premerge_snapshot_owner(state)
        if snapshot_owner is not None:
            active_labels = [
                label for label in active_labels if label != snapshot_owner
            ]
        if active_labels:
            raise StateError(
                "discuss requires tasks quiescent: " + ", ".join(active_labels)
            )
    active = [
        item
        for item in items.values()
        if any(
            item[field]["state"] == "active"
            for field in ("implementation_task", "review_task")
        )
    ]
    for index, left in enumerate(active):
        for right in active[index + 1 :]:
            if dependency_reaches(items, left["id"], right["id"]) or dependency_reaches(
                items, right["id"], left["id"]
            ):
                raise StateError(
                    "dependency-edge slices cannot mutate concurrently: "
                    f"{left['id']}, {right['id']}"
                )
            if (
                left["execution_mode"] != "parallel"
                or right["execution_mode"] != "parallel"
                or left["wave"] != right["wave"]
            ):
                raise StateError(
                    "concurrent mutation requires one approved parallel wave: "
                    f"{left['id']}, {right['id']}"
                )
            overlap = owned_paths_overlap(left, right)
            if overlap is not None:
                raise StateError(
                    "active slice owned paths overlap: "
                    f"{left['id']}:{overlap[0]} and {right['id']}:{overlap[1]}"
                )
            require_independent_pairs(state, [left, right])

def validate_bindings(items: dict[str, dict]) -> None:
    branches: dict[str, str] = {}
    for identifier, item in items.items():
        for owned_path in item["owned_paths"]:
            repo_path_parts(owned_path, f"{identifier} owned path")
        binding = (item["branch"], item["base_ref"], item["base_sha"])
        if any(value is not None for value in binding) and not all(
            value is not None for value in binding
        ):
            raise StateError(f"{identifier} branch/base binding must be complete")
        if item["status"] in BOUND_SLICE_STATUSES and not all(
            value is not None for value in binding
        ):
            raise StateError(f"{identifier} status {item['status']} requires a binding")
        branch = item["branch"]
        if branch is not None:
            owner = branches.get(branch)
            if owner is not None:
                raise StateError(
                    f"branch is shared by {owner} and {identifier}: {branch}"
                )
            branches[branch] = identifier

def validate_observed_main(state: dict) -> None:
    observed = state["observed_main_sha"]
    deferred_carrier = terminal_snapshot_carrier(state)
    for item in state["slices"]:
        if item["base_ref"] != "origin/main":
            continue
        if observed is None:
            raise StateError("origin/main bindings require an observed_main_sha")
        if item["base_sha"] == observed or item["status"] in TERMINAL_SLICE_STATUSES:
            continue
        if item["id"] == deferred_carrier and item["status"] != "pr_open":
            continue
        if item["status"] != "blocked":
            raise StateError(
                f"{item['id']} origin/main binding is stale against observed_main_sha"
            )
        active = nonquiescent_task_labels(item)
        if active:
            raise StateError(
                "stale origin/main binding has nonquiescent tasks: "
                + ", ".join(active)
            )

def require_current_base(state: dict, item: dict) -> None:
    upstream = stackable_dependency(slice_map(state), item)
    if upstream is not None:
        if (
            item["base_ref"] != upstream["branch"]
            or item["base_sha"] != upstream["head_sha"]
        ):
            raise StateError(
                f"{item['id']} must bind its open dependency branch and head"
            )
        return
    if item["base_ref"] == "origin/main":
        if (
            state["observed_main_sha"] is None
            or item["base_sha"] != state["observed_main_sha"]
        ):
            raise StateError(
                f"{item['id']} must bind the current observed origin/main SHA"
            )
        return
    raise StateError(
        f"{item['id']} non-main base must bind its clean direct upstream head"
    )


def canonical_remote_branch_ref(value: str, *, remote: str = "origin") -> str:
    string_value(value, "remote branch ref")
    if value.startswith("refs/heads/"):
        branch = value.removeprefix("refs/heads/")
    elif value.startswith(f"refs/remotes/{remote}/"):
        branch = value.removeprefix(f"refs/remotes/{remote}/")
    elif value.startswith(f"{remote}/"):
        branch = value.removeprefix(f"{remote}/")
    elif value.startswith("refs/"):
        raise StateError(f"unsupported remote branch ref: {value}")
    else:
        branch = value
    if (
        not branch
        or branch.startswith("/")
        or branch.endswith("/")
        or ".." in branch
        or "@{" in branch
    ):
        raise StateError(f"unsupported remote branch ref: {value}")
    return f"refs/heads/{branch}"


