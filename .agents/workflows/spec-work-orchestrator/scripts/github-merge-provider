#!/usr/bin/env python3
"""Create one exact-parent GitHub merge commit with atomic base/head CAS."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
from typing import NoReturn


SHA_RE = re.compile(r"[0-9a-f]{40}")
REPOSITORY_RE = re.compile(r"[^/\s]+/[^/\s]+")
PROVIDER = "github-update-refs"
UPDATE_REFS_MUTATION = """
mutation GitHubAtomicMerge(
  $repositoryId: ID!
  $refUpdates: [RefUpdate!]!
) {
  updateRefs(input: {
    repositoryId: $repositoryId
    refUpdates: $refUpdates
    clientMutationId: "github-merge-provider"
  }) {
    clientMutationId
  }
}
""".strip()


class ProviderError(RuntimeError):
    """The provider could not emit a truthful typed result."""


class GitHubError(RuntimeError):
    """One GitHub CLI request failed before a merge mutation was submitted."""

    def __init__(self, status: int, detail: str):
        super().__init__(detail)
        self.status = status


def canonical_bytes(value: object) -> bytes:
    return (
        json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n"
    ).encode("utf-8")


def sha(value: object, label: str) -> str:
    if not isinstance(value, str) or SHA_RE.fullmatch(value) is None:
        raise ProviderError(f"{label} must be a lowercase 40-character SHA")
    return value


def positive_integer(value: object, label: str) -> int:
    if type(value) is not int or value < 1:
        raise ProviderError(f"{label} must be a positive integer")
    return value


def repository_name() -> str:
    configured = os.environ.get("GH_REPO")
    if configured:
        if REPOSITORY_RE.fullmatch(configured) is None:
            raise ProviderError("GH_REPO must be an owner/repository name")
        return configured
    result = subprocess.run(
        ["gh", "repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner"],
        text=True,
        capture_output=True,
        check=False,
        timeout=30,
    )
    value = result.stdout.strip()
    if result.returncode != 0 or REPOSITORY_RE.fullmatch(value) is None:
        detail = result.stderr.strip() or "could not infer the GitHub repository"
        raise ProviderError(detail)
    return value


def gh_json(arguments: list[str]) -> dict:
    try:
        result = subprocess.run(
            ["gh", *arguments],
            text=True,
            capture_output=True,
            check=False,
            timeout=60,
        )
    except (OSError, subprocess.SubprocessError) as error:
        raise GitHubError(1, str(error)) from error
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip()
        raise GitHubError(result.returncode, detail or "GitHub request failed")
    try:
        value = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise GitHubError(1, f"GitHub returned invalid JSON: {error}") from error
    if not isinstance(value, dict):
        raise GitHubError(1, "GitHub returned a non-object JSON response")
    return value


def read_pull(repository: str, number: int) -> dict:
    return gh_json([
        "api",
        "--method",
        "GET",
        f"repos/{repository}/pulls/{number}",
    ])


def read_commit(repository: str, oid: str) -> dict:
    return gh_json([
        "api",
        "--method",
        "GET",
        f"repos/{repository}/git/commits/{oid}",
    ])


def nested(value: dict, *path: str) -> object:
    current: object = value
    for component in path:
        if not isinstance(current, dict) or component not in current:
            raise ProviderError(
                f"GitHub response missing {'.'.join(path)}"
            )
        current = current[component]
    return current


def optional_observed_sha(value: dict, side: str) -> str | None:
    try:
        observed = nested(value, side, "sha")
    except ProviderError:
        return None
    if not isinstance(observed, str) or SHA_RE.fullmatch(observed) is None:
        return None
    return observed


def provider_result(
    *,
    result: str,
    status: int = 200,
    atomic: bool = False,
    pr_number: int | None = None,
    head_sha: str | None = None,
    base_sha: str | None = None,
    merge_sha: str | None = None,
    parents: list[str] | None = None,
) -> dict:
    return {
        "provider": PROVIDER,
        "providerStatus": status,
        "atomicCommitIdentityEnforced": atomic,
        "observedPrNumber": pr_number,
        "observedHeadSha": head_sha,
        "observedBaseSha": base_sha,
        "result": result,
        "mergeCommitSha": merge_sha,
        "mergeCommitParents": parents or [],
    }


def request_identity(request: dict) -> tuple[int, str, str, str]:
    number = positive_integer(request.get("expectedPrNumber"), "expectedPrNumber")
    head = sha(request.get("expectedHeadSha"), "expectedHeadSha")
    base = sha(request.get("expectedBaseSha"), "expectedBaseSha")
    base_ref = request.get("expectedBaseRef")
    if not isinstance(base_ref, str) or not base_ref.strip():
        raise ProviderError("expectedBaseRef must be a non-empty string")
    if base_ref.startswith("origin/"):
        base_ref = base_ref.removeprefix("origin/")
    if not base_ref.startswith("refs/heads/"):
        base_ref = f"refs/heads/{base_ref}"
    return number, head, base_ref, base


def classify_identity(
    request: dict,
    pull: dict,
    repository: str,
) -> tuple[dict | None, dict]:
    number, expected_head, expected_base_ref, expected_base = request_identity(
        request
    )
    observed_number = pull.get("number")
    observed_head = optional_observed_sha(pull, "head")
    observed_base = optional_observed_sha(pull, "base")
    evidence = {
        "number": observed_number if type(observed_number) is int else None,
        "head": observed_head,
        "base": observed_base,
    }

    if observed_number != number:
        return provider_result(
            result="PR_NUMBER_DRIFT",
            pr_number=evidence["number"],
            head_sha=observed_head,
            base_sha=observed_base,
        ), evidence
    if observed_head != expected_head:
        return provider_result(
            result="HEAD_DRIFT",
            pr_number=number,
            head_sha=observed_head,
            base_sha=observed_base,
        ), evidence
    if observed_base != expected_base:
        return provider_result(
            result="BASE_DRIFT_AFTER_CONSUMED_FRESHNESS",
            pr_number=number,
            head_sha=observed_head,
            base_sha=observed_base,
        ), evidence

    base_ref_name = nested(pull, "base", "ref")
    if (
        not isinstance(base_ref_name, str)
        or f"refs/heads/{base_ref_name}" != expected_base_ref
        or pull.get("state") != "open"
        or pull.get("merged") is not False
        or pull.get("draft") is not False
    ):
        return provider_result(
            result="PR_LIFECYCLE_DRIFT",
            pr_number=number,
            head_sha=observed_head,
            base_sha=observed_base,
        ), evidence

    base_repository = nested(pull, "base", "repo", "full_name")
    head_repository = nested(pull, "head", "repo", "full_name")
    if base_repository != repository or head_repository != repository:
        return provider_result(
            result="ATOMIC_PRECONDITION_UNAVAILABLE",
            pr_number=number,
            head_sha=observed_head,
            base_sha=observed_base,
        ), evidence
    return None, evidence


def merge_candidate(
    repository: str,
    number: int,
    expected_base: str,
    expected_head: str,
) -> tuple[str, list[str]]:
    reference = gh_json([
        "api",
        "--method",
        "GET",
        f"repos/{repository}/git/ref/pull/{number}/merge",
    ])
    if reference.get("ref") != f"refs/pull/{number}/merge":
        raise ProviderError("GitHub returned the wrong PR merge reference")
    candidate = sha(nested(reference, "object", "sha"), "merge candidate")
    if nested(reference, "object", "type") != "commit":
        raise ProviderError("GitHub PR merge reference does not target a commit")
    commit = read_commit(repository, candidate)
    raw_parents = commit.get("parents")
    if not isinstance(raw_parents, list):
        raise ProviderError("GitHub merge candidate has no parent list")
    parents = [
        sha(parent.get("sha") if isinstance(parent, dict) else None, "merge parent")
        for parent in raw_parents
    ]
    if parents != [expected_base, expected_head]:
        raise ProviderError(
            "GitHub PR merge candidate does not bind the expected base/head"
        )
    return candidate, parents


def atomic_update_refs(
    repository_id: str,
    base_ref: str,
    base_sha: str,
    head_ref: str,
    head_sha: str,
    merge_sha: str,
) -> subprocess.CompletedProcess:
    payload = {
        "query": UPDATE_REFS_MUTATION,
        "variables": {
            "repositoryId": repository_id,
            "refUpdates": [
                {
                    "name": base_ref,
                    "beforeOid": base_sha,
                    "afterOid": merge_sha,
                    "force": False,
                },
                {
                    "name": head_ref,
                    "beforeOid": head_sha,
                    "afterOid": head_sha,
                    "force": False,
                },
            ],
        },
    }
    try:
        return subprocess.run(
            ["gh", "api", "graphql", "--input", "-"],
            input=json.dumps(payload, separators=(",", ":")) + "\n",
            text=True,
            capture_output=True,
            check=False,
            timeout=60,
        )
    except (OSError, subprocess.SubprocessError) as error:
        raise ProviderError(
            f"atomic GitHub operation outcome is unknown: {error}"
        ) from error


def graphql_succeeded(result: subprocess.CompletedProcess) -> bool:
    if result.returncode != 0:
        return False
    try:
        response = json.loads(result.stdout)
    except json.JSONDecodeError:
        return False
    return (
        isinstance(response, dict)
        and not response.get("errors")
        and nested(response, "data", "updateRefs", "clientMutationId")
        == "github-merge-provider"
    )


def unavailable_graphql(detail: str) -> bool:
    lowered = detail.lower()
    return (
        "updaterefs" in lowered
        and (
            "doesn't exist" in lowered
            or "unknown" in lowered
            or "not supported" in lowered
        )
    )


def structured_graphql_error(result: subprocess.CompletedProcess) -> bool:
    for output in (result.stdout, result.stderr):
        for line in reversed(output.splitlines()):
            try:
                value = json.loads(line)
            except json.JSONDecodeError:
                continue
            if isinstance(value, dict) and value.get("errors"):
                return True
    return False


def perform_merge(request: dict, repository: str) -> dict:
    number, expected_head, base_ref, expected_base = request_identity(request)
    try:
        pull = read_pull(repository, number)
    except GitHubError as error:
        return provider_result(result="PROVIDER_REFUSAL", status=error.status)
    try:
        classified, evidence = classify_identity(request, pull, repository)
    except ProviderError:
        return provider_result(
            result="PROVIDER_REFUSAL",
            status=1,
            pr_number=(
                pull.get("number") if type(pull.get("number")) is int else None
            ),
            head_sha=optional_observed_sha(pull, "head"),
            base_sha=optional_observed_sha(pull, "base"),
        )
    if classified is not None:
        return classified
    try:
        candidate, parents = merge_candidate(
            repository,
            number,
            expected_base,
            expected_head,
        )
        repository_id = nested(pull, "base", "repo", "node_id")
        head_name = nested(pull, "head", "ref")
        if not isinstance(repository_id, str) or not repository_id:
            raise ProviderError("GitHub PR base repository has no node ID")
        if not isinstance(head_name, str) or not head_name:
            raise ProviderError("GitHub PR head has no ref name")
    except (GitHubError, ProviderError) as error:
        status = error.status if isinstance(error, GitHubError) else 1
        return provider_result(
            result="PROVIDER_REFUSAL",
            status=status,
            pr_number=evidence["number"],
            head_sha=evidence["head"],
            base_sha=evidence["base"],
        )

    mutation = atomic_update_refs(
        repository_id,
        base_ref,
        expected_base,
        f"refs/heads/{head_name}",
        expected_head,
        candidate,
    )
    if graphql_succeeded(mutation):
        return provider_result(
            result="MERGED",
            atomic=True,
            pr_number=number,
            head_sha=expected_head,
            base_sha=expected_base,
            merge_sha=candidate,
            parents=parents,
        )

    detail = "\n".join((mutation.stdout, mutation.stderr)).strip()
    try:
        current = read_pull(repository, number)
    except (GitHubError, ProviderError) as error:
        raise ProviderError(
            "atomic GitHub operation outcome is unknown; reconciliation required"
        ) from error
    current_head = optional_observed_sha(current, "head")
    current_base = optional_observed_sha(current, "base")
    if current_head == expected_head and (
        current_base == candidate
        or (
            current.get("merged") is True
            and current.get("merge_commit_sha") == candidate
        )
    ):
        return provider_result(
            result="MERGED",
            atomic=True,
            pr_number=number,
            head_sha=expected_head,
            base_sha=expected_base,
            merge_sha=candidate,
            parents=parents,
        )
    if not structured_graphql_error(mutation):
        raise ProviderError(
            "atomic GitHub operation outcome is unknown; reconciliation required"
        )
    drift, current_evidence = classify_identity(request, current, repository)
    if drift is not None and drift["result"] in {
        "PR_NUMBER_DRIFT",
        "HEAD_DRIFT",
        "BASE_DRIFT_AFTER_CONSUMED_FRESHNESS",
        "PR_LIFECYCLE_DRIFT",
    }:
        drift["providerStatus"] = mutation.returncode or 1
        drift["atomicCommitIdentityEnforced"] = True
        return drift
    if unavailable_graphql(detail):
        return provider_result(
            result="ATOMIC_PRECONDITION_UNAVAILABLE",
            status=mutation.returncode or 1,
            pr_number=current_evidence["number"],
            head_sha=current_evidence["head"],
            base_sha=current_evidence["base"],
        )
    if not detail:
        raise ProviderError(
            "atomic GitHub operation outcome is unknown; reconciliation required"
        )
    return provider_result(
        result="PROVIDER_REFUSAL",
        status=mutation.returncode or 1,
        atomic=True,
        pr_number=current_evidence["number"],
        head_sha=current_evidence["head"],
        base_sha=current_evidence["base"],
    )


def perform_reconciliation(value: dict, repository: str) -> dict:
    reservation = value.get("reservation")
    digest = value.get("reservationDigest")
    if not isinstance(reservation, dict) or not isinstance(digest, str):
        raise ProviderError("reconciliation reservation is invalid")
    if hashlib.sha256(canonical_bytes(reservation)).hexdigest() != digest:
        raise ProviderError("reconciliation reservation digest does not match")
    request_identity(reservation)
    raise ProviderError(
        "provider outcome remains ambiguous; reservation does not authenticate "
        "the exact candidate SHA; do not retry"
    )


def emit(value: dict) -> None:
    sys.stdout.buffer.write(canonical_bytes(value))


def fail(message: str) -> NoReturn:
    print(f"github-merge-provider: {message}", file=sys.stderr)
    raise SystemExit(2)


def parser() -> argparse.ArgumentParser:
    return argparse.ArgumentParser(
        description=(
            "Read a typed merge or reconciliation request from stdin and emit "
            "one typed GitHub provider result on stdout."
        )
    )


def main() -> int:
    parser().parse_args()
    try:
        value = json.load(sys.stdin)
        if not isinstance(value, dict):
            raise ProviderError("input must be a JSON object")
        schema = value.get("schema")
        repository = repository_name()
        if schema == "spec-work-premerge-operation":
            emit(perform_merge(value, repository))
        elif schema == "spec-work-premerge-reconciliation":
            emit(perform_reconciliation(value, repository))
        else:
            raise ProviderError("input schema is unsupported")
        return 0
    except (json.JSONDecodeError, ProviderError) as error:
        fail(str(error))


if __name__ == "__main__":
    raise SystemExit(main())
